+        tmp = Path(tempfile.mkdtemp(prefix="t06b-part-"))
+        pr, cu, _ = _stage_and_publish(tmp, run, parent, segs1)
+        # manifest 声明两个可发布区间（expected=2），但只回报/登记第一个（registered=1）
+        key2 = f"slope:{(BASE_S + 5) * NANO}:{(BASE_S + 6) * NANO}"
+        manifest = _manifest_dict(run, parent, outcome="SUCCESS", segments=segs1, expected=[key1, key2])
+        body = _report_body(run, parent, manifest=manifest, child_map={key1: cu[key1], key2: _child_uid()})
+        r1 = client.post(f"/api/v1/scene-analysis-runs/{run_id}/results", json=body)
+        assert r1.status_code == 200
+        # complete：expected(2) != registered(1) → 409 INCOMPLETE
