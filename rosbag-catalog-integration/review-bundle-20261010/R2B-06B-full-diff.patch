+def reconcile_scene(db: Session, pipeline_run_id: str, payload: dict) -> dict:
+    """POST /reconcile-scene：按发布目录的 per-slice manifest 补登记/推进可用。
+
+    - 恢复入口不要求租约（运行可能已终态/租约已清），但要求运行类型 + 源围栏
+      + 场景在 run 内 + 源代次一致（防跨代次补登记）；
+    - 先查登记事实：av 行已关联内容行且完整性满足 → 只做可用性推进；
+    - 未登记 → 从发布目录读 per-slice manifest 重建 SceneManifest（digest 必须
+      全切片一致），幂等登记（06A 语义），再推进；
+    - 不重复 move、不覆盖文件、不创建新 run、不切当前（换版只在 complete）。
+    """
+    run = db.scalar(select(PipelineRun).where(PipelineRun.pipeline_run_id == pipeline_run_id).with_for_update())
+    if run is None:
+        raise HTTPException(404, f"scene run not found: {pipeline_run_id}")
+    if run.pipeline_type != PIPELINE_TYPE_SCENE_SLICE:
+        raise HTTPException(409, "run is not a scene slice run")
+    parent = db.scalar(select(BagRecord).where(BagRecord.bag_uid == run.source_id))
+    if parent is None:
+        raise HTTPException(409, "SOURCE_NOT_READY: 父包已不存在（对账先行，不得补登记）")
+    if parent.source_generation != int(payload.get("source_generation") or 0):
+        gen = payload.get("source_generation")
+        raise HTTPException(409, f"SOURCE_GENERATION_MISMATCH: 对账代次 {gen} != 当前 {parent.source_generation}")
+    check_fence_for_source(db, run.source_id)
+    scene_code = str(payload.get("scene_code") or "")
+    _require_scene_entry(run, scene_code)  # 场景须在 run 内（对账不信任调用方越权场景）
+    manifest, child_uids = _manifest_from_publish_root(run, scene_code, payload)
+    av_row = _find_av_row(db, run, scene_code)
+    if av_row is not None:
+        _link_av_row(db, av_row, manifest)
+    res = scene_result_service.register_manifest(db, manifest, expected_child_uids=child_uids)
+    content_row = db.get(SceneAnalysisVersion, res["analysis_version_id"])
+    if content_row is None:
+        raise HTTPException(409, "INCOMPLETE: 登记内容行缺失")
+    outcome = manifest.outcome
+    response: dict = {
+        "pipeline_run_id": pipeline_run_id,
+        "scene_code": scene_code,
+        "reconciled": True,
+        "registered": content_row.registered_segment_count == content_row.expected_segment_count,
+    }
+    if outcome in (SceneOutcome.SUCCESS.value, SceneOutcome.NO_MATCH.value):
+        _check_integrity(db, content_row, manifest)
+        _verify_published_files(db, run, content_row, manifest, payload)
+        response["available_children"] = _mark_children_available(db, run, content_row)
+    db.commit()
+    return response
+
+
+def _manifest_from_publish_root(
+    run: PipelineRun, scene_code: str, payload: dict
+) -> tuple[SceneManifest, dict[str, str]]:
+    """发布目录 per-slice manifest → (SceneManifest, slice_key→child_uid)。
+
+    恢复事实来源：完整 manifest 以 per-slice 记录为准（各切片记录同一份完整
+    manifest，digest 必须一致），子包身份映射从记录中恢复，不猜测。
+    """
+    root = payload.get("publish_root")
+    if not root:
+        raise HTTPException(409, "INCOMPLETE: reconcile 需要 publish_root（恢复必须按 manifest 对账）")
+    from pathlib import Path
+
+    from app.services.scene_publish_service import SLICE_MANIFEST_NAME
+
+    base = Path(str(root)) / (payload.get("vehicle_key") or "unassigned") / scene_code
+    records = []
+    if base.is_dir():
+        for d in sorted(base.iterdir()):
+            f = d / SLICE_MANIFEST_NAME
+            if d.is_dir() and f.is_file() and d.name.startswith(f"{run.source_id}_"):
+                try:
+                    records.append(json.loads(f.read_text(encoding="utf-8")))
+                except (OSError, json.JSONDecodeError):
+                    raise HTTPException(409, f"INCOMPLETE: per-slice manifest 不可读 {f}")
+    if not records:
+        raise HTTPException(409, f"INCOMPLETE: 发布根 {base} 下无本 run 切片的 manifest 记录（文件未发布或路径不符）")
+    manifest_raw = dict(records[0].get("manifest") or {})
+    entry = _require_scene_entry(run, scene_code)
+    manifest = parse_report_manifest(manifest_raw, run=run, scene_code=scene_code, entry=entry)
+    child_uids: dict[str, str] = {}
+    for rec in records:
+        slice_info = rec.get("slice") or {}
+        child_uid = slice_info.get("child_bag_uid")
+        if child_uid:
+            child_uids[str(slice_info.get("slice_key") or "")] = str(child_uid)
+    digests = {rec.get("manifest_digest") for rec in records}
+    if digests != {manifest.digest()}:
+        raise HTTPException(409, "INCOMPLETE: 发布物 per-slice manifest digest 不一致（混合版本，需人工对账）")
+    return manifest, child_uids
