+def test_reconcile_semantics(client):
+    """恢复入口不要求租约：已终态 run 仍可 reconcile；无文件事实如实 409；代次不符 409。"""
+    with SessionLocal() as db:
+        parent = _parent(db, "rec2")
+        uid = parent.bag_uid
+    run_ids = []
+    try:
+        created = _create_run(client, uid)
+        run_id = created["pipeline_run_id"]
+        run_ids.append(run_id)
+        run = _claim_specific(client, run_id)
+        manifest = _manifest_dict(run, parent, outcome="NO_MATCH", segments=[], expected=[])
+        body = _report_body(run, parent, manifest=manifest, child_map={})
+        assert client.post(f"/api/v1/scene-analysis-runs/{run_id}/results", json=body).status_code == 200
+        done = client.post(
+            f"/api/v1/scene-analysis-runs/{run_id}/complete-scene", json=_complete_body(body, publish_root=None)
+        )
+        assert done.status_code == 200
+        # run 已终态、租约已清：reconcile 不要求 lease token
+        rbody = {
+            "scene_code": "slope",
+            "source_generation": parent.source_generation,
+            "publish_root": tempfile.mkdtemp(prefix="t06b-rec2-"),
+        }
+        # NO_MATCH 发布根下无切片记录 → 409 INCOMPLETE（如实：没有可恢复文件事实）
+        resp = client.post(f"/api/v1/scene-analysis-runs/{run_id}/reconcile-scene", json=rbody)
+        assert resp.status_code == 409
+        assert "INCOMPLETE" in resp.json()["detail"]
+        # 源代次不符 → 409
+        resp2 = client.post(
+            f"/api/v1/scene-analysis-runs/{run_id}/reconcile-scene", json={**rbody, "source_generation": 99}
+        )
+        assert resp2.status_code == 409
+        assert "SOURCE_GENERATION_MISMATCH" in resp2.json()["detail"]
+    finally:
+        with SessionLocal() as db:
+            _purge(db, [uid], run_ids)
