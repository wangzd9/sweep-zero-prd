+                            child_bag_uid=CHILD_UID,
+                            staging_dir=staging,
+                            db3_sha256="0" * 64,
+                            message_count=1,
+                            start_ns=seg.start_ns,
+                            end_ns=seg.end_ns,
+                            topics={},
+                        )
+                    ],
+                )
+            assert ei.value.code == scene_publish_service.PUBLISH_BLOCKED
+        finally:
+            shutil.rmtree(staging, ignore_errors=True)
