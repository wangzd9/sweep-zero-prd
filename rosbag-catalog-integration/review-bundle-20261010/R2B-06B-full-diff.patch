+def test_full_report_publish_complete_flow(client):
+    with SessionLocal() as db:
+        parent = _parent(db, "flow")
+        uid = parent.bag_uid
+    run_ids: list[str] = []
+    tmp = None
+    try:
+        created = _create_run(client, uid)
+        run_id = created["pipeline_run_id"]
+        run_ids.append(run_id)
+        run = _claim_specific(client, run_id)
+        segs = [("slope", (BASE_S + 2) * NANO, (BASE_S + 4) * NANO)]
+        key = f"slope:{(BASE_S + 2) * NANO}:{(BASE_S + 4) * NANO}"
+        tmp = Path(tempfile.mkdtemp(prefix="t06b-flow-"))
+        publish_root, child_uids, manifest_dict = _stage_and_publish(tmp, run, parent, segs)
+        child = child_uids[key]
+        body = _report_body(run, parent, manifest=manifest_dict, child_map={key: child})
+        body["idempotency_key"] = "t06b-key"
+        resp = client.post(f"/api/v1/scene-analysis-runs/{run_id}/results", json=body)
+        assert resp.status_code == 200, resp.text
+        data = resp.json()
+        assert data["registered_segments"] == 1
+        assert data["availability"] == "PENDING"
+        assert data["derived_children"] == 1
+        assert data["replayed"] is False
+        # PENDING：子包登记但不可用（DB 事实；PENDING 不进入可用检索）
+        with SessionLocal() as db:
+            c = db.scalar(select(BagRecord).where(BagRecord.bag_uid == child))
+            assert c is not None and c.availability == "PENDING"
+        # 幂等重放（同键同内容 → idempotency 通道 200）
+        again = client.post(f"/api/v1/scene-analysis-runs/{run_id}/results", json=body)
+        assert again.status_code == 200
+        assert again.json()["replayed"] is True
+        assert again.json()["analysis_version_id"] == data["analysis_version_id"]
+        # 同键不同参数 → 409（幂等键被不同内容复用）
+        diff = dict(body, manifest=_manifest_dict(run, parent, outcome="NO_MATCH", segments=[], expected=[]))
+        assert client.post(f"/api/v1/scene-analysis-runs/{run_id}/results", json=diff).status_code == 409
+        # complete：文件证据 + 完整性 → AVAILABLE + 换版 + 终态
+        cbody = _complete_body(body, publish_root=publish_root)
+        done = client.post(f"/api/v1/scene-analysis-runs/{run_id}/complete-scene", json=cbody)
+        assert done.status_code == 200, done.text
+        dd = done.json()
+        assert dd["outcome"] == "SUCCESS"
+        assert dd["run_status"] == "SCENE_DONE"
+        assert dd["switch"] == {"switched": True, "current": True, "reason": None}
+        assert dd["available_children"] == [child]
+        # complete 终态重放（租约已清，不再要求 token）
+        replay = client.post(f"/api/v1/scene-analysis-runs/{run_id}/complete-scene", json=cbody)
+        assert replay.status_code == 200
+        assert replay.json()["replayed"] is True
+        assert replay.json()["run_status"] == "SCENE_DONE"
+        # AVAILABLE：DB 事实 + 血缘可查
+        with SessionLocal() as db:
+            c = db.scalar(select(BagRecord).where(BagRecord.bag_uid == child))
+            assert c.availability == "AVAILABLE"
+            der = db.scalar(select(BagDerivation).where(BagDerivation.child_bag_uid == child))
+            assert der.run_id == run_id and der.parent_bag_uid == uid
+        mf = client.get(f"/api/v1/bags/{child}")
+        assert mf.status_code == 200
+    finally:
+        if tmp is not None:
+            shutil.rmtree(tmp, ignore_errors=True)
+        with SessionLocal() as db:
+            _purge(db, [uid], run_ids)
