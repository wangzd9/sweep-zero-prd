+    def test_cross_filesystem_blocked(self, tmp_path):
+        """staging 在 /dev/shm（tmpfs）、发布根在普通文件系统 → PUBLISH_BLOCKED。"""
+        seg = SegT("slope", (BASE_S + 2) * NANO, (BASE_S + 4) * NANO, True, "header_stamp_ns")
+        m = _publish_manifest("run-xfs", "PUBPARENT000000000001", [seg])
+        staging = Path("/dev/shm") / f"t06b-xfs-{uuid.uuid4().hex[:8]}"
+        staging.mkdir(parents=True, exist_ok=True)
+        (staging / "rosbag2_0.db3").write_bytes(b"x")
+        try:
+            assert staging.stat().st_dev != tmp_path.stat().st_dev  # 前提：确为不同设备
+            with pytest.raises(scene_publish_service.PublishError) as ei:
+                scene_publish_service.publish_scene_slices(
+                    m,
+                    publish_root=tmp_path / "publish",
+                    vehicle_key="",
+                    specs=[
+                        scene_publish_service.SlicePublishSpec(
