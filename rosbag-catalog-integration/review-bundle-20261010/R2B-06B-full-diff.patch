+"""场景结果回报与完成请求协议（TASK-06B，DESIGN §7.1）。
+
+执行面专用入口的请求 DTO：
+- POST /api/v1/scene-analysis-runs/{id}/results          分批幂等登记 manifest
+- POST /api/v1/scene-analysis-runs/{id}/complete-scene   完整性门禁 + 换版
+
+manifest 以 JSON 对象承载（04A SceneManifest.to_dict 形状：schema_version/
+scene_code/run_id/source_id/source_generation/source_fingerprint/config_hash/
+outcome/segments/evidence/expected_slice_keys/created_at）。单批区间上限与
+JSON 限额由 06B 服务层与 04A 类型共同强制（拒绝而非截断，DESIGN §7.1/§8.1）。
+
+浏览器不得伪造已验证产物：真实租约/源代次校验在 scene_result_report_service。
+"""
+
+from __future__ import annotations
+
+from pydantic import BaseModel, Field, field_validator
+
+from app.schemas.scene_config import check_json_field_size
+
+
+class SceneResultReportRequest(BaseModel):
+    scene_code: str = Field(min_length=1, max_length=32)
+    lease_token: str | None = Field(default=None, max_length=128)
+    source_generation: int = Field(ge=1)
+    manifest: dict = Field(description="04A SceneManifest.to_dict() JSON 对象")
+    child_bag_uids: dict[str, str] = Field(
+        default_factory=dict, description="slice_key → 子包 bag_uid（仅 publish_target 区间必填）"
+    )
+    idempotency_key: str | None = Field(default=None, max_length=255)
+    publish_root: str | None = Field(default=None, description="受控发布根（complete-scene 文件证据核对用）")
+    vehicle_key: str | None = Field(default=None, max_length=128, description="发布路径车辆段，缺省 unassigned")
+
+    @field_validator("manifest")
+    @classmethod
+    def _manifest_size(cls, v: dict) -> dict:
+        check_json_field_size(v)
+        return v
+
+    @field_validator("child_bag_uids")
+    @classmethod
+    def _child_uid_shape(cls, v: dict[str, str]) -> dict[str, str]:
+        for key, uid in v.items():
+            if not (0 < len(uid) <= 26):
+                raise ValueError(f"child_bag_uids 值必须是 1..26 长度 bag_uid：{uid!r}")
+        return v
+
+    def as_payload(self) -> dict:
+        return {
+            "scene_code": self.scene_code,
+            "lease_token": self.lease_token,
+            "source_generation": self.source_generation,
+            "manifest": self.manifest,
+            "child_bag_uids": self.child_bag_uids,
+            "idempotency_key": self.idempotency_key,
+            "publish_root": self.publish_root,
+            "vehicle_key": self.vehicle_key,
+        }
+
+
+class SceneCompleteRequest(BaseModel):
+    scene_code: str = Field(min_length=1, max_length=32)
+    lease_token: str | None = Field(default=None, max_length=128)
+    source_generation: int = Field(ge=1, description="父包当前源代次（03B bound source_generation 口径）")
+    manifest: dict = Field(description="与登记批次内容身份一致（同 digest）的 04A manifest JSON")
+    child_bag_uids: dict[str, str] = Field(default_factory=dict)
+    publish_root: str | None = Field(default=None, description="受控发布根（文件证据核对必需，NO_MATCH 豁免）")
+    vehicle_key: str | None = Field(default=None, max_length=128, description="发布路径车辆段，缺省 unassigned")
+
+    @field_validator("manifest")
+    @classmethod
+    def _manifest_size(cls, v: dict) -> dict:
+        check_json_field_size(v)
+        return v
+
+    def as_payload(self) -> dict:
+        return {
+            "scene_code": self.scene_code,
+            "lease_token": self.lease_token,
+            "source_generation": self.source_generation,
+            "manifest": self.manifest,
+            "child_bag_uids": self.child_bag_uids,
+            "publish_root": self.publish_root,
+            "vehicle_key": self.vehicle_key,
+        }
+
+
+class SceneReconcileRequest(BaseModel):
+    """恢复补偿入口（无租约字段：运行可能已终态/租约已清；源代次仍必填）。"""
+
+    scene_code: str = Field(min_length=1, max_length=32)
+    source_generation: int = Field(ge=1)
+    publish_root: str | None = Field(default=None, description="受控发布根（恢复按其中 per-slice manifest 对账）")
+    vehicle_key: str | None = Field(default=None, max_length=128)
+
+    def as_payload(self) -> dict:
+        return {
+            "scene_code": self.scene_code,
+            "source_generation": self.source_generation,
+            "publish_root": self.publish_root,
+            "vehicle_key": self.vehicle_key,
+        }
diff --git a/app/services/scene_publish_service.py b/app/services/scene_publish_service.py
