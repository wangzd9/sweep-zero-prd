+def test_reconcile_backfills_after_publish_without_report(client):
+    """发布后登记故障补偿：/results 超时未登记 → reconcile 按发布目录 manifest 补登记+推进可用。"""
+    with SessionLocal() as db:
+        parent = _parent(db, "rec")
+        uid = parent.bag_uid
+    run_ids = []
+    tmp = None
+    try:
+        created = _create_run(client, uid)
+        run_id = created["pipeline_run_id"]
+        run_ids.append(run_id)
+        run = _claim_specific(client, run_id)
+        segs = [("slope", (BASE_S + 2) * NANO, (BASE_S + 4) * NANO)]
+        key = segs[0][0] + f":{segs[0][1]}:{segs[0][2]}"
+        tmp = Path(tempfile.mkdtemp(prefix="t06b-rec-"))
+        publish_root, child_uids, _ = _stage_and_publish(tmp, run, parent, segs)
+        # 不调用 /results：直接 reconcile（模拟回报 HTTP 超时，文件已发布）
+        rbody = {
+            "scene_code": "slope",
+            "source_generation": parent.source_generation,
+            "publish_root": publish_root,
+            "vehicle_key": "",
+        }
+        resp = client.post(f"/api/v1/scene-analysis-runs/{run_id}/reconcile-scene", json=rbody)
+        assert resp.status_code == 200, resp.text
+        data = resp.json()
+        assert data["reconciled"] is True
+        assert data["registered"] is True
+        assert data["available_children"] == [child_uids[key]]
+        with SessionLocal() as db:
+            child = db.scalar(select(BagRecord).where(BagRecord.bag_uid == child_uids[key]))
+            assert child is not None and child.availability == "AVAILABLE"
+            der = db.scalar(select(BagDerivation).where(BagDerivation.child_bag_uid == child_uids[key]))
+            assert der is not None and der.run_id == run_id and der.parent_bag_uid == uid
+        # 幂等：再次 reconcile 不重复登记
+        again = client.post(f"/api/v1/scene-analysis-runs/{run_id}/reconcile-scene", json=rbody)
+        assert again.status_code == 200
+        assert again.json()["registered"] is True
+        # reconcile 不切当前（换版只在 complete）
+        with SessionLocal() as db:
+            cur = db.scalar(
+                select(SceneAnalysisVersion).where(
+                    SceneAnalysisVersion.parent_bag_uid == uid, SceneAnalysisVersion.current.is_(True)
+                )
+            )
+            assert cur is None
+    finally:
+        if tmp is not None:
+            shutil.rmtree(tmp, ignore_errors=True)
+        with SessionLocal() as db:
+            _purge(db, [uid], run_ids)
