+            f"/api/v1/scene-analysis-runs/{run_id}/complete-scene", json=_complete_body(body, publish_root=pr)
+        )
+        assert done.status_code == 409, done.text
+        assert "INCOMPLETE" in done.json()["detail"]
+    finally:
+        if tmp is not None:
+            shutil.rmtree(tmp, ignore_errors=True)
