+def _publish_manifest(run_id: str, source_id: str, segs) -> SceneManifest:
+    return SceneManifest(
+        scene_code="slope",
+        capability_version="slope-v1",
+        run_id=run_id,
+        analysis_version=1,
+        source_id=source_id,
+        source_generation=1,
+        source_fingerprint="f",
+        config_hash="c" + "a" * 61,
+        outcome=SceneOutcome.SUCCESS,
+        segments=tuple(segs),
+        evidence=(),
+        expected_slice_keys=tuple(s.slice_key for s in segs if s.publish_target),
+        created_at="2026-10-09T08:00:00+00:00",
+    )
+
+
+def _spec(seg: SegT, result: SliceWriteResult, child_uid: str):
+    return scene_publish_service.SlicePublishSpec(
+        slice_key=seg.slice_key,
+        child_bag_uid=child_uid,
+        staging_dir=result.out_dir,
+        db3_sha256=result.db3_sha256 or "",
+        message_count=result.message_count,
+        start_ns=seg.start_ns,
+        end_ns=seg.end_ns,
+        topics=result.topics,
+    )
+
+
+CHILD_UID = "CHILD000000000000000001"
+
+
+class TestAtomicPublish:
+    def test_publish_moves_with_slice_manifest_and_reuses_on_replay(self, tmp_path):
+        seg = SegT("slope", (BASE_S + 2) * NANO, (BASE_S + 4) * NANO, True, "header_stamp_ns")
+        m = _publish_manifest("run-pub", "PUBPARENT000000000001", [seg])
+        bag = _bag_with_offset(tmp_path / "src", offset_ns=0)
+        result = slice_bag_to_staging(bag, tmp_path / "stg", seg, storage_offset_ns=0)
+        root = tmp_path / "publish"
+        outs = scene_publish_service.publish_scene_slices(
+            m, publish_root=root, vehicle_key="", specs=[_spec(seg, result, CHILD_UID)]
+        )
+        target = root / "unassigned" / "slope" / f"PUBPARENT000000000001_{CHILD_UID}"
+        assert outs == [target]
+        assert (target / "rosbag2_0.db3").is_file()
+        assert (target / scene_publish_service.SLICE_MANIFEST_NAME).is_file()
+        # staging 目录已被 move（不再存在）
+        assert not result.out_dir.exists()
+        # 幂等重试：重切同区间 → 同摘要 → 复用不冲突（不重复 move）
+        result2 = slice_bag_to_staging(bag, tmp_path / "stg2", seg, storage_offset_ns=0)
+        assert result2.db3_sha256 == result.db3_sha256
+        scene_publish_service.publish_scene_slices(
+            m, publish_root=root, vehicle_key="", specs=[_spec(seg, result2, CHILD_UID)]
+        )
+        assert (target / "rosbag2_0.db3").is_file()
+        assert (target / scene_publish_service.SLICE_MANIFEST_NAME).is_file()
+
+    def test_publish_conflict_forbids_overwrite(self, tmp_path):
+        seg = SegT("slope", (BASE_S + 2) * NANO, (BASE_S + 4) * NANO, True, "header_stamp_ns")
+        m = _publish_manifest("run-cf", "PUBPARENT000000000001", [seg])
+        bag = _bag_with_offset(tmp_path / "src", offset_ns=0)
+        result = slice_bag_to_staging(bag, tmp_path / "stg", seg, storage_offset_ns=0)
+        root = tmp_path / "publish"
+        scene_publish_service.publish_scene_slices(
+            m, publish_root=root, vehicle_key="", specs=[_spec(seg, result, CHILD_UID)]
+        )
+        target = root / "unassigned" / "slope" / f"PUBPARENT000000000001_{CHILD_UID}"
+        (target / "rosbag2_0.db3").write_bytes(b"corrupted")
+        # 不同内容（不同 manifest digest）再发布 → 冲突，禁止覆盖
+        m2 = _publish_manifest("run-cf2", "PUBPARENT000000000001", [seg])
+        result2 = slice_bag_to_staging(bag, tmp_path / "stg2", seg, storage_offset_ns=0)
+        with pytest.raises(scene_publish_service.PublishError) as ei:
+            scene_publish_service.publish_scene_slices(
+                m2, publish_root=root, vehicle_key="", specs=[_spec(seg, result2, CHILD_UID)]
+            )
+        assert ei.value.code == scene_publish_service.PUBLISH_CONFLICT
+        assert (target / "rosbag2_0.db3").read_bytes() == b"corrupted"  # 原文件未被覆盖
