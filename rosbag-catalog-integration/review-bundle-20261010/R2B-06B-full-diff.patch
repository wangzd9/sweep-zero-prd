+"""场景结果回报与完成 API（TASK-06B，DESIGN §7.1 执行面专用路由）。
+
+- POST /api/v1/scene-analysis-runs/{id}/results          分批幂等登记（租约+源代次+运行类型）
+- POST /api/v1/scene-analysis-runs/{id}/complete-scene   完整性门禁+文件证据+换版+运行终态
+- POST /api/v1/scene-analysis-runs/{id}/reconcile-scene  发布后登记故障补偿（恢复入口）
+
+执行面专用：真实租约/源代次校验在 scene_result_report_service，浏览器不得
+伪造已验证产物。路由注册属共享入口（DESIGN §11.3）：本 commit 带入口改动，
+由协调者合入时接线 app/api/__init__.py。
+"""
+
+from __future__ import annotations
+
+from fastapi import APIRouter, Depends, Request
+from sqlalchemy.orm import Session
+
+from app.database import get_db
+from app.schemas.scene_result import SceneCompleteRequest, SceneReconcileRequest, SceneResultReportRequest
+from app.services import scene_result_report_service
+from app.services.control_plane import idempotency_key
+
+router = APIRouter()
+
+
+@router.post("/api/v1/scene-analysis-runs/{pipeline_run_id}/results")
+def report_scene_result(
+    pipeline_run_id: str, body: SceneResultReportRequest, request: Request, db: Session = Depends(get_db)
+):
+    """执行面回报：携租约、源代次、场景与 manifest，分批幂等登记（200）。"""
+    payload = body.as_payload()
+    return scene_result_report_service.report_result(db, pipeline_run_id, payload, idempotency_key(request, payload))
+
+
+@router.post("/api/v1/scene-analysis-runs/{pipeline_run_id}/complete-scene")
+def complete_scene(pipeline_run_id: str, body: SceneCompleteRequest, request: Request, db: Session = Depends(get_db)):
+    """执行面完成：校验完整 manifest + 文件证据，保存终态并按规则换版（200）。"""
+    payload = body.as_payload()
+    return scene_result_report_service.complete_scene(db, pipeline_run_id, payload)
+
+
+@router.post("/api/v1/scene-analysis-runs/{pipeline_run_id}/reconcile-scene")
+def reconcile_scene(pipeline_run_id: str, body: SceneReconcileRequest, request: Request, db: Session = Depends(get_db)):
+    """恢复补偿：文件已发布、数据库未登记时按发布目录 manifest 补登记/推进可用。"""
+    payload = body.as_payload()
+    return scene_result_report_service.reconcile_scene(db, pipeline_run_id, payload)
