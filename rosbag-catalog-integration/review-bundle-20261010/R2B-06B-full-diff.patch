--- /dev/null
+++ b/app/services/scene_publish_service.py
@@ -0,0 +1,245 @@
+"""场景切片 staging 校验/原子发布与 storage_offset 推导（TASK-06B，DESIGN §6）。
+
+职责（执行面编排层，04B writer 之上的发布段）：
+- ``derive_storage_offset``：writer 的 storage_offset_ns 由本层从 manifest + 源 bag
+  推导（TODO 交接约束）：
+  - 区间 basis 全为 bag_storage_ns → 边界已在存储域，offset=0；
+  - 区间 basis 全为 header_stamp_ns → 逐帧解码源 bag 相机 topic，
+    offset = storage_ts - header_ts 必须全帧恒定，否则不可推导；
+  - mixed/证据缺失/解码失败 → 不可推导，**必须阻塞发布**（DESIGN §4：实际时间
+    映射不能验证时阻塞真实切片发布），不得假定 0。
+- ``publish_scene_slices``：同文件系统原子发布到
+  ``<publish_root>/<vehicle_key>/<scene_code>/<parent_uid>_<child_uid>/``；
+  目标已存在仅在完整 manifest 与文件摘要一致时复用（幂等），否则冲突失败，
+  禁止覆盖（DESIGN §6.3）。未知车辆用 unassigned。
+- 发布内容含 per-slice ``slice_manifest.json``（完整 manifest + 切片校验证据 +
+  db3 摘要），是"文件已发布"的对账事实（DESIGN §6.6 恢复器按 manifest 补登记）。
+
+本模块不做数据库登记（06A register_manifest 职责）、不读 Scanner、
+不删除/移动源 bag（父/子文件均不复制，发布为 move 语义）。
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import shutil
+from dataclasses import dataclass
+from pathlib import Path
+
+from app.scene.slope.bag_io import BagIoError, read_messages, read_topics
+from app.scene.types import SceneManifest
+
+PUBLISH_BLOCKED = "PUBLISH_BLOCKED"
+PUBLISH_CONFLICT = "PUBLISH_CONFLICT"
+
+SLICE_MANIFEST_NAME = "slice_manifest.json"
+PUBLISH_SCHEMA = "scene-slice-publish/v1"
+
+
+class PublishError(Exception):
+    """发布阻断/冲突：携带错误码，路由/执行面按码留痕，不当成功。"""
+
+    def __init__(self, code: str, detail: str):
+        self.code = code
+        self.detail = detail
+        super().__init__(f"{code}: {detail}")
+
+
+def _camera_topic_from_manifest(manifest: SceneManifest) -> str | None:
+    """manifest 证据中的相机 topic（04B 适配器写 SLOPE_TOPIC 证据，path=topic 名）。"""
+    for ev in manifest.evidence:
+        if ev.kind == "SLOPE_TOPIC" and ev.path:
+            return ev.path
+    return None
+
+
+def derive_storage_offset(manifest: SceneManifest, source_bag_dir: Path) -> int | None:
+    """推导 writer storage_offset_ns（header 域 → 存储域）。不可推导返回 None。
+
+    判定（见模块 docstring）：
+    - 无 publish_target 区间（NO_MATCH）→ 无切包，offset 无关，返回 0 仅表示
+      "推导已解决"（调用方对空 manifest 不应再切包）；
+    - basis 全 bag_storage_ns → 0；
+    - basis 全 header_stamp_ns → 逐帧 (storage - header) 必须恒定；
+    - mixed/空证据/相机 topic 缺失或读取失败 → None。
+    """
+    bases = {seg.mapping_basis for seg in manifest.publishable_segments()}
+    if not bases:
+        return 0
+    if bases == {"bag_storage_ns"}:
+        return 0
+    if bases != {"header_stamp_ns"}:
+        return None  # mixed_header_and_storage 或其他：不可推导，阻塞发布
+    cam_topic = _camera_topic_from_manifest(manifest)
+    if not cam_topic:
+        return None
+    try:
+        topics = {t.name: t for t in read_topics(source_bag_dir)}
+        if cam_topic not in topics:
+            return None
+        messages = read_messages(source_bag_dir, topic=cam_topic)
+    except BagIoError:
+        return None
+    if not messages:
+        return None
+    offsets: set[int] = set()
+    for m in messages:
+        header_ts = _decode_header_ns(m.data, topics[cam_topic].msgtype)
+        if header_ts is None:
+            return None  # 解码失败：不能证明时间映射（不得当 0）
+        offsets.add(m.timestamp_ns - header_ts)
+    if len(offsets) != 1:
+        return None  # 非恒定偏移：逐帧不一致，不可推导
+    return offsets.pop()
+
+
+def _decode_header_ns(data: bytes, msgtype: str) -> int | None:
+    """解码单条相机消息的 header.stamp → 整数纳秒；失败返回 None（不猜测）。"""
+    from app.scene.slope.cdr import decode_compressed_image, decode_image
+
+    try:
+        if "CompressedImage" in msgtype:
+            obj, _ = decode_compressed_image(data, 0)
+        elif "Image" in msgtype:
+            obj, _ = decode_image(data, 0)
+        else:
+            return None
+    except Exception:  # noqa: BLE001 — 任意解码异常都归"不可推导"（不猜测）
+        return None
+    stamp = obj.header.stamp
+    if not isinstance(stamp.sec, int) or not isinstance(stamp.nanosec, int):
+        return None
+    if stamp.sec < 0 or not (0 <= stamp.nanosec < 1_000_000_000):
+        return None
+    return stamp.sec * 1_000_000_000 + stamp.nanosec
+
+
+@dataclass(frozen=True)
+class SlicePublishSpec:
+    """单个待发布切片的定位与校验证据（来自 04B SliceWriteResult + 子包身份）。"""
+
+    slice_key: str
+    child_bag_uid: str
+    staging_dir: Path
+    db3_sha256: str
+    message_count: int
+    start_ns: int
+    end_ns: int
+    topics: dict[str, int]
+
+
+def publish_scene_slices(
+    manifest: SceneManifest,
+    *,
+    publish_root: Path,
+    vehicle_key: str,
+    specs: list[SlicePublishSpec],
+) -> list[Path]:
+    """把已 staging 校验的切片原子发布到受控路径；返回各切片发布目录。
+
+    - 同文件系统检查（staging 与 publish_root 同设备），跨设备 PUBLISH_BLOCKED
+      （rename 非原子，禁止降级复制——DESIGN §6.3 要求同文件系统原子发布）；
+    - 目标存在：slice_manifest.json 的 manifest digest + db3 摘要全一致 → 复用
+      （幂等重试）；任一不一致 → PUBLISH_CONFLICT（禁止覆盖）；
+    - 发布内容 = staging 目录整体 move + slice_manifest.json（先写入 staging，
+      随目录一起落位，发布后不存在"有文件无 manifest"的中间态）。
+    - 空 specs（NO_MATCH）无操作，返回 []。
+    """
+    if not specs:
+        return []
+    if not publish_root.is_absolute():
+        raise PublishError(PUBLISH_BLOCKED, "publish_root 必须是绝对路径（受控发布根）")
+    try:
+        publish_root.stat()
+    except OSError:
+        publish_root.mkdir(parents=True, exist_ok=True)
+    if os.stat(publish_root).st_dev != os.stat(specs[0].staging_dir).st_dev:
+        raise PublishError(
+            PUBLISH_BLOCKED,
+            f"staging 与发布根不在同一文件系统，无法原子发布（{specs[0].staging_dir} vs {publish_root}）",
+        )
+    vehicle = vehicle_key or "unassigned"
+    manifest_digest = manifest.digest()
+    out: list[Path] = []
+    for spec in specs:
+        target = publish_root / vehicle / manifest.scene_code / f"{manifest.source_id}_{spec.child_bag_uid}"
+        # 先把 per-slice manifest 写入 staging（成为发布内容的一部分）
+        _write_slice_manifest(
+            spec.staging_dir,
+            manifest,
+            manifest_digest,
+            spec,
+            publish_path=str(target),
+        )
+        if target.exists():
+            if not _target_matches(target, manifest_digest, spec.db3_sha256):
+                raise PublishError(
+                    PUBLISH_CONFLICT,
+                    f"目标 {target} 已存在且 manifest/摘要不一致，禁止覆盖（对账先行）",
+                )
+            out.append(target)  # 完整一致 → 复用（幂等重试不重复 move）
+            continue
+        target.parent.mkdir(parents=True, exist_ok=True)
+        tmp = target.parent / (target.name + ".incomplete")
+        if tmp.exists():
+            # 上次崩溃残留：先清理（未完成目录不是合法发布物）
+            shutil.rmtree(tmp)
+        spec.staging_dir.rename(tmp)
+        try:
+            os.replace(tmp, target)  # 同文件系统原子落位
+        except BaseException:
+            if tmp.exists():
+                shutil.rmtree(tmp, ignore_errors=True)
+            raise
+        out.append(target)
+    return out
+
+
+def _write_slice_manifest(
+    staging_dir: Path,
+    manifest: SceneManifest,
+    manifest_digest: str,
+    spec: SlicePublishSpec,
+    *,
+    publish_path: str,
+) -> None:
+    payload = {
+        "schema": PUBLISH_SCHEMA,
+        "manifest_digest": manifest_digest,
+        "manifest": manifest.to_dict(),
+        "slice": {
+            "slice_key": spec.slice_key,
+            "child_bag_uid": spec.child_bag_uid,
+            "db3_sha256": spec.db3_sha256,
+            "message_count": spec.message_count,
+            "start_ns": str(spec.start_ns),
+            "end_ns": str(spec.end_ns),
+            "topics": dict(sorted(spec.topics.items())),
+            "publish_path": publish_path,
+        },
+    }
+    (staging_dir / SLICE_MANIFEST_NAME).write_text(
+        json.dumps(payload, ensure_ascii=False, sort_keys=True), encoding="utf-8"
+    )
+
+
+def _target_matches(target: Path, manifest_digest: str, db3_sha256: str) -> bool:
+    """目标已存在时核对"完整 manifest 和摘要一致"（DESIGN §6.3）。"""
+    record_file = target / SLICE_MANIFEST_NAME
+    if not record_file.exists():
+        return False  # 无发布记录 = 不完整 → 冲突（不猜测）
+    try:
+        record = json.loads(record_file.read_text(encoding="utf-8"))
+    except (OSError, json.JSONDecodeError):
+        return False
+    if record.get("manifest_digest") != manifest_digest:
+        return False
+    if record.get("slice", {}).get("db3_sha256") != db3_sha256:
+        return False
+    db3 = target / "rosbag2_0.db3"
+    if not db3.is_file():
+        return False
+    import hashlib
+
+    return hashlib.sha256(db3.read_bytes()).hexdigest() == db3_sha256
diff --git a/app/services/scene_result_report_service.py b/app/services/scene_result_report_service.py
new file mode 100644
index 0000000..1be53ab
--- /dev/null
+++ b/app/services/scene_result_report_service.py
@@ -0,0 +1,553 @@
+"""场景执行面结果回报、complete-scene 与发布后登记补偿（TASK-06B，DESIGN §6/§7.1）。
+
+路由（/results、/complete-scene）归本任务（05 已声明不实现）；服务层承载：
+- 身份校验：真实租约（05 lease 通道 require_valid_task_lease）、运行类型
+  （pipeline_type=SCENE_SLICE）、源代次（03B bound source_generation 口径：
+  manifest.source_generation 必须等于父包当前代次）、源围栏、配置对账
+  （manifest.config_hash == run 快照 capability_config_hash，两级 hash 不混用，
+  DESIGN §11.2）；
+- 登记：复用 06A register_manifest/switch_current（不另建切片索引）；
+  05 分配的版本行（av{N}）回填为登记事实行（content 身份 + result + 段数），
+  保持"提交时分配的分析版本排序"语义；
+- 完整性门禁（06A 终版契约 #1）：expected_segment_count ==
+  registered_segment_count 等值比较（同基数 = manifest 全部区间数含 flat）；
+  可发布子集用 list_segments(publish_only=True) 与 manifest expected_slice_keys
+  核对，不混入段数基数；
+- PENDING→AVAILABLE：文件（非空/可打开/时间证据：staging 校验证据随 per-slice
+  manifest 落发布目录）与数据库登记均完成才可用（DESIGN §6.4/§6.5）；
+- 换版（契约 #2）：switch_current 3 次有界重试后 409 重放语义；新版失败保旧
+  current 不动；晚到旧版不倒退；成功无命中切空；NOT_APPLICABLE/FAILED 不换版；
+- 补偿：文件已发布、数据库未登记（HTTP 超时等）时，reconcile-scene 按发布目录
+  的 per-slice manifest 补登记并推进可用性，不重复 move/不覆盖。
+
+浏览器不得伪造已验证产物：全部写入口要求有效租约 + 源代次 + 运行类型三重校验。
+"""
+
+from __future__ import annotations
+
+import json
+import re
+
+from fastapi import HTTPException
+from sqlalchemy import select
+from sqlalchemy.orm import Session
+
+from app.clock import now as local_now
+from app.domain.transitions import SCENE_TERMINAL_STATES as SCENE_TERMINAL
+from app.models import BagDerivation, BagRecord, PipelineRun, SceneAnalysisVersion
+from app.scene.types import EvidenceRef, SceneManifest, SceneOutcome
+from app.scene.types import SceneSegment as SegType
+from app.services import scene_result_service
+from app.services.control_plane import idempotent_replay, store_idempotency
+from app.services.scene_result_query import list_segments
+from app.services.scene_slice_service import PIPELINE_TYPE_SCENE_SLICE, finish_scene_run, record_scene_outcome
+from app.services.source_fence import check_fence_for_source
+
+# 05 提交时分配的版本占位格式（allocate_analysis_version：av{N}）；
+# 登记事实行的内容身份是 digest 前 16 位 hex，两者形状可区分。
+_PLACEHOLDER_RE = re.compile(r"^av\d+$")
+
+
+# ---------------------------------------------------------------------------
+# 身份校验（06B 边界：真实租约/源代次/运行类型，替身不得进入生产登记）
+# ---------------------------------------------------------------------------
+
+
+def _require_scene_run(
+    db: Session, pipeline_run_id: str, lease_token: str | None, *, source_generation: int
+) -> PipelineRun:
+    run = db.scalar(select(PipelineRun).where(PipelineRun.pipeline_run_id == pipeline_run_id).with_for_update())
+    if run is None:
+        raise HTTPException(404, f"scene run not found: {pipeline_run_id}")
+    if run.pipeline_type != PIPELINE_TYPE_SCENE_SLICE:
+        raise HTTPException(409, "run is not a scene slice run")
+    from app.domain.security import require_valid_task_lease
+
+    require_valid_task_lease(run, lease_token, local_now())
+    parent = db.scalar(select(BagRecord).where(BagRecord.bag_uid == run.source_id))
+    if parent is None:
+        raise HTTPException(409, "SOURCE_NOT_READY: 父包已不存在（对账先行，不得继续登记）")
+    if parent.source_generation != source_generation:
+        raise HTTPException(
+            409, f"SOURCE_GENERATION_MISMATCH: 回报代次 {source_generation} != 当前 {parent.source_generation}"
+        )
+    check_fence_for_source(db, run.source_id)
+    return run
+
+
+def _run_snapshot(run: PipelineRun) -> dict:
+    return json.loads(run.pipeline_config_snapshot_json or "{}")
+
+
+def _require_scene_entry(run: PipelineRun, scene_code: str) -> dict:
+    entry = next((e for e in _run_snapshot(run).get("scenes") or [] if e.get("scene_code") == scene_code), None)
+    if entry is None:
+        raise HTTPException(422, f"run 未选择场景 {scene_code}（不得回报 run 外场景）")
+    return entry
+
+
+def _find_av_row(db: Session, run: PipelineRun, scene_code: str) -> SceneAnalysisVersion | None:
+    """05 创建 run 时预分配的版本行（显式 API 路径，av{N} + run_id 已绑定）。
+
+    事件消费路径（03B→05）不预分配版本行——此时返回 None，由
+    register_manifest 按 (parent, scene, run_id) 建内容行（版本分配时点=首次
+    回报，幂等；换版排序仍按 created_at/id，较旧运行晚完成不倒退语义不变）。
+    """
+    return db.scalar(
+        select(SceneAnalysisVersion).where(
+            SceneAnalysisVersion.run_id == run.pipeline_run_id,
+            SceneAnalysisVersion.parent_bag_uid == run.source_id,
+            SceneAnalysisVersion.scene_code == scene_code,
+        )
+    )
+
+
+def _link_av_row(db: Session, av_row: SceneAnalysisVersion, manifest: SceneManifest) -> bool:
+    """把 05 预分配的版本占位行升级为 06A 登记事实行（同 run 只有一行，不另建）。
+
+    返回是否**首次**升级为内容身份（True=本 run 尚未登记过该内容；False=内容身份
+    已就位，属重放）。05 占位行已绑定 run_id，register_manifest 按 run_id 查到的
+    就是它——其 analysis_version 必须先升级为内容身份（digest 前 16 位），否则
+    register 判"同 run 不同内容" 409。升级后 register 走回放/补齐路径，行
+    id/created_at 保持 05 提交时点（"提交时分配的分析版本排序"语义，DESIGN §6.7）。
+
+    三态判定（占位 vs 已关联内容身份）：
+    - 当前是占位（av{N}）→ 首次升级，返回 True；
+    - 当前 == 本 manifest 内容身份 → 重放，返回 False；
+    - 当前是**不同**内容身份（16 hex，非占位）→ 同 run 已登记别的内容，
+      06A 契约 DUPLICATE_CONFLICT 409（不盲目覆盖）。
+    占位行已被升级时，register 的 replayed 恒为 True（行存在），需由本返回值修正
+    "首次登记 vs 重放" 语义（06A 契约：首次登记 replayed=False）。
+    """
+    content_identity = manifest.digest()[:16]
+    current = str(av_row.analysis_version or "")
+    if current == content_identity:
+        av_row.result = manifest.outcome.value  # 重放：结果同步（幂等）
+        return False
+    if not _PLACEHOLDER_RE.fullmatch(current):
+        # 已是内容身份且与本次不同：同 run 不同内容 → 冲突，不覆盖
+        raise HTTPException(
+            409,
+            f"DUPLICATE_CONFLICT: run 已登记内容身份 {current}，本次 {content_identity} 不同（不覆盖）",
+        )
+    clash = db.scalar(
+        select(SceneAnalysisVersion).where(
+            SceneAnalysisVersion.parent_bag_uid == av_row.parent_bag_uid,
+            SceneAnalysisVersion.scene_code == av_row.scene_code,
+            SceneAnalysisVersion.analysis_version == content_identity,
+            SceneAnalysisVersion.id != av_row.id,
+        )
+    )
+    if clash is not None:
+        raise HTTPException(409, "DUPLICATE_CONFLICT: 同 parent+scene 已存在同内容身份的版本行（需对账，不合并）")
+    av_row.analysis_version = content_identity
+    av_row.result = manifest.outcome.value
+    av_row.capability_version = manifest.capability_version
+    av_row.config_hash = manifest.config_hash
+    return True
+
+
+def parse_report_manifest(raw: dict, *, run: PipelineRun, scene_code: str, entry: dict) -> SceneManifest:
+    """JSON → SceneManifest，并做配置对账（manifest.config_hash vs 冻结能力 hash）。"""
+    try:
+        outcome = SceneOutcome(str(raw.get("outcome") or ""))
+    except ValueError as exc:
+        raise HTTPException(422, f"MANIFEST_INVALID: 未知 outcome {raw.get('outcome')!r}") from exc
+    segments: list[SegType] = []
+    for s in raw.get("segments") or []:
+        try:
+            segments.append(
+                SegType(
+                    label=str(s.get("label") or ""),
+                    start_ns=int(s["start_ns"]),
+                    end_ns=int(s["end_ns"]),
+                    publish_target=bool(s.get("publish_target")),
+                    mapping_basis=str(s.get("mapping_basis") or ""),
+                    evidence_ref=(s.get("evidence_ref") or None),
+                )
+            )
+        except (KeyError, TypeError, ValueError) as exc:
+            raise HTTPException(422, f"MANIFEST_INVALID: 区间字段非法 {s!r}") from exc
+    try:
+        manifest = SceneManifest(
+            scene_code=scene_code,
+            capability_version=str(raw.get("capability_version") or ""),
+            run_id=run.pipeline_run_id,
+            analysis_version=1,  # 行 id 才是版本身份；digest 不含该字段外的语义
+            source_id=run.source_id,
+            source_generation=int(raw.get("source_generation") or 0),
+            source_fingerprint=str(raw.get("source_fingerprint") or ""),
+            config_hash=str(raw.get("config_hash") or ""),
+            outcome=outcome,
+            segments=tuple(segments),
+            evidence=tuple(
+                EvidenceRef(
+                    kind=str(e.get("kind") or ""), path=e.get("path"), digest=e.get("digest"), count=e.get("count")
+                )
+                for e in raw.get("evidence") or []
+            ),
+            expected_slice_keys=tuple(str(k) for k in raw.get("expected_slice_keys") or []),
+            error_code=raw.get("error_code"),
+            error_detail=raw.get("error_detail"),
+            created_at=raw.get("created_at"),
+        )
+    except Exception as exc:  # 04A 构造限额（>100 区间 / JSON 超限）
+        raise HTTPException(422, f"MANIFEST_INVALID: {exc}") from exc
+    if manifest.run_id != run.pipeline_run_id or manifest.source_id != run.source_id:
+        raise HTTPException(422, "MANIFEST_INVALID: manifest 身份字段与 run 不一致")
+    # 配置对账：04A 单能力维度 config_hash（DESIGN §11.2 两级 hash 不混用）
+    frozen = entry.get("capability_config_hash")
+    if frozen and manifest.config_hash != frozen:
+        raise HTTPException(409, f"CONFIG_MISMATCH: manifest.config_hash 与冻结能力配置 {frozen} 不一致")
+    if manifest.capability_version != entry.get("capability_version"):
+        raise HTTPException(409, "CAPABILITY_MISMATCH: manifest 能力版本与 run 冻结版本不一致")
+    return manifest
+
+
+# ---------------------------------------------------------------------------
+# 登记 / 完整性 / 换版
+# ---------------------------------------------------------------------------
+
+
+def report_result(db: Session, pipeline_run_id: str, payload: dict, idempotency_key: str | None) -> dict:
+    """POST /results：身份校验 + 分批幂等登记（06A 仓储语义，先标 PENDING）。"""
+    operation = f"scene-result-report:{pipeline_run_id}"
+    replay = idempotent_replay(db, operation, idempotency_key, payload)
+    if replay is not None:
+        replay = dict(replay)
+        replay["replayed"] = True
+        return replay
+    run = _require_scene_run(
+        db, pipeline_run_id, payload.get("lease_token"), source_generation=int(payload.get("source_generation") or 0)
+    )
+    scene_code = str(payload.get("scene_code") or "")
+    entry = _require_scene_entry(run, scene_code)
+    manifest = parse_report_manifest(payload.get("manifest") or {}, run=run, scene_code=scene_code, entry=entry)
+    child_uids = {str(k): str(v) for k, v in (payload.get("child_bag_uids") or {}).items()}
+    av_row = _find_av_row(db, run, scene_code)
+    fresh = False
+    if av_row is not None:
+        fresh = _link_av_row(db, av_row, manifest)  # 先升级占位行内容身份，register 再按 run_id 回放/补齐
+    res = scene_result_service.register_manifest(db, manifest, expected_child_uids=child_uids)
+    # 05 占位行已绑 run_id：register 按 run_id 查到该行 → replayed 恒 True。
+    # 首次升级为内容身份（fresh）才是真"首次登记"，按 06A 契约 replayed=False。
+    response = {
+        "pipeline_run_id": pipeline_run_id,
+        "scene_code": scene_code,
+        "analysis_version_id": res["analysis_version_id"],
+        "run_id": res["run_id"],
+        "registered_segments": res["registered_segments"],
+        "derived_children": res["derived_children"],
+        "replayed": (not fresh) and res["replayed"],
+        "availability": "PENDING",  # 文件+登记均完成前不可用（complete-scene 才切）
+    }
+    store_idempotency(db, operation, idempotency_key, payload, response)
+    db.commit()
+    return response
+
+
+def _check_integrity(db: Session, row: SceneAnalysisVersion, manifest: SceneManifest) -> None:
+    """完整性门禁（06A 契约 #1）：段数等值比较 + 可发布子集核对。"""
+    db.expire(row)
+    if row.expected_segment_count != row.registered_segment_count:
+        raise HTTPException(
+            409,
+            f"INCOMPLETE: expected {row.expected_segment_count} != registered {row.registered_segment_count}，"
+            "不能完成版本（DESIGN §6.5）",
+        )
+    if manifest.publishable_segments():
+        listed = list_segments(db, analysis_version_id=row.id, publish_only=True, limit=200)
+        if listed["truncated"]:
+            raise HTTPException(409, "INCOMPLETE: 可发布区间超过单页上限，完整性核对失败")
+        listed_keys = {s["slice_key"] for s in listed["items"]}
+        expected_keys = set(manifest.expected_slice_keys)
+        if expected_keys and listed_keys != expected_keys:
+            raise HTTPException(
+                409,
+                f"INCOMPLETE: 可发布子集 {sorted(listed_keys)} 与 expected_slice_keys {sorted(expected_keys)} 不一致",
+            )
+
+
+def _mark_children_available(db: Session, run: PipelineRun, row: SceneAnalysisVersion) -> list[str]:
+    """PENDING→AVAILABLE：数据库登记完成的子包置可用（文件证据由 complete 前校验）。
+
+    仅本 run 登记的子包（derivation.run_id == 本 run）；started_at/duration/
+    message_count 以登记事实为准（区间首末纳秒与校验消息数）。
+    """
+    uids: list[str] = []
+    ders = db.scalars(
+        select(BagDerivation).where(
+            BagDerivation.run_id == run.pipeline_run_id, BagDerivation.analysis_version_id == row.id
+        )
+    ).all()
+    for der in ders:
+        child = db.scalar(select(BagRecord).where(BagRecord.bag_uid == der.child_bag_uid))
+        if child is None:
+            raise HTTPException(409, f"INCOMPLETE: 子包 {der.child_bag_uid} 登记行缺失（需先 reconcile）")
+        if child.availability != "AVAILABLE":
+            child.availability = "AVAILABLE"
+            if child.started_at is None:
+                from datetime import datetime, timezone
+
+                child.started_at = datetime.fromtimestamp(der.start_ns / 1e9, tz=timezone.utc).replace(tzinfo=None)
+            child.duration_ns = der.duration_ns
+            child.updated_at = local_now()
+        uids.append(der.child_bag_uid)
+    return uids
+
+
+def complete_scene(db: Session, pipeline_run_id: str, payload: dict) -> dict:
+    """POST /complete-scene：完整 manifest 校验 → 登记对账 → 运行终态 → 换版。
+
+    语义（DESIGN §6）：
+    - SUCCESS/NO_MATCH：完整性门禁 + 文件证据校验后先记场景结果并推导运行终态
+      （05 finish_scene_run 单一终态入口），再切当前版本（NO_MATCH 切空）；
+    - NOT_APPLICABLE/FAILED：保存结果语义并推导运行终态，**不替换既有当前结果**
+      （旧结果不替换，switch_current 拒绝非 SUCCESS/NO_MATCH）；
+    - 幂等：run 已终态（终态时租约已清，不再要求 lease token）且本场景已记录
+      同 outcome → 200 重放（不二次登记/换版/终态）；已终态但结果不一致 →
+      409 CONFLICT 留痕；已终态但本场景无记录（自动重试失败等）→ 409。
+    """
+    run = _require_scene_run(
+        db, pipeline_run_id, payload.get("lease_token"), source_generation=int(payload.get("source_generation") or 0)
+    )
+    scene_code = str(payload.get("scene_code") or "")
+    entry = _require_scene_entry(run, scene_code)
+    manifest = parse_report_manifest(payload.get("manifest") or {}, run=run, scene_code=scene_code, entry=entry)
+    outcome = manifest.outcome.value
+    recorded = _recorded_outcome(run, scene_code)
+    if run.status in SCENE_TERMINAL:
+        if recorded != outcome:
+            raise HTTPException(409, f"CONFLICT: run 已终态（{run.status}）且场景结果不一致（{recorded} vs {outcome}）")
+        # 幂等重放：HTTP 超时后执行面重试 complete，终态已定、租约已清——
+        # 不要求有效 lease token，直接回显既有事实（与项目 200 重放约定一致）
+        return {
+            "pipeline_run_id": pipeline_run_id,
+            "scene_code": scene_code,
+            "outcome": outcome,
+            "run_status": run.status,
+            "switch": _replay_switch(db, run, scene_code, outcome),
+            "available_children": _available_children_of(db, run),
+            "replayed": True,
+        }
+    child_uids = {str(k): str(v) for k, v in (payload.get("child_bag_uids") or {}).items()}
+    av_row = _find_av_row(db, run, scene_code)
+    if av_row is not None:
+        _link_av_row(db, av_row, manifest)
+    # 幂等登记（/results 已登记 → 回放补齐；未登记 → 完整登记）
+    res = scene_result_service.register_manifest(db, manifest, expected_child_uids=child_uids)
+    content_row = db.get(SceneAnalysisVersion, res["analysis_version_id"])
+    if content_row is None:
+        raise HTTPException(409, "INCOMPLETE: 登记内容行缺失（需先 /results 登记）")
+    uids: list[str] = []
+    if outcome in (SceneOutcome.SUCCESS.value, SceneOutcome.NO_MATCH.value):
+        _check_integrity(db, content_row, manifest)
+        _verify_published_files(db, run, content_row, manifest, payload)
+        uids = _mark_children_available(db, run, content_row)
+    record_scene_outcome(db, run, scene_code, outcome, manifest.error_detail or "")
+    finished = finish_scene_run(db, run, payload.get("lease_token"))
+    # 登记事实 + 运行终态先落盘：换版冲突（晚到旧版 409）不连带回滚结果——
+    # 否则 run 停在 SCENE_RUNNING，执行面重试 complete 会再次 409，死循环且
+    # 版本行永远进不了"历史"。终态已定后，重试 complete 走顶部终态重放 200。
+    db.commit()
+    if outcome in (SceneOutcome.SUCCESS.value, SceneOutcome.NO_MATCH.value):
+        try:
+            scene_result_service.switch_current(
+                db,
+                parent_bag_uid=content_row.parent_bag_uid,
+                scene_code=scene_code,
+                analysis_version_id=content_row.id,
+                result=outcome,
+            )
+        except HTTPException as exc:
+            if exc.status_code == 409 and not db.get(SceneAnalysisVersion, content_row.id).current:
+                # switch_current 3 次有界重试后 409（契约 #2 重放语义）：
+                # 晚到旧版/竞争收尾 → 如实 409（保旧 current 不动），执行面下轮对账。
+                # 直接 re-raise 保留原 status_code（不得经 _exc 二次解析：
+                # HTTPException str() 形如 "409: CODE: ..."，split 后 409 不在码表 → 误落 500）。
+                db.commit()  # 登记事实与运行终态落盘后再报冲突（见上方说明）
+                raise
+        switch = {"switched": True, "current": True, "reason": None}
+    else:
+        switch = {"switched": False, "current": False, "reason": "NOT_APPLICABLE/FAILED 不替换既有当前结果"}
+    response = {
+        "pipeline_run_id": pipeline_run_id,
+        "scene_code": scene_code,
+        "outcome": outcome,
+        "run_status": finished["status"],
+        "switch": switch,
+        "available_children": uids,
+    }
+    db.commit()
+    return response
+
+
+def _recorded_outcome(run: PipelineRun, scene_code: str) -> str | None:
+    return (_run_snapshot(run).get("scene_outcomes") or {}).get(scene_code, {}).get("outcome")
+
+
+def _replay_switch(db: Session, run: PipelineRun, scene_code: str, outcome: str) -> dict:
+    """complete 重放回显：该场景内容行是否当前指针（不回显猜测值）。"""
+    row = db.scalar(
+        select(SceneAnalysisVersion).where(
+            SceneAnalysisVersion.parent_bag_uid == run.source_id,
+            SceneAnalysisVersion.scene_code == scene_code,
+            SceneAnalysisVersion.run_id == run.pipeline_run_id,
+        )
+    )
+    if row is None or outcome not in (SceneOutcome.SUCCESS.value, SceneOutcome.NO_MATCH.value):
+        return {"switched": False, "current": bool(row.current) if row else False, "reason": "complete 重放（无换版）"}
+    return {"switched": False, "current": bool(row.current), "reason": "complete 重放（已换版/未换版见 current）"}
+
+
+def _available_children_of(db: Session, run: PipelineRun) -> list[str]:
+    """重放回显：该 run 已登记子包中当前 AVAILABLE 的 bag_uid。"""
+    ders = db.scalars(select(BagDerivation).where(BagDerivation.run_id == run.pipeline_run_id)).all()
+    if not ders:
+        return []
+    uids = [d.child_bag_uid for d in ders]
+    rows = db.scalars(select(BagRecord).where(BagRecord.bag_uid.in_(uids))).all()
+    return sorted(b.bag_uid for b in rows if b.availability == "AVAILABLE")
+
+
+def _verify_published_files(
+    db: Session, run: PipelineRun, row: SceneAnalysisVersion, manifest: SceneManifest, payload: dict
+) -> None:
+    """文件证据校验（DESIGN §6.2/§6.4）：发布根非空、可打开、摘要与登记一致才可用。
+
+    publish_root 缺失/文件缺失/摘要不一致 → 409 INCOMPLETE（不得"先可用后补"）。
+    NO_MATCH（无可发布区间）无文件义务，直接放行。
+    本校验在 Backend 发布根（本地/NAS 挂载）读取——P0 单文件系统口径；
+    执行面私有 staging 的原始校验证据由 per-slice manifest 随发布物落位。
+    """
+    if not manifest.publishable_segments():
+        return
+    publish_root = payload.get("publish_root")
+    if not publish_root:
+        raise HTTPException(409, "INCOMPLETE: 未提供 publish_root，无法核对文件证据（不得假定已发布）")
+    from pathlib import Path
+
+    from app.services.scene_publish_service import SLICE_MANIFEST_NAME, _target_matches
+
+    root = Path(str(publish_root))
+    if not root.is_dir():
+        raise HTTPException(409, f"INCOMPLETE: 发布根不可读 {root}")
+    manifest_digest = manifest.digest()
+    for der in db.scalars(
+        select(BagDerivation).where(
+            BagDerivation.run_id == run.pipeline_run_id, BagDerivation.analysis_version_id == row.id
+        )
+    ).all():
+        child_dir = f"{run.source_id}_{der.child_bag_uid}"
+        target = root / (payload.get("vehicle_key") or "unassigned") / manifest.scene_code / child_dir
+        if not target.is_dir():
+            raise HTTPException(409, f"INCOMPLETE: 切片 {der.slice_key} 未发布（{target} 不存在）")
+        # db3 摘要在 per-slice manifest 中（登记事实）；核对发布物与登记一致
+        record_file = target / SLICE_MANIFEST_NAME
+        if not record_file.is_file():
+            raise HTTPException(409, f"INCOMPLETE: 切片 {der.slice_key} 缺少 per-slice manifest（发布不完整）")
+        try:
+            import hashlib
+
+            db3 = target / "rosbag2_0.db3"
+            digest = hashlib.sha256(db3.read_bytes()).hexdigest() if db3.is_file() else None
+        except OSError as exc:
+            raise HTTPException(409, f"INCOMPLETE: 切片 {der.slice_key} 文件不可读（{exc}）")
+        if digest is None:
+            raise HTTPException(409, f"INCOMPLETE: 切片 {der.slice_key} db3 缺失或为空（不得标记可用）")
+        if not _target_matches(target, manifest_digest, digest):
+            raise HTTPException(409, f"INCOMPLETE: 切片 {der.slice_key} 发布物与 manifest/摘要不一致（禁止放行）")
+
