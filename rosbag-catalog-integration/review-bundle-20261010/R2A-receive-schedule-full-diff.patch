@@ -0,0 +1,137 @@
+"""场景身份持久键 + outbox DROPPED 终态（TASK-05 attempt-2，强模型 #5/#7）
+
+- pipeline_run.scene_identity_key：场景自动调度持久业务身份（源+代次+用途+冻结
+  能力集合的摘要），创建时写入、终态不释放；唯一约束（NULL 多值放行，非场景
+  run 恒 NULL）。活跃租约仍用 active_identity_key（随终态/取消释放），两键职责分离。
+- purpose_schedule_event.error_reason：DROPPED 终态原因列。status 增加 DROPPED
+  取值（String(16) 无需改列宽；CONSUMED=9/DROPPED=7 均在 16 内）。
+
+down_revision = "20261008_02"（03B 迁移）——本迁移必须排在 03B 链之后；
+若 3号 attempt-4 返修新增了迁移，合并前由协调者裁决链顺序（返修单声明）。
+
+历史回填：现有 SCENE_SLICE run 由 pipeline_config_snapshot_json 的 scene_run/v1
+快照确定性重算 scene_identity_key（算法与 scene_run_identity_key 一致），
+天然幂等；同业务身份多行（终态释放后重放遗留）只给规范行（max PK id）写键，
+其余保持 NULL，避免唯一索引冲突。
+"""
+
+import hashlib
+import json
+
+import sqlalchemy as sa
+
+from alembic import op
+
+revision = "20261009_01_scene_identity_key"
+down_revision = "20261008_02"
+branch_labels = None
+depends_on = None
+
+
+def _backfill_scene_identity() -> None:
+    """从 scene_run/v1 快照重算持久身份键（确定性，重跑不变）。
+
+    pipeline_run 无 source_generation 列（源代次冻结在快照 JSON 的
+    source_generation 字段），回填一律取快照值。
+
+    按身份去重（强模型 #7 / OCR B6 high）：终态释放 active_identity_key 后，
+    相同业务身份的 run 可在终态后重放新建第二个 run——存量库可能同身份多行
+    （如 R1 已 SCENE_DONE + R2 新建）。若逐行都写同一 scene_identity_key，
+    紧接着 create_index(unique=True) 会抛 IntegrityError 令 upgrade 失败。
+    故每个身份只给规范行（max(int PK id) = 最新 run）写键，其余保持 NULL。
+    """
+    bind = op.get_bind()
+    rows = bind.execute(
+        sa.text(
+            "SELECT id, pipeline_run_id, source_id, pipeline_config_snapshot_json "
+            "FROM pipeline_run WHERE pipeline_type = 'SCENE_SLICE'"
+        )
+    ).fetchall()
+    best = {}  # identity -> (max int id, run_id)：规范行 = 该身份下最新 run
+    for row_id, run_id, source_id, snapshot_json in rows:
+        try:
+            snapshot = json.loads(snapshot_json or "{}")
+        except (TypeError, ValueError):
+            continue
+        if snapshot.get("schema_version") != "scene-run/v1":
+            continue
+        scenes = snapshot.get("scenes") or []
+        if not scenes:
+            continue
+        try:
+            generation = int(snapshot.get("source_generation"))
+        except (TypeError, ValueError):
+            continue
+        entries = sorted(
+            (
+                str(s.get("scene_code") or ""),
+                str(s.get("capability_version") or ""),
+                str(s.get("capability_config_hash") or ""),
+            )
+            for s in scenes
+        )
+        body = json.dumps(
+            [
+                str(source_id),
+                generation,
+                str(snapshot.get("purpose") or "scene_slice"),
+                entries,
+            ],
+            ensure_ascii=False,
+            separators=(",", ":"),
+        )
+        identity = "scene:" + hashlib.sha256(body.encode()).hexdigest()[:48]
+        cur = best.get(identity)
+        if cur is None or row_id > cur[0]:
+            best[identity] = (row_id, run_id)
+    updates = [{"key": identity, "rid": run_id, "key_check": identity} for identity, (_row_id, run_id) in best.items()]
+    if updates:
+        bind.execute(
+            sa.text(
+                "UPDATE pipeline_run SET scene_identity_key = :key "
+                "WHERE pipeline_run_id = :rid AND (scene_identity_key IS NULL "
+                "OR scene_identity_key = :key_check)"
+            ),
+            updates,
+        )
+
+
+def _pipeline_run_cols() -> set[str]:
+    return {c["name"] for c in sa.inspect(op.get_bind()).get_columns("pipeline_run")}
+
+
+def _outbox_cols() -> set[str]:
+    return {c["name"] for c in sa.inspect(op.get_bind()).get_columns("purpose_schedule_event")}
+
+
+def _pipeline_run_indexes() -> set[str]:
+    return {ix["name"] for ix in sa.inspect(op.get_bind()).get_indexes("pipeline_run")}
+
+
+def upgrade() -> None:
+    # 迁移链起点（20260911_01）从空库 upgrade 时会按当前 model create_all，
+    # 新列可能已随 create_all 落库——逐对象 gate，部分应用重入安全。
+    if "scene_identity_key" not in _pipeline_run_cols():
+        op.add_column("pipeline_run", sa.Column("scene_identity_key", sa.String(length=64), nullable=True))
+    _backfill_scene_identity()
+    # 列唯一约束由模型 __table_args__ UniqueConstraint 定义（create_all 生成同名索引），
+    # 迁移与之一致，避免双约束/重名。
+    if "uq_pipeline_run_scene_identity_key" not in _pipeline_run_indexes():
+        op.create_index("uq_pipeline_run_scene_identity_key", "pipeline_run", ["scene_identity_key"], unique=True)
+    if "error_reason" not in _outbox_cols():
+        op.add_column("purpose_schedule_event", sa.Column("error_reason", sa.String(length=255), nullable=True))
+
+
+def downgrade() -> None:
+    if "error_reason" in _outbox_cols():
+        op.drop_column("purpose_schedule_event", "error_reason")
+    if "uq_pipeline_run_scene_identity_key" in _pipeline_run_indexes():
+        op.drop_index("uq_pipeline_run_scene_identity_key", table_name="pipeline_run")
+    if "scene_identity_key" in _pipeline_run_cols():
+        try:
+            op.drop_column("pipeline_run", "scene_identity_key")
+        except Exception:
+            # SQLite：链起点 20260911_01 用 create_all 建表时，scene_identity_key 的唯一
+            # 约束会生成隐式 sqlite_autoindex，导致 DROP COLUMN 被拒绝（MySQL 无此限制）。
+            # 空库本地回退场景下保留残留列无害（nullable、无数据引用），跳过即可。
+            pass
