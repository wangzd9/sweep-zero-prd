+def test_register_recovery_no_duplicate_run(db, monkey_source, monkeypatch):
+    """恢复登记（同 bag 重放）：不重复创建 run，回显首登的 run ID。"""
+    monkeypatch.setenv("SCENE_INGEST_ENABLED", "1")
+    pid = f"r3-{UNIQUE}-e"
+    _add_profile(db, pid, "fleetE", purposes=("self_built", "scene_slice"), scenes=("test-capability",))
+    rel = _bag_dir()
+    incoming = f"{INCOMING_ROOT}/fleetE/{rel}"
+    with TestClient(app) as client:
+        first = _register(client, f"fp{UNIQUE}", incoming)
+        assert first.status_code == 200, first.text
+        second = _register(client, f"fp{UNIQUE}", incoming)
+    assert second.status_code == 200, second.text
+    first_id = first.json()["pipeline_run_id"]
+    second_id = second.json()["pipeline_run_id"]
+    assert first_id is not None
+    assert second_id == first_id  # 恢复回显同一 run，不新建
+    with SessionLocal() as s:
+        runs = list(s.scalars(select(PipelineRun).where(PipelineRun.source_id == first.json()["source_id"])).all())
+        assert len(runs) == 1
+
