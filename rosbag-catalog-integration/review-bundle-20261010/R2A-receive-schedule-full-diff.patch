+def test_patch_submission_selects_with_for_update(db):
+    """#6 行锁证据：PATCH 读 submission 的 SELECT 携带 with_for_update 标志。
+
+    通过包装 db.scalar 捕获语句（session 内部不走 db.execute 绑定方法），
+    断言存在 _for_update_arg 的 ingest_submission SELECT。SQLite 方言编译省略
+    FOR UPDATE 子句，MySQL 隔离库并发实测为权威证据（见回执）。
+    """
+    pid = f"fz4-{UNIQUE}-h"
+    _add_profile(db, pid, "fleetH")
+    response = _create_scene_submission(db, pid, "bagH")
+    sub_id = response["submission_id"]
+
+    captured = []
+    real_scalar = db.scalar
+
+    def spy_scalar(statement, *a, **k):
+        cds = getattr(statement, "column_descriptions", [])
+        entity = cds[0].get("entity") if cds else None
+        captured.append((entity, getattr(statement, "_for_update_arg", None)))
+        return real_scalar(statement, *a, **k)
+
+    old = db.scalar
+    db.scalar = spy_scalar
+    try:
+        ingest_service.patch_submission(db, sub_id, 1, {"purposes": ["scene_slice"]}, None)
+    finally:
+        db.scalar = old
+    for_update = [c for c in captured if c[0] is IngestSubmission and c[1] is not None]
+    assert for_update, f"PATCH 路径的 submission SELECT 未携带 with_for_update: {captured}"
