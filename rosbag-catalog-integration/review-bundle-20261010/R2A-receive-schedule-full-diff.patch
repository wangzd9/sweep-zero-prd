+def _add_profile(db, profile_id, prefix, purposes=("scene_slice",), scenes=("test-capability",)):
+    row = IngestProfile(
+        profile_id=profile_id,
+        version=1,
+        display_name=profile_id,
+        incoming_prefix=prefix,
+        default_purposes_json=json.dumps(list(purposes)),
+        default_scenes_json=json.dumps(list(scenes)),
+        default_scene_parameters_json=json.dumps({}),
+        enabled=True,
+    )
+    db.add(row)
+    db.commit()
+    return row
+
+
+def _create_submission(pid, relative_path, purposes, scenes=None):
+    selection = SubmissionSelection(
+        purposes=[IngestPurpose(p) for p in purposes],
+        scenes=[SceneSelection(**s) for s in scenes] if scenes is not None else None,
+        relative_path=relative_path,
+    )
+    with SessionLocal() as s:
+        response, status = ingest_service.create_submission(s, pid, relative_path, selection, None)
+    assert status == 201
+    return response
+
+
+def _register(client, fingerprint, incoming_path):
+    return client.post(
+        "/api/v1/sources/register",
+        json={"path": _bag_path(), "fast_fingerprint": fingerprint, "incoming_path": incoming_path},
+    )
+
