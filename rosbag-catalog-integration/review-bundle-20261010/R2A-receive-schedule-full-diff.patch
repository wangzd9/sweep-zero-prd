+    assert response["config_required"] is True
+    sub = db.scalar(select(IngestSubmission).where(IngestSubmission.submission_id == response["submission_id"]))
+    assert json.loads(sub.frozen_capability_hashes_json) == {}
+    result = _bind(db, _bag_uid(), f"{INCOMING_ROOT}/fleetC/bagC")
+    assert result["config_required"] is True
+    assert result["scheduled_purposes"] == []
+    db.commit()
+    events = list(
+        db.scalars(
+            select(PurposeScheduleEvent).where(PurposeScheduleEvent.submission_id == response["submission_id"])
+        ).all()
+    )
+    assert events == []
+
+
+def test_self_built_accept_freezes_empty(db, monkeypatch):
+    """self_built 用途不出 scene 事件：冻结值 {} 合法（无 NULL-hash scene 事件）。"""
+    monkeypatch.setenv("SCENE_INGEST_ENABLED", "1")
+    pid = f"fz4-{UNIQUE}-d"
+    _add_profile(db, pid, "fleetD", purposes=("self_built",), scenes=())
