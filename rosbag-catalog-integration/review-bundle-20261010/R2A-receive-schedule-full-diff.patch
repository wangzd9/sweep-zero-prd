+    @staticmethod
+    def _spec_raw_image(
+        sec: int,
+        nanosec: int,
+        frame_id: str,
+        height: int,
+        width: int,
+        encoding: str,
+        step: int,
+        data: bytes,
+        *,
+        encap: bool = True,
+        align: bool = True,
+    ) -> bytes:
+        """按 OMG CDR 规范独立构造 Image 体（不依赖本仓库 encode）。
+
+        align=True 时在每个 32 位字段前插规范 padding（真实 ROS2 序列化行为）。
+        align=False 构造"无 padding"字节，仅用于证明旧解码器读这类合法样本会错位。
+        """
+        import struct
+
+        def pad(cur: int) -> bytes:
+            if not align:
+                return b""
+            return b"\x00" * ((4 - (cur % 4)) % 4)
+
+        body = b""
+        fid = frame_id.encode("utf-8") + b"\x00"
+        enc = encoding.encode("utf-8") + b"\x00"
+
+        # std_msgs/Header: Time{sec i32, nanosec u32} + frame_id string
+        body += pad(len(body)) + struct.pack("<iI", sec, nanosec)
+        body += pad(len(body)) + struct.pack("<I", len(fid)) + fid
+        # Image 字段
+        body += pad(len(body)) + struct.pack("<II", height, width)
+        body += pad(len(body)) + struct.pack("<I", len(enc)) + enc
+        body += struct.pack("<B", 0)  # is_bigendian（1 字节，无对齐）
+        body += pad(len(body)) + struct.pack("<I", step)
+        body += pad(len(body)) + struct.pack("<I", len(data)) + data
+        head = ENCAP_LE if encap else b""
+        return head + body
+
+    @staticmethod
+    def _expect_padding(frame_id_len: int, encoding_len: int, encap: bool) -> tuple[int, int]:
+        """计算 frame_id 长度字段前的 padding 字节数（返回 (fid_pad, enc_pad)）。"""
+        fid_len = frame_id_len + 1  # 含 NUL
+        # header: Time 8B + fid(string)
+        # 对齐基准 = 封装头后(4) 或 0；body 起点恒对齐，故用 body 相对偏移算
+        pos_after_time = 8
+        fid_pad = (4 - (pos_after_time % 4)) % 4  # 0
+        pos_after_fid = pos_after_time + 4 + fid_len
+        # encoding 字符串长度字段前
+        enc_pad = (4 - (pos_after_fid % 4)) % 4
+        return fid_pad, enc_pad
+
