+def test_patch_concurrent_guard_zero_rows_returns_409(db, monkey_settings, monkeypatch):
+    """F2 隔离库并发复测（MySQL 8.4 双独立会话竞争）：让 409 路径在真并发下可达。
+
+    真并发窗口：读比通过（submission.row_version == expected）之后、条件 UPDATE
+    之前，另一端已抢先推进 row_version → 守卫 UPDATE 匹配 0 行。单会话无法模拟
+    （同库连接串行会掩盖），这里 monkeypatch 在 execute 层只拦截"守卫 UPDATE"
+    （带 row_version + 自增表达式的 sa_update）并强制 0 行返回，验证 API 面行为：
+    必须 409 ROW_VERSION_CONFLICT，而非旧实现的 ORM 内容 flush 抛 StaleDataError
+    （500）。SQLite 下 ORM 单条按主键 flush 匹配 1 行，无法复现 MySQL affected-rows
+    语义，故隔离 MySQL 双线程复测为权威证据（见回执隔离库复测段），本测试固化
+    "rowcount==0 → 409 可达且不覆盖内容"的守卫语义。
+    """
+    monkeypatch.setenv("SCENE_INGEST_ENABLED", "1")
+    pid = f"t03b-{UNIQUE}-f2"
+    _add_profile(db, pid, "fleetF2")
+    response, _ = ingest_service.create_submission(db, pid, "bagF2", _selection("bagF2"), None)
+    sub_id = response["submission_id"]
+    before = db.scalar(select(IngestSubmission).where(IngestSubmission.submission_id == sub_id))
+    before_hash = before.effective_config_hash
+    before_selection = before.selection_json
+
+    real_execute = db.execute
+
+    class _ZeroRowResult:
+        rowcount = 0
+
+    def fake_execute(statement, *args, **kwargs):
+        # 只拦截守卫 UPDATE（合并了内容列 + row_version+1 自增的 sa_update）：
+        # patch_submission 里对 ingest_submission 唯一发出的 sa_update，且自增表达式
+        # 在编译 SQL 里出现 "row_version + 1"；其它语句（idempotency store 的 INSERT 等）
+        # 原样透传。强制 rowcount=0 模拟真并发下守卫 0 行匹配。
+        if type(statement).__name__ == "Update" and getattr(statement.table, "name", "") == "ingest_submission":
+            sql = str(statement.compile(compile_kwargs={"literal_binds": True}))
+            if "row_version + 1" in sql:
+                return _ZeroRowResult()
+        return real_execute(statement, *args, **kwargs)
+
+    monkeypatch.setattr(db, "execute", fake_execute)
+
+    # 关键回归锚点（让本测试对旧架构 RED）：旧实现守卫前先 db.flush() 把内容列作为
+    # 独立 ORM UPDATE 写入；真并发下该内容 flush 在 MySQL affected-rows 语义下 0 行 →
+    # ORM check_rowcount 抛 StaleDataError（500），409 分支不可达。这里把 flush 模拟为
+    # 抛 StaleDataError：旧代码（调用 flush）→ 冒泡异常 → 非 409 → RED；新代码
+    # （内容并入守卫 UPDATE、守卫前不再 flush）→ 走 rowcount==0 → 409 → GREEN。
+    # 隔离 MySQL 双线程复测为权威证据（见回执），本测试固化"内容不经 ORM flush"的不变式。
+    def fake_flush(*args, **kwargs):
+        raise StaleDataError(
+            "UPDATE statement on table 'ingest_submission' expected to update 1 row(s); 0 were matched."
+        )
+
+    monkeypatch.setattr(db, "flush", fake_flush)
+    with pytest.raises(HTTPException) as exc:
+        ingest_service.patch_submission(db, sub_id, 1, {"purposes": ["self_built"]}, None)
+    assert exc.value.status_code == 409
+    assert "ROW_VERSION_CONFLICT" in str(exc.value.detail)
+
+    # 内容不被并发端覆盖（守卫 0 行 → 回滚，DB 保持 winner 前的代次 1 内容）
+    db.expire_all()
+    after = db.scalar(select(IngestSubmission).where(IngestSubmission.submission_id == sub_id))
+    assert after.row_version == 1  # 未被推进
+    assert after.effective_config_hash == before_hash
+    assert after.selection_json == before_selection  # 内容未被并发端覆盖
+    assert json.loads(after.selection_json)["purposes"] != ["self_built"]  # 败者写入未落地
+
+
