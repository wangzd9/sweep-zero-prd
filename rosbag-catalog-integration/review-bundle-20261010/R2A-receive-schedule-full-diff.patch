+def test_migration_backfill_dedupes_duplicate_identity_runs(tmp_path):
+    """backfill 去重回归（强模型 #7 / OCR B6 high）：预置同业务身份两条 SCENE_SLICE run
+    （R1 已 SCENE_DONE + R2 新建排队，快照逐字节相同 → 同一持久身份），跑真实 alembic
+    upgrade head：唯一索引建成、规范行=max(int PK id)=R2 持键、R1 保持 NULL、不抛
+    IntegrityError。迁移在独立临时 SQLite 库上执行（子进程跑 alembic CLI，不污染共享测试库）。
+
+    步骤：upgrade 到 20261008_02（列尚无 scene_identity_key 索引语义，表已建）→
+    直插两条同身份 run（R1 终态先插 id=1、R2 新 run 后插 id=2）→ upgrade head
+    （触发 20261009_01 的 backfill + 唯一索引）→ 断言去重结果与幂等重跑。"""
+    import os
+    import subprocess
+    import sys
+
+    from sqlalchemy import create_engine, inspect, text
+
+    db_path = tmp_path / "backfill_dedupe.db"
+    database_url = f"sqlite:///{db_path}"
+
+    def _alembic(*args: str) -> None:
+        env = {**os.environ, "DATABASE_URL": database_url}
+        subprocess.run(
+            [sys.executable, "-m", "alembic", *args],
+            check=True,
+            env=env,
+            capture_output=True,
+            text=True,
+        )
+
+    # 1) 迁移到 05 前一步：pipeline_run / outbox 表已建，scene_identity_key 列未加
+    _alembic("upgrade", "20261008_02")
+    import datetime as dt
+
+    from app import models  # noqa: F401
+    from app.database import Base
+
+    table = Base.metadata.tables["pipeline_run"]
+    engine = create_engine(database_url)
+    with engine.begin() as conn:
+        snap = json.dumps(
+            {
+                "schema_version": "scene-run/v1",
+                "purpose": "scene_slice",
+                "scenes": [
+                    {
+                        "scene_code": "demo_scene",
+                        "capability_version": "v1",
+                        "capability_config_hash": "h" * 64,
+                    }
+                ],
+                "source_generation": 1,
+                "reanalysis_id": None,
+            },
+            ensure_ascii=False,
+            sort_keys=True,
+        )
+        # 直插两条同身份存量 run：R1 先插（较小 PK id）已终态 SCENE_DONE，
+        # R2 后插（max PK id）新 run——模拟 active_identity_key 终态释放后
+        # 同身份重放遗留的重复行（backfill 触发条件）。
+        for rid, rpid, rstatus in (
+            (1, "scene-backfill-r1", "SCENE_DONE"),
+            (2, "scene-backfill-r2", "SCENE_SLICE_QUEUE"),
+        ):
+            params = {"s": snap}
+            cols = [
+                "id",
+                "pipeline_run_id",
+                "source_id",
+                "queue_name",
+                "status",
+                "pipeline_type",
+                "pipeline_config_snapshot_json",
+            ]
+            vals = [
+                str(rid),
+                f"'{rpid}'",
+                "'T05BF-0001'",
+                "'SCENE_SLICE_QUEUE'",
+                f"'{rstatus}'",
+                "'SCENE_SLICE'",
+                ":s",
+            ]
+            for col in table.columns:
+                if col.name in (
+                    "id",
+                    "pipeline_run_id",
+                    "source_id",
+                    "queue_name",
+                    "status",
+                    "pipeline_type",
+                    "pipeline_config_snapshot_json",
+                ):
+                    continue
+                # NOT NULL 且无 server_default 的列按 ORM 默认值补齐（直插不经过 ORM）
+                if col.nullable or col.server_default is not None:
+                    continue
+                if col.name in (
+                    "priority",
+                    "attempt",
+                    "auto_retry_count",
+                    "publish_origin_to_nas",
+                    "publish_final_to_nas",
+                ):
+                    v = "0"
+                elif col.name in ("created_at", "updated_at"):
+                    v = f":{col.name}"
+                    params[col.name] = dt.datetime(2026, 10, 9, 12, 0, 0)
+                else:
+                    v = "''"
+                cols.append(col.name)
+                vals.append(v)
+            conn.execute(
+                text(f"INSERT INTO pipeline_run ({', '.join(cols)}) VALUES ({', '.join(vals)})"),
+                params,
+            )
+    engine.dispose()
+
+    # 2) upgrade head：触发 20261009_01 backfill + create_index(unique=True)。
+    # 修复前此处对两行写同一键 → IntegrityError，upgrade 直接失败（check=True 抛异常）。
+    _alembic("upgrade", "head")
+
+    # 3) 断言：唯一索引建成、规范行=max(PK id)=R2 持键、R1 保持 NULL
+    engine = create_engine(database_url)
+    with engine.connect() as conn:
+        insp = inspect(conn)
+        index_names = {ix["name"] for ix in insp.get_indexes("pipeline_run")}
+        assert "uq_pipeline_run_scene_identity_key" in index_names
+        rows = conn.execute(
+            text("SELECT pipeline_run_id, scene_identity_key FROM pipeline_run WHERE id IN (1, 2) ORDER BY id")
+        ).fetchall()
+    engine.dispose()
+    r1, r2 = rows
+    assert r1[0] == "scene-backfill-r1" and r1[1] is None
+    assert r2[0] == "scene-backfill-r2" and r2[1] is not None
+    assert r2[1].startswith("scene:")
+
+    # 3b) 反证（独立库副本，不污染主库）：修复前的逐行回填写法对存量重复身份必炸
+    # （两行写同一键 → 唯一索引 IntegrityError）——证明本回归测试确实覆盖该缺陷。
+    import shutil
+
+    from sqlalchemy.exc import IntegrityError as SAIntegrityError
+
+    neg_path = tmp_path / "backfill_neg.db"
+    shutil.copyfile(db_path, neg_path)
+    neg_engine = create_engine(f"sqlite:///{neg_path}")
+    with pytest.raises(SAIntegrityError):
+        with neg_engine.begin() as conn:
+            conn.execute(
+                text("UPDATE pipeline_run SET scene_identity_key = :k WHERE pipeline_run_id = :r1"),
+                {"k": r2[1], "r1": "scene-backfill-r1"},
+            )
+    neg_engine.dispose()
+
+    # 4) 幂等：重跑 20261009_01（downgrade 一步再 upgrade）结果不变
+    _alembic("downgrade", "20261008_02")
+    _alembic("upgrade", "head")
+    engine = create_engine(database_url)
+    with engine.connect() as conn:
+        rows = conn.execute(
+            text("SELECT pipeline_run_id, scene_identity_key FROM pipeline_run WHERE id IN (1, 2) ORDER BY id")
+        ).fetchall()
+    engine.dispose()
+    assert rows == [
+        ("scene-backfill-r1", None),
+        ("scene-backfill-r2", r2[1]),
+    ]
+
