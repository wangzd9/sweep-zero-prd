+"""场景结果检索与血缘查询（专项 TASK-06A，DESIGN §7.1/§8.1）。
+
+有界契约：
+- 列表 limit 默认 50、上限 200（API 层校验；本层防御性 clamp）。
+- 排序固定：started_at、bag_uid 倒序，空 started_at 排最后；
+  血缘子包沿用此排序；区间按 start_ns、区间 ID 升序。
+- cursor 为 base64(JSON)：包含排序锚点与筛选上下文，翻页稳定但不承诺快照隔离。
+- 列表只投影摘要字段，不无界展开 topic/子包/历史；
+  区间/证据明细走单独有界端点（segments/lineage）。
+- PENDING 切片不进入默认可用检索；include_history=True 显式包含历史版本。
+"""
+
+from __future__ import annotations
+
+import base64
+import json
+
+from fastapi import HTTPException
+from sqlalchemy import select
+from sqlalchemy.orm import Session
+
+from app.models import (
+    BagDerivation,
+    BagRecord,
+    BagSceneLabelEvidence,
+    Scene,
+    SceneAnalysisVersion,
+    SceneSegment,
+    Vehicle,
+)
+
+DEFAULT_LIMIT = 50
+MAX_LIMIT = 200
+
+
+def _clamp_limit(limit: int | None) -> int:
+    if limit is None:
+        return DEFAULT_LIMIT
+    return max(1, min(int(limit), MAX_LIMIT))
+
+
+def _decode_cursor(raw: str | None) -> dict:
+    if not raw:
+        return {}
+    try:
+        payload = json.loads(base64.urlsafe_b64decode(raw.encode()).decode("utf-8"))
+        if not isinstance(payload, dict):
+            raise ValueError
+        return payload
+    except Exception as exc:  # noqa: BLE001 — 非法 cursor 一律 422，不猜测
+        raise HTTPException(422, f"invalid cursor: {exc}") from exc
+
+
+def _encode_cursor(payload: dict) -> str:
+    return base64.urlsafe_b64encode(json.dumps(payload, sort_keys=True).encode()).decode()
+
+
+def _time_desc_clause(column):
+    """started_at 倒序、NULL 排最后（跨 SQLite/MySQL 的有界写法）。"""
+    return [column.is_(None).asc(), column.desc()]
+
+
+def _bag_summary(bag: BagRecord, vehicle: Vehicle | None, scene_names: list[str]) -> dict:
+    return {
+        "bag_uid": bag.bag_uid,
+        "name": bag.name,
+        "role": bag.bag_role,
+        "availability": bag.availability,
+        "started_at": bag.started_at.isoformat() if bag.started_at else None,
+        "duration_ns": str(bag.duration_ns),
+        "vehicle": vehicle.name if vehicle else None,
+        "scenes": scene_names,
+        "dataset_type": bag.dataset_type,
+    }
+
+
+def search_scene_bags(
+    db: Session,
+    *,
+    view: str = "slices",
+    scene_code: str | None = None,
+    vehicle_id: int | None = None,
+    parent_bag_uid: str | None = None,
+    role: str | None = None,
+    keyword: str | None = None,
+    include_history: bool = False,
+    cursor: str | None = None,
+    limit: int | None = None,
+    child_uid_prefix: str | None = None,
+) -> dict:
+    """统一服务检索（DESIGN §7.1 GET /api/v1/bags）。
+
+    view=slices：当前版本 + AVAILABLE 切片（include_history 时放宽为全部历史切片，
+    行内 current 字段标明是否属于当前版本）；view=originals：仅 ORIGINAL；
+    view=all：全部角色。child_uid_prefix 仅测试/有界过滤用（按 bag_uid 前缀隔离行集）。
+    parent_bag_uid/scene_code 过滤作用在 derivation 关联上，语义为"该父包/场景的
+    切片"，仅对 slices/all 视图有意义；originals 视图请改用 child_uid_prefix 等角色过滤。
+    """
+    if view not in ("slices", "originals", "all"):
+        raise HTTPException(422, f"view 非法：{view}（仅 slices/originals/all）")
+    lim = _clamp_limit(limit)
+    ctx = _decode_cursor(cursor)
+
+    q = select(BagRecord, Vehicle).join(Vehicle, isouter=True)
+    q = q.outerjoin(BagRecord.derivation)  # 切片 → 父包关联（view=slices 用）
+    if role:
+        q = q.where(BagRecord.bag_role == role)
+    if vehicle_id is not None:
+        q = q.where(Vehicle.id == vehicle_id)
+    if keyword:
+        q = q.where(BagRecord.name.contains(keyword))
+    if child_uid_prefix:
+        q = q.where(BagRecord.bag_uid.like(f"{child_uid_prefix}%"))
+
+    if view == "originals":
+        q = q.where(BagRecord.bag_role == "ORIGINAL")
+    elif view == "slices":
+        if not include_history:
+            # 默认：仅当前版本 AVAILABLE 切片（PENDING 不进入可用检索，DESIGN §4.1）
+            q = q.where(BagRecord.bag_role == "SCENE_SLICE", BagRecord.availability == "AVAILABLE")
+            if scene_code:
+                q = q.where(BagDerivation.scene_code == scene_code)
+            if parent_bag_uid:
+                q = q.where(BagDerivation.parent_bag_uid == parent_bag_uid)
+        else:
+            # 历史切片：全部 SCENE_SLICE（行内 current 标记当前性）
+            q = q.where(BagRecord.bag_role == "SCENE_SLICE")
+            if scene_code:
+                q = q.where(BagDerivation.scene_code == scene_code)
+            if parent_bag_uid:
+                q = q.where(BagDerivation.parent_bag_uid == parent_bag_uid)
+    else:  # all
+        if scene_code:
+            q = q.where(BagDerivation.scene_code == scene_code)
+        if parent_bag_uid:
+            q = q.where(BagDerivation.parent_bag_uid == parent_bag_uid)
+
+    # cursor 锚点：(started_at IS NULL, started_at DESC, bag_uid DESC)
+    if ctx:
+        anchor_null = bool(ctx.get("null"))
+        anchor_ts = ctx.get("ts")
+        anchor_uid = ctx.get("uid")
+        if anchor_uid is None:
+            raise HTTPException(422, "cursor 缺少排序锚点")
+        if anchor_ts is None:
+            # 上一页锚点是 started_at NULL 行：只续查 NULL 区且 bag_uid 更小
+            if not anchor_null:
+                raise HTTPException(422, "cursor 锚点不一致（ts 缺失但 null 标记错误）")
+            q = q.where(BagRecord.started_at.is_(None), BagRecord.bag_uid < anchor_uid)
+        else:
+            from datetime import datetime as _dt
+
+            ts = _dt.fromisoformat(anchor_ts)
+            if anchor_null:
+                raise HTTPException(422, "cursor 锚点不一致（ts 存在但 null 标记为真）")
+            # started_at 更小的全取；同 started_at 的取 bag_uid 更小的
+            q = q.where(
+                (BagRecord.started_at.is_(None))
+                | ((BagRecord.started_at < ts) | ((BagRecord.started_at == ts) & (BagRecord.bag_uid < anchor_uid)))
+            )
+
+    q = q.order_by(*_time_desc_clause(BagRecord.started_at), BagRecord.bag_uid.desc())
+    # +1 探测判定 has_more：超大量数据下每页多取 1 行，代价有界（不额外 COUNT）；
+    # 该行为已在 DESIGN §7.1 接受，无需为大数据量另设全量计数路径。
+    q = q.limit(lim + 1)
+
+    rows = db.execute(q).all()
+    has_more = len(rows) > lim
+    rows = rows[:lim]
+
+    # scenes 摘要：一次有界批量查询（bag_scene 关联表），不逐行 lazy load
+    bag_ids = [b.id for b, _ in rows]
+    scene_map: dict[int, list[str]] = {}
+    if bag_ids:
+        from app.models import bag_scene
+
+        for bag_id, scene_id in db.execute(bag_scene.select().where(bag_scene.c.bag_id.in_(bag_ids))):
+            scene_map.setdefault(bag_id, []).append(scene_id)
+        if scene_map:
+            scene_names = {
+                s.id: s.name
+                for s in db.scalars(
+                    select(Scene).where(Scene.id.in_(set(i for vs in scene_map.values() for i in vs)))
+                ).all()
+            }
+            scene_map = {k: [scene_names[i] for i in v] for k, v in scene_map.items()}
+
+    # 当前性标注：include_history 时查询当前版本指针（一次有界查询，不逐行查）
+    current_set: set[str] = set()
+    if view == "slices" and include_history and rows:
+        child_uids = [r[0].bag_uid for r in rows]
+        cur = (
+            db.execute(
+                select(BagDerivation.child_bag_uid)
+                .join(SceneAnalysisVersion, SceneAnalysisVersion.id == BagDerivation.analysis_version_id)
+                .where(SceneAnalysisVersion.current.is_(True), BagDerivation.child_bag_uid.in_(child_uids))
+            )
+            .scalars()
+            .all()
+        )
+        current_set = set(cur)
+
+    items = []
+    for bag, vehicle in rows:
+        item = _bag_summary(bag, vehicle, scene_map.get(bag.id, []))
+        if view == "slices" and include_history:
+            item["current"] = bag.bag_uid in current_set
+        items.append(item)
+
+    next_cursor = None
+    if has_more and rows:
+        last = rows[lim - 1][0]
+        next_cursor = _encode_cursor(
+            {
+                "null": last.started_at is None,
+                "ts": last.started_at.isoformat() if last.started_at else None,
+                "uid": last.bag_uid,
+                "view": view,
+                "scene_code": scene_code,
+            }
+        )
+    return {"items": items, "limit": lim, "has_more": has_more, "next_cursor": next_cursor}
+
+
+def current_versions(
+    db: Session, *, parent_bag_uid: str | None = None, scene_code: str | None = None, limit: int | None = None
+) -> list[dict]:
+    """父包+场景当前版本指针（有界）。"""
+    lim = _clamp_limit(limit)
+    q = (
+        select(SceneAnalysisVersion)
+        .where(SceneAnalysisVersion.current.is_(True))
+        .order_by(SceneAnalysisVersion.id.asc())
+        .limit(lim)
+    )
+    if parent_bag_uid:
+        q = q.where(SceneAnalysisVersion.parent_bag_uid == parent_bag_uid)
+    if scene_code:
+        q = q.where(SceneAnalysisVersion.scene_code == scene_code)
+    return [
+        {
+            "id": v.id,
+            "parent_bag_uid": v.parent_bag_uid,
+            "scene_code": v.scene_code,
+            "analysis_version": v.analysis_version,
+            "run_id": v.run_id,
+            "result": v.result,
+            "expected_segment_count": str(v.expected_segment_count),
+            "registered_segment_count": str(v.registered_segment_count),
+            "current": bool(v.current),
+            "created_at": v.created_at.isoformat() if v.created_at else None,
+        }
+        for v in db.scalars(q)
+    ]
+
+
+def list_segments(
+    db: Session,
+    *,
+    analysis_version_id: int,
+    publish_only: bool = False,
+    limit: int | None = None,
+) -> dict:
+    """区间列表（start_ns、id 升序；含 flat 等非发布结果，publish_only 时过滤）。"""
+    lim = _clamp_limit(limit)
+    q = select(SceneSegment).where(SceneSegment.analysis_version_id == analysis_version_id)
+    if publish_only:
+        q = q.where(SceneSegment.publish_target.is_(True))
+    q = q.order_by(SceneSegment.start_ns.asc(), SceneSegment.id.asc()).limit(lim + 1)
+    rows = db.scalars(q).all()
+    # truncated 复用首次查询的 +1 探测结果，不做第二次相同查询（attempt-2 #6）。
+    truncated = len(rows) > lim
+    if truncated:
+        rows = rows[:lim]
+    return {
+        "items": [
+            {
+                "id": s.id,
+                "label": s.label,
+                "start_ns": str(s.start_ns),
+                "end_ns": str(s.end_ns),
+                "duration_ns": str(s.duration_ns),
+                "publish_target": bool(s.publish_target),
+                "slice_key": s.slice_key,
+                "boundary_mapping_note": s.boundary_mapping_note,
+                "boundary_evidence_artifact_id": s.boundary_evidence_artifact_id,
+            }
+            for s in rows
+        ],
+        "limit": lim,
+        "truncated": truncated,
+    }
+
+
+def lineage(db: Session, *, bag_uid: str, cursor: str | None = None, limit: int | None = None) -> dict:
+    """GET /api/v1/bags/{uid}/lineage：父包视角列子包（started_at/bag_uid 倒序，
+    区间按 start_ns/id 升序）；子包视角返回父包与自身登记。历史版本可经 current_versions 显式查。"""
+    lim = _clamp_limit(limit)
+    ctx = _decode_cursor(cursor)
+
+    bag = db.scalar(select(BagRecord).where(BagRecord.bag_uid == bag_uid))
+    if bag is None:
+        raise HTTPException(404, f"bag not found: {bag_uid}")
+
+    if bag.bag_role == "SCENE_SLICE":
+        der = db.scalar(select(BagDerivation).where(BagDerivation.child_bag_uid == bag_uid))
+        if der is None:
+            return {"bag_uid": bag_uid, "direction": "slice", "parent": None, "children": []}
+        parent = db.scalar(select(BagRecord).where(BagRecord.bag_uid == der.parent_bag_uid))
+        seg = db.scalar(select(SceneSegment).where(SceneSegment.id == der.segment_id)) if der.segment_id else None
+        return {
+            "bag_uid": bag_uid,
+            "direction": "slice",
+            "parent": {
+                "bag_uid": parent.bag_uid if parent else der.parent_bag_uid,
+                "name": parent.name if parent else None,
+            },
+            "self": {
+                "run_id": der.run_id,
+                "slice_key": der.slice_key,
+                "scene_code": der.scene_code,
+                "start_ns": str(der.start_ns),
+                "end_ns": str(der.end_ns),
+                "analysis_version_id": der.analysis_version_id,
+                "segment": (
+                    {"id": seg.id, "label": seg.label, "publish_target": bool(seg.publish_target)} if seg else None
+                ),
+            },
+            "children": [],
+        }
+
+    # 父包视角：子包按排序 + cursor
+    q = (
+        select(BagDerivation)
+        .join(BagRecord, BagRecord.bag_uid == BagDerivation.child_bag_uid)
+        .where(BagDerivation.parent_bag_uid == bag_uid)
+        .order_by(*_time_desc_clause(BagRecord.started_at), BagRecord.bag_uid.desc())
+    )
+    if ctx:
+        anchor_ts, anchor_uid = ctx.get("ts"), ctx.get("uid")
+        if anchor_uid is None:
+            raise HTTPException(422, "cursor 缺少排序锚点")
+        if anchor_ts is None:
+            q = q.where(BagRecord.started_at.is_(None), BagRecord.bag_uid < anchor_uid)
+        else:
+            from datetime import datetime as _dt
+
+            ts = _dt.fromisoformat(anchor_ts)
+            # started_at 更小的全取；同 started_at 的取 bag_uid 更小的；
+            # NULL started_at 行排序上位于最后（_time_desc_clause），锚点非 NULL 时
+            # 续查必须显式带上 NULL 区，否则 NULL 子包分页丢失（attempt-2 #1，
+            # 与 search_scene_bags 同口径）。
+            q = q.where(
+                (BagRecord.started_at.is_(None))
+                | ((BagRecord.started_at < ts) | ((BagRecord.started_at == ts) & (BagRecord.bag_uid < anchor_uid)))
+            )
+    q = q.limit(lim + 1)
+    ders = db.scalars(q).all()
+    has_more = len(ders) > lim
+    ders = ders[:lim]
+
+    # 子包/区间/版本：各一次有界批量查询，循环内不再逐子包回表（attempt-2 #5，N+1）。
+    children = []
+    child_by_uid: dict[str, BagRecord] = {}
+    if ders:
+        child_by_uid = {
+            c.bag_uid: c
+            for c in db.scalars(select(BagRecord).where(BagRecord.bag_uid.in_([d.child_bag_uid for d in ders]))).all()
+        }
+        segs = db.scalars(
+            select(SceneSegment).where(SceneSegment.id.in_([d.segment_id for d in ders if d.segment_id]))
+        ).all()
+        seg_by_id = {s.id: s for s in segs}
+        versions = db.scalars(
+            select(SceneAnalysisVersion).where(
+                SceneAnalysisVersion.id.in_([d.analysis_version_id for d in ders if d.analysis_version_id])
+            )
+        ).all()
+        ver_by_id = {v.id: v for v in versions}
+        for d in ders:
+            child = child_by_uid.get(d.child_bag_uid)
+            seg = seg_by_id.get(d.segment_id)
+            ver = ver_by_id.get(d.analysis_version_id) if d.analysis_version_id else None
+            children.append(
+                {
+                    "bag_uid": d.child_bag_uid,
+                    "name": child.name if child else None,
+                    "availability": child.availability if child else None,
+                    "started_at": child.started_at.isoformat() if child and child.started_at else None,
+                    "run_id": d.run_id,
+                    "slice_key": d.slice_key,
+                    "scene_code": d.scene_code,
+                    "start_ns": str(d.start_ns),
+                    "end_ns": str(d.end_ns),
+                    "current": bool(ver.current) if ver else None,
+                    "segment_label": seg.label if seg else None,
+                }
+            )
+    next_cursor = None
+    if has_more and ders:
+        last = ders[lim - 1]
+        # next_cursor 锚点直接复用批量取的子包行，不再重复回表（attempt-2 #5）。
+        child = child_by_uid.get(last.child_bag_uid)
+        next_cursor = _encode_cursor(
+            {"ts": child.started_at.isoformat() if child and child.started_at else None, "uid": last.child_bag_uid}
+        )
+    return {
+        "bag_uid": bag_uid,
+        "direction": "parent",
+        "children": children,
+        "limit": lim,
+        "has_more": has_more,
+        "next_cursor": next_cursor,
+    }
+
+
+def label_evidence(db: Session, *, bag_uid: str, limit: int | None = None) -> list[dict]:
+    """标签证据（区间证据可查，验收项）：MODEL 原始判定引用 + P1 修订字段。"""
+    lim = _clamp_limit(limit)
+    rows = db.scalars(
+        select(BagSceneLabelEvidence)
+        .where(BagSceneLabelEvidence.bag_uid == bag_uid)
+        .order_by(BagSceneLabelEvidence.id.asc())
+        .limit(lim)
+    ).all()
+    scene_names = {
+        s.id: s.name for s in db.scalars(select(Scene).where(Scene.id.in_([r.scene_id for r in rows] or [0]))).all()
+    }
+    return [
+        {
+            "id": r.id,
+            "scene": scene_names.get(r.scene_id),
+            "label_source": r.label_source,
+            "analysis_version_id": r.analysis_version_id,
+            "segment_id": r.segment_id,
+            "original_judgment_ref": r.original_judgment_ref,
+            "revised_by": r.revised_by,
+            "revision_reason": r.revision_reason,
+            "withdrawn": bool(r.withdrawn),
+        }
+        for r in rows
+    ]
diff --git a/app/services/scene_result_service.py b/app/services/scene_result_service.py
new file mode 100644
index 0000000..969337a
--- /dev/null
+++ b/app/services/scene_result_service.py
@@ -0,0 +1,473 @@
+"""场景结果仓储（专项 rosbag-catalog-integration TASK-06A，DESIGN §4/§6/§7.1/§8.1）。
+
+06A 职责边界（与 06B 的分工）：
+- 本模块：manifest 批次幂等登记（run+slice_key 唯一约束防重复）、分析版本当前/历史
+  指针、区间与标签证据落库、子包 PENDING 登记、换版原语（较旧提交不得倒退）。
+- 06B：正式回报 API 的身份校验（租约/源代次/执行类型）、staging 文件校验与原子
+  发布、availability PENDING→AVAILABLE 切换、complete-scene 路由。
+- 本模块不接真实执行回报入口、不宣称发布成功（DESIGN §11.2/§11.3）。
+
+幂等模型：
+- 同 (parent_bag_uid, scene_code, run_id) + 相同内容身份（manifest digest 前 16 位）
+  → 幂等回放，补齐缺失区间/派生行（200 语义，不重复写）。
+- 同 run_id 但内容身份不同 → 409 DUPLICATE_CONFLICT（重试必须复用稳定 slice_key
+  与原内容，显式重新分析必须新 run/新版本，DESIGN §6 规则 1）。
+- 子包 bag_record 行按 bag_uid 唯一复用；父包不存在或角色非 ORIGINAL → 409（不猜测）。
+- 幂等写路径全部为 check-then-act + IntegrityError 兜底（06A attempt-2 返修 #3）：
+  并发同 run 重试在唯一键（uq_scene_analysis_parent_scene_version /
+  uq_bag_derivation_run_slice / child_bag_uid）冲突时回滚嵌套事务后重查——
+  已是目标态 → 200 语义重放，内容身份不一致 → 409，其他冲突 → 409 冲突描述，
+  不裸 500（遵守模块错误码契约）。
+
+段数口径（attempt-2 返修 #2，契约选择，06B 完整性门禁按此实现）：
+- expected_segment_count = manifest 全部区间数（含 flat 等非发布）。
+- registered_segment_count = 该版本 scene_segment 表实际已登记行数（重放补齐
+  后重算刷新，不存过期值）。
+- 两值同基数：06B PENDING→AVAILABLE 门禁应做 expected == registered 等值比较
+  （全部区间落库即完整；publishable 子集另由 list_segments(publish_only=True)
+  与 expected_slice_keys 核对）。选"全部"而非"可发布"的理由：flat 区间同样是
+  manifest 声明的落库义务（DESIGN §4.1），只按可发布计数会让"含 flat 的 manifest
+  永不相等"成为 409 或让门禁漏检 flat 区间缺失。
+
+时间：数据库纳秒 BIGINT；API 序列化为十进制字符串（由查询层负责）。
+"""
+
+from __future__ import annotations
+
+from fastapi import HTTPException
+from sqlalchemy import func, select, update
+from sqlalchemy.exc import IntegrityError
+from sqlalchemy.orm import Session
+
+from app.models import (
+    BagDerivation,
+    BagRecord,
+    BagSceneLabelEvidence,
+    Scene,
+    SceneAnalysisVersion,
+    SceneSegment,
+)
+from app.scene.types import MAX_SEGMENTS_PER_BATCH, SceneManifest, SceneOutcome
+
+# 场景结果登记错误码（06B 路由映射：NOT_FOUND→404，*CONFLICT/PARENT_*→409，*INVALID→422）
+RESULT_NOT_FOUND = "RESULT_NOT_FOUND"
+DUPLICATE_CONFLICT = "DUPLICATE_CONFLICT"
+PARENT_NOT_READY = "PARENT_NOT_READY"
+MANIFEST_INVALID = "MANIFEST_INVALID"
+LIMIT_EXCEEDED = "LIMIT_EXCEEDED"
+
+
+def _err(code: str, detail: str, http: int) -> HTTPException:
+    return HTTPException(http, detail=f"{code}: {detail}")
+
+
+def _segment_row(db: Session, av: SceneAnalysisVersion, seg) -> SceneSegment:
+    """按 (analysis_version_id, slice_key) 复用区间行；同 slice_key 不同内容 → 冲突。
+
+    注：scene_segment 无 (analysis_version_id, slice_key) 唯一约束（06A 零新迁移），
+    并发重复登记窗口由 av 级 uq_scene_analysis_parent_scene_version 兜底——同一
+    分析版本并发插入时一方必然 409/重放，不会双写区间行。
+    """
+    row = db.scalar(
+        select(SceneSegment).where(SceneSegment.analysis_version_id == av.id, SceneSegment.slice_key == seg.slice_key)
+    )
+    if row is not None:
+        if (row.label, row.start_ns, row.end_ns) != (seg.label, seg.start_ns, seg.end_ns):
+            raise _err(
+                DUPLICATE_CONFLICT,
+                f"slice_key {seg.slice_key} 已登记为 [{row.start_ns},{row.end_ns}]，与本次冲突",
+                409,
+            )
+        row.publish_target = seg.publish_target
+        row.duration_ns = seg.duration_ns
+        return row
+    row = SceneSegment(
+        analysis_version_id=av.id,
+        label=seg.label,
+        start_ns=seg.start_ns,
+        end_ns=seg.end_ns,
+        duration_ns=seg.duration_ns,
+        publish_target=seg.publish_target,
+        boundary_mapping_note=(seg.mapping_basis or None) and seg.mapping_basis[:512],
+        boundary_evidence_artifact_id=seg.evidence_ref and seg.evidence_ref[:64],
+        slice_key=seg.slice_key,
+    )
+    db.add(row)
+    db.flush()
+    return row
+
+
+def _scene_row(db: Session, name: str) -> Scene:
+    """按 name 复用场景行；flush IntegrityError 兜底（attempt-2 #3）：重查取既有行，不裸 500。"""
+    row = db.scalar(select(Scene).where(Scene.name == name))
+    if row is None:
+        try:
+            with db.begin_nested():
+                row = Scene(name=name[:64])
+                db.add(row)
+                db.flush()
+        except IntegrityError:
+            # 并发同场景创建撞 scene.name 唯一键 → 回滚嵌套事务后重查既有行。
+            db.expire_all()
+            row = db.scalar(select(Scene).where(Scene.name == name))
+            if row is None:
+                raise  # 非 name 唯一键冲突（不应发生）→ 交外层并留痕
+    return row
+
+
+def _validate_manifest_shape(manifest: SceneManifest) -> None:
+    if len(manifest.segments) > MAX_SEGMENTS_PER_BATCH:
+        raise _err(LIMIT_EXCEEDED, f"单批 {len(manifest.segments)} 区间超过上限 {MAX_SEGMENTS_PER_BATCH}", 422)
+    if not manifest.run_id or len(manifest.run_id) > 64:
+        raise _err(MANIFEST_INVALID, "run_id 缺失或超长", 422)
+    if not manifest.source_fingerprint:
+        raise _err(MANIFEST_INVALID, "source_fingerprint 缺失（06B 身份校验依赖）", 422)
+
+
+def _find_analysis_version(db: Session, manifest: SceneManifest) -> SceneAnalysisVersion | None:
+    return db.scalar(
+        select(SceneAnalysisVersion).where(
+            SceneAnalysisVersion.parent_bag_uid == manifest.source_id,
+            SceneAnalysisVersion.scene_code == manifest.scene_code,
+            SceneAnalysisVersion.run_id == manifest.run_id,
+        )
+    )
+
+
+def _find_evidence(db: Session, bag_uid: str, scene_id: int, evidence_ref: str) -> BagSceneLabelEvidence | None:
+    return db.scalar(
+        select(BagSceneLabelEvidence).where(
+            BagSceneLabelEvidence.bag_uid == bag_uid,
+            BagSceneLabelEvidence.scene_id == scene_id,
+            BagSceneLabelEvidence.original_judgment_ref == evidence_ref,
+        )
+    )
+
+
+def _refresh_counts(db: Session, av: SceneAnalysisVersion, manifest: SceneManifest) -> None:
+    """重放/并发兜底后刷新段数（attempt-2 #2：补齐**完成后**调用，不存过期值）。
+
+    expected = manifest 全部区间数（含 flat）；registered = scene_segment 实际落库行数
+    （重查计数，与 docstring 契约一致）。两值同基数，06B 完整性门禁做等值比较。
+    """
+    av.expected_segment_count = len(manifest.segments)
+    n = db.scalar(select(func.count()).select_from(SceneSegment).where(SceneSegment.analysis_version_id == av.id))
+    av.registered_segment_count = n or 0
+
+
+def _backfill_segments(db: Session, av: SceneAnalysisVersion, manifest: SceneManifest) -> None:
+    """部分重放：按 slice_key 补齐缺失区间；内容冲突 → 409（_segment_row 语义）。"""
+    existing = set(db.scalars(select(SceneSegment.slice_key).where(SceneSegment.analysis_version_id == av.id)).all())
+    for seg in manifest.segments:
+        if seg.slice_key not in existing:
+            _segment_row(db, av, seg)
+
+
+def register_manifest(
+    db: Session, manifest: SceneManifest, *, expected_child_uids: dict[str, str] | None = None
+) -> dict:
+    """批次幂等登记一份场景 manifest（06B 在身份校验后调用本函数）。
+
+    expected_child_uids: slice_key → 子包 bag_uid（manifest 的 expected_slice_keys 对应）。
+    目标切片缺少子包身份映射时拒绝（不猜测 UID），非发布区间不需要。
+
+    返回 {analysis_version_id, run_id, registered_segments, derived_children, replayed}。
+    不提交事务（由调用方与身份校验同事务）。
+    """
+    _validate_manifest_shape(manifest)
+    digest = manifest.digest()
+    content_identity = digest[:16]
+
+    parent = db.scalar(select(BagRecord).where(BagRecord.bag_uid == manifest.source_id))
+    if parent is None or parent.bag_role != "ORIGINAL":
+        raise _err(PARENT_NOT_READY, f"父包 {manifest.source_id} 不存在或角色非 ORIGINAL", 409)
+
+    scene = _scene_row(db, manifest.scene_code)
+
+    # 幂等判定：同 (parent, scene, run_id) 视为同一 run 的批次重放。
+    # 并发同 run 重试：check-then-act 间隙两事务都可能查到 av 为空，第二个 insert 撞
+    # uq_scene_analysis_parent_scene_version → IntegrityError 兜底重查（attempt-2 #3）：
+    # 内容身份一致 → 200 语义重放；不同 → 409。
+    av = _find_analysis_version(db, manifest)
+    if av is not None:
+        if av.analysis_version != content_identity:
+            raise _err(
+                DUPLICATE_CONFLICT,
+                f"run {manifest.run_id} 已登记内容身份 {av.analysis_version}，本次 {content_identity} 不同",
+                409,
+            )
+        replayed = True
+        _backfill_segments(db, av, manifest)
+        _refresh_counts(db, av, manifest)
+    else:
+        replayed = False
+        av = SceneAnalysisVersion(
+            parent_bag_uid=manifest.source_id,
+            scene_code=manifest.scene_code,
+            # 分析版本身份 = digest 前 16 位：同 manifest 幂等，不同 manifest 不同版本。
+            analysis_version=content_identity,
+            run_id=manifest.run_id,
+            capability_version=manifest.capability_version,
+            config_hash=manifest.config_hash,
+            result=manifest.outcome,
+            # 口径统一（attempt-2 #2）：expected = manifest 全部区间数（含 flat），
+            # 与 registered 同基数；06B 完整性门禁做 expected == registered 等值比较。
+            expected_segment_count=len(manifest.segments),
+            registered_segment_count=len(manifest.segments),
+            current=False,  # 当前指针由 switch_current 在完整性校验后切换（06B）
+        )
+        try:
+            with db.begin_nested():
+                db.add(av)
+                db.flush()
+        except IntegrityError:
+            db.expire_all()
+            av = _find_analysis_version(db, manifest)
+            if av is None:
+                raise  # 非本 run 唯一键冲突（不应发生）→ 交外层 5xx 并留痕
+            if av.analysis_version != content_identity:
+                raise _err(
+                    DUPLICATE_CONFLICT,
+                    f"run {manifest.run_id} 已登记内容身份 {av.analysis_version}，本次 {content_identity} 不同",
+                    409,
+                )
+            replayed = True
+        if replayed:
+            _backfill_segments(db, av, manifest)
+        else:
+            for seg in manifest.segments:
+                _segment_row(db, av, seg)
+        # 段数在补齐/首登记完成后统一重查刷新（attempt-2 #2，不存过期值）。
+        _refresh_counts(db, av, manifest)
+
+    # 标签证据：bag_scene 是有效标签投影；MODEL 来源记录保留原始判定引用。
+    # 并发重放下 evidence 插入撞唯一键（若存在）时 IntegrityError 兜底重查（attempt-2 #3）。
+    evidence_ref = f"{manifest.run_id}#{content_identity}"
+    ev = _find_evidence(db, manifest.source_id, scene.id, evidence_ref)
+    if ev is None:
+        try:
+            with db.begin_nested():
+                db.add(
+                    BagSceneLabelEvidence(
+                        bag_uid=manifest.source_id,
+                        scene_id=scene.id,
+                        label_source="MODEL",
+                        analysis_version_id=av.id,
+                        original_judgment_ref=evidence_ref,
+                        withdrawn=False,
+                    )
+                )
+                db.flush()
+        except IntegrityError:
+            db.expire_all()
+            if _find_evidence(db, manifest.source_id, scene.id, evidence_ref) is None:
+                raise
+    else:
+        # 重放：证据行的 analysis_version_id 指向重放方版本（幂等对齐）
+        ev.analysis_version_id = av.id
+
+    # 子包登记：publish_target 区间 → bag_record(SCENE_SLICE, PENDING) + bag_derivation。
+    derived = 0
+    for seg in manifest.segments:
+        if not seg.publish_target:
+            continue
+        child_uid = (expected_child_uids or {}).get(seg.slice_key)
+        if not child_uid:
+            raise _err(MANIFEST_INVALID, f"目标区间 {seg.slice_key} 缺少子包身份映射", 422)
+        derived += _register_derivation(db, manifest, av, seg, child_uid, parent)
+
+    return {
+        "analysis_version_id": av.id,
+        "run_id": manifest.run_id,
+        "registered_segments": len(manifest.segments),
+        "derived_children": derived,
+        "replayed": replayed,
+    }
+
+
+def _register_derivation(
+    db: Session,
+    manifest: SceneManifest,
+    av: SceneAnalysisVersion,
+    seg,
+    child_uid: str,
+    parent: BagRecord,
+) -> int:
+    """子包 PENDING 登记 + 派生血缘（run+slice_key 唯一防重复；父子 FK RESTRICT 兜底）。
+
+    并发兜底（attempt-2 #3）：bag_record/derivation 的 check-then-act 间隙，另一方
+    可能已插入同 (run, slice) 或同 child_bag_uid 行 → IntegrityError 时回滚嵌套
+    事务重查：run+slice 已绑本子包 → 重放（0），绑其他子包 → 409，否则 → 409 冲突。
+    """
+    existing = db.scalar(select(BagDerivation).where(BagDerivation.child_bag_uid == child_uid))
+    if existing is not None:
+        # 重放：核对一致性；run+slice_key 已被不同子包占用 → 409。
+        dup = db.scalar(
+            select(BagDerivation).where(
+                BagDerivation.run_id == manifest.run_id, BagDerivation.slice_key == seg.slice_key
+            )
+        )
+        if dup is not None and dup.child_bag_uid != child_uid:
+            raise _err(
+                DUPLICATE_CONFLICT,
+                f"run+slice_key {manifest.run_id}#{seg.slice_key} 已绑定子包 {dup.child_bag_uid}",
+                409,
+            )
+        return 0
+    segment_row = db.scalar(
+        select(SceneSegment).where(SceneSegment.analysis_version_id == av.id, SceneSegment.slice_key == seg.slice_key)
+    )
+    if segment_row is None:
+        raise _err(MANIFEST_INVALID, f"目标区间 {seg.slice_key} 未落库（不应发生）", 422)
+    try:
+        with db.begin_nested():
+            if db.scalar(select(BagRecord).where(BagRecord.bag_uid == child_uid)) is None:
+                db.add(
+                    BagRecord(
+                        bag_uid=child_uid[:26],
+                        name=f"{parent.name}-{seg.label}-{seg.start_ns}-{seg.end_ns}"[:255],
+                        relative_path=f"scene/{manifest.scene_code}/{parent.bag_uid}/{child_uid[:26]}"[:1024],
+                        bag_role="SCENE_SLICE",
+                        availability="PENDING",  # 06B 校验+发布后切 AVAILABLE
+                        dataset_type="self_built",
+                        duration_ns=seg.duration_ns,
+                        source_generation=manifest.source_generation,
+                        # 父子同指纹不回避：子包继承源指纹（DESIGN §4.1），
+                        # 隔离由 bag_role/血缘承载，register 防归并检查任一 SCENE_SLICE 命中即 409。
+                        fast_fingerprint=parent.fast_fingerprint,
+                    )
+                )
+                db.flush()
+            db.add(
+                BagDerivation(
+                    parent_bag_uid=parent.bag_uid,
+                    child_bag_uid=child_uid[:26],
+                    run_id=manifest.run_id[:64],
+                    slice_key=seg.slice_key[:64],
+                    scene_code=manifest.scene_code[:32],
+                    analysis_version_id=av.id,
+                    segment_id=segment_row.id,
+                    start_ns=seg.start_ns,
+                    end_ns=seg.end_ns,
+                    duration_ns=seg.duration_ns,
+                    config_hash=manifest.config_hash,
+                    source_fingerprint=manifest.source_fingerprint[:128],
+                    source_generation=manifest.source_generation,
+                )
+            )
+            db.flush()
+    except IntegrityError:
+        db.expire_all()
+        dup = db.scalar(
+            select(BagDerivation).where(
+                BagDerivation.run_id == manifest.run_id, BagDerivation.slice_key == seg.slice_key
+            )
+        )
+        if dup is None or dup.child_bag_uid != child_uid:
+            raise _err(
+                DUPLICATE_CONFLICT,
+                f"并发登记冲突：run+slice {manifest.run_id}#{seg.slice_key} "
+                f"已被 {dup.child_bag_uid if dup else '其他'} 占用",
+                409,
+            )
+        return 0  # 并发同内容重试：重放
+    return 1
+
+
+def switch_current(db: Session, *, parent_bag_uid: str, scene_code: str, analysis_version_id: int, result: str) -> None:
+    """父包+场景锁下原子切换当前版本指针（DESIGN §6 规则 5/7）。
+
+    - 仅 SUCCESS / NO_MATCH 可切当前（NOT_APPLICABLE 不替换既有当前结果，FAILED 旧结果不替换）。
+    - 较旧提交（created_at/id 序早于当前 current 行）晚完成不得倒退：拒绝 409。
+    - 已是当前 → no-op 幂等。
+
+    指针唯一性（attempt-2 #4）：DB 层**没有** (parent, scene) 级 current 唯一约束
+    （ix_scene_analysis_parent_scene_current 是普通索引；uq_scene_analysis_parent_scene_version
+    只防同版本重复登记，管不住 current 列）。不变式由两条 guarded UPDATE 承载：
+    - 清旧指针：`UPDATE ... SET current=0 WHERE current=1 AND parent=? AND scene=?
+      AND id=?`，rowcount==0 说明竞争方已抢先清掉 → 重读重判（有界 3 次）；
+    - 置新指针：`UPDATE ... SET current=1 WHERE id=? AND NOT EXISTS(同 parent+scene
+      其他 current 行)`，rowcount==0 说明他版本抢先成为当前 → 重读重判（同目标则
+      幂等重放）。两条均为单条原子 UPDATE，SQLite/MySQL 两后端通用，不依赖行锁
+      强度（SQLite WAL 并发下 FOR UPDATE 退化为 no-op 仍安全）。
+    """
+    if result not in (SceneOutcome.SUCCESS.value, SceneOutcome.NO_MATCH.value):
+        raise _err(MANIFEST_INVALID, f"结果 {result} 不得切换当前版本（仅 SUCCESS/NO_MATCH）", 422)
+    with db.begin_nested():
+        for attempt in (1, 2, 3):
+            # FOR UPDATE 锁父包+场景的当前行（MySQL 生产路径行锁生效；SQLite 退化为
+            # 无行锁，正确性不依赖它，见 docstring 的 guarded UPDATE 说明）。
+            current = db.execute(
+                select(SceneAnalysisVersion)
+                .where(
+                    SceneAnalysisVersion.parent_bag_uid == parent_bag_uid,
+                    SceneAnalysisVersion.scene_code == scene_code,
+                    SceneAnalysisVersion.current.is_(True),
+                )
+                .with_for_update()
