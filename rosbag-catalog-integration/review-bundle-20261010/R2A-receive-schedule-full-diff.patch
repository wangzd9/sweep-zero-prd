+def test_register_scene_only_no_phase0_run(db, monkey_source, monkeypatch):
+    """仅 scene_slice（用户提交）→ 不创建 Phase0 run，pipeline_run_id=None。"""
+    monkeypatch.setenv("SCENE_INGEST_ENABLED", "1")
+    pid = f"r3-{UNIQUE}-a"
+    _add_profile(db, pid, "fleetA")
+    rel = _bag_dir()
+    _create_submission(pid, rel, ["scene_slice"])
+    with TestClient(app) as client:
+        resp = _register(client, f"fp{UNIQUE}", f"{INCOMING_ROOT}/fleetA/{rel}")
+    assert resp.status_code == 200, resp.text
+    body = resp.json()
+    assert body["pipeline_run_id"] is None
+    assert body["ingest"]["scheduled_purposes"] == ["scene_slice"]
+    with SessionLocal() as s:
+        runs = list(s.scalars(select(PipelineRun).where(PipelineRun.source_id == body["source_id"])).all())
+        assert runs == []  # 任何类型 run 都不得创建
+        subs = s.scalars(select(IngestSubmission).where(IngestSubmission.source_id == body["source_id"])).all()
+        assert len(subs) == 1 and subs[0].status == "SCHEDULED"
+
