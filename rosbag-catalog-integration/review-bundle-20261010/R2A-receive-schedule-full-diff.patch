+def test_register_new_generation_reuses_generation_scoped_run(db, monkey_source, monkeypatch):
+    """代次推进（墓碑重登记）：新代次不匹配旧代次的 self_built run → 建新代次 run。"""
+    monkeypatch.setenv("SCENE_INGEST_ENABLED", "1")
+    pid = f"r3-{UNIQUE}-g"
+    _add_profile(db, pid, "fleetG", purposes=("self_built",), scenes=())
+    rel = _bag_dir()
+    incoming = f"{INCOMING_ROOT}/fleetG/{rel}"
+    with TestClient(app) as client:
+        first = _register(client, f"fp{UNIQUE}", incoming)
+    assert first.status_code == 200, first.text
+    source_id = first.json()["source_id"]
+    run1 = first.json()["pipeline_run_id"]
+    with SessionLocal() as s:
+        bag = s.scalar(select(BagRecord).where(BagRecord.bag_uid == source_id))
+        # 推进代次（模拟墓碑重登记：source_generation 2）
+        bag.source_generation = 2
+        # 该 bag 的绑定提交释放（模拟新一代重走绑定）
+        s.query(IngestSubmission).filter(IngestSubmission.source_id == source_id).delete()
+        s.commit()
+    with TestClient(app) as client:
+        second = _register(client, f"fp{UNIQUE}", incoming)
+    assert second.status_code == 200, second.text
+    run2 = second.json()["pipeline_run_id"]
+    assert run2 is not None and run2 != run1
+    with SessionLocal() as s:
+        new_run = s.scalar(select(PipelineRun).where(PipelineRun.pipeline_run_id == run2))
+        assert new_run.source_generation == 2
+
