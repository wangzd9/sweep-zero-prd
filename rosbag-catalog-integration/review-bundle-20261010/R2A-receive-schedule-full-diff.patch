+def test_scene_run_not_matched_as_self_built_on_recovery(db, monkey_source, monkeypatch):
+    """跨类型误配回归：既有 run 只有 SCENE_SLICE（05 消费产物）时，
+    恢复/重登记不得把它当成 self_built run 返回。"""
+    monkeypatch.setenv("SCENE_INGEST_ENABLED", "1")
+    pid = f"r3-{UNIQUE}-f"
+    _add_profile(db, pid, "fleetF", purposes=("self_built", "scene_slice"), scenes=("test-capability",))
+    rel = _bag_dir()
+    incoming = f"{INCOMING_ROOT}/fleetF/{rel}"
+    with TestClient(app) as client:
+        first = _register(client, f"fp{UNIQUE}", incoming)
+    assert first.status_code == 200, first.text
+    source_id = first.json()["source_id"]
+    with SessionLocal() as s:
+        # 模拟 05 消费：删掉 self_built run，只留一条 SCENE_SLICE run（代次冻结在快照，
+        # run 表 source_generation 列为 NULL 历史语义）
+        self_run = s.scalar(
+            select(PipelineRun).where(PipelineRun.source_id == source_id, PipelineRun.pipeline_type == "SELF_BUILT_BAG")
+        )
+        assert self_run is not None
+        s.delete(self_run)
+        s.add(
+            PipelineRun(
+                pipeline_run_id="scene-" + uuid.uuid4().hex[:28],
+                source_id=source_id,
+                queue_name="SCENE_SLICE_QUEUE",
+                status="SCENE_SLICE_QUEUE",
+                pipeline_type="SCENE_SLICE",
+            )
+        )
+        s.commit()
+    # 重登记（恢复）：不得回显 SCENE_SLICE run
+    with TestClient(app) as client:
+        second = _register(client, f"fp{UNIQUE}", incoming)
+    assert second.status_code == 200, second.text
+    assert second.json()["pipeline_run_id"] is None  # 恢复路径下无 self_built run → None
+    with SessionLocal() as s:
+        self_runs = list(
+            s.scalars(
+                select(PipelineRun).where(
+                    PipelineRun.source_id == source_id, PipelineRun.pipeline_type == "SELF_BUILT_BAG"
+                )
+            ).all()
+        )
+        assert self_runs == []  # 恢复登记不重复创建
+
