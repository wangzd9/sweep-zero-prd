+    sub_id = response["submission_id"]
+    sub = db.scalar(select(IngestSubmission).where(IngestSubmission.submission_id == sub_id))
+    before = json.loads(sub.frozen_capability_hashes_json)["test-capability"]["capability_config_hash"]
+    cap16 = registry.effective_params("test-capability", {"expect_frames": 16}, "test-v1")
