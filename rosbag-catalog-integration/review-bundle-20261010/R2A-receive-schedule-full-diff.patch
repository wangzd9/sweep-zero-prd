+def test_register_config_required_with_self_built_creates_run(db, monkey_source, monkeypatch):
+    """CONFIG_REQUIRED 且选择含 self_built → 仍建 Phase0 run（用途未冻结，按选择回显）。"""
+    monkeypatch.setenv("SCENE_INGEST_ENABLED", "1")
+    pid = f"r3-{UNIQUE}-c"
+    _add_profile(db, pid, "fleetC", scenes=("not-registered-scene",))
+    rel = _bag_dir()
+    _create_submission(pid, rel, ["self_built", "scene_slice"])
+    with TestClient(app) as client:
+        resp = _register(client, f"fp{UNIQUE}", f"{INCOMING_ROOT}/fleetC/{rel}")
+    assert resp.status_code == 200, resp.text
+    body = resp.json()
+    assert body["ingest"]["config_required"] is True
+    assert body["pipeline_run_id"] is not None
+    with SessionLocal() as s:
+        run = s.scalar(select(PipelineRun).where(PipelineRun.pipeline_run_id == body["pipeline_run_id"]))
+        assert run is not None and run.status == "PHASE0_QUEUE"
+        assert run.pipeline_type == "SELF_BUILT_BAG"
+        # 登记代次冻结（首登 generation=1）
+        assert run.source_generation == 1
+        # 不出 scene 事件（CONFIG_REQUIRED 停待处理）
+        subs = s.scalars(select(IngestSubmission).where(IngestSubmission.source_id == body["source_id"])).all()
+        events = s.scalars(
+            select(PurposeScheduleEvent).where(PurposeScheduleEvent.submission_id.in_([x.submission_id for x in subs]))
+        ).all()
+        assert events == []
