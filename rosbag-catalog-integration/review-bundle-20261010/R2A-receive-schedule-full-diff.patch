+def test_patch_success_refreezes_hash(db, monkeypatch):
+    """PATCH 成功 = 重新接受 → 冻结值按新参数刷新（事件携带最近一次接受时刻 hash）。"""
+    monkeypatch.setenv("SCENE_INGEST_ENABLED", "1")
+    from app.scene.registry import get_registry
+
+    registry = get_registry()
+    pid = f"fz4-{UNIQUE}-e"
+    _add_profile(db, pid, "fleetE")
