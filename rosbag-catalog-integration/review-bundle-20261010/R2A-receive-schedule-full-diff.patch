+def test_dropped_event_atomically_leaves_pending_outbox():
+    """强模型 #5：永久无效事件必须落 outbox DROPPED 终态+原因，不占 PENDING 头部。"""
+    with SessionLocal() as db:
+        bag = _make_ready_bag(db, "drop5")
+        uid = bag.bag_uid
+        try:
+            row = _outbox_row(db, bag, purpose="weird_purpose", scene_code=None)
+            stats = scene_schedule_consumer.consume_purpose_events(db, [_event_from_outbox(row)])
+            db.commit()
+            assert stats["dropped"] == 1
+            from app.models import PurposeScheduleEvent
+
+            # 消费器用原始 SQL 更新 outbox 状态（绕过 ORM identity map），
+            # expire 后重查才能看到真实落库值
+            db.expire_all()
+            refreshed = db.scalar(select(PurposeScheduleEvent).where(PurposeScheduleEvent.event_id == row.event_id))
+            assert refreshed.status == "DROPPED"  # 原子离开 PENDING
+            assert refreshed.error_reason and "CONTRACT_VIOLATION" in refreshed.error_reason
+            # PENDING 头部不再被坏事件占据
+            assert scene_schedule_consumer.poll_outbox_events(db) == []
+        finally:
+            _purge(db, [uid])
