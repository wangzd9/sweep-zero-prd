+def _outbox_row(db, bag, **overrides):
+    """直插一条 PENDING outbox 行（测试者侧替身，走真实表结构）。"""
+    from app.models import PurposeScheduleEvent
+
+    row = PurposeScheduleEvent(
+        event_id="ob-" + uuid.uuid4().hex[:12],
+        submission_id="sub-" + uuid.uuid4().hex[:8],
+        source_id=bag.bag_uid,
+        source_generation=bag.source_generation,
+        parent_bag_uid=bag.bag_uid,
+        purpose="scene_slice",
+        scene_code="slope",
+        capability_version="slope-v1",
+        capability_config_hash="ob-cap-" + uuid.uuid4().hex[:8],
+        effective_config_hash=None,
+        profile_id="scene-incoming",
+        profile_version=1,
+        status="PENDING",
+    )
+    for key, value in overrides.items():
+        setattr(row, key, value)
+    db.add(row)
+    db.commit()
+    db.refresh(row)
+    return row
+
