+"""TASK-03B attempt-4（强模型 #4）：接受时冻结单能力 hash，bind 只读不重算。
+
+协调者裁决（purpose-schedule-event/v1，两端同一策略）：
+- 能力 hash 在 submission 接受（create/PATCH 成功）时按当时 registry 计算并
+  持久化到 ingest_submission.frozen_capability_hashes_json；
+- bind（source_service 登记完成）只读冻结值，不得重新从当前 registry 计算；
+  registry 此后漂移 → 事件仍带接受时刻的 hash（05 消费端 SCENE_UNAVAILABLE
+  失败运行留痕）；
+- CONFIG_REQUIRED（接受时能力未解析）不出 scene 事件；
+- 任何 scene 事件都必须带有效冻结 hash，禁止 NULL-hash 事件流出本服务。
+
+测试驱动 ingest_service 层（SQLite 纯单测，registry 漂移用 monkeypatch 模拟）。
+"""
+
+import json
+import uuid
+
+import pytest
+from sqlalchemy import select
+
+from app.database import Base, SessionLocal, engine
+from app.domain.scene_config import IngestPurpose, SceneSelection, SubmissionSelection
+from app.models import ApiIdempotency, IngestProfile, IngestSubmission, PurposeScheduleEvent
+from app.services import ingest_service
+
+UNIQUE = uuid.uuid4().hex[:10]
+INCOMING_ROOT = "/test/incoming"
+READY_ROOT = "/test/ready"
+
+
+@pytest.fixture()
+def db():
+    Base.metadata.create_all(engine)
+    with SessionLocal() as session:
+        ingest_service.seed_default_profile(session, "default")
+        session.commit()
+        yield session
+        session.rollback()
+        session.query(PurposeScheduleEvent).filter(
+            PurposeScheduleEvent.submission_id.in_(
+                select(IngestSubmission.submission_id).where(IngestSubmission.profile_id.like(f"fz4-{UNIQUE}%"))
+            )
+        ).delete(synchronize_session=False)
+        session.query(IngestSubmission).filter(IngestSubmission.profile_id.like(f"fz4-{UNIQUE}%")).delete(
+            synchronize_session=False
+        )
+        session.query(IngestProfile).filter(IngestProfile.profile_id.like(f"fz4-{UNIQUE}%")).delete(
+            synchronize_session=False
+        )
+        session.query(ApiIdempotency).filter(ApiIdempotency.idempotency_key.like(f"fzkey-{UNIQUE}%")).delete(
+            synchronize_session=False
+        )
+        session.commit()
+
+
+def _add_profile(db, profile_id, prefix, purposes=("scene_slice",), scenes=("test-capability",)):
+    row = IngestProfile(
+        profile_id=profile_id,
+        version=1,
+        display_name=profile_id,
+        incoming_prefix=prefix,
+        default_purposes_json=json.dumps(list(purposes)),
+        default_scenes_json=json.dumps(list(scenes)),
+        default_scene_parameters_json=json.dumps({}),
+        enabled=True,
+    )
+    db.add(row)
+    db.commit()
+    return row
+
+
+def _bag_uid():
+    return "0" + ((f"fz4-{UNIQUE}".upper().replace("-", "X") + "0" * 20)[:25])
+
+
+def _selection(relative_path, purposes=None, scenes=None):
+    return SubmissionSelection(
+        purposes=[IngestPurpose(p) for p in purposes] if purposes is not None else None,
+        scenes=[SceneSelection(**s) for s in scenes] if scenes is not None else None,
+        relative_path=relative_path,
+    )
+
+
+def _create_scene_submission(db, pid, path, expect_frames=8):
+    selection = _selection(
+        path,
+        ["scene_slice"],
+        [
+            {
+                "scene_code": "test-capability",
+                "capability_version": "test-v1",
+                "parameters": {"expect_frames": expect_frames},
+            }
+        ],
+    )
+    response, status = ingest_service.create_submission(db, pid, path, selection, None)
+    assert status == 201
+    return response
+
+
+def _bind(db, bag_uid, incoming_path):
+    return ingest_service.bind_ingest_for_registration(
+        db, bag_uid, f"{READY_ROOT}/fz4-{UNIQUE}-{bag_uid}", incoming_path, 1
+    )
+
+
+def test_accept_freezes_capability_hash(db):
+    """create（接受）时冻结值 = 当时 registry 的 04A 单能力 hash。"""
+    from app.scene.registry import get_registry
+
+    pid = f"fz4-{UNIQUE}-a"
+    _add_profile(db, pid, "fleetA")
+    response = _create_scene_submission(db, pid, "bagA")
+    sub = db.scalar(select(IngestSubmission).where(IngestSubmission.submission_id == response["submission_id"]))
+    frozen = json.loads(sub.frozen_capability_hashes_json)
+    assert set(frozen) == {"test-capability"}
+    entry = frozen["test-capability"]
+    assert entry["capability_version"] == "test-v1"
+    cap = get_registry().effective_params("test-capability", {"expect_frames": 8}, "test-v1")
+    assert entry["capability_config_hash"] == cap.config_hash
+
+
+def test_bind_uses_frozen_hash_not_recomputed(db, monkeypatch):
+    """接受后 registry 漂移 → bind 事件仍携带接受时刻的 hash（不重算、不置 NULL）。"""
+    monkeypatch.setenv("SCENE_INGEST_ENABLED", "1")
+    from app.scene.registry import get_registry
+
+    registry = get_registry()
+    real_effective = registry.effective_params
+    original = real_effective("test-capability", {"expect_frames": 8}, "test-v1")
+
+    pid = f"fz4-{UNIQUE}-b"
+    _add_profile(db, pid, "fleetB")
+    response = _create_scene_submission(db, pid, "bagB")
+
+    def drifted(scene_code, params, version=None):
+        if scene_code == "test-capability" and params.get("expect_frames") == 8:
+            # 模拟 registry 漂移：同参数算出不同 hash（如默认参数集变更）
+            class _Cap:
+                config_hash = original.config_hash + "drifted"
+                parameters = dict(params)
+
+            return _Cap()
+        return real_effective(scene_code, params, version)
+
+    monkeypatch.setattr(registry, "effective_params", drifted)
+    result = _bind(db, _bag_uid(), f"{INCOMING_ROOT}/fleetB/bagB")
+    assert result["scheduled_purposes"] == ["scene_slice"]
+    db.commit()
+    events = list(
+        db.scalars(
+            select(PurposeScheduleEvent).where(PurposeScheduleEvent.submission_id == response["submission_id"])
+        ).all()
+    )
+    assert len(events) == 1
+    assert events[0].capability_config_hash == original.config_hash  # 冻结值，非漂移值
+    assert events[0].capability_version == "test-v1"
+
+
+def test_config_required_accept_freezes_empty_and_bind_emits_no_scene_event(db, monkeypatch):
+    """CONFIG_REQUIRED（接受时能力未解析）：冻结值恒 {}，bind 停 BOUND 不出事件。"""
+    monkeypatch.setenv("SCENE_INGEST_ENABLED", "1")
