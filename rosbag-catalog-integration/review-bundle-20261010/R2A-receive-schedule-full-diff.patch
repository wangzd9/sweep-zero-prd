@@ -0,0 +1,77 @@
+"""03B 强模型返修：登记代次冻结 + 接受时能力 hash 冻结列（#3/#4）
+
+- pipeline_run.source_generation（Integer, nullable, index）：self_built run
+  登记时冻结的源代次。历史行不回填（恒 NULL）——恢复登记查询保留
+  "pipeline_type=SELF_BUILT_BAG AND source_generation IS NULL" 兜底分支，
+  旧 run 语义不变。
+- ingest_submission.frozen_capability_hashes_json（Text, nullable）：接受/PATCH
+  时刻持久化的 04A 单能力 hash 集合（{"scene_code":
+  {"capability_version": str, "capability_config_hash": str}}）。bind 只读
+  冻结值不再从当前 registry 重算；存量行回填 '{}'（接受时未冻结的历史提交若
+  走到 bind 的 scene_slice 事件路径会被应用层显式失败拦截，不放 NULL-hash 事件）。
+
+⚠️ 逐对象 gate（与 20261009_01 同模式）：迁移链起点 20260911_01 从空库
+upgrade 时会按**当前** model `Base.metadata.create_all(checkfirst=True)`，
+上述两列在空库上已随 create_all 落库 → 无 gate 的 add_column 在空库重放
+报 "duplicate column name"（隔离库 upgrade head 实测）。部署中的真实 DB
+（20260911_01 建表时 model 尚无此列）则无此列 → gate 放行。故每个对象
+先 inspect 再操作，部分应用重入安全。
+
+down_revision = "20261009_01_scene_identity_key"（05 attempt-2 迁移）——
+本迁移必须排在 05 链之后；与 05 零文件冲突（05 只加 scene_identity_key/
+error_reason 两列），合并顺序由协调者按 BASELINE 裁决。
+
+⚠️ downgrade→upgrade 往返风险（202610-10 OCR B5b low，仅文档化，不改列结构）：
+backfill 只在 upgrade 把 NULL 置 '{}'、未加门控。生产库 upgrade 后若已有新
+提交写入真实冻结 hash，再 downgrade（drop 列）→ upgrade（add 列全 NULL +
+backfill 无条件置 '{}'），这些行的冻结值被静默覆写为 '{}'，其后续 bind 命中
+"冻结缺失"显式 raise → 登记 500 + Scanner 重试同一 bag。drop 列丢数据是
+downgrade 固有的、gate 挡不住（与 20261009_01 drop-数据列口径一致）；运维
+处置=对受影响的 PENDING_INPUT 提交重新 PATCH 以恢复接受时刻冻结值。
+"""
+
+import sqlalchemy as sa
+
+from alembic import op
+
+revision = "20261009_02_ingest_frozen_columns"
+down_revision = "20261009_01_scene_identity_key"
+branch_labels = None
+depends_on = None
+
+
+def _pipeline_run_cols() -> set[str]:
+    return {c["name"] for c in sa.inspect(op.get_bind()).get_columns("pipeline_run")}
+
+
+def _submission_cols() -> set[str]:
+    return {c["name"] for c in sa.inspect(op.get_bind()).get_columns("ingest_submission")}
+
+
+def _pipeline_run_indexes() -> set[str]:
+    return {ix["name"] for ix in sa.inspect(op.get_bind()).get_indexes("pipeline_run")}
+
+
+def upgrade() -> None:
+    if "source_generation" not in _pipeline_run_cols():
+        op.add_column("pipeline_run", sa.Column("source_generation", sa.Integer(), nullable=True))
+    if "ix_pipeline_run_source_generation" not in _pipeline_run_indexes():
+        op.create_index("ix_pipeline_run_source_generation", "pipeline_run", ["source_generation"], unique=False)
+    if "frozen_capability_hashes_json" not in _submission_cols():
+        op.add_column("ingest_submission", sa.Column("frozen_capability_hashes_json", sa.Text(), nullable=True))
+    # 存量行回填 '{}'（幂等：重跑仍全部置 '{}'——接受时冻结未发生的历史行语义不变）
+    op.execute(
+        sa.text(
+            "UPDATE ingest_submission SET frozen_capability_hashes_json = '{}' "
+            "WHERE frozen_capability_hashes_json IS NULL"
+        )
+    )
+
+
+def downgrade() -> None:
+    if "frozen_capability_hashes_json" in _submission_cols():
+        op.drop_column("ingest_submission", "frozen_capability_hashes_json")
+    if "ix_pipeline_run_source_generation" in _pipeline_run_indexes():
+        op.drop_index("ix_pipeline_run_source_generation", table_name="pipeline_run")
+    if "source_generation" in _pipeline_run_cols():
+        op.drop_column("pipeline_run", "source_generation")
