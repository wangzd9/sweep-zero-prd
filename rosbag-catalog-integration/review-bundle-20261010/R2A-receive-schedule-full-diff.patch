+            ]
+        },
+        None,
+    )
+    assert updated["row_version"] == 2
+    db.expire_all()
+    sub = db.scalar(select(IngestSubmission).where(IngestSubmission.submission_id == sub_id))
+    after = json.loads(sub.frozen_capability_hashes_json)["test-capability"]
+    assert after["capability_config_hash"] == cap16.config_hash
+
+    result = _bind(db, _bag_uid(), f"{INCOMING_ROOT}/fleetE/bagE")
+    assert result["scheduled_purposes"] == ["scene_slice"]
+    db.commit()
+    events = list(db.scalars(select(PurposeScheduleEvent).where(PurposeScheduleEvent.submission_id == sub_id)).all())
+    assert events[0].capability_config_hash == cap16.config_hash
