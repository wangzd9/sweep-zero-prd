-     body = await request.json()
+         body = await request.json()
+     except Exception as exc:
+         raise HTTPException(422, "invalid JSON body") from exc
+     if not isinstance(body, dict):
+         raise HTTPException(422, "request body must be a JSON object")
+     return body
+ 
