+# 6. 元数据/车辆绑定消费 12S-A source_metadata（代理侧 fail-closed，不猜车）
+# ===========================================================================
+class TestProxyVehicleBindingConsumes12SA:
+    """12S-A 在提交面强制 source_metadata.vehicle_code（spray 入口 422 未调度）；父包车辆
+    绑定后传递。代理 resolve_spec 若 spray run 缺车辆 = 父绑定链断裂 → fail-closed 不执行
+    （不静默 unassigned）。slope 保持既有 lenient 口径（unassigned 兜底），旧坡道无回归。"""
+
+    def _cfg(self, tmp_path: Path) -> object:
+        from scene_host_proxy import ProxyConfig
+
+        (tmp_path / "pub").mkdir(exist_ok=True)
+        return ProxyConfig(
+            backend_url="http://unused", bind="127.0.0.1", port=0,
+            state_root=tmp_path / "state", work_root_base=tmp_path / "work",
+            publish_root=tmp_path / "pub", ready_root=str(tmp_path / "ready"),
+            min_free_bytes=0, cancel_poll_seconds=0.2, heartbeat_interval_seconds=0.2,
+            heartbeat_fail_budget=4, lease_ttl_seconds=120,
+        )
+
+    def _run_detail(self, run_id: str, scene_code: str, eff) -> dict:
+        return {
+            "pipeline_run_id": run_id, "pipeline_type": "SCENE_SLICE", "attempt": 1,
+            "source_id": "SRC1", "status": "SCENE_RUNNING",
+            "steps": [{"step_name": s, "attempt": 1, "status": "QUEUED"}
+                      for s in ("PRECHECK", "EXTRACT", "INFER", "SEGMENT", "WRITE",
+                                "VALIDATE", "PUBLISH", "REGISTER")],
+            "pipeline_config_snapshot": {
+                "schema_version": "scene-run/v1", "source_generation": 1,
+                "scenes": [{"scene_code": scene_code,
+                            "capability_version": eff.capability_version,
+                            "capability_config_hash": eff.config_hash}],
+            },
+        }
+
+    def _source_detail(self, vehicle_code: str | None) -> dict:
+        bag = {
+            "bag_uid": "SRC1", "relative_path": "source_bag", "source_generation": 1,
+            "fast_fingerprint": "f" * 64,
+        }
+        if vehicle_code is not None:
+            bag["vehicle"] = {"vehicle_code": vehicle_code}
+        else:
+            bag["vehicle"] = None
+        return {"source_id": "SRC1", "bag": bag,
+                "copies": [{"fingerprint": "f" * 64, "storage_type": "NAS",
+                            "path": "/ready/source_bag"}]}
+
+    def _fake_backend(self, run_detail: dict, source_detail: dict) -> object:
+        class _FB:
+            def run_detail(self, run_id):
+                return run_detail
+
+            def source_detail(self, source_id):
+                return source_detail
+
+        return _FB()
+
+    def _stage_spray_bags(self, tmp_path: Path) -> None:
+        """resolve_spec 要求 ready_root/relative_path 是目录（本机物理映射）。"""
+        from scene_host_proxy import resolve_spec  # noqa: F401  (确认导入面)
+
+        bag = build_pointcloud_bag(tmp_path / "bagbuild", ["normal"] * 2)
+        ready = tmp_path / "ready"
+        ready.mkdir(exist_ok=True)
+        dest = ready / "source_bag"
+        import shutil
+
+        if dest.exists():
+            shutil.rmtree(dest)
+        shutil.move(str(bag), str(dest))
+
+    def test_spray_missing_vehicle_fails_closed_no_guess(self, tmp_path, monkeypatch, spray_registry):
+        from scene_host_proxy import SpecError, resolve_spec
+
+        eff = spray_registry.effective_params("spray", None)
+        self._stage_spray_bags(tmp_path)
+        cfg = self._cfg(tmp_path)
+        fb = self._fake_backend(self._run_detail("scene-spray-1", "spray", eff), self._source_detail(None))
+        payload = {"pipeline_run_id": "scene-spray-1", "source_id": "SRC1", "attempt": 1,
+                   "lease_token": "tok-1"}
+        with pytest.raises(SpecError) as ei:
+            resolve_spec(cfg, fb, payload)
+        assert "spray" in str(ei.value) and "车辆" in str(ei.value)
+
+    def test_spray_with_vehicle_resolves_spec(self, tmp_path, monkeypatch, spray_registry):
+        from scene_host_proxy import resolve_spec
+
+        eff = spray_registry.effective_params("spray", None)
+        self._stage_spray_bags(tmp_path)
+        cfg = self._cfg(tmp_path)
+        fb = self._fake_backend(self._run_detail("scene-spray-2", "spray", eff), self._source_detail("spray-veh-01"))
+        payload = {"pipeline_run_id": "scene-spray-2", "source_id": "SRC1", "attempt": 1,
+                   "lease_token": "tok-1"}
+        spec, status = resolve_spec(cfg, fb, payload)
+        assert spec.scene_code == "spray"
+        assert spec.vehicle_key == "spray-veh-01", "父包车辆绑定应传递到 spec（A 消费面，非 unassigned）"
+        assert status == "SCENE_RUNNING"
+
+    def test_slope_missing_vehicle_still_lenient_no_regression(self, tmp_path, spray_registry):
+        """旧坡道：缺车辆保持 unassigned 兜底（lenient 口径），不因 spray fail-closed 收紧而回归。"""
