+# ===========================================================================
+# 5. 旧坡道 header 轴一包恢复回归（水雾 import 同进程，证明零回归）
+# ===========================================================================
+class TestOldSlopeHeaderAxisRecoveryRegression:
+    def test_slope_header_axis_crash_recovery_still_passes_with_spray_imported(self, tmp_path, monkeypatch):
+        """硬证据：装载水雾适配器（本单 import）后，旧坡道 header→存储轴 offset 推导 +
+        一包崩溃恢复重跑仍全链 SUCCESS 且不重复计费模型。本测试进程已 import
+        app.scene.spray（模块顶部经 scene_host_orchestrator），验证零回归。"""
+        import app.scene.spray  # noqa: F401  (确认已装载)
+        assert SPRAY_ADAPTER_KEY in __import__("app.scene.adapter", fromlist=["_ADAPTERS"])._ADAPTERS
+
+        reg = get_registry()
+        slope_eff = reg.effective_params("slope", None)
+        bag = make_source_bag(tmp_path, ["坡道"] * 30)
+
+        def slope_spec(tag, reporter):
+            return SceneExecSpec(
+                run_id=f"scene-slope-{tag}-001",
+                attempt=1,
+                source_id="SRC1",
+                source_generation=1,
+                source_fingerprint="a" * 64,
+                source_path=str(bag),
+                scene_code="slope",
+                capability_version=slope_eff.capability_version,
+                parameters=slope_eff.parameters,
+                config_hash=slope_eff.config_hash,
+                work_root=tmp_path / tag / "work",
+                publish_root=tmp_path / tag / "slices",
+                vehicle_key="veh1",
+                reporter=reporter,
+            )
+
+        server = FakeVlmServer(label_policy=lambda b: "坡道").start()
+        monkeypatch.setenv("SLOPE_VLM_ENDPOINT", server.endpoint)
+        spec1 = slope_spec("slope-rec", FakeReporter())
+        spec1.publish_root.mkdir(parents=True)
+        m1, _ = SceneHostOrchestrator(reg).run(spec1)
+        assert m1.outcome.value == SceneOutcome.SUCCESS.value
+        # header 轴 offset 推导真实存在（slope 帧带 header）→ 非 None
+        off1 = scene_publish_service.derive_storage_offset(m1, Path(spec1.source_path))
+        assert off1 is not None
+        first_req = server.stats()["requests"]
+        assert first_req > 0
+
+        # 恢复重跑（同 work/publish/identity）→ 不重复计费，同 manifest 身份
+        server2 = FakeVlmServer(label_policy=lambda b: "坡道").start()
+        monkeypatch.setenv("SLOPE_VLM_ENDPOINT", server2.endpoint)
+        spec2 = slope_spec("slope-rec", FakeReporter())
+        m2, steps2 = SceneHostOrchestrator(reg).run(spec2)
+        monkeypatch.delenv("SLOPE_VLM_ENDPOINT", raising=False)
+        server.stop()
+        server2.stop()
+        assert m2.outcome.value == SceneOutcome.SUCCESS.value
+        assert server2.stats()["requests"] == 0, "坡道恢复重跑不应再请求模型（旧 header 轴无回归）"
+        assert m1.digest() == m2.digest()
+        by_name = {s.name: s.status for s in steps2}
+        assert by_name["EXTRACT"] == "DONE" and by_name["REGISTER"] == "DONE"
+
