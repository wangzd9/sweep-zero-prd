+"""TASK-12S-C 水雾正式接线——模块级自测（9.6 卡清单）。
+
+前置口径（派单 attempt-1）：硬依赖 16B(40ab818)/12S-A(77c395b)/12S-B(f62a29c) 未全部
+接受合入 → 本测试做**模块级**验证（真实 dispatch→SprayAdapter（B 固定 SHA 产物）、
+真实 writer/publish（04B/06B 复用层）、PRECHECK 7 图 hash 受控预检、车辆绑定 fail-closed、
+offset=0 分支、旧坡道 header 轴一包恢复回归），**不做正式联调 PASS**（真链冒烟留接线核验单）。
+
+真实 VLM / 真实渲染不做：模型经确定性 DeterministicModel（B 面替身）、渲染经
+patch_render（open3d 处理机依赖本机缺失，不 mock 当真实渲染）。
+"""
+
+from __future__ import annotations
+
+import sys
+from dataclasses import replace
+from pathlib import Path
+
+import pytest
+
+ROOT = Path(__file__).resolve().parents[1]
+for _p in (ROOT, ROOT / "scripts", ROOT / "tests"):
+    if str(_p) not in sys.path:
+        sys.path.insert(0, str(_p))
+
+# 复用 12S-B 确定性替身（固定 SHA f62a29c 产物）
+from fake_vlm_server import FakeVlmServer  # noqa: E402
+from scene_fixture import make_source_bag  # noqa: E402
+
+# 复用 16B 编排 + 坡道夹具（旧坡道 header 轴回归）
+from scene_host_orchestrator import (  # noqa: E402
+    SceneExecError,
+    SceneExecSpec,
+    SceneHostOrchestrator,
+)
+from test_spray_adapter import (  # noqa: E402
+    DeterministicModel,
+    build_other_topics_bag,
+    build_pointcloud_bag,
+    patch_render,
+)
+
+from app.scene import CapabilityRegistry, get_registry  # noqa: E402
+from app.scene.adapter import _adapter_for  # noqa: E402
+from app.scene.spray import SPRAY_ADAPTER_KEY  # noqa: E402
+from app.scene.spray.adapter import SprayAdapter  # noqa: E402
+from app.scene.types import SceneOutcome  # noqa: E402
+from app.services import scene_publish_service  # noqa: E402
+
+
+# ---------------------------------------------------------------------------
+# 替身 / 受控注册表
+# ---------------------------------------------------------------------------
+class FakeReporter:
+    def __init__(self):
+        self.calls: list[tuple[str, dict]] = []
+
+    def report_results(self, **kw):
+        self.calls.append(("results", kw["child_bag_uids"]))
+        return {"ok": True}
+
+    def complete_scene(self, **kw):
+        self.calls.append(("complete", kw["child_bag_uids"]))
+        return {"ok": True}
+
+
+@pytest.fixture
+def spray_registry():
+    """把真实 config 里的 spray 能力翻成 enabled（dataclasses.replace，不新建能力描述）。
+
+    真实 config 起步 enabled=false（资产未核实，12S-B 口径）；模块级接线测试需验证
+    **dispatch 路由到 SprayAdapter** 这一 12S-C 消费面，故在受控测试注册表内启用。
+    不改变 param schema / output_labels / adapter_key（同一真实契约）。
+    """
+    reg = get_registry()
+    caps = list(reg.all())
+    out = []
+    for c in caps:
+        if c.scene_code == "spray":
+            out.append(replace(c, enabled=True, disabled_reason=None))
+        else:
+            out.append(c)
+    new_reg = CapabilityRegistry(tuple(out))
+    from app.scene import reset_registry
+
+    reset_registry(new_reg)
+    yield new_reg
+    reset_registry(reg)
+
+
+def _inject_spray_adapter(monkeypatch, model_client: DeterministicModel):
+    """dispatch 无 client 注入缝（_adapter_for 返回 cls()）→ 在 dispatch 边界注入
+    确定性模型客户端的 SprayAdapter，覆盖真实路由路径（adapter_key→SprayAdapter 类）。"""
+    import app.scene.adapter as A
+
+    def fake_adapter_for(capability):
+        if capability.adapter_key == SPRAY_ADAPTER_KEY:
+            return SprayAdapter(model_client=model_client)
+        return _adapter_for(capability)
+
+    monkeypatch.setattr(A, "_adapter_for", fake_adapter_for)
+
+
+def _spray_spec(tmp_path: Path, bag: Path, tag: str, reg: CapabilityRegistry, **over) -> SceneExecSpec:
+    eff = reg.effective_params("spray", None)
+    base = dict(
+        run_id=f"scene-spray-{tag}-001",
+        attempt=1,
+        source_id="SRC-SPRAY-001",
+        source_generation=1,
+        source_fingerprint="s" * 64,  # 夹具无 metadata → PRECHECK 代次核对如实跳过
+        source_path=str(bag),
+        scene_code="spray",
+        capability_version=eff.capability_version,
+        parameters=eff.parameters,
+        config_hash=eff.config_hash,
+        work_root=tmp_path / tag / "work",
+        publish_root=tmp_path / tag / "slices",
+        vehicle_key="spray-veh-01",
+        reporter=FakeReporter(),
+    )
+    base.update(over)
+    return SceneExecSpec(**base)
+
+
+@pytest.fixture
+def refs_and_render(monkeypatch):
+    # 7 图 hash 受控预检走真实清单：SPRAY_REFERENCE_DIR 指向已批准的 7 图受控目录
+    #（B 面 test_real_refs_7_of_7 已核验 hash/字节/顺序），PRECHECK 与 analyze 的
+    # verify_references 都经此真实校验（不 patch 掉预检产物，忠实消费 B 的 hash 门禁）。
+    from test_spray_adapter import REAL_REF_DIR
+
+    if not REAL_REF_DIR.is_dir() or len(list(REAL_REF_DIR.glob("*.jpg"))) < 7:
+        pytest.skip("7 图受控参考目录不可用（处理机/真实资产未就位）")
+    monkeypatch.setenv("SPRAY_REFERENCE_DIR", str(REAL_REF_DIR))
+    patch_render(monkeypatch)  # open3d 渲染本机缺失：确定性渲染替身（非真实渲染）
+
+
+# ===========================================================================
+# 1. 全链 SUCCESS：dispatch→SprayAdapter→writer→publish→register（B 固定 SHA 消费）
+# ===========================================================================
+class TestSprayFullChain:
+    def test_success_publishes_to_spray_slice_tree_and_registers(
+        self, tmp_path, monkeypatch, spray_registry, refs_and_render,
+    ):
+        _inject_spray_adapter(monkeypatch, DeterministicModel(spray_positions={0, 1, 2, 3}))
+        bag = build_pointcloud_bag(tmp_path, ["normal"] * 30)
+        spec = _spray_spec(tmp_path, bag, "succ", spray_registry)
+        spec.publish_root.mkdir(parents=True)
+        manifest, steps = SceneHostOrchestrator(spray_registry).run(spec)
+
+        assert manifest.outcome.value == SceneOutcome.SUCCESS.value
+        assert manifest.scene_code == "spray"
+        # 八步全 DONE，步骤名不变（复用 16B 既有编排，无新旁路）
+        assert [s.name for s in steps] == [
+            "PRECHECK", "EXTRACT", "INFER", "SEGMENT", "WRITE", "VALIDATE", "PUBLISH", "REGISTER",
+        ]
+        assert all(s.status == "DONE" for s in steps)
+        # 可发布区间 = spray 命中段，mapping_basis 全 bag_storage_ns（整数 ns 分段，B 产物口径）
+        pubs = manifest.publishable_segments()
+        assert pubs
+        assert all(s.mapping_basis == "bag_storage_ns" for s in pubs)
+        assert all(isinstance(s.start_ns, int) and isinstance(s.end_ns, int) for s in pubs)
+        # 发布落受控根 veh/scene 语义 → spray 场景子树（scene_code 命名，06B 复用层口径）
+        pub_dir = spec.publish_root / "spray-veh-01" / "spray"
+        assert pub_dir.is_dir()
+        assert any(pub_dir.iterdir())
+        # REGISTER 经 Backend 回报（report_results + complete_scene），子包 uid 一致（复用 16B 机制）
+        calls = {c[0]: c[1] for c in spec.reporter.calls}
+        assert "results" in calls and "complete" in calls
+        assert set(calls["results"]) == {seg.slice_key for seg in pubs}
+
+    def test_offset_bag_storage_ns_reuses_zero_branch(self, tmp_path, spray_registry, refs_and_render, monkeypatch):
+        """mapping_basis=bag_storage_ns → derive_storage_offset 走 offset=0 分支（水雾无 header 偏移）。"""
+        _inject_spray_adapter(monkeypatch, DeterministicModel(spray_positions={0, 1, 2, 3}))
+        bag = build_pointcloud_bag(tmp_path, ["normal"] * 30)
+        spec = _spray_spec(tmp_path, bag, "offset", spray_registry)
+        spec.publish_root.mkdir(parents=True)
+        manifest, _ = SceneHostOrchestrator(spray_registry).run(spec)
+        offset = scene_publish_service.derive_storage_offset(manifest, Path(spec.source_path))
+        assert offset == 0, "bag_storage_ns 分支必须返回 0（水雾无 header 偏移），不得推导/猜测"
+
+    def test_no_match_not_publish_complete_only(self, tmp_path, monkeypatch, spray_registry, refs_and_render):
+        _inject_spray_adapter(monkeypatch, DeterministicModel(always="正常"))
+        bag = build_pointcloud_bag(tmp_path, ["normal"] * 30)
+        spec = _spray_spec(tmp_path, bag, "nomatch", spray_registry)
+        spec.publish_root.mkdir(parents=True)
+        manifest, _ = SceneHostOrchestrator(spray_registry).run(spec)
+        assert manifest.outcome.value == SceneOutcome.NO_MATCH.value
+        assert not manifest.publishable_segments()
+        # 无文件义务：只 complete，不 report
+        calls = {c[0]: c[1] for c in spec.reporter.calls}
+        assert "complete" in calls and "results" not in calls
+
+    def test_not_applicable_missing_front_topic_is_terminal(
+        self, tmp_path, monkeypatch, spray_registry, refs_and_render,
+    ):
+        _inject_spray_adapter(monkeypatch, DeterministicModel())
+        bag = build_other_topics_bag(tmp_path)  # 只后雷达+相机，无前雷达输入
+        spec = _spray_spec(tmp_path, bag, "na", spray_registry)
+        spec.publish_root.mkdir(parents=True)
+        manifest, steps = SceneHostOrchestrator(spray_registry).run(spec)
+        assert manifest.outcome.value == SceneOutcome.NOT_APPLICABLE.value
+        by_name = {s.name: s.status for s in steps}
+        assert by_name["EXTRACT"] == "DONE"
+        assert all(s.status in ("DONE", "PENDING") for s in steps)
+
