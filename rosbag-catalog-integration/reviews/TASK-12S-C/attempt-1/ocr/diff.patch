+# ===========================================================================
+# 2. PRECHECK 消费 12S-B 7 图 hash 受控预检（fail-closed，不烧模型）
+# ===========================================================================
+class TestSprayPrecheckReferencesGate:
+    def test_missing_references_blocks_precheck_no_model_charge(self, tmp_path, monkeypatch, spray_registry):
+        # 不 patch_refs → 真实 verify_references 指向默认 SPRAY_REFERENCE_DIR（缺失/不可校验）
+        monkeypatch.delenv("SPRAY_REFERENCE_DIR", raising=False)
+        # 用一个**记录型**确定性客户端：若 PRECHECK 不拦截，模型会被调用 → 断言其未被调用
+        model = DeterministicModel()
+        called = {"n": 0}
+
+        orig = DeterministicModel.judge_frame
+
+        def spy(self, *a, **k):
+            called["n"] += 1
+            return orig(self, *a, **k)
+
+        monkeypatch.setattr(DeterministicModel, "judge_frame", spy)
+        _inject_spray_adapter(monkeypatch, model)
+        bag = build_pointcloud_bag(tmp_path, ["normal"] * 30)
+        spec = _spray_spec(tmp_path, bag, "prefail", spray_registry)
+        spec.publish_root.mkdir(parents=True)
+        with pytest.raises(SceneExecError) as ei:
+            SceneHostOrchestrator(spray_registry).run(spec)
+        assert ei.value.step == "PRECHECK"
+        assert "PRECHECK_SPRAY_" in ei.value.code
+        assert called["n"] == 0, "PRECHECK 7 图未过不得进分析/烧模型（fail-closed）"
+        # 未进 PUBLISH：受控 slices 根下的车辆/场景子树未被创建
+        assert not (spec.publish_root / "spray-veh-01" / "spray").exists(), "PRECHECK 失败不得发布"
+
+
+# ===========================================================================
+# 3. 恢复/幂等（复用 16B 机制，水雾不新开旁路）
+# ===========================================================================
+class TestSprayRecoveryIdempotency:
+    def test_recovery_reuses_manifest_no_second_charge(self, tmp_path, monkeypatch, spray_registry, refs_and_render):
+        _inject_spray_adapter(monkeypatch, DeterministicModel(spray_positions={0, 1, 2, 3}))
+        bag = build_pointcloud_bag(tmp_path, ["normal"] * 30)
+        spec = _spray_spec(tmp_path, bag, "rec", spray_registry)
+        spec.publish_root.mkdir(parents=True)
+        m1, _ = SceneHostOrchestrator(spray_registry).run(spec)
+        assert m1.outcome.value == SceneOutcome.SUCCESS.value
+
+        # 崩溃恢复：同一 work_root/checkpoint + 同 identity，新 orchestrator 重跑。
+        # 模型换记录型客户端：恢复重跑不应再请求模型（复用已落盘 manifest）。
+        model2 = DeterministicModel(spray_positions={0, 1, 2, 3})
+        calls2 = {"n": 0}
+        orig = DeterministicModel.judge_frame
+
+        def spy(self, *a, **k):
+            calls2["n"] += 1
+            return orig(self, *a, **k)
+
+        monkeypatch.setattr(DeterministicModel, "judge_frame", spy)
+        _inject_spray_adapter(monkeypatch, model2)
+        reporter2 = FakeReporter()
+        spec2 = _spray_spec(tmp_path, bag, "rec", spray_registry, reporter=reporter2)  # 同 work/publish/identity
+        m2, steps2 = SceneHostOrchestrator(spray_registry).run(spec2)
+        assert m2.outcome.value == SceneOutcome.SUCCESS.value
+        assert calls2["n"] == 0, "恢复重跑不应再请求模型（幂等/缓存，复用 16B 机制）"
+        assert m1.digest() == m2.digest(), "恢复重跑应得到同一 manifest 身份"
+        by_name = {s.name: s.status for s in steps2}
+        assert by_name["EXTRACT"] == "DONE" and by_name["REGISTER"] == "DONE"
+
+
+# ===========================================================================
+# 4. 失败归因（模型失败→INFER，不当 NO_MATCH）
+# ===========================================================================
+class TestSprayFailureAttribution:
+    def test_model_failed_is_infer_not_no_match(self, tmp_path, monkeypatch, spray_registry, refs_and_render):
+        _inject_spray_adapter(monkeypatch, DeterministicModel(fail=True))
+        bag = build_pointcloud_bag(tmp_path, ["normal"] * 30)
+        spec = _spray_spec(tmp_path, bag, "modfail", spray_registry)
+        spec.publish_root.mkdir(parents=True)
+        with pytest.raises(SceneExecError) as ei:
+            SceneHostOrchestrator(spray_registry).run(spec)
+        # MODEL_FAILED 归因 INFER（dispatch 映射），不当 NO_MATCH、不发布
+        assert ei.value.step in ("INFER", "SEGMENT")
+        assert "MODEL_FAILED" in ei.value.code
+        assert not (spec.publish_root / "spray-veh-01" / "spray").exists()
+
