+def classify_bag_input(entries: list[dict], metadata_text: str) -> tuple[dict | None, str | None, str | None]:
+    """TASK-12S-F（REQ-21）：无效输入分类——稳定后先更新证据再分类校验。
+
+    返回 (parsed, None, None)=有效；(None, reason_code, detail)=无效。
+    reason_code 是稳定机器码（AC-21 可查询/可追溯）：
+    - BAD_METADATA：metadata 缺失/不可解析/无 rosbag2_bagfile_information/DB3 路径非法；
+    - UNSUPPORTED_STORAGE：storage_identifier 非 sqlite3；
+    - EMPTY_BAG：message_count=0 或零 DB3 声明（空包）；
+    - MISSING_DB3：metadata 引用的 DB3 文件缺失。
+    detail 是有界错误详情（不写凭据，截断至 512 字符），供拒绝证据留痕。
+    网络/存储不可达不在本函数口径——client 异常由 runner 计 failed（基础设施
+    故障），不判包损坏。
+    """
+    try:
+        parsed = parse_metadata(metadata_text)
+    except Exception as exc:  # noqa: BLE001
+        return None, "BAD_METADATA", str(exc)[:512]
+    storage = parsed.get("storage")
+    if storage != "sqlite3":
+        # parse_metadata 已拒绝非 sqlite3（raise ValueError）；此处是防御分支
+        # （若上游解析口径变化，分类仍归 UNSUPPORTED_STORAGE 不混入 BAD_METADATA）。
+        return None, "UNSUPPORTED_STORAGE", f"storage_identifier={storage!r}"[:512]
+    if parsed["message_count"] == 0 or not parsed["relative_file_paths"]:
+        return None, "EMPTY_BAG", (
+            f"message_count={parsed['message_count']}, "
+            f"relative_file_paths={len(parsed['relative_file_paths'])}"
+        )[:512]
+    try:
+        _check_parsed(parsed, entries)
+    except ValueError as exc:
+        if "missing files" in str(exc):
+            return None, "MISSING_DB3", str(exc)[:512]
+        return None, "BAD_METADATA", str(exc)[:512]
+    return parsed, None, None
+
+
