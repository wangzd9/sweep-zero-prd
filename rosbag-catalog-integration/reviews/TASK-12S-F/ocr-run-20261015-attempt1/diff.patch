+def _run_migration(tmp_path, name, rev_id, direction):
+    """在独立空库上执行指定 revision 的 upgrade/downgrade（模块级函数口径）。
+
+    旧库形态：create_all 生成当前 model 全量 DDL，再手工回退到目标 revision
+    的前置状态（upgrade 时 drop 新列新索引；downgrade 时保留新列）。
+    """
+    path = tmp_path / f"{name}.db"
+    engine = create_engine(f"sqlite:///{path}")
+    script = ScriptDirectory("alembic")
+    rev = script.get_revision(rev_id)
+    with engine.begin() as conn:
+        models.Base.metadata.create_all(conn)
+        conn.execute(
+            text(
+                "CREATE TABLE IF NOT EXISTS alembic_version "
+                "(version_num VARCHAR(32) NOT NULL, PRIMARY KEY (version_num))"
+            )
+        )
+        if direction == "upgrade":
+            # 回退到 down_revision 状态（模拟迁移前旧库）
+            conn.execute(text("DROP INDEX ix_ingest_submission_rejection_reason_code"))
+            conn.execute(text("ALTER TABLE ingest_submission DROP COLUMN stable_reject_rounds"))
+            conn.execute(text("ALTER TABLE ingest_submission DROP COLUMN rejection_evidence_json"))
+            conn.execute(text("ALTER TABLE ingest_submission DROP COLUMN rejection_reason_code"))
+            conn.execute(text(f"INSERT INTO alembic_version (version_num) VALUES ('{rev.down_revision}')"))
+        else:
+            conn.execute(text(f"INSERT INTO alembic_version (version_num) VALUES ('{rev.revision}')"))
+        # 绑定 op 代理后执行迁移函数（alembic CLI 同款机制：Operations.context
+        # 建立迁移上下文，其内 op.* 可用）
+        from alembic.operations import Operations
+
+        ctx = MigrationContext.configure(conn)
+        with Operations.context(ctx):
+            if direction == "upgrade":
+                rev.module.upgrade()
+            else:
+                rev.module.downgrade()
+            # alembic CLI 由 upgrade/downgrade 命令维护 alembic_version；
+            # 手工调用迁移函数后按 rev 记录落版本标记（同一事实来源）。
+            target = rev.revision if direction == "upgrade" else rev.down_revision
+            conn.execute(text("UPDATE alembic_version SET version_num=:v"), {"v": target})
+    return engine
+
+
+def test_migration_upgrade_adds_rejection_columns(tmp_path):
+    engine = _run_migration(tmp_path, "t12sf-up", "20261014_01_ingest_rejected", "upgrade")
+    cols = {c["name"] for c in inspect(engine).get_columns("ingest_submission")}
+    assert {"rejection_reason_code", "rejection_evidence_json", "stable_reject_rounds"} <= cols
+    idx = {i["name"] for i in inspect(engine).get_indexes("ingest_submission")}
+    assert "ix_ingest_submission_rejection_reason_code" in idx
+    with engine.connect() as conn:
+        assert conn.execute(text("SELECT version_num FROM alembic_version")).scalar() == "20261014_01_ingest_rejected"
+    engine.dispose()
+
+
+def test_migration_downgrade_drops_rejection_columns(tmp_path):
+    engine = _run_migration(tmp_path, "t12sf-down", "20261014_01_ingest_rejected", "downgrade")
+    cols = {c["name"] for c in inspect(engine).get_columns("ingest_submission")}
+    assert not ({"rejection_reason_code", "rejection_evidence_json", "stable_reject_rounds"} & cols)
+    idx = {i["name"] for i in inspect(engine).get_indexes("ingest_submission")}
+    assert "ix_ingest_submission_rejection_reason_code" not in idx
+    engine.dispose()
