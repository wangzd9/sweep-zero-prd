+down_revision = "20261013_01_scene_intake"
+branch_labels = None
+depends_on = None
+
+
+def _submission_cols() -> set[str]:
+    return {c["name"] for c in sa.inspect(op.get_bind()).get_columns("ingest_submission")}
+
+
+def _submission_index(name: str) -> bool:
+    return name in {ix["name"] for ix in sa.inspect(op.get_bind()).get_indexes("ingest_submission")}
+
+
+def upgrade() -> None:
+    cols = _submission_cols()
+    if "rejection_reason_code" not in cols:
+        op.add_column(
+            "ingest_submission",
+            sa.Column("rejection_reason_code", sa.String(length=32), nullable=True),
+        )
+    if "rejection_evidence_json" not in cols:
+        op.add_column(
+            "ingest_submission",
+            sa.Column("rejection_evidence_json", sa.Text(), nullable=True),
+        )
+    if "stable_reject_rounds" not in cols:
+        op.add_column(
+            "ingest_submission",
+            sa.Column("stable_reject_rounds", sa.Integer(), nullable=True),
+        )
+    if not _submission_index("ix_ingest_submission_rejection_reason_code"):
+        op.create_index(
+            "ix_ingest_submission_rejection_reason_code",
+            "ingest_submission",
+            ["rejection_reason_code"],
+        )
+
+
+def downgrade() -> None:
+    if _submission_index("ix_ingest_submission_rejection_reason_code"):
+        op.drop_index("ix_ingest_submission_rejection_reason_code", table_name="ingest_submission")
+    cols = _submission_cols()
+    if "stable_reject_rounds" in cols:
+        op.drop_column("ingest_submission", "stable_reject_rounds")
+    if "rejection_evidence_json" in cols:
+        op.drop_column("ingest_submission", "rejection_evidence_json")
+    if "rejection_reason_code" in cols:
+        op.drop_column("ingest_submission", "rejection_reason_code")
