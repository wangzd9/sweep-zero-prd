+        .where(
+            IngestSubmission.profile_id == profile_row.profile_id,
+            IngestSubmission.profile_version == profile_row.version,
+            IngestSubmission.path_claim_key == claim,
+        )
+        .with_for_update()
+    )
+    if holder is not None:
+        return holder
+    submission = _ensure_system_submission(db, profile_row, entry_relative)
+    submission.source = "scanner-reject"
+    return submission
+
+
+def report_input_rejected(db: Session, evidence: dict) -> dict:
+    """Scanner 无效输入上报（内部报告端点，DTO/鉴权/幂等由本任务冻结）。
+
+    按 root+incoming_path 定位接收入口：
+    - 命中未绑定 PENDING_INPUT 提交 → 置 INPUT_REJECTED（持久拒绝，结束本次
+      自动接收尝试；保留提交 ID/幂等键/path claim/资料/拒绝原因/证据/时间）。
+    - 无提交（确认拒绝前没有 submission）→ 建系统拒绝提交（source=system-reject，
+      PENDING 口径的根+路径+观测身份持久记录），后续合法提交可按 path_claim
+      关联该证据（不静默丢失）。
+    已绑定（BOUND/SCHEDULED）提交不受本端点影响——只针对尚未绑定的无效输入。
+    不生成 source/run/模型请求；不是 SCENE_FAILED/NO_MATCH/NOT_APPLICABLE。
+    幂等：相同证据重复上报不推进行版本外的副作用（拒绝态可重复确认）。
+    """
+    root_id = evidence.get("root_id")
+    incoming_path = str(evidence.get("incoming_path") or "").rstrip("/")
+    if not incoming_path:
+        raise HTTPException(422, "evidence.incoming_path is required")
+    # 受控根校验：incoming_path 必须落在声明 root_id 的受控 scan 根下。
+    roots = _controlled_scan_roots(root_id)
+    if not roots or not any(
+        incoming_path == r or incoming_path.startswith(r + "/") for r in roots
+    ):
+        raise HTTPException(409, "incoming_path is outside the controlled scan root for root_id")
+    relative_to_scan = next(
+        (incoming_path[len(r) + 1 :] for r in roots if incoming_path.startswith(r + "/")), None
+    )
+    profile_row, entry_relative = (None, None)
+    if relative_to_scan:
+        matched = match_profile_for_incoming(
+            db, incoming_path, root_id=root_id, scan_root=roots[0]
+        )
+        if matched is not None:
+            profile_row, entry_relative = matched
+    entry_relative = entry_relative or relative_to_scan or incoming_path
+    # 极端兜底（入口完全不可定位）：不建表行会丢证据——按 root+路径建系统
+    # 拒绝提交（profile 用声明 root 的活动入口兜底，取不到则 409 显式失败）。
+    if profile_row is None:
+        rows = _active_profiles(db, root_id)
+        if not rows:
+            raise HTTPException(409, "no active ingest profile for root_id; cannot persist rejection")
+        profile_row = rows[0]
+    submission = _ensure_reject_submission(db, profile_row, entry_relative)
+    db.flush()
+    before_status = submission.status
+    if submission.status not in ("PENDING_INPUT",):
+        # 已绑定/已调度行不受拒绝端点影响（只针对尚未绑定的无效输入）。
+        db.rollback()
+        raise HTTPException(409, "SUBMISSION_BOUND: rejection only applies to unbound PENDING_INPUT")
+    rejection = _submission_reject_block(submission, evidence, before_status)
+    submission.status = "INPUT_REJECTED"
+    submission.rejection_reason_code = str(evidence.get("reason_code") or "BAD_METADATA")[:32]
+    submission.rejection_evidence_json = json.dumps(rejection, ensure_ascii=False)
+    # 稳定确认计数：同一无效快照经不同扫描轮次确认的累计（服务端权威口径）。
+    try:
+        rounds = int(evidence.get("stable_rounds") or 1)
+    except (TypeError, ValueError):
+        rounds = 1
+    submission.stable_reject_rounds = rounds
+    submission.row_version = submission.row_version + 1
+    submission.updated_at = now()
+    db.commit()
+    return {
+        "submission_id": submission.submission_id,
+        "status": "INPUT_REJECTED",
+        "rejection_reason_code": submission.rejection_reason_code,
+        "row_version": submission.row_version,
+    }
+
+
+def resume_input_submission(
+    db: Session, submission_id: str, row_version: int, operator: str | None, key: str | None
+) -> dict:
+    """POST resume-input（REQ-21）：材料补齐后显式恢复，重走完整校验链。
+
+    只允许 INPUT_REJECTED 且尚未绑定恢复；旧 version/已绑定/非法状态 409。
+    同一幂等重放回放首次响应（不重复推进代次、不绕过当前状态）。
+    恢复=回 PENDING_INPUT + 清本次稳定/拒绝抑制标记（保留拒绝历史在 evidence
+    审计块；stable_reject_rounds 清零重计），随后 Scanner 重新完整校验：仍坏
+    则再次 INPUT_REJECTED（可重复尝试、幂等），合法则走 E 绑定链。
+    200 只表示受理回 PENDING，不代表输入已合法。
+    """
+    operation = f"ingest-submission-resume:{submission_id}:v{row_version}"
+    payload = {"row_version": row_version, "operator": operator}
+    replay = idempotent_replay(db, operation, key, payload)
+    if replay is not None:
+        return replay
+    submission = db.scalar(
+        select(IngestSubmission).where(IngestSubmission.submission_id == submission_id).with_for_update()
+    )
+    if submission is None:
+        raise HTTPException(404, "submission not found")
+    if submission.status != "INPUT_REJECTED":
+        raise HTTPException(409, "SUBMISSION_NOT_REJECTED: only INPUT_REJECTED submissions can resume")
+    if row_version != submission.row_version:
+        raise HTTPException(409, "ROW_VERSION_CONFLICT: submission changed concurrently")
+    # 已绑定防线：INPUT_REJECTED 本就不绑定，防御性再核 source_id 为空。
+    if submission.source_id:
+        raise HTTPException(409, "SUBMISSION_BOUND: already bound, cannot resume")
+    # 保留拒绝历史（审计），清本次稳定/抑制标记，回 PENDING 重走完整校验。
+    submission.status = "PENDING_INPUT"
+    submission.stable_reject_rounds = None
+    submission.row_version = row_version + 1
+    submission.updated_at = now()
+    response = _submission_payload_response(submission)
+    store_idempotency(db, operation, key, payload, response)
+    db.commit()
+    return response
+
