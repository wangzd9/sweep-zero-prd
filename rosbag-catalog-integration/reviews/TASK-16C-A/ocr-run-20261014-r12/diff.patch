+UID_PREFIX = "T16CA"
+
+
+def _uid(n: int) -> str:
+    return f"{UID_PREFIX}{n:020d}"
+
+
+@pytest.fixture
+def db():
+    session: Session = SessionLocal()
+    try:
+        _purge_prefix(session)
+    except Exception:  # noqa: BLE001
+        session.rollback()
+    Base.metadata.create_all(engine)
+    try:
+        _purge_prefix(session)
+    except Exception:  # noqa: BLE001
+        session.rollback()
+    try:
+        yield session
+    finally:
+        try:
+            session.rollback()
+        except Exception:  # noqa: BLE001
+            pass
+        session.close()
+        _purge_prefix()
+
+
+def _purge_prefix(session: Session | None = None) -> None:
+    s = session or SessionLocal()
+    try:
+        bag_ids = s.scalars(select(BagRecord.id).where(BagRecord.bag_uid.like(f"{UID_PREFIX}%"))).all()
+        if bag_ids:
+            s.execute(BagPurpose.__table__.delete().where(BagPurpose.bag_id.in_(bag_ids)))
+            from app.models import bag_scene
+
+            s.execute(bag_scene.delete().where(bag_scene.c.bag_id.in_(bag_ids)))
+        s.execute(
+            BagDerivation.__table__.delete().where(
+                BagDerivation.parent_bag_uid.like(f"{UID_PREFIX}%") | BagDerivation.child_bag_uid.like(f"{UID_PREFIX}%")
+            )
+        )
+        s.execute(BagRecord.__table__.delete().where(BagRecord.bag_uid.like(f"{UID_PREFIX}%")))
+        s.commit()
+    except Exception:  # noqa: BLE001
+        s.rollback()
+    finally:
+        s.close()
+
+
+def _add_bag(
+    session: Session,
+    n: int,
+    *,
+    bag_role: str = "ORIGINAL",
+    dataset_type: str = "self_built",
+    availability: str | None = None,
+    started_at: datetime | None = None,
+) -> BagRecord:
+    bag = BagRecord(
+        bag_uid=_uid(n),
+        name=f"t16ca-bag-{n:02d}",
+        relative_path=f"/test/t16ca/bag-{n:02d}",
+        bag_role=bag_role,
+        dataset_type=dataset_type,
+        availability=availability,
+        status="READY",
+        started_at=started_at,
+    )
+    session.add(bag)
+    return bag
+
+
+def _add_purpose(session: Session, bag: BagRecord, purpose: str) -> None:
+    session.flush()
+    session.add(BagPurpose(purpose=purpose, bag_id=bag.id))
+
+
+def _add_derivation(session: Session, parent_uid: str, child_uid: str) -> BagDerivation:
+    der = BagDerivation(
+        parent_bag_uid=parent_uid,
+        child_bag_uid=child_uid,
+        scene_code="slope",
+        slice_key=f"t16ca-{child_uid[-4:]}",
+        run_id=f"{UID_PREFIX}-run",
+        start_ns=0,
+        end_ns=1000,
+        duration_ns=1000,
+    )
+    session.add(der)
+    return der
+
