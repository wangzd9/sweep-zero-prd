+class TestCursorContext:
+    """16C-c03-02/03：cursor 上下文绑定实际过滤条件 + 旧合法 cursor 兼容。
+
+    用固定日期窗（started_from/started_to=2026-12-01 全天）隔离本类 12 个种子袋：
+    共享 SQLite 中其他 test 文件日期均在 1–4 月，2026-12-01 无既有数据，成员口径确定。
+    """
+
+    @pytest.fixture(autouse=True)
+    def _seed(self, db: Session):
+        base = datetime(2026, 12, 1)
+        self.bags = [
+            _add_bag(db, 40 + i, started_at=base + timedelta(hours=i * 2))
+            for i in range(12)
+        ]
+        self.window = {"view": "all", "limit": "5", "started_from": "2026-12-01", "started_to": "2026-12-01"}
+        db.commit()
+
+    def test_cursor_chain_no_gap_no_dup(self):
+        with TestClient(app) as client:
+            seen = []
+            params = dict(self.window)
+            for _ in range(10):
+                body = client.get("/api/v1/bags", params=params).json()
+                seen.extend(i["bag_uid"] for i in body["items"])
+                if not body["has_more"]:
+                    break
+                params["cursor"] = body["next_cursor"]
+            # 无漏无重：窗口内恰好 12 个种子袋（demo 数据在 2026-07-20，窗外）
+            expected = sorted(b.bag_uid for b in self.bags)
+            assert sorted(seen) == expected
+            assert len(seen) == len(set(seen)) == 12
+
+    def test_cursor_with_changed_filter_422(self):
+        with TestClient(app) as client:
+            first = client.get("/api/v1/bags", params=self.window).json()
+            cursor = first["next_cursor"]
+            assert cursor
+            # 换日期窗复用旧 cursor → 422（c03-02：不复用错误上下文）
+            changed = dict(self.window)
+            changed["started_from"] = "2026-12-02"
+            changed["cursor"] = cursor
+            assert client.get("/api/v1/bags", params=changed).status_code == 422
+            # 换 data_kind 条件复用 → 422
+            changed2 = dict(self.window)
+            changed2.update({"cursor": cursor, "data_kind": "scene_slice"})
+            assert client.get("/api/v1/bags", params=changed2).status_code == 422
+            # 换 dataset_type 条件复用 → 422
+            changed3 = dict(self.window)
+            changed3.update({"cursor": cursor, "dataset_type": "nvidia_physicalai"})
+            assert client.get("/api/v1/bags", params=changed3).status_code == 422
+            # 同条件续页 → 200（不误拒合法翻页）
+            same = dict(self.window)
+            same["cursor"] = cursor
+            assert client.get("/api/v1/bags", params=same).status_code == 200
+
+    def test_legacy_cursor_without_new_keys_accepted(self):
+        # c03-03：历史 cursor（含 scene_code/data_kind/purpose，无 dataset_type 等新增键）
+        # 在请求未使用新增字段时兼容可翻页；新字段缺省比较不受影响
+        with TestClient(app) as client:
+            first = client.get("/api/v1/bags", params=self.window).json()
+            new_cursor = first["next_cursor"]
+            assert new_cursor
+            import base64
+            import json as _json
+
+            payload = _json.loads(base64.urlsafe_b64decode(new_cursor.encode()).decode())
+            # 构造旧格式：剔除 2026-10-14 新增键，保留排序锚点 + 旧筛选键
+            legacy = {k: v for k, v in payload.items() if k not in (
+                "dataset_type", "role", "vehicle_id", "keyword",
+                "parent_bag_uid", "include_history",
+            )}
+            legacy_cursor = base64.urlsafe_b64encode(_json.dumps(legacy, sort_keys=True).encode()).decode()
+            legacy_req = dict(self.window)
+            legacy_req["cursor"] = legacy_cursor
+            body = client.get("/api/v1/bags", params=legacy_req)
+            assert body.status_code == 200
+            new_req = dict(self.window)
+            new_req["cursor"] = new_cursor
+            # 旧 cursor 续页 = 新 cursor 续页同结果（无漏无重）
+            assert [i["bag_uid"] for i in body.json()["items"]] == [
+                i["bag_uid"] for i in client.get("/api/v1/bags", params=new_req).json()["items"]
+            ]
+
+    def test_legacy_cursor_scene_code_none_equivalent_empty(self):
+        # c03-03：旧 cursor 的 scene_code=None 与空串归一同义（不误拒/不放行）
+        import base64
+        import json as _json
+
+        with TestClient(app) as client:
+            first = client.get("/api/v1/bags", params=self.window).json()
+            new_cursor = first["next_cursor"]
+            assert new_cursor
+            payload = _json.loads(base64.urlsafe_b64decode(new_cursor.encode()).decode())
+            payload["scene_code"] = None  # 旧编码可能落 None
+            none_cursor = base64.urlsafe_b64encode(_json.dumps(payload, sort_keys=True).encode()).decode()
+            req = dict(self.window)
+            req["cursor"] = none_cursor
+            assert client.get("/api/v1/bags", params=req).status_code == 200
+            # 反向：cursor 携带 scene_code="slope" 而请求缺省 → 上下文不一致 422
+            payload["scene_code"] = "slope"
+            mismatch = base64.urlsafe_b64encode(_json.dumps(payload, sort_keys=True).encode()).decode()
+            req2 = dict(self.window)
+            req2["cursor"] = mismatch
+            assert client.get("/api/v1/bags", params=req2).status_code == 422
+
+    def test_tampered_cursor_rejected(self):
