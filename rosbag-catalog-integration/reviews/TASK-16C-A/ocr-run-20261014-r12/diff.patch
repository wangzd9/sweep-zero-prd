+class TestC7DateTimeInput:
+    """C7：日期输入 422/400、全天截止、时区一致（Web 与 API 共用解析）。"""
+
+    def test_invalid_date_api_422(self):
+        with TestClient(app) as client:
+            assert client.get("/api/v1/bags", params={"started_from": "not-a-date"}).status_code == 422
+            assert client.get("/api/v1/bags", params={"started_to": "2026-13-45"}).status_code == 422
+            assert client.get("/api/v1/bags", params={"started_from": "2026/02/01"}).status_code == 422
+
+    def test_invalid_date_web_400(self, db: Session):
+        _add_bag(db, 20, started_at=datetime(2026, 2, 1))
+        db.commit()
+        with TestClient(app) as client:
+            resp = client.get("/bags?start_from=not-a-date")
+            assert resp.status_code == 400
+
+    def test_end_to_full_day_cutoff(self, db: Session):
+        # 日期全天截止：end 边界覆盖当天 23:59:59.999999（库内秒精度行的当天最大时间也被包含）
+        day = datetime(2026, 2, 10)
+        bag = _add_bag(db, 21, started_at=day.replace(hour=23, minute=59, second=59))
+        outside = _add_bag(db, 22, started_at=day.replace(hour=23, minute=59, second=59) + timedelta(seconds=1))
+        db.commit()
+        with TestClient(app) as client:
+            body = client.get("/api/v1/bags", params={"view": "all", "started_to": "2026-02-10"}).json()
+            uids = [i["bag_uid"] for i in body["items"]]
+            assert bag.bag_uid in uids
+            assert outside.bag_uid not in uids
+
+    def test_start_date_includes_day_start(self, db: Session):
+        day = datetime(2026, 2, 10)
+        bag = _add_bag(db, 23, started_at=day)
+        before = _add_bag(db, 24, started_at=day - timedelta(seconds=1))
+        db.commit()
+        with TestClient(app) as client:
+            body = client.get("/api/v1/bags", params={"view": "all", "started_from": "2026-02-10"}).json()
+            uids = [i["bag_uid"] for i in body["items"]]
+            assert bag.bag_uid in uids
+            assert before.bag_uid not in uids
+
+    def test_aware_input_converted_to_display_tz(self, db: Session):
+        # aware 入参（UTC+10 固定偏移，避免容器缺 tzdata 的 ZoneInfo 区域名）
+        # 换算到业务时区（settings.display_timezone=Asia/Shanghai）后与库内 naive 值同口径
+        # 库内值：上海时间 2026-02-10 08:00:00
+        stored = datetime(2026, 2, 10, 8, 0, 0)
+        bag = _add_bag(db, 25, started_at=stored)
+        db.commit()
+        utc10 = timezone(timedelta(hours=10))
+        # 2026-02-10 04:00 (UTC+10) == 2026-02-09 18:00 UTC == 上海 2026-02-10 02:00
+        request_at = datetime(2026, 2, 10, 4, 0, 0, tzinfo=utc10)
+        assert _parse_time(request_at.isoformat(), end=False) == datetime(2026, 2, 10, 2, 0, 0)
+        with TestClient(app) as client:
+            body = client.get("/api/v1/bags", params={"view": "all", "started_from": request_at.isoformat()}).json()
+            assert bag.bag_uid in [i["bag_uid"] for i in body["items"]]
+            # 请求晚于 stored（上海 09:00 == UTC+10 11:00）→ 不包含
+            later = datetime(2026, 2, 10, 11, 0, 0, tzinfo=utc10)
+            body2 = client.get("/api/v1/bags", params={"view": "all", "started_from": later.isoformat()}).json()
+            assert bag.bag_uid not in [i["bag_uid"] for i in body2["items"]]
+
+    def test_naive_and_zulu_equivalent(self):
+        tz = ZoneInfo(settings.display_timezone)
+        zulu = "2026-02-10T00:00:00Z"
+        assert _parse_time(
+            zulu, end=False
+        ) == datetime.fromisoformat(zulu.replace("Z", "+00:00")).astimezone(tz).replace(tzinfo=None)
+
+    def test_end_before_start_422(self):
+        with TestClient(app) as client:
+            assert (
