+                    params={"started_from": "2026-02-10", "started_to": "2026-02-01"},
+                ).status_code
+                == 422
+            )
+
+    def test_invalid_bag_search_state_raised(self):
+        with pytest.raises(InvalidBagSearchState):
+            _parse_time("garbage", end=False)
