+class TestC6SharedSingleTruth:
+    """C6：API 行内 data_kind 与 Web 标签上下文共用单一真相，无分叉规则。"""
+
+    def test_api_row_kind_matches_web_context(self, db: Session):
+        base = datetime(2026, 3, 1)
+        unknown = _add_bag(db, 10, bag_role="NOT_APPLICABLE", dataset_type="self_built", started_at=base)
+        # 合法无血缘历史切片：袋存在但无 derivation 行，角色 SCENE_SLICE（16C-c03-04）
+        orphan = _add_bag(db, 11, bag_role="SCENE_SLICE", availability="AVAILABLE", started_at=base)
+        db.commit()
+        with TestClient(app) as client:
+            body = client.get("/api/v1/bags", params={"view": "all"}).json()
+            row_kinds = {i["bag_uid"]: i["data_kind"] for i in body["items"]}
+            ctx = data_kind_context(db, [unknown, orphan])
+            # API 行内值 = Web 上下文首个命中值（同优先级，不分叉）
+            assert row_kinds[orphan.bag_uid] == ctx[orphan.bag_uid][0] == "scene_slice"
+            # NOT_APPLICABLE 非 NVIDIA 不猜类型：API 行内 None、Web 标签 []（模板渲染"未分类"）
+            assert row_kinds[unknown.bag_uid] is None
