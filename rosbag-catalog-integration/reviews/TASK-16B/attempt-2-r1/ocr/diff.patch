+def _cfg_with_backend(tmp_path: Path, fb: FakeBackend, run_id: str) -> ProxyConfig:
+    pub = tmp_path / "pub"
+    pub.mkdir(exist_ok=True)
+    cfg = _cfg(tmp_path, pub)
+    return ProxyConfig(**{**cfg.__dict__, "backend_url": fb.base})
+
+
+def test_report_steps_done_reaches_terminal_from_queued(tmp_path):
+    """H2：DB 侧步骤 QUEUED/None（崩溃恢复重跑且本 attempt 无 RUNNING 行）+
+    checkpoint DONE → 必须 post RUNNING 后刷新 cur 再 post DONE（终态不被跳过）。"""
+    run_id = "scene-h2"
+    fb = FakeBackend(_run_detail(run_id), _source_detail())
+    cfg = _cfg_with_backend(tmp_path, fb, run_id)
+    work_root = tmp_path / "work" / run_id / "attempt-1"
+    work_root.mkdir(parents=True)
+    (work_root / "checkpoint.json").write_text(
+        json.dumps({"steps": {s: {"status": "DONE", "detail": "ok"} for s in
+                              ("PRECHECK", "EXTRACT", "INFER", "SEGMENT", "WRITE",
+                               "VALIDATE", "PUBLISH")}}),
+        encoding="utf-8",
+    )
+    _report_steps(Backend(cfg), run_id=run_id, attempt=1, lease_token="tok",
+                  work_root=work_root, terminal_step="REGISTER")
+    for name in ("PRECHECK", "EXTRACT", "INFER", "SEGMENT", "WRITE", "VALIDATE", "PUBLISH"):
+        statuses = [p["status"] for p in fb.wrote(f"/steps/{name}") if p]
+        assert "RUNNING" in statuses, (name, statuses)
+        assert statuses[-1] == "DONE", (name, statuses)  # 终态落地非卡 RUNNING
+    fb.stop()
+
