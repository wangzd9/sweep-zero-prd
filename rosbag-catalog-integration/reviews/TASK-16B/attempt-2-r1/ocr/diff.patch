+def test_run_concurrent_same_identity_single_writer(live_proxy):
+    """H1：existing 判空→try_reserve 的 TOCTOU 窗口内并发同身份 POST，
+    恰一个 accepted(202)，另一个 already_running(200)/409；ACTIVE 恒至多一条。"""
+    client = live_proxy["client"]
+    fb = live_proxy["fb"]
+    run_id = live_proxy["run_id"]
+    payload = {"pipeline_run_id": run_id, "source_id": "SRC1", "attempt": 1,
+               "lease_token": "tok-c", "resource_lease_token": None}
+    results: list = []
+    barrier = threading.Barrier(2)
+
+    def _post():
+        barrier.wait()
+        results.append(client.post("/run", payload))
+
+    ts = [threading.Thread(target=_post) for _ in range(2)]
+    for t in ts:
+        t.start()
+    for t in ts:
+        t.join(timeout=30)
+    assert len(results) == 2
+    codes = sorted(c for c, _ in results)
+    assert codes.count(202) == 1, results     # 恰一个真正受理
+    assert set(codes) <= {200, 202, 409}, results
+    losers = [r for c, r in results if c != 202]
+    assert all(r.get("accepted") is True for r in losers)  # 幂等同一接收结果
+    assert [a["pipeline_run_id"] for a in client.get("/health")[1]["active_runs"]].count(run_id) <= 1
+    # 台账不重复写：recovery 文件只落一份，受理路径恰一次
+    accepted_posts = [p for c, p in results if c == 202]
+    assert len(accepted_posts) == 1
+    _ = fb  # 断言走 health/结果
+
