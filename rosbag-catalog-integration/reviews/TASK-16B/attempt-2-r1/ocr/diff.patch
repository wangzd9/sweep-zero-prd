+def test_report_step_single_filters_by_attempt(tmp_path):
+    """L1：_report_step_single 只读本 attempt 的 step 行——上一 attempt 已 DONE、
+    本 attempt QUEUED → 走 QUEUED→RUNNING→DONE，不得把旧态当当前态跳过。"""
+    run_id = "scene-l1"
+    detail = _run_detail(run_id)
+    detail["steps"] = (
+        [{"step_name": s, "attempt": 1, "status": "DONE"} for s in
+         ("PRECHECK", "EXTRACT", "INFER", "SEGMENT", "WRITE", "VALIDATE", "PUBLISH")]
+        + [{"step_name": "REGISTER", "attempt": 1, "status": "DONE"}]
+        + [{"step_name": "REGISTER", "attempt": 2, "status": "QUEUED"}]
+    )
+    fb = FakeBackend(detail, _source_detail())
+    cfg = _cfg_with_backend(tmp_path, fb, run_id)
+    work_root = tmp_path / "work" / run_id / "attempt-2"
+    work_root.mkdir(parents=True)
+    (work_root / "checkpoint.json").write_text(
+        json.dumps({"steps": {"REGISTER": {"status": "DONE", "detail": "ok"}}}),
+        encoding="utf-8",
+    )
+    _report_step_single(Backend(cfg), run_id=run_id, attempt=2, lease_token="tok",
+                        name="REGISTER", work_root=work_root)
+    posted = [(p["status"], p["attempt"]) for p in fb.wrote("/steps/REGISTER") if p]
+    assert ("RUNNING", 2) in posted, posted   # 未因旧 attempt DONE 跳过 RUNNING
+    assert ("DONE", 2) in posted, posted
+    fb.stop()
+
