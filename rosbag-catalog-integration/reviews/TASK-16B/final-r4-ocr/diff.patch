+            stage="FINALIZING_SUCCESS",
+            work_root=case.work,
+            complete_payload={"manifest": manifest.to_dict()},
+            complete_idem="r4-resume-complete",
+        )
+        state = json.loads(proxy.state_path(case.cfg, case.run_id).read_text())
+        worker = threading.Thread(target=proxy._resume_finalization, args=(case.cfg, case.backend, state), daemon=True)
+        worker.start()
+    else:
+        proxy.execute_run(
+            case.cfg,
+            case.backend,
+            {
+                "pipeline_run_id": case.run_id,
+                "attempt": 1,
+                "lease_token": "token-r3",
+            },
+        )
+    assert case.backend.pending_seen.wait(1)
+    # 后台步骤失败跨过两倍原TTL；心跳接口始终可用，资格不能因待补报丢失。
+    threading.Event().wait(case.backend.ttl * 2.2)
+    assert case.backend.heartbeats >= 2, "待收尾必须继续续租"
+    assert time.monotonic() < case.backend.expiry
+    assert case.run_id in proxy.ACTIVE, "原attempt在待收尾期间保持单写者"
+    case.backend.fail_step_terminal = False
+    deadline = time.monotonic() + 2
+    while proxy.state_path(case.cfg, case.run_id).exists() and time.monotonic() < deadline:
+        threading.Event().wait(0.02)
+    if entrypoint == "execute_failure":
+        assert case.backend.run_status == "SCENE_FAILED"
+        assert case.backend.steps["INFER"] == "FAILED"
+        assert all(case.backend.steps[name] == "SKIPPED" for name in proxy.STEPS[3:])
+    else:
+        assert case.backend.run_status == "SCENE_DONE"
+        assert all(status == "DONE" for status in case.backend.steps.values())
+    assert not proxy.state_path(case.cfg, case.run_id).exists()
+    assert case.model_calls == ([] if entrypoint == "resume_success" else ["首次完成"])
+    assert case.backend.terminal_step_attempts == 0
+    if worker is not None:
+        worker.join(timeout=1)
+        assert not worker.is_alive()
+
+
+@pytest.mark.parametrize("lost_identity", ["expired", "new_attempt", "missing_lease"])
+def test_recovery_of_ineligible_finalization_blocks_without_writes(expiring_case, lost_identity):
+    import time
+
+    case = expiring_case
+    _, manifest = prepare_expiring_success(case)
+    proxy.save_recovery_state(
+        case.cfg,
+        run_id=case.run_id,
+        attempt=1,
+        lease_token="token-r3",
+        resource_lease_token=None,
+        stage="EXECUTING",
+        identity={"pid": 99999999},
+        accepted_at=1,
+    )
+    proxy._save_finalization(
+        case.cfg,
+        case.run_id,
+        1,
+        "token-r3",
+        stage="FINALIZING_SUCCESS",
+        work_root=case.work,
+        complete_payload={"manifest": manifest.to_dict()},
+        complete_idem="r4-complete",
+    )
+    if lost_identity == "expired":
+        case.backend.expiry = time.monotonic() - 1
+    elif lost_identity == "new_attempt":
+        case.backend.current_attempt = 2
+    else:
+        original_detail = case.backend.run_detail
+
+        def missing_lease_detail(run_id):
+            return {**original_detail(run_id), "lease_expires_at": None}
+
+        case.backend.run_detail = missing_lease_detail
+    state = json.loads(proxy.state_path(case.cfg, case.run_id).read_text())
+    worker = threading.Thread(target=proxy._resume_finalization, args=(case.cfg, case.backend, state), daemon=True)
+    worker.start()
+    worker.join(timeout=2)
+    assert not worker.is_alive(), "资格丢失应有限停止，不能永久补报循环"
+    saved = json.loads(proxy.state_path(case.cfg, case.run_id).read_text())
+    assert saved["stage"] == "FINALIZATION_BLOCKED"
+    assert case.backend.calls == [], "过期/新attempt不得尝试steps/status/complete"
+    assert case.model_calls == []
+
+
+def test_explicit_watchdog_stop_blocks_before_any_finalization_write(expiring_case):
+    case = expiring_case
+    proxy.save_recovery_state(
+        case.cfg,
+        run_id=case.run_id,
+        attempt=1,
+        lease_token="token-r3",
+        resource_lease_token=None,
+        stage="EXECUTING",
+        identity={"pid": 99999999},
+        accepted_at=1,
+    )
+    proxy._save_finalization(
+        case.cfg,
+        case.run_id,
+        1,
+        "token-r3",
+        stage="FINALIZING_SUCCESS",
+        work_root=case.work,
+        complete_payload={},
+        complete_idem="r4-stop",
+    )
+    state = json.loads(proxy.state_path(case.cfg, case.run_id).read_text())
+    stop = threading.Event()
+    stop.set()
+    proxy._finalization_loop(case.cfg, case.backend, state, stop, {"value": "lease_lost"})
+    saved = json.loads(proxy.state_path(case.cfg, case.run_id).read_text())
+    assert saved["stage"] == "FINALIZATION_BLOCKED"
+    assert case.backend.calls == []
+    assert case.model_calls == []
+    assert case.run_id not in proxy.ACTIVE
