@@ -0,0 +1,129 @@
+#!/usr/bin/env bash
+# install_scene_host.sh —— 场景常驻代理安装/卸载/状态三分支（TASK-11S-PREP，A 独占域）
+#
+# **本单只生成不执行**：脚本随交付物冻结，实际安装属 11S G1–G6 发布执行面
+# （用户 17:30 放行 + 当次授权），协调者/发布 owner 在发布窗内执行。
+#
+# 三分支：install / uninstall / status
+#   - install  幂等：目标 unit/env 已存在且内容同 hash 不覆盖；不同 hash 先备份再替换
+#   - uninstall 回滚段：disable + stop + remove unit（保留 journal，不删日志）
+#   - status   只读：is-active/is-enabled + 端口占用核实 + env 文件存在性
+#
+# 边界：
+#   - 不写 C 域 scripts/scene_host_{proxy,orchestrator}.py 本体（模板只引用）
+#   - 不重建 decoder/VLM 运行镜像（环境 owner 已完成 cross-host PASS）
+#   - 不执行任何生产迁移（迁移在 11S 发布门禁面单独执行）
+set -Eeuo pipefail
+
+# ---- 路径口径（与 scene-host.service ExecStart 一致）----
+DEPLOY_DIR="${DEPLOY_DIR:-/home/data-process/deploy/rosbag-catalog}"
+UNIT_SRC="$DEPLOY_DIR/deploy/scene/scene-host.service"
+ENV_EXAMPLE_SRC="$DEPLOY_DIR/deploy/scene/rosbag-scene.env.example"
+COMPOSE_SRC="$DEPLOY_DIR/deploy/scene/scene-proxy.yaml"
+UNIT_DST="/etc/systemd/system/rosbag-scene-host.service"
+ENV_DST="/etc/default/rosbag-scene"
+COMPOSE_DST="/home/data-process/scene/scene-proxy.yaml"
+UNIT_NAME="rosbag-scene-host.service"
+
+usage() {
+  echo "用法：sudo scripts/install_scene_host.sh {install|uninstall|status}"
+  echo "  install    幂等安装 unit + env 占位文件（同 hash 不覆盖，不同 hash 先备份）"
+  echo "  uninstall  回滚段：disable + stop + remove unit（保留 journal）"
+  echo "  status     只读：active/enabled + 端口占用 + env 存在性"
+  exit "${2:-0}"
+}
+
+require_root() {
+  [[ "$EUID" == 0 ]] || { echo "必须使用 sudo/root" >&2; exit 1; }
+}
+
+sha256_of() { sha256sum "$1" | awk '{print $1}'; }
+
+# ---- install（幂等）----
+do_install() {
+  require_root
+  [[ -f "$UNIT_SRC" ]] || { echo "unit 源不存在：$UNIT_SRC" >&2; exit 2; }
+  [[ -f "$ENV_EXAMPLE_SRC" ]] || { echo "env 占位源不存在：$ENV_EXAMPLE_SRC" >&2; exit 2; }
+  [[ -f "$COMPOSE_SRC" ]] || { echo "compose 源不存在：$COMPOSE_SRC" >&2; exit 2; }
+
+  install_unit() {
+    local src="$1" dst="$2" label="$3"
+    local src_hash dst_hash
+    src_hash="$(sha256_of "$src")"
+    if [[ -f "$dst" ]]; then
+      dst_hash="$(sha256_of "$dst")"
+      if [[ "$src_hash" == "$dst_hash" ]]; then
+        echo "[idempotent] $label 内容一致（sha256 $src_hash），不覆盖：$dst"
+        return 0
+      fi
+      # 不同 hash：先备份再替换（保留旧内容可回滚）
+      local backup="$dst.bak.$(date +%Y%m%d-%H%M%S)"
+      cp -p "$dst" "$backup"
+      echo "[replace] $label 内容不同，已备份旧文件 → $backup"
+    fi
+    install -m 0644 -o root -g root "$src" "$dst"
+    echo "[installed] $label → $dst"
+  }
+
+  install_unit "$UNIT_SRC" "$UNIT_DST" "unit"
+  # compose 服务文件（scene-host.service ExecStart 目标；同 hash 幂等，异 hash 先备份）
+  mkdir -p /home/data-process/scene
+  install -d -m 0700 -o data-process -g data-process /home/data-process/scene/state /home/data-process/scene/work
+  install_unit "$COMPOSE_SRC" "$COMPOSE_DST" "compose"
+  # env 文件：生产已有实际值则只提示不覆盖；缺失才落占位模板
+  if [[ -f "$ENV_DST" ]]; then
+    echo "[skip] env 文件已存在（生产实际值），不落占位覆盖：$ENV_DST"
+  else
+    install -m 0640 -o root -g data-process "$ENV_EXAMPLE_SRC" "$ENV_DST"
+    echo "[installed] env 占位模板 → $ENV_DST（发布前需填 SPRAY_* 实际值，见环境 owner 证据）"
+  fi
+
+  systemctl daemon-reload
+  echo "[reload] systemd daemon-reload 完成"
+  echo "[next] 发布执行面：核对端口占用后 systemctl enable --now $UNIT_NAME（属 11S 门禁，本脚本不自动拉起）"
+}
+
+# ---- uninstall（回滚段，保留 journal）----
+do_uninstall() {
+  require_root
+  systemctl disable --now "$UNIT_NAME" 2>/dev/null || echo "[warn] unit 未 active，跳过 disable --now"
+  systemctl stop "$UNIT_NAME" 2>/dev/null || true
+  # remove 仅删 unit 文件；journal 日志保留（不清 journald）
+  if [[ -f "$UNIT_DST" ]]; then
+    local backup="$UNIT_DST.removed.$(date +%Y%m%d-%H%M%S)"
+    mv "$UNIT_DST" "$backup"
+    echo "[rollback] unit 已移出（保留备份 → $backup，journal 不删）"
+  else
+    echo "[rollback] unit 文件不存在，无需移除"
+  fi
+  systemctl daemon-reload
+  echo "[done] 回滚段完成（env 文件 $ENV_DST 保留，发布 owner 视需要处理）"
+}
+
+# ---- status（只读）----
+do_status() {
+  echo "=== $UNIT_NAME ==="
+  systemctl is-active "$UNIT_NAME" 2>&1 || true
+  systemctl is-enabled "$UNIT_NAME" 2>&1 || true
+  echo "=== compose 服务文件 ==="
+  [[ -f "$COMPOSE_DST" ]] && echo "存在：$COMPOSE_DST" || echo "缺失：$COMPOSE_DST"
+  echo "=== env 文件 ==="
+  [[ -f "$ENV_DST" ]] && echo "存在：$ENV_DST" || echo "缺失：$ENV_DST"
+  echo "=== 端口占用核实（SCENE_PROXY_PORT，发布前必查不猜）==="
+  local port
+  port="$(grep -E '^SCENE_PROXY_PORT=' "$ENV_DST" 2>/dev/null | cut -d= -f2)"
+  port="${port:-8767}"
+  if command -v ss >/dev/null 2>&1; then
+    ss -ltn 2>/dev/null | grep -E "[:.]$port\b" && echo "端口 $port 已被占用（需核实归属）" || echo "端口 $port 空闲"
+  else
+    echo "ss 不可用，需手动核实端口 $port"
+  fi
+}
+
+case "${1:-}" in
+  install)   do_install ;;
+  uninstall) do_uninstall ;;
+  status)    do_status ;;
+  -h|--help) usage 0 ;;
+  *)         usage 2 ;;
+esac
