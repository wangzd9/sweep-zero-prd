+# /etc/default/rosbag-scene —— 场景常驻代理占位键（TASK-11S-PREP，A 独占域，只生成不执行）
+#
+# 由 deploy/scene/scene-host.service 经 EnvironmentFile=-/etc/default/rosbag-scene 读取。
+# 安装路径属 11S G1–G6 发布执行面，本单不执行；本文件仅为占位模板。
+#
+# 分两组键：
+#   1) SPRAY_* —— 水雾运行环境键（decoder/VLM 运行镜像 rosbag-spray-runtime:20261013
+#      已由环境 owner（用户指定 Codex）完成并 cross-host PASS；此处为部署时占位，
+#      实际值以环境 owner 证据 analysis/spray-runtime-install-20261013/evidence/ 为准）
+#   2) SCENE_* —— 常驻代理本体键（C 域 scripts/scene_host_proxy.py 读取，默认值见其
+#      os.getenv 口径；SCENE_EXEC_HOST=1 声明本机为场景执行宿主）
+
+# ===== 1) 水雾运行环境（部署时按环境 owner 证据填实际值，本单占位）=====
+# VLM 推理端点：完整 chat/completions URL（代理代码 app/scene/spray/adapter.py
+# _default_model_client 实读 SPRAY_VLM_ENDPOINT；原 SPRAY_MODEL_ENDPOINT 占位有误，r1 勘误）
+SPRAY_VLM_ENDPOINT=
+# 模型名（adapter.py 实读 SPRAY_VLM_MODEL）
+SPRAY_VLM_MODEL=
+# 模型 API 密钥（仅受控配置供给，不进入镜像或日志）
+SPRAY_VLM_API_KEY=
+# 水雾参考数据目录（7 受控参考图，app/scene/spray/references.py 实读 SPRAY_REFERENCE_DIR）
+SPRAY_REFERENCE_DIR=/opt/spray/refs
+SPRAY_REFERENCE_HOST_DIR=/home/data-process/spray-runtime/20261013/reference/images/refs
+# 点云 decoder 可执行路径（容器内 /opt/spray/bin/packet2pointcloud；
+# 由spray.precheck.resolve_decoder_path及adapter实际读取，空值会覆盖镜像默认）
+SPRAY_DECODER_PATH=/opt/spray/bin/packet2pointcloud
+
+# ===== 2) 常驻代理本体（C 域 scene_host_proxy.py 口径）=====
+# 声明本机为场景执行宿主（Orchestrator 派发侧据此纳入 SCENE_EXEC_HOST 资源池）
+SCENE_EXEC_HOST=1
+# 回环常驻代理端口（生产端口发布前实测不猜占用；默认 8767）
+SCENE_PROXY_PORT=8767
+# 回环绑定（只本机，对外经既有网关/隧道）
+SCENE_PROXY_BIND=127.0.0.1
+# 代理状态/工作根（与生产 /var/lib/scene-proxy 同源）
+SCENE_PROXY_STATE_ROOT=/var/lib/scene-proxy/state
+SCENE_PROXY_WORK_ROOT=/var/lib/scene-proxy/work
+# 后端 URL（处理机容器网络内为 http://backend:8000，宿主回环部署时核实）
+BACKEND_URL=http://127.0.0.1:18000
+# 环境标识
+ENVIRONMENT=production
+# NAS 就绪根 / 切片发布根（部署时按生产 NAS 根填实际值，本单占位）
+SCENE_NAS_READY_ROOT=/public/rosbag_scene_processing/ready
+SCENE_SLICE_PUBLISH_ROOT=/public/rosbag_scene_processing/slices
+# 宿主实际NAS路径发布前核实；ready只读，slices允许独立新产物发布。
+SCENE_READY_HOST_ROOT=
+# 切片发布根的宿主侧可达路径（处理机 CIFS 挂载实际位置；scene-proxy.yaml compose 变量插值用，
+# 发布前实测回填，未配置 compose 解析失败拒启动）
+SCENE_SLICE_PUBLISH_HOST_ROOT=
