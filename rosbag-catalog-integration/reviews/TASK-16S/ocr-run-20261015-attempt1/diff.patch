+def test_receive_closed_bag_preserves_bytes_and_source(tmp_path, monkeypatch):
+    root, request = setup_job(tmp_path, monkeypatch)
+    output = SprayScriptAdapter().analyze(request)
+    src = root / "slices/test/spray/clip"
+    write_bag(
+        src,
+        [BagTopic("/opaque", "custom/msg/Packet", 2), BagTopic("/empty", "custom/msg/Packet", 0)],
+        [
+            BagMessage("/opaque", "custom/msg/Packet", 10_000_000_000, b"first"),
+            BagMessage("/opaque", "custom/msg/Packet", 25_000_000_000, b"last"),
+        ],
+    )
+    (src / "rosbag2_0.db3").rename(src / "clip_0.db3")
+    meta = yaml.safe_load((src / "metadata.yaml").read_text())
+    meta["rosbag2_bagfile_information"]["relative_file_paths"] = ["clip_0.db3"]
+    meta["rosbag2_bagfile_information"]["files"][0]["uri"] = "clip_0.db3"
+    (src / "metadata.yaml").write_text(yaml.safe_dump(meta))
+    before = {p.name: p.read_bytes() for p in src.iterdir()}
+    result = receive_script_slice(Path(request.work_dir), tmp_path / "staging", output.segments[0])
+    assert result.message_count == 2
+    # 上游保留零消息topic定义，发布证据须完整映射到实际DB3表。
+    assert result.topics == {"/opaque": 2, "/empty": 0}
+    assert [m.data for m in read_messages(result.out_dir)] == [b"first", b"last"]
+    assert before == {p.name: p.read_bytes() for p in src.iterdir()}
+
