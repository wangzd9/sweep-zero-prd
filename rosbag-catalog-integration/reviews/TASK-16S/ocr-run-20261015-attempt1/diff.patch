+"""调用原样 ros2_slice；仅做输入副本隔离、计时及输出验证。"""
+
+import argparse
+import hashlib
+import json
+import shutil
+import sqlite3
+import sys
+import time
+import traceback
+from datetime import datetime
+from pathlib import Path
+
+STATE_PATH = None
+
+
+def save(path, data):
+    temp = path.with_suffix(path.suffix + ".tmp")
+    temp.write_text(json.dumps(data, ensure_ascii=False, indent=2))
+    temp.replace(path)
+
+
+def digest(path):
+    with path.open("rb") as f:
+        return hashlib.file_digest(f, "sha256").hexdigest() if hasattr(hashlib, "file_digest") else chunk_digest(f)
+
+
+def chunk_digest(f):
+    h = hashlib.sha256()
+    for block in iter(lambda: f.read(4 * 1024 * 1024), b""):
+        h.update(block)
+    return h.hexdigest()
+
+
+def main():
+    global STATE_PATH
+    p = argparse.ArgumentParser()
+    p.add_argument("--source", type=Path, required=True)
+    p.add_argument("--work", type=Path, required=True)
+    p.add_argument("--vehicle", default="test")
+    p.add_argument("--prepare-only", action="store_true")
+    args = p.parse_args()
+    source, work = args.source.resolve(), args.work.resolve()
+    if source == work or source in work.parents or work in source.parents:
+        raise ValueError("源包与工作目录必须隔离")
+    work.mkdir(parents=True, exist_ok=True)
+    # OS 文件锁保证相同工作目录不会重复烧模型。
+    import fcntl
+
+    lock = (work / "call.lock").open("a")
+    fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+    STATE_PATH = work / "status.json"
+    import signal
+
+    signal.signal(signal.SIGTERM, lambda *_: sys.exit("调用进程收到停止信号"))
+    started = time.monotonic()
+    state = {
+        "status": "PREPARING",
+        "started_at": datetime.now().astimezone().isoformat(),
+        "source": str(source),
+        "vehicle": args.vehicle,
+        "source_commit": json.loads(Path("/opt/caller/source-manifest.json").read_text())["commit"],
+        "platform_modified": False,
+    }
+    save(work / "status.json", state)
+    sys.path.insert(0, "/opt/ros2_slice")
+    snapshot = json.loads(Path("/opt/caller/source-manifest.json").read_text())
+    for rel, expected in snapshot["files"].items():
+        if digest(Path("/opt/ros2_slice") / rel) != expected:
+            raise ValueError(f"上游源码快照校验失败：{rel}")
+    from request import request_spray
+    from src.analysis_perform import analysis_perform
+
+    source_files = sorted([source / "metadata.yaml", *source.glob("*.db3")])
+    if len(source_files) < 2 or not all(x.is_file() for x in source_files):
+        raise ValueError("输入必须包含 metadata.yaml 和 DB3")
+    bag = work / "input" / source.name
+    bag.mkdir(parents=True, exist_ok=True)
+    identity = {
+        "commit": state["source_commit"],
+        "vehicle": args.vehicle,
+        "files": {x.name: {"size": x.stat().st_size, "sha256": digest(x)} for x in source_files},
+    }
+    identity_path = work / "input-identity.json"
+    if identity_path.exists() and json.loads(identity_path.read_text()) != identity:
+        raise ValueError("工作目录输入或程序版本已变化，请使用新的独立目录")
+    for original in source_files:
+        target = bag / original.name
+        if target.exists():
+            if digest(target) != identity["files"][original.name]["sha256"]:
+                raise ValueError(f"本地副本校验失败：{target.name}")
+        else:
+            temp = target.with_suffix(target.suffix + ".partial")
+            shutil.copyfile(original, temp)
+            if digest(temp) != identity["files"][original.name]["sha256"]:
+                raise ValueError(f"复制校验失败：{target.name}")
+            temp.replace(target)
+    save(identity_path, identity)
+    if args.prepare_only:
+        state.update(status="PREPARED", elapsed_s=time.monotonic() - started)
+        save(work / "status.json", state)
+        return
+
+    frame_log = (work / "frames.jsonl").open("a", buffering=1)
+    call_started = {}
+    frame_count = 0
+    unknown_count = 0
+
+    # 只观察原函数调用/返回；不替换模型、缓存、分段或切片实现。
+    def profile(frame, event, value):
+        nonlocal frame_count, unknown_count
+        if frame.f_code is request_spray.judge_one.__code__:
+            if event == "call":
+                call_started[id(frame)] = time.monotonic()
+            elif event == "return":
+                elapsed = time.monotonic() - call_started.pop(id(frame), time.monotonic())
+                if isinstance(value, dict):
+                    frame_count += 1
+                    unknown_count += value.get("final") not in ("正常", "异常")
+                    frame_log.write(
+                        json.dumps(
+                            {
+                                "index": frame_count,
+                                "completed_at": datetime.now().astimezone().isoformat(),
+                                "elapsed_s": elapsed,
+                                **value,
+                            },
+                            ensure_ascii=False,
+                        )
+                        + "\n"
+                    )
+                    state.update(
+                        status="RUNNING",
+                        new_frames=frame_count,
+                        unknown_frames=unknown_count,
+                        last_frame_at=datetime.now().astimezone().isoformat(),
+                    )
+                    save(work / "status.json", state)
+
+    state.update(status="RUNNING")
+    save(work / "status.json", state)
+    sys.setprofile(profile)
+    try:
+        segments = analysis_perform(
+            str(bag), scene="spray", vehicle_id=args.vehicle, output_base_path=str(work / "slices")
+        )
+    finally:
+        sys.setprofile(None)
+        frame_log.close()
+    save(work / "segments.json", segments)
+    failures = []
+    for i, seg in enumerate(segments):
+        output = Path(seg.get("slice_path_local", ""))
+        dbs = list(output.glob("*.db3")) if output.is_dir() else []
+        if not dbs or not (output / "metadata.yaml").is_file():
+            failures.append(f"片段 {i} 没有完整物理输出")
+        for db in dbs:
+            conn = sqlite3.connect(f"file:{db}?mode=ro", uri=True)
+            try:
+                check = conn.execute("PRAGMA quick_check").fetchone()[0]
+                n, lo, hi = conn.execute("SELECT COUNT(*),MIN(timestamp),MAX(timestamp) FROM messages").fetchone()
+                if check != "ok" or not n or lo < seg["start"] * 10**9 or hi > seg["end"] * 10**9:
+                    failures.append(f"片段 {i} DB3 完整性或时间范围异常")
+            finally:
+                conn.close()
+    pic = bag / f"point_pic_{bag.name}"
+    cache_path = pic.parent / (pic.name + "_cache.json")
+    results = json.loads(cache_path.read_text())["results"] if cache_path.exists() else []
+    jpg_count = len(list(pic.glob("*.jpg")))
+    if not jpg_count or len(results) != jpg_count or any(x.get("result") not in ("正常", "异常") for x in results):
+        failures.append("有效图片/逐帧结果不完整或包含未知判定")
+    state.update(
+        status="FAILED" if failures else "COMPLETED",
+        elapsed_s=time.monotonic() - started,
+        completed_at=datetime.now().astimezone().isoformat(),
+        failures=failures,
+        segments=len(segments),
+        valid_images=jpg_count,
+        cached_results=len(results),
+        new_frames=frame_count,
+        unknown_frames=unknown_count,
+        pcd_frames=len(list((bag / f"point_pdc_{bag.name}").glob("*.pcd"))),
+    )
+    save(work / "status.json", state)
+    if failures:
+        raise RuntimeError("；".join(failures))
+
+
+if __name__ == "__main__":
+    try:
+        main()
+    except BaseException:
+        if STATE_PATH is not None and STATE_PATH.exists():
+            status = json.loads(STATE_PATH.read_text())
+            status.update(
+                status="FAILED", error=str(sys.exc_info()[1]), stopped_at=datetime.now().astimezone().isoformat()
+            )
+            save(STATE_PATH, status)
+        traceback.print_exc()
+        raise
