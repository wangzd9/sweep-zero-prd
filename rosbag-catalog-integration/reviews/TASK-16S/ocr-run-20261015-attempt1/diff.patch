+"""验证脚本调用边界和真实 Bag 接收，不替代上游算法质量验收。"""
+
+import json
+from dataclasses import replace
+from pathlib import Path
+
+import pytest
+import yaml
+
+from app.scene.registry import CapabilityRegistry, get_registry
+from app.scene.slope.bag_io import BagMessage, BagTopic, read_messages, write_bag
+from app.scene.spray.script_adapter import UPSTREAM_COMMIT, SprayScriptAdapter, receive_script_slice
+from app.scene.types import Cancellation, SceneAdapterError, SceneRunRequest
+
+
+def setup_job(tmp_path, monkeypatch):
+    root = tmp_path / "jobs" / "probe"
+    root.mkdir(parents=True)
+    monkeypatch.setenv("SCENE_SCRIPT_JOBS_ROOT", str(root.parent))
+    identity = {
+        "source_id": "SRC1",
+        "source_generation": 1,
+        "source_fingerprint": "a" * 64,
+        "upstream_commit": UPSTREAM_COMMIT,
+    }
+    (root / "job.json").write_text(json.dumps(identity))
+    status = {
+        "status": "COMPLETED",
+        "source_commit": UPSTREAM_COMMIT,
+        "valid_images": 3,
+        "cached_results": 3,
+        "unknown_frames": 0,
+        "segments": 1,
+    }
+    (root / "status.json").write_text(json.dumps(status))
+    row = {"start": 10, "end": 25, "label": "spray", "slice_path_local": "/work/slices/test/spray/clip"}
+    (root / "segments.json").write_text(json.dumps([row]))
+    cap = get_registry().get("spray", "spray-script-deb8be8-call")
+    req = SceneRunRequest(
+        "SRC1", 1, "a" * 64, "/source", (), cap, {"job_id": "probe"}, "frozen", str(tmp_path / "scene-1" / "attempt-1")
+    )
+    return root, req
+
+
+def test_script_output_and_claim_are_bound_to_formal_run(tmp_path, monkeypatch):
+    root, request = setup_job(tmp_path, monkeypatch)
+    output = SprayScriptAdapter().analyze(request)
+    assert output.outcome.value == "SUCCESS"
+    assert output.segments[0].start_ns == 10_000_000_000
+    assert json.loads((root / "platform-claim.json").read_text())["run_id"] == "scene-1"
+    # 同 run 正常重试可复用；其他 run 不得抢领同一作业冒充新推理。
+    SprayScriptAdapter().analyze(replace(request, work_dir=str(tmp_path / "scene-1" / "attempt-2")))
+    with pytest.raises(SceneAdapterError, match="ALREADY_CLAIMED"):
+        SprayScriptAdapter().analyze(replace(request, work_dir=str(tmp_path / "scene-2" / "attempt-1")))
+
+
+def test_source_identity_mismatch_is_rejected(tmp_path, monkeypatch):
+    _, request = setup_job(tmp_path, monkeypatch)
+    with pytest.raises(SceneAdapterError, match="IDENTITY_MISMATCH"):
+        SprayScriptAdapter().analyze(replace(request, source_generation=2))
+
+
+def test_default_parameters_find_job_by_verified_source_uid(tmp_path, monkeypatch):
+    root, request = setup_job(tmp_path, monkeypatch)
+    root.rename(root.parent / request.source_id)
+    assert SprayScriptAdapter().analyze(replace(request, parameters={})).outcome.value == "SUCCESS"
+
+
+def test_unknown_results_are_never_published(tmp_path, monkeypatch):
+    root, request = setup_job(tmp_path, monkeypatch)
+    status = json.loads((root / "status.json").read_text())
+    status["unknown_frames"] = 1
