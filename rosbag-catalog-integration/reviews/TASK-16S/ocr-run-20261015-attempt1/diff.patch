+"""原样 ros2_slice 脚本作业与平台流水线的调用边界。
+
+脚本在独立运行环境执行；平台只认领固定来源的作业、观察终态、校验并接收
+已关闭的物理切片。不实现识别、抽帧、分段或切包算法。
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import re
+import shutil
+import time
+from dataclasses import replace
+from pathlib import Path
+
+import yaml
+
+from app.scene.adapter import register_adapter
+from app.scene.slope.bag_io import read_topics
+from app.scene.slope.writer import SliceWriterError, _validate_slice
+from app.scene.spray.adapter import SprayAdapter
+from app.scene.types import AnalysisOutput, EvidenceRef, SceneAdapterError, SceneOutcome, SceneSegment
+
+SCRIPT_ADAPTER_KEY = "ros2-spray-script-v1"
+UPSTREAM_COMMIT = "deb8be8515ffaa8b556e442332725e876dc2f2ca"
+
+
+def _read(path: Path):
+    return json.loads(path.read_text(encoding="utf-8"))
+
+
+def _save(path: Path, data):
+    tmp = path.with_suffix(".tmp")
+    tmp.write_text(json.dumps(data, ensure_ascii=False), encoding="utf-8")
+    tmp.replace(path)
+
+
+class SprayScriptAdapter(SprayAdapter):
+    """使用既有适用性检查，只消费受控脚本作业的真实结果。"""
+
+    def analyze(self, request):
+        # 既有显式运行入口只冻结能力摘要，执行端按默认参数还原。
+        # 默认按已验证的源UID查找受控作业，不要求提交方传递运行目录。
+        job_id = request.parameters.get("job_id") or request.source_id
+        if not re.fullmatch(r"[a-zA-Z0-9_-]{1,100}", job_id):
+            raise SceneAdapterError("SCRIPT_JOB_INVALID", "必须指定受控的脚本 job_id")
+        base = Path(os.environ.get("SCENE_SCRIPT_JOBS_ROOT", "/var/lib/scene-script-jobs"))
+        job = (base / job_id).resolve()
+        if not job.is_relative_to(base.resolve()) or not job.is_dir():
+            raise SceneAdapterError("SCRIPT_JOB_UNAVAILABLE", "脚本作业目录不存在或越界")
+        identity = _read(job / "job.json")
+        expected = {
+            "source_id": request.source_id,
+            "source_generation": request.source_generation,
+            "source_fingerprint": request.source_fingerprint,
+            "upstream_commit": UPSTREAM_COMMIT,
+        }
+        if any(identity.get(k) != v for k, v in expected.items()):
+            raise SceneAdapterError("SCRIPT_IDENTITY_MISMATCH", "脚本来源/代次/指纹/版本与正式任务不一致")
+        work = Path(request.work_dir)
+        work.mkdir(parents=True, exist_ok=True)
+        owner = {**expected, "run_id": work.parent.name, "config_hash": request.config_hash}
+        claim = job / "platform-claim.json"
+        try:
+            with claim.open("x", encoding="utf-8") as f:
+                json.dump(owner, f)
+        except FileExistsError:
+            if _read(claim) != owner:
+                raise SceneAdapterError("SCRIPT_JOB_ALREADY_CLAIMED", "此脚本作业已属于另一正式流水线") from None
+        deadline = time.monotonic() + float(os.environ.get("SCENE_SCRIPT_TIMEOUT_SECONDS", "86400"))
+        while True:
+            if request.cancellation.is_cancelled():
+                _save(job / "cancel-request.json", owner)
+                raise SceneAdapterError("CANCELLED", "正式任务取消，已通知脚本监控器停止作业")
+            status = _read(job / "status.json")
+            _save(work / "script-progress.json", status)
+            if status.get("source_commit") != UPSTREAM_COMMIT:
+                raise SceneAdapterError("SCRIPT_IDENTITY_MISMATCH", "实际执行脚本版本不一致")
+            if status.get("status") == "FAILED":
+                raise SceneAdapterError("SCRIPT_FAILED", str(status.get("error") or status.get("failures")))
+            if status.get("status") == "COMPLETED":
+                break
+            if time.monotonic() >= deadline:
+                _save(job / "cancel-request.json", owner)
+                raise SceneAdapterError("SCRIPT_TIMEOUT", "脚本未在受控执行时限内完成")
+            time.sleep(1)
+        # caller 只有在所有图片判定可解析、每个物理切片非空且时间范围一致时才完成。
+        if (
+            not status.get("valid_images")
+            or status.get("cached_results") != status["valid_images"]
+            or status.get("unknown_frames")
+        ):
+            raise SceneAdapterError("SCRIPT_RESULTS_INVALID", "缺少完整有效的逐帧识别证据")
+        rows = _read(job / "segments.json")
+        if status.get("segments") != len(rows):
+            raise SceneAdapterError("SCRIPT_RESULTS_INVALID", "片段数与脚本完成证据不一致")
+        segments = []
+        for row in rows:
+            if row.get("label") != "spray" or any(type(row.get(k)) is not int for k in ("start", "end")):
+                raise SceneAdapterError("SCRIPT_RESULTS_INVALID", "上游片段标签或整数秒边界非法")
+            if row["end"] <= row["start"]:
+                raise SceneAdapterError("SCRIPT_RESULTS_INVALID", "上游输出空片段")
+            # 上游自身以整数 epoch 秒定义物理切包的存储轴边界。只做精确单位转换，
+            # 不把秒级输出宣称为纳秒级识别精度。
+            segments.append(
+                SceneSegment(
+                    "spray", row["start"] * 10**9, row["end"] * 10**9, True, "bag_storage_ns", "ROS2_SLICE_SCRIPT_JOB"
+                )
+            )
+        _save(
+            work / "script-job.json",
+            {
+                "job_root": str(job),
+                "identity": owner,
+                "segments": rows,
+                "boundary_precision": "whole_epoch_seconds_from_upstream",
+            },
+        )
+        evidence = EvidenceRef(
+            "ROS2_SLICE_SCRIPT_JOB",
+            str(work / "script-job.json"),
+            hashlib.sha256((work / "script-job.json").read_bytes()).hexdigest(),
+            len(rows),
+        )
+        return AnalysisOutput(
+            SceneOutcome.SUCCESS if segments else SceneOutcome.NO_MATCH, segments=tuple(segments), evidence=(evidence,)
+        )
+
+
+def receive_script_slice(work_root: Path, staging_root: Path, segment: SceneSegment):
+    """把上游已关闭的切片复制为平台既定文件布局，再复用原完整性校验。"""
+    receipt = _read(work_root / "script-job.json")
+    rows = [
+        r
+        for r in receipt["segments"]
+        if r["start"] * 10**9 == segment.start_ns and r["end"] * 10**9 == segment.end_ns and r["label"] == segment.label
+    ]
+    if len(rows) != 1:
+        raise SliceWriterError("平台区间与脚本物理产物不唯一对应")
+    root = Path(receipt["job_root"]).resolve()
+    try:
+        rel = Path(rows[0]["slice_path_local"]).relative_to("/work/slices")
+    except (KeyError, ValueError) as exc:
+        raise SliceWriterError("脚本切片路径不在受控输出根") from exc
+    source = (root / "slices" / rel).resolve()
+    if not source.is_relative_to(root / "slices") or not source.is_dir():
+        raise SliceWriterError("脚本切片目录缺失或越界")
+    if any(p.is_symlink() for p in source.rglob("*")):
+        raise SliceWriterError("脚本切片含符号链接")
+    dbs = list(source.glob("*.db3"))
+    if len(dbs) != 1:
+        raise SliceWriterError("当前上游切片应为单 DB3，不能漏接文件")
+    target = staging_root / segment.slice_key.replace(":", "_")
+    if target.exists():
+        shutil.rmtree(target)
+    shutil.copytree(source, target)
+    name = dbs[0].name
+    if name != "rosbag2_0.db3":
+        (target / name).rename(target / "rosbag2_0.db3")
+    metadata_path = target / "metadata.yaml"
+    metadata = yaml.safe_load(metadata_path.read_text())
+    bag_info = metadata["rosbag2_bagfile_information"]
+    if bag_info["relative_file_paths"] != [name]:
+        raise SliceWriterError("脚本 metadata 与实际 DB3 不一致")
+    bag_info["relative_file_paths"] = ["rosbag2_0.db3"]
+    for item in bag_info.get("files", []):
+        key = "path" if "path" in item else "uri"
+        if item.get(key) != name:
+            raise SliceWriterError("脚本 metadata.files 含未知 DB3")
+        item[key] = "rosbag2_0.db3"
+    metadata_path.write_text(yaml.safe_dump(metadata, allow_unicode=True, sort_keys=False))
+    result = _validate_slice(target, segment, expected_topics=None, bounds=(segment.start_ns, segment.end_ns))
+    # 上游保留零消息topic定义；发布台账必须与真实DB3的完整topic集合一致。
+    # 只补齐接收证据，不改原始/切片DB3，也不放宽Backend完整性校验。
+    return replace(result, topics={topic.name: topic.message_count for topic in read_topics(target)})
+
+
+register_adapter(SCRIPT_ADAPTER_KEY, SprayScriptAdapter)
