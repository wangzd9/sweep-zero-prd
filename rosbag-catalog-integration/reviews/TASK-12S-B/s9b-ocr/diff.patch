+# ===========================================================================
+# T7：ASCII intensity 首值不丢
+# ===========================================================================
+
+
+class TestT7:
+    def test_ascii_first_value_preserved(self, tmp_path):
+        from app.scene.spray.pcd_io import read_intensity
+
+        inten = [0.11, 0.22, 0.33, 0.44]
+        p = _ascii_pcd(tmp_path / "a.pcd", len(inten), inten)
+        vals = read_intensity(p)
+        assert len(vals) == len(inten)
+        assert abs(vals[0] - 0.11) < 1e-9, f"首条 ASCII 数据被丢弃（vals={vals}）"
+        assert vals == pytest.approx(inten)
+
+    def test_ascii_with_blank_header_line(self, tmp_path):
+        # 头内含空行：rfind 口径下首值仍不丢
+        from app.scene.spray.pcd_io import read_intensity
+
+        text = (
+            "# hdr\n\nFIELDS x y z intensity\nSIZE 4 4 4 4\nTYPE F F F F\nCOUNT 1 1 1 1\n"
+            "WIDTH 2\nHEIGHT 1\nPOINTS 2\nDATA ascii\n0.1 0.2 0.3 0.55\n1.1 1.2 1.3 0.77\n"
+        )
+        p = tmp_path / "b.pcd"
+        p.write_text(text, encoding="ascii")
+        vals = read_intensity(p)
+        assert vals == pytest.approx([0.55, 0.77])
