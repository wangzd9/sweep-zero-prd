+@dataclass
+class _FrontMidMsg:
+    db3: str
+    message_id: int
+    storage_ns: int
+    data: bytes
+
+
+def _read_front_mid(bag_dir: Path) -> list[_FrontMidMsg]:
+    """只读读取 front_mid 全部消息（含 message_id 与来源 db3），全局 (storage_ns, id) 升序。
+
+    不复用 slope.bag_io.read_messages：它丢弃 message_id 与 db3 归属，无法支撑
+    S9 的可追溯帧映射；且本读取器限 front_mid 单 topic，语义自足。read-only 打开。
+    """
+    from app.scene.slope.bag_io import find_db3_files
+
+    all_msgs: list[_FrontMidMsg] = []
+    for path in find_db3_files(bag_dir):
+        try:
+            conn = sqlite3.connect(f"file:{path}?mode=ro", uri=True)
+        except sqlite3.Error as exc:
+            raise DecodeError("BAG_READ_FAILED", f"无法只读打开 {path.name}：{exc}") from exc
+        try:
+            tables = {r[0] for r in conn.execute("SELECT name FROM sqlite_master WHERE type='table'")}
+            if "messages" not in tables or "topics" not in tables:
+                continue  # 无 messages/topics 的库跳过（与其他 topic 无关）
+            tids = {r[0] for r in conn.execute("SELECT id FROM topics WHERE name = ?", (PACKET_TOPIC,))}
+            if not tids:
+                continue
+            placeholders = ",".join("?" * len(tids))
+            rows = conn.execute(
+                f"SELECT id, timestamp, data FROM messages WHERE topic_id IN ({placeholders}) ORDER BY timestamp, id",
+                tuple(tids),
+            ).fetchall()
+        finally:
+            conn.close()
+        for mid, ts, data in rows:
+            all_msgs.append(_FrontMidMsg(db3=path.name, message_id=int(mid), storage_ns=int(ts), data=data))
+    all_msgs.sort(key=lambda m: (m.storage_ns, m.message_id))
+    return all_msgs
+
+
+def _seyondscan_is_last(data: bytes) -> bool:
+    """解析 SeyondScan CDR 的 is_last_scan（u8，@base+12）。只读该字段，不展开 packet 体。
+
+    封装头：CDR_LE `00 01 00 00`→base 4 / CDR_BE `00 00 01 00`→base 4；无封装 base 0。
+    布局（SPRAY-INTEGRATION 接口）：f64 timestamp@base+0 / u32 size@base+8 / u8 is_last@base+12。
+    长度不足以定位该字段 → False（残缺消息，由上层完整性守卫拒绝）。
+    """
+    base = 0
+    if len(data) >= 4 and data[:4] == b"\x00\x01\x00\x00":
+        base = 4
+    elif len(data) >= 4 and data[:4] == b"\x00\x00\x01\x00":
+        base = 4
+    off = base + 12
+    if len(data) <= off:
+        return False
+    return data[off] != 0
+
+
+def _seyondscan_head(data: bytes) -> tuple[float, int]:
+    """读 scan 结束消息的 (scan_timestamp_f64, packet_count)。
+
+    packet_count = SeyondPacket[] sequence 长度（u32 @ base+16）。缺字段 → (0.0, 0)。
+    """
+    base = 4 if (len(data) >= 4 and data[:4] in (b"\x00\x01\x00\x00", b"\x00\x00\x01\x00")) else 0
+    order = "<" if base == 0 or data[:4] != b"\x00\x00\x01\x00" else ">"
+    ts = 0.0
+    if len(data) >= base + 8:
+        ts = struct.unpack_from(f"{order}d", data, base)[0]
+    pkt = 0
+    if len(data) >= base + 20:
+        pkt = struct.unpack_from(f"{order}I", data, base + 16)[0]
+    return ts, pkt
+
+
+def _build_scan_frames(msgs: list[_FrontMidMsg]) -> tuple[list[ScanFrameMapping], int]:
+    """以 is_last_scan 消息为帧边界，把 front_mid 消息序列切成 scan 帧。
+
+    返回 (frames, tail_truncated_count)：
+    - 第 k 帧 = 上一个 scan 结束（或序列头）之后到第 k 个 is_last_scan 消息为止；
+    - 帧源 ns = 该 scan 结束消息的整数 storage_ns（不近似）；
+    - 帧首 message = 上一边界后的第一条（跨 DB3 拼接时 first_db3 与 end_db3 可不同）；
+    - tail_truncated_count = 最后一个 scan 结束之后的非空消息数（尾部无 is_last 的残缺
+      scan：作证据，不计入可发布帧，不静默丢弃也不冒充）。
+    无 is_last_scan 消息 → ( [], len(msgs) )（首尾均不完整，上层按 DECODE_FAILED 拒绝）。
+    """
+    scan_end_idx = [i for i, m in enumerate(msgs) if _seyondscan_is_last(m.data)]
+    if not scan_end_idx:
+        return [], len(msgs)
+    frames: list[ScanFrameMapping] = []
+    for k, end_i in enumerate(scan_end_idx):
+        first_i = scan_end_idx[k - 1] + 1 if k > 0 else 0
+        end = msgs[end_i]
+        ts, pkt = _seyondscan_head(end.data)
+        frames.append(
+            ScanFrameMapping(
+                scan_end_storage_ns=end.storage_ns,
+                scan_end_message_id=end.message_id,
+                scan_end_db3=end.db3,
+                first_message_id=msgs[first_i].message_id,
+                first_db3=msgs[first_i].db3,
+                packet_count=pkt,
+                scan_timestamp_f64=ts,
+            )
+        )
+    tail = len(msgs) - (scan_end_idx[-1] + 1)
+    return frames, max(0, tail)
+
