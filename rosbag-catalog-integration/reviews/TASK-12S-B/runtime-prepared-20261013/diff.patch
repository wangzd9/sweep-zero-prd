+class TestE2E:
+    def test_hit_success_segments(self, tmp_path, monkeypatch):
+        """完整 adapter：decode→选帧→render→model→segment，已知命中 → SUCCESS + 可发布 spray 区间。"""
+        from app.scene.spray.adapter import SprayAdapter
+        from app.scene.types import SceneOutcome
+
+        patch_refs(monkeypatch)
+        patch_render(monkeypatch)
+        bag = build_pointcloud_bag(tmp_path, ["normal"] * 30)
+        req = make_request(bag, tmp_path / "w")
+        # 30 帧 → 选帧 [10,13,16,19,22,25,28]（7 帧）；模型按调用次序判 spray 块
+        model = DeterministicModel(spray_positions={0, 1, 2, 3})
+        out = SprayAdapter(model_client=model).analyze(req)
+        assert out.outcome == SceneOutcome.SUCCESS
+        pub = [s for s in out.segments if s.publish_target]
+        assert pub
+        for s in pub:
+            assert isinstance(s.start_ns, int) and isinstance(s.end_ns, int)
+            assert s.end_ns > s.start_ns
+            assert s.mapping_basis == "bag_storage_ns"
+        # 命中区间起点应贴近 spray 首帧往前 3s（lead），整数 ns 不 round 秒
+        first_spray_ns = BASE_TS + 10 * NANO  # 选中第 0 帧 = 原帧 10
+        assert any(s.start_ns <= first_spray_ns for s in pub)
