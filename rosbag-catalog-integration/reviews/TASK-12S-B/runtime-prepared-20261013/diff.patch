+"""spray 模型判定与归一（TASK-12S-B，SPRAY-INTEGRATION §3）。
+
+对照 ros2_slice/request/request_spray.py + request_common.py：
+- 双 pass：pass1=SPRAY_PROMPT_V18（thinking）主判定；pass2=SPRAY_PROMPT_SIM
+  （不 thinking）按参考图编号复核（1~4 正常 / 5~7 异常）。
+- **归一 spray/normal/unknown**：禁止照搬原 `result == '是'`（原代码把"正常/异常/
+  未知:xx"三种串混用导致全部 NO_MATCH）；也禁止 `!=异常` 统称正常。
+- pass1 明确异常 → 直接 spray；否则 pass2 复核：pass2 异常 → spray；pass2 正常且
+  pass1 正常 → normal；任一路径 unknown/解析失败 → 有界重试后仍不确定 = **FAILED**
+  （不是 normal，不是 NO_MATCH）。
+- 每 pass 记录目标图/7 参考图重复传输 bytes 与重试次数（AC-15.2 带宽证据面）。
+
+客户端可注入（测试用确定性客户端）；生产 HTTP 客户端惰性 import requests，
+端点/凭据只在服务端配置，不进能力描述。
+"""
+
+from __future__ import annotations
+
+import base64
+import re
+import time
+from dataclasses import dataclass, field
+from typing import Protocol
+
+# ---- 对照实现原样冻结的提示词/系统串（hash 进执行证据，改串=升版本）----
+SPRAY_SYSTEM = (
+    "你是一名激光雷达点云图像分析专家。判断输入的2D俯观点云图像是否受水雾干扰。"
+    "只输出结果，不添加额外解释。"
+)
+SPRAY_PROMPT_V18 = """
+    激光雷达点云水雾判定。
+判据一：右侧红色团块的状态（对照参考图）：
+- 状态A（参考图1/3）：紧凑、实心、范围窄、边界清晰——是固定墙体，正常
+- 状态B（参考图5）：宽幅、斑驳、散点蓬松弥散——是雾团，异常
+判据二：中央红色扇面内出现以下任一分布即异常：
+1. 弧线断裂、成暗色空洞（紧邻排水渠等规整结构的暗区不算）
+2. 绿/黄绿/蓝散点悬浮于弧线间隙、分布成片（正常图只有零星孤点）
+3. 蓬松雾团侵入扇面
+4. 弧线波浪形变：平滑的同心弧局部扭曲起伏、弧线本身走波浪（正常图的弧线骨架始终平滑）
+扇面干净+右侧状态A=正常（底部黄→绿渐变弧、远端衰减、零星孤点、排水渠都是正常特征）。
+
+先看7张参考图：参考图1、2、3、4是正常图，参考图5、6、7是异常图，按扇面特征和右侧状态对照。第8张图是待判定图。
+只输出"正常"或"异常"。
+"""
+SPRAY_PROMPT_SIM = (
+    "前7张是参考图（参考图1~参考图7，其中参考图1、2、3、4是正常图，参考图5、6、7是异常图）。"
+    "最后1张是待判定图。\n"
+    "问题：待判定图的整体形态（右侧红色团块状态 + 中央扇面特征）最接近哪张参考图？\n"
+    '只输出"最像参考图N"。'
+)
+
+# 归一标签
+LABEL_SPRAY = "spray"
+LABEL_NORMAL = "normal"
+LABEL_UNKNOWN = "unknown"
+
+_REF_NUM_RE = re.compile(r"参考图\s*([1-7])")
+
+
+class SprayModelError(Exception):
+    """有界重试后模型仍不可解析/HTTP 失败 → FAILED（不是 normal）。"""
+
+
+@dataclass(frozen=True)
+class PassStat:
+    """单 pass 带宽/重试证据（AC-15.2）。"""
+
+    prompt: str
+    target_bytes: int
+    refs_bytes: int
+    total_bytes: int
+    retries: int
+    elapsed_s: float = 0.0
+
+
+@dataclass
+class FrameVerdict:
+    """一帧双 pass 归一结果。"""
+
+    label: str  # spray / normal / unknown
+    p1_raw: str = ""
+    p2_raw: str = ""
+    p2_ref_num: int | None = None
+    passes: list[PassStat] = field(default_factory=list)
+    # 该帧是否可用（label != unknown 且两 pass 都成功）
+    resolvable: bool = False
+
+
+def _verdict_of(text: str) -> str:
+    """归一单 pass 文本：异常/正常/unknown（对照实现 verdict_of，但三分离）。"""
+    s = (text or "").strip()
+    if not s:
+        return LABEL_UNKNOWN
+    if "异常" in s:
+        return LABEL_SPRAY
+    if "正常" in s:
+        return LABEL_NORMAL
+    return LABEL_UNKNOWN
+
+
+def _ref_num_of(text: str) -> int | None:
+    m = _REF_NUM_RE.search(text or "")
+    return int(m.group(1)) if m else None
+
+
+def classify_two_pass(
+    p1_raw: str,
+    p2_raw: str | None,
+    p2_ref_num: int | None,
+) -> FrameVerdict:
+    """双 pass 归一纯逻辑（不依赖客户端，可独立测试）。
+
+    - pass1 明确异常 → spray（resolvable）；
+    - pass1 非异常 → 用 pass2：pass2 缺（p2_raw 为 None）视为未跑；
+      pass2 异常(5~7) → spray；pass2 正常(1~4) 且 pass1 正常 → normal；
+      pass1/pass2 有 unknown 或解析失败 → unknown（resolvable=False）。
+    """
+    p1v = _verdict_of(p1_raw)
+    if p1v == LABEL_SPRAY:
+        return FrameVerdict(
+            label=LABEL_SPRAY, p1_raw=p1_raw, p2_raw=p2_raw or "", p2_ref_num=p2_ref_num, resolvable=True
+        )
+    if p2_raw is None:
+        # pass2 未跑（不应发生；调用方保证 pass1 非异常时必跑 pass2）
+        return FrameVerdict(label=LABEL_UNKNOWN, p1_raw=p1_raw, resolvable=False)
+    # pass2 归一：参考图编号 1~4 正常 / 5~7 异常；编号缺失时退回文本判定
+    if p2_ref_num is not None and p2_ref_num <= 4:
+        p2v = LABEL_NORMAL
+    elif p2_ref_num is not None and p2_ref_num >= 5:
+        p2v = LABEL_SPRAY
+    else:
+        p2v = _verdict_of(p2_raw)
+    if p1v == LABEL_NORMAL and p2v == LABEL_SPRAY:
+        return FrameVerdict(label=LABEL_SPRAY, p1_raw=p1_raw, p2_raw=p2_raw, p2_ref_num=p2_ref_num, resolvable=True)
+    if p1v == LABEL_NORMAL and p2v == LABEL_NORMAL:
+        return FrameVerdict(label=LABEL_NORMAL, p1_raw=p1_raw, p2_raw=p2_raw, p2_ref_num=p2_ref_num, resolvable=True)
+    return FrameVerdict(label=LABEL_UNKNOWN, p1_raw=p1_raw, p2_raw=p2_raw, p2_ref_num=p2_ref_num, resolvable=False)
+
+
+class SprayModelClient(Protocol):
+    """双 pass 识别协议：输入目标图 + 7 参考图 bytes，输出 (p1_raw, p2_raw, p2_ref_num)。
+
+    实现负责有界重试与 bytes/重试计数（经 on_pass 回传 PassStat）；
+    仍不确定时抛 SprayModelError（上层 → FAILED）。
+    """
+
+    def is_available(self) -> bool: ...
+
+    def judge_frame(
+        self,
+        target_bytes: bytes,
+        ref_bytes: list[bytes],
+        on_pass=None,
+    ) -> tuple[str, str | None, int | None]: ...
+
+
+@dataclass(frozen=True)
+class HttpSprayModelClient:
+    """生产 HTTP 客户端（OpenAI chat/completions 多图，对照 request_spray.post）。
+
+    7 参考图顺序固定（1~4 正常 / 5~7 异常），待判定图为第 8 张。
+    pass1 thinking=True，pass2 thinking=False。
+    """
+
+    endpoint: str
+    api_key: str
+    model: str
+    ref_order_names: tuple[str, ...]  # 7 文件名（顺序）
+    timeout_seconds: float = 600.0
+    max_retries: int = 3
+    pass1_max_tokens: int = 4096
+    pass2_max_tokens: int = 256
+
+    def is_available(self) -> bool:
+        return bool(self.endpoint)
+
+    def _build_content(self, target_b64: str, ref_b64: list[str]) -> list[dict]:
+        content: list[dict] = []
+        for n, r in enumerate(ref_b64, 1):
+            content.append({"type": "text", "text": f"参考图{n}"})
+            content.append({"type": "image_url", "image_url": {"url": f"data:image/jpeg;base64,{r}"}})
+        content.append({"type": "text", "text": "待判定图"})
+        content.append({"type": "image_url", "image_url": {"url": f"data:image/jpeg;base64,{target_b64}"}})
+        return content
+
+    def _post(self, content: list[dict], prompt: str, thinking: bool, max_tokens: int) -> tuple[str, int]:
+        """有界重试 POST；返回 (raw_text, retries_used)。耗尽仍空 → SprayModelError。"""
+        import requests
+
+        last_err = "模型返回空内容"
+        for attempt in range(self.max_retries):
+            try:
+                resp = requests.post(
+                    self.endpoint,
+                    json={
+                        "model": self.model,
+                        "messages": [
+                            {"role": "system", "content": SPRAY_SYSTEM},
+                            {"role": "user", "content": content + [{"type": "text", "text": prompt}]},
+                        ],
+                        "max_tokens": max_tokens,
+                        "temperature": 0.0,
+                        "top_p": 0.95,
+                        "chat_template_kwargs": {"enable_thinking": thinking},
+                    },
+                    headers={"Authorization": f"Bearer {self.api_key}"},
+                    timeout=self.timeout_seconds,
+                )
+                resp.raise_for_status()
+                ch = resp.json()["choices"][0]
+                c = (ch["message"].get("content") or "").strip()
+                if c:
+                    return c, attempt
+                last_err = "模型返回空内容"
+            except Exception as exc:  # 网络/解析/HTTP
+                last_err = f"{type(exc).__name__}: {exc}"
+            if attempt < self.max_retries - 1:
+                time.sleep(2 * (attempt + 1))
+        raise SprayModelError(f"模型有界重试后仍失败：{last_err}")
+
+    def judge_frame(
+        self, target_bytes: bytes, ref_bytes: list[bytes], on_pass=None
+    ) -> tuple[str, str | None, int | None]:
+        if len(ref_bytes) != 7:
+            raise SprayModelError(f"参考图必须恰好 7 张（顺序固定），实际 {len(ref_bytes)}")
+        target_b64 = base64.b64encode(target_bytes).decode("ascii")
+        ref_b64 = [base64.b64encode(r).decode("ascii") for r in ref_bytes]
+        t0 = time.time()
+        content = self._build_content(target_b64, ref_b64)
+        refs_total = sum(len(r) for r in ref_bytes)
+        target_len = len(target_bytes)
+        p1_raw, r1 = self._post(content, SPRAY_PROMPT_V18, thinking=True, max_tokens=self.pass1_max_tokens)
+        if on_pass:
+            on_pass(
+                PassStat(
+                    prompt="V18",
+                    target_bytes=target_len,
+                    refs_bytes=refs_total,
+                    total_bytes=target_len + refs_total,
+                    retries=r1,
+                    elapsed_s=time.time() - t0,
+                )
+            )
+        p1v = _verdict_of(p1_raw)
+        if p1v == LABEL_SPRAY:
+            return p1_raw, None, None
+        t1 = time.time()
+        p2_raw, r2 = self._post(content, SPRAY_PROMPT_SIM, thinking=False, max_tokens=self.pass2_max_tokens)
+        p2n = _ref_num_of(p2_raw)
+        if on_pass:
+            on_pass(
+                PassStat(
+                    prompt="SIM",
+                    target_bytes=target_len,
+                    refs_bytes=refs_total,
+                    total_bytes=target_len + refs_total,
+                    retries=r2,
+                    elapsed_s=time.time() - t1,
+                )
+            )
+        return p1_raw, p2_raw, p2n
+
+
+def prompt_hashes() -> dict[str, str]:
+    """提示词/系统串 hash（进执行证据，改串=升 rules_revision）。"""
+    import hashlib
+
+    return {
+        "system": hashlib.sha256(SPRAY_SYSTEM.encode("utf-8")).hexdigest()[:16],
+        "v18": hashlib.sha256(SPRAY_PROMPT_V18.encode("utf-8")).hexdigest()[:16],
+        "sim": hashlib.sha256(SPRAY_PROMPT_SIM.encode("utf-8")).hexdigest()[:16],
+    }
