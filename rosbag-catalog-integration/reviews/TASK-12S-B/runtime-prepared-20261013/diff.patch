+# ===========================================================================
+# packet 解码：fake decoder（缺图 / 非零返回 / 序号歧义 / 成功）
+# ===========================================================================
+
+
+def _write_fake_decoder(path: Path, mode: str) -> Path:
+    shebang = "#!/usr/bin/env python3\n"
+    pcd_write = (
+        "def _w(p):\n"
+        "    p.write_text('# .PCD v0.7\\nVERSION 0.7\\nFIELDS x y z intensity\\nSIZE 4 4 4 4\\n"
+        "TYPE F F F F\\nCOUNT 1 1 1 1\\nWIDTH 1\\nHEIGHT 1\\nVIEWPOINT 0 0 0 1 0 0 0\\n"
+        "POINTS 1\\nDATA binary\\n', encoding='ascii')\n"
+        "    with p.open('ab') as f: f.write(b'\\x00'*16)\n"
+    )
+    if mode == "ok":
+        body = shebang + "import sys\nfrom pathlib import Path\n" + pcd_write + (
+            "out = Path(sys.argv[3]); out.mkdir(parents=True, exist_ok=True)\n"
+            "for i in range(12):\n"
+            "    _w(out / f'frame-{1700000000000+i:013d}.pcd')\n"
+        )
+    elif mode == "rc":
+        body = shebang + "import sys\nsys.stderr.write('decoder boom')\nsys.exit(3)\n"
+    elif mode == "count_mismatch":
+        body = shebang + "import sys\nfrom pathlib import Path\n" + pcd_write + (
+            "out = Path(sys.argv[3]); out.mkdir(parents=True, exist_ok=True)\n"
+            "for i in range(5):\n"
+            "    _w(out / f'frame-{1700000000000+i:013d}.pcd')\n"
+        )
+    path.write_text(body, encoding="utf-8")
+    path.chmod(0o755)
+    return path
