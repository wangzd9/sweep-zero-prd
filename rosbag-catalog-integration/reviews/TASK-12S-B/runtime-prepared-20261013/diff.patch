+"""spray 输入解码（TASK-12S-B，SPRAY-INTEGRATION §2/§3）。
+
+两条路线，按 sensor profile 选择（不 AND、不默默用后雷达）：
+- packet 路线（优先）：/iv_packets_front_mid（seyond/msg/SeyondScan）→ 已批准
+  packet2pointcloud（x86-64 动态 ELF，型号/依赖在处理机安装）→ 逐帧 binary PCD。
+- pointcloud 路线（替代）：/iv_points_front_mid_transformed（sensor_msgs/msg/PointCloud2，
+  x/y/z[/intensity]）→ 纯 stdlib CDR+struct 解析（不依赖 rosbags/sensor_msgs/numpy）。
+
+源时间：全程源 db3 存储整数纳秒（bag_io.read_messages），不做本地时间文件名回推。
+decoder 只输出 ms 截断 PCD 文件名时，按消息序号建立确定映射；重复/歧义拒绝。
+
+本模块不 import numpy/roslib（stdlib）；packet 子进程调用检查 returncode。
+真实 PCD 解码依赖处理机 libseyond*/rclcpp/pcl —— 缺失时明确 DECODER_UNAVAILABLE
+（不冒充 PASS，不迁 A100）。
+"""
+
+from __future__ import annotations
+
+import os
+import struct
+import subprocess
+from dataclasses import dataclass
+from pathlib import Path
+
+from app.scene.slope.bag_io import BagIoError, read_messages
+from app.scene.spray.pcd_io import PcdError, build_binary_pcd, parse_binary_pcd_header
+
+# 两路线 topic（RAW-DATA-REQUIREMENTS §1）
+PACKET_TOPIC = "/iv_packets_front_mid"
+PACKET_TYPE = "seyond/msg/SeyondScan"
+POINTCLOUD_TOPIC = "/iv_points_front_mid_transformed"
+POINTCLOUD_TYPE = "sensor_msgs/msg/PointCloud2"
+
+# sensor profile → 路线
+ROUTE_PACKET = "packet"
+ROUTE_POINTCLOUD = "pointcloud"
+ROUTE_AUTO = "auto"
+
+_MS_PCD_SUFFIX = (".pcd",)
+
+
+class DecodeError(Exception):
+    """解码失败（区别于 NOT_APPLICABLE：topic 存在但解不出有效数据）。"""
+
+    def __init__(self, code: str, detail: str = ""):
+        self.code = code
+        self.detail = detail or code
+        super().__init__(f"{code}: {self.detail}" if detail else code)
+
+
+@dataclass(frozen=True)
+class SprayFrame:
+    """一帧源时间 + 解码产物（PCD 路径或点云数组）。"""
+
+    storage_ns: int
+    pcd_path: Path | None = None
+    points: tuple[tuple[float, float, float], ...] | None = None
+    intensity: tuple[float, ...] | None = None
+    route: str = ""
+
+
+# ---------------------------------------------------------------------------
+# PointCloud2 纯 stdlib 解析（替代路线）
+# ---------------------------------------------------------------------------
+
+# intensity 字段按 datatype 的 struct 小端格式（默认 FLOAT32）
+_INTENSITY_FMT = {1: "<b", 2: "<B", 3: "<h", 4: "<H", 5: "<i", 6: "<I", 7: "<f", 8: "<d"}
+
+
+def _p2_align4(pos: int, base: int) -> int:
+    return pos + (4 - (pos - base)) % 4
+
+
+def parse_pointcloud2(
+    data: bytes, *, require_intensity: bool = True
+) -> tuple[list[tuple[float, float, float]], list[float] | None]:
+    """解析 sensor_msgs/msg/PointCloud2 CDR（含 ROS2 封装头），提取 x/y/z[/intensity]。
+
+    字段布局校验：x/y/z 必须存在且为 FLOAT32；intensity 缺失时（require_intensity）
+    抛 DecodeError（不默默换配色）。未知字段/布局错位 → DecodeError（不猜测）。
+    返回 (points, intensity)；points 顺序 = 消息内行主序（height*width）。
+    """
+    # 封装头检测（与 slope.cdr 同特征：00 01 00 00 小端 CDR_LE）
+    order, base = "<", 0
+    if len(data) >= 4 and data[0] in (0, 1) and data[2:4] == b"\x00\x00" and (data[0], data[1]) in ((0, 1), (1, 2)):
+        order = "<" if data[0] == 0 else ">"
+        base = 4
+    pos = base
+    # header (std_msgs/Header): Time(sec i, nanosec I) + frame_id string
+    pos = _p2_align4(pos, base)
+    sec, nanosec = struct.unpack_from(f"{order}iI", data, pos)
+    pos += 8
+    pos = _p2_align4(pos, base)
+    (str_len,) = struct.unpack_from(f"{order}I", data, pos)
+    pos += 4
+    if pos + str_len > len(data):
+        raise DecodeError("P2_TRUNCATED", "PointCloud2 header frame_id 越界")
+    pos += str_len
+    # height/width (uint32 each)
+    pos = _p2_align4(pos, base)
+    height, width = struct.unpack_from(f"{order}II", data, pos)
+    pos += 8
+    # fields: sequence<PointField>
+    pos = _p2_align4(pos, base)
+    (nfields,) = struct.unpack_from(f"{order}I", data, pos)
+    pos += 4
+    fields: list[tuple[str, int, int, int]] = []  # (name, offset, datatype, count)
+    for _ in range(nfields):
+        pos = _p2_align4(pos, base)
+        (fname_len,) = struct.unpack_from(f"{order}I", data, pos)
+        pos += 4
+        if pos + fname_len > len(data):
+            raise DecodeError("P2_TRUNCATED", "PointCloud2 field name 越界")
+        fname = data[pos : pos + fname_len].rstrip(b"\x00").decode("utf-8", "replace")
+        pos += fname_len
+        # PointField: name(str) offset(uint32) datatype(uint8) count(uint8)
+        (f_off,) = struct.unpack_from(f"{order}I", data, pos)
+        pos += 4
+        f_dt = data[pos]
+        f_cnt = data[pos + 1]
+        pos += 2
+        fields.append((fname, f_off, f_dt, f_cnt if f_cnt > 0 else 1))
+    # is_bigendian(uint8) + point_step(uint32)
+    is_be = data[pos]
+    pos += 1
+    pos = _p2_align4(pos, base)
+    (point_step,) = struct.unpack_from(f"{order}I", data, pos)
+    pos += 4
+    # row_step(uint32)
+    (row_step,) = struct.unpack_from(f"{order}I", data, pos)
+    pos += 4
+    # data: sequence<uint8>
+    pos = _p2_align4(pos, base)
+    (data_len,) = struct.unpack_from(f"{order}I", data, pos)
+    pos += 4
+    if pos + data_len > len(data):
+        raise DecodeError("P2_TRUNCATED", f"PointCloud2 data 越界：需 {data_len} 剩 {len(data) - pos}")
+    blob = data[pos : pos + data_len]
+
+    by_name = {f[0]: f for f in fields}
+    for req in ("x", "y", "z"):
+        if req not in by_name:
+            raise DecodeError("P2_LAYOUT", f"PointCloud2 缺必需字段 {req}（实际 {list(by_name)}）")
+        if by_name[req][2] != 7:
+            raise DecodeError("P2_LAYOUT", f"PointCloud2 字段 {req} 非 FLOAT32（datatype={by_name[req][2]}）")
+    has_intensity = "intensity" in by_name
+    if require_intensity and not has_intensity:
+        raise DecodeError("P2_NO_INTENSITY", "PointCloud2 缺 intensity 字段，不能默默换渲染配色（SPRAY §2）")
+    fmt = "<" if not is_be else ">"
+    n = int(height * width)
+    if n <= 0:
+        raise DecodeError("P2_EMPTY", "PointCloud2 宽高为 0，无有效点")
+    # 期望数据长度（含 point_step 对齐）：n * point_step
+    if len(blob) < n * point_step:
+        raise DecodeError("P2_TRUNCATED", f"PointCloud2 数据长度 {len(blob)} < 期望 {n * point_step}")
+    points: list[tuple[float, float, float]] = []
+    intensities: list[float] | None = [] if has_intensity else None
+    ox, oy, oz = by_name["x"][1], by_name["y"][1], by_name["z"][1]
+    oi: int | None = None
+    i_fmt = "<f"
+    if has_intensity:
+        oi = by_name["intensity"][1]
+        i_fmt = _INTENSITY_FMT.get(by_name["intensity"][2], "<f")
+    for k in range(n):
+        base_off = k * point_step
+        x = struct.unpack_from(f"{fmt}f", blob, base_off + ox)[0]
+        y = struct.unpack_from(f"{fmt}f", blob, base_off + oy)[0]
+        z = struct.unpack_from(f"{fmt}f", blob, base_off + oz)[0]
+        # 非有限点（NaN/inf）跳过计数，但保留位置（对照实现按索引上色）
+        points.append((x, y, z))
+        if intensities is not None and oi is not None:
+            v = struct.unpack_from(i_fmt, blob, base_off + oi)[0]
+            intensities.append(float(v))
+    return points, intensities
+
+
+# ---------------------------------------------------------------------------
+# packet 路线：packet2pointcloud 子进程 + 源 ns 序号映射
+# ---------------------------------------------------------------------------
+
+
+def _sorted_ms_pcds(out_dir: Path) -> list[Path]:
+    """decoder 输出的 PCD（ms 截断命名），按文件名升序（= 源消息序号）。"""
+    return sorted(p for p in out_dir.iterdir() if p.suffix in _MS_PCD_SUFFIX and p.is_file())
+
+
+def decode_packet_route(
+    bag_dir: Path,
+    work_dir: Path,
+    decoder_path: str | Path,
+    *,
+    cancel_check=None,
+) -> list[SprayFrame]:
+    """packet 路线：调 packet2pointcloud 逐 db3 → PCD 目录，映射源 db3 存储 ns。
+
+    - 检查子进程 returncode（非 0 → DECODER_FAILED，对照实现未检查 returncode 的缺陷）；
+    - 无 PCD 输出 → DECODE_FAILED（decoder 空输出，不冒充无命中）；
+    - 源 ns 映射：read_messages(PACKET_TOPIC) 的存储 ns 升序 = PCD 序号序；
+      序号数不一致或出现重复/歧义 → DECODE_FAILED（不冒充 ms×1e6）。
+    """
+    bag_dir = Path(bag_dir)
+    work_dir = Path(work_dir)
+    decoder = Path(decoder_path)
+    if not decoder.is_file():
+        raise DecodeError("DECODER_UNAVAILABLE", f"packet2pointcloud 缺失：{decoder}（型号/依赖处理机安装）")
+    if not os.access(decoder, os.X_OK):
+        raise DecodeError("DECODER_UNAVAILABLE", f"packet2pointcloud 不可执行：{decoder}")
+    # 源消息存储 ns 升序（bag_io 多库合并升序）
+    try:
+        src_msgs = read_messages(bag_dir, topic=PACKET_TOPIC)
+    except BagIoError as exc:
+        raise DecodeError("BAG_READ_FAILED", str(exc)) from exc
+    if not src_msgs:
+        raise DecodeError("DECODE_FAILED", f"{PACKET_TOPIC} 无消息")
+    pcd_dir = work_dir / "pcd"
+    pcd_dir.mkdir(parents=True, exist_ok=True)
+    from app.scene.slope.bag_io import find_db3_files
+
+    try:
+        db3s = find_db3_files(bag_dir)
+    except BagIoError as exc:
+        raise DecodeError("BAG_READ_FAILED", str(exc)) from exc
+    for db3 in db3s:
+        if cancel_check is not None and cancel_check():
+            raise DecodeError("CANCELLED", "decoder 阶段收到取消信号")
+        proc = subprocess.run(
+            [str(decoder), str(db3), PACKET_TOPIC, str(pcd_dir)],
+            capture_output=True,
+            text=True,
+            timeout=3600,
+        )
+        if proc.returncode != 0:
+            tail = (proc.stderr or proc.stdout or "").strip()[-400:]
+            raise DecodeError("DECODER_FAILED", f"packet2pointcloud rc={proc.returncode} {db3.name}：{tail}")
+    pc_ds = _sorted_ms_pcds(pcd_dir)
+    if not pc_ds:
+        raise DecodeError("DECODE_FAILED", f"decoder 无 PCD 输出（{len(src_msgs)} 条源消息）")
+    if len(pc_ds) != len(src_msgs):
+        raise DecodeError(
+            "DECODE_FAILED",
+            f"PCD 数 {len(pc_ds)} != 源消息数 {len(src_msgs)}，序号映射歧义（重复/缺失），拒绝冒充",
+        )
+    # 逐序号映射源存储 ns（升序）；同一 ns 多次出现不歧义（帧序号唯一）
+    frames: list[SprayFrame] = []
+    for idx, pcd in enumerate(pc_ds):
+        try:
+            parse_binary_pcd_header(pcd)  # 头合法性（可解码），无 intensity 不在此拒（渲染层判）
+        except PcdError as exc:
+            raise DecodeError("DECODE_FAILED", f"PCD 头非法 {pcd.name}：{exc}") from exc
+        frames.append(SprayFrame(storage_ns=src_msgs[idx].timestamp_ns, pcd_path=pcd, route=ROUTE_PACKET))
+    return frames
+
+
+def decode_pointcloud_route(bag_dir: Path, work_dir: Path, *, require_intensity: bool = True) -> list[SprayFrame]:
+    """pointcloud 路线：纯 stdlib 解析 PointCloud2 → 写 PCD（统一下游渲染面）。"""
+    bag_dir = Path(bag_dir)
+    work_dir = Path(work_dir)
+    try:
+        src_msgs = read_messages(bag_dir, topic=POINTCLOUD_TOPIC)
+    except BagIoError as exc:
+        raise DecodeError("BAG_READ_FAILED", str(exc)) from exc
+    if not src_msgs:
+        raise DecodeError("DECODE_FAILED", f"{POINTCLOUD_TOPIC} 无消息")
+    pcd_dir = work_dir / "pcd"
+    pcd_dir.mkdir(parents=True, exist_ok=True)
+    frames: list[SprayFrame] = []
+    for idx, m in enumerate(src_msgs):
+        points, intensities = parse_pointcloud2(m.data, require_intensity=require_intensity)
+        pcd = build_binary_pcd(pcd_dir / f"frame_{idx:06d}.pcd", points, intensities)
+        frames.append(
+            SprayFrame(
+                storage_ns=m.timestamp_ns,
+                pcd_path=pcd,
+                points=tuple(points),
+                intensity=tuple(intensities) if intensities is not None else None,
+                route=ROUTE_POINTCLOUD,
+            )
+        )
+    return frames
