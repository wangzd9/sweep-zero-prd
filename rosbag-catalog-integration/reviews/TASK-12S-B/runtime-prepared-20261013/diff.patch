+"""spray 能力/资产预检（TASK-12S-B，§2/§3 部署预检）。
+
+descriptor 与真实 adapter 同一 owner：源码在但依赖缺失时返回**明确
+unavailable_reason**（decoder 二进制/共享库、Open3D/EGL 或软件渲染、参考图清单），
+**不宣称 enabled 即可用**。预检只读、不改原包、不迁 A100。
+
+预检项（SPRAY-INTEGRATION §3 平台部署预检）：
+- 参考图 7 文件清单（hash/bytes/顺序/JPEG 可解码）→ REFERENCE_MISSING / MISMATCH；
+- decoder packet2pointcloud（文件存在 + 可执行 + 关键共享库 ldd）→ DECODER_*；
+- Open3D/numpy（渲染依赖）→ RENDER_UNAVAILABLE（本机探针口径，不迁 A100）；
+- 模型多图接口（client.is_available）→ MODEL_UNAVAILABLE。
+
+预检结果进能力描述不可用原因 + 执行证据；enabled 起步 false，资产/依赖未核实
+不宣称可用（config/scene_capabilities.yaml spray-v1 descriptor enabled=false）。
+"""
+
+from __future__ import annotations
+
+import os
+import subprocess
+from dataclasses import dataclass
+from pathlib import Path
+
+from app.scene.spray.references import REFERENCES, ReferenceError, verify_references
+
+# decoder 关键共享库（缺任一 → 处理机未装解码依赖；本机探针口径）
+_DECODER_REQUIRED_LIBS = (
+    "libseyond",  # 雷达 SDK（libseyond__rosidl_typesupport_cpp 等）
+    "librclcpp",  # ROS2 C++ 客户端
+    "libpcl",  # 点云库
+)
+
+
+@dataclass(frozen=True)
+class PrecheckResult:
+    """单项预检：ok + 不可用原因（ok=False 时）。"""
+
+    ok: bool
+    reason: str | None = None
+    detail: str = ""
+
+
+@dataclass
+class SprayPrecheck:
+    """整体预检汇总（进能力不可用原因 + 执行证据）。"""
+
+    references: PrecheckResult
+    decoder: PrecheckResult
+    render: PrecheckResult
+    model: PrecheckResult
+
+    @property
+    def all_ok(self) -> bool:
+        return self.references.ok and self.decoder.ok and self.render.ok and self.model.ok
+
+    def unavailable_reasons(self) -> list[str]:
+        out = []
+        for name, r in (
+            ("references", self.references),
+            ("decoder", self.decoder),
+            ("render", self.render),
+            ("model", self.model),
+        ):
+            if not r.ok:
+                out.append(f"{name}: {r.reason} {r.detail}".strip())
+        return out
+
+    def to_dict(self) -> dict:
+        return {
+            "ok": self.all_ok,
+            "all_ok": self.all_ok,
+            "unavailable_reasons": self.unavailable_reasons(),
+            "references": {
+                "ok": self.references.ok,
+                "reason": self.references.reason,
+                "detail": self.references.detail,
+            },
+            "decoder": {"ok": self.decoder.ok, "reason": self.decoder.reason, "detail": self.decoder.detail},
+            "render": {"ok": self.render.ok, "reason": self.render.reason, "detail": self.render.detail},
+            "model": {"ok": self.model.ok, "reason": self.model.reason, "detail": self.model.detail},
+        }
+
+
+def check_references() -> PrecheckResult:
+    try:
+        v = verify_references(REFERENCES)
+    except ReferenceError as exc:
+        msg = str(exc)
+        reason = "REFERENCE_MISSING" if "REFERENCE_MISSING" in msg else "REFERENCE_MISMATCH"
+        return PrecheckResult(ok=False, reason=reason, detail=msg)
+    except Exception as exc:
+        return PrecheckResult(ok=False, reason="REFERENCE_ERROR", detail=str(exc))
+    detail = f"7/7 校验通过 ordered_hash={v.ordered_hash[:16]} total_bytes={v.total_bytes}"
+    return PrecheckResult(ok=True, detail=detail)
+
+
+def _ldd_missing_libs(executable: Path) -> list[str]:
+    """对 decoder 做 ldd，返回缺失（not found）的关键共享库族。"""
+    try:
+        proc = subprocess.run(["ldd", str(executable)], capture_output=True, text=True, timeout=30)
+    except (OSError, subprocess.TimeoutExpired) as exc:
+        return [f"ldd 失败：{exc}"]
+    missing = [ln.strip() for ln in (proc.stdout or "").splitlines() if "not found" in ln]
+    return missing
+
+
+def check_decoder(decoder_path: str | Path | None = None) -> PrecheckResult:
+    """decoder 预检：文件存在 + 可执行 + 关键共享库（libseyond/rclcpp/pcl）。"""
+    default = Path("/home/wang/work/ros2_slice/utils/packet2pointcloud")
+    exe = Path(decoder_path) if decoder_path else default
+    if not exe.is_file():
+        detail = f"packet2pointcloud 缺失：{exe}（型号/依赖处理机安装）"
+        return PrecheckResult(ok=False, reason="DECODER_UNAVAILABLE", detail=detail)
+    if not os.access(exe, os.X_OK):
+        return PrecheckResult(ok=False, reason="DECODER_UNAVAILABLE", detail=f"不可执行：{exe}")
+    missing = _ldd_missing_libs(exe)
+    missing_families = sorted({m.split(".so")[0] for m in missing})
+    required_missing = [fam for fam in _DECODER_REQUIRED_LIBS if any(fam in mf for mf in missing_families)]
+    if required_missing:
+        detail = (
+            f"decoder 关键共享库缺失（处理机需安装）：{', '.join(required_missing)}"
+            f"；ldd not found {len(missing)} 项"
+        )
+        return PrecheckResult(ok=False, reason="DECODER_DEPS_MISSING", detail=detail)
+    return PrecheckResult(ok=True, detail=f"{exe.name} 可执行，关键共享库在位（ldd not found {len(missing)}）")
+
+
+def check_render() -> PrecheckResult:
+    """Open3D/numpy 渲染依赖预检（本机口径；EGL/软件渲染需处理机实测）。"""
+    missing = []
+    try:
+        import numpy  # noqa: F401
+    except Exception:
+        missing.append("numpy")
+    try:
+        import open3d  # noqa: F401
+    except Exception:
+        missing.append("open3d")
+    if missing:
+        detail = f"渲染依赖缺失：{', '.join(missing)}（处理机安装；EGL/软件渲染实测未在本机）"
+        return PrecheckResult(ok=False, reason="RENDER_UNAVAILABLE", detail=detail)
+    return PrecheckResult(ok=True, detail="numpy/open3d 在位（EGL 离屏渲染需处理机实测）")
+
+
+def check_model(model_client) -> PrecheckResult:
+    if model_client is None:
+        detail = "服务端未配置 spray 模型客户端（model_profile 引用缺失）"
+        return PrecheckResult(ok=False, reason="MODEL_UNAVAILABLE", detail=detail)
+    try:
+        if not model_client.is_available():
+            return PrecheckResult(ok=False, reason="MODEL_UNAVAILABLE", detail="模型端点未配置")
+    except Exception as exc:
+        return PrecheckResult(ok=False, reason="MODEL_ERROR", detail=str(exc))
+    return PrecheckResult(ok=True)
+
+
+def run_precheck(decoder_path: str | Path | None = None, model_client=None) -> SprayPrecheck:
+    return SprayPrecheck(
+        references=check_references(),
+        decoder=check_decoder(decoder_path),
+        render=check_render(),
+        model=check_model(model_client),
+    )
