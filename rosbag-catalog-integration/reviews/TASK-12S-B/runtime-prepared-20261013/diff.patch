@@ -0,0 +1,78 @@
+"""spray 源时间映射（TASK-12S-B，SPRAY-INTEGRATION §2/§4）。
+
+全程**源 DB3 存储时间整数纳秒**：
+- 不从本地时间文件名/毫秒 round 回推；
+- 旧 decoder 只输出 ms 截断文件名时，由工作副本/包装层建立确定映射并检验，
+  重复/歧义拒绝，**不把 ms×1e6 冒充源 ns**；
+- 映射依据写入 mapping_basis 证据（本场景固定 bag_storage_ns，offset=0，
+  scene_publish_service.derive_storage_offset 已支持该 basis 返回 0）。
+
+对照实现 pdc_to_pic 用 `datetime.fromtimestamp` 把文件名秒→本地 epoch→毫秒
+（无时区字符串回推 + round 丢精度）；本模块**禁止**该路径，一律用源 db3
+messages.timestamp 整数纳秒作为帧时间轴。
+"""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+
+# mapping_basis 取值：spray 场景固定 bag 存储轴（与 slope.time_map 同常量域）
+MAPPING_BAG_STORAGE = "bag_storage_ns"
+
+# 源 db3 文件名毫秒截断签名：<name>-<13位毫秒>（decoder 只输出 ms 时的回退路径）
+_MS_NAME_RE = re.compile(r"-(\d{13})$")
+
+
+@dataclass(frozen=True)
+class SprayFrameTime:
+    """一帧的确定源时间映射结果。"""
+
+    storage_ns: int
+    basis: str
+    # 若由 ms 文件名回退推断（仅在源 db3 存在对应消息且唯一匹配时），标记 inferred=True
+    inferred: bool = False
+
+
+def resolve_storage_ns(
+    file_ms: int | None,
+    candidates_ns: list[int],
+) -> SprayFrameTime:
+    """从 ms 文件名 + 候选源 db3 存储 ns 建立确定映射。
+
+    - 无 candidates_ns：拒绝（无法确定源轴，不冒充 ms×1e6）。
+    - 有 candidates_ns：取与 file_ms（若给定）最近的候选；
+      若最近距离 < 1ms（确定性唯一）且仅一个候选在该容差内 → 命中，basis 标 inferred；
+      否则歧义 → 抛 ValueError（重复/歧义拒绝，SPRAY §2）。
+    - file_ms 为 None 时直接取候选唯一值（多候选歧义拒绝）。
+    """
+    if not candidates_ns:
+        raise ValueError("无源 db3 存储时间候选，不能从 ms 文件名冒充源 ns（SPRAY §2）")
+    if file_ms is None:
+        if len(candidates_ns) != 1:
+            raise ValueError(f"候选存储时间歧义（{len(candidates_ns)} 个），拒绝回退映射")
+        return SprayFrameTime(storage_ns=candidates_ns[0], basis=MAPPING_BAG_STORAGE, inferred=True)
+    # file_ms 给定：找 1ms 容差内候选
+    window_ns = 1_000_000
+    target_lo = file_ms * 1_000_000 - window_ns
+    target_hi = file_ms * 1_000_000 + window_ns
+    hits = [c for c in candidates_ns if target_lo <= c <= target_hi]
+    if len(hits) == 0:
+        # 放宽到最近候选，但要求唯一最近且距离 < 50ms（防止跨帧误配）
+        nearest = min(candidates_ns, key=lambda c: abs(c - file_ms * 1_000_000))
+        dist = abs(nearest - file_ms * 1_000_000)
+        if dist >= 50_000_000:
+            raise ValueError(f"ms 文件名与候选源时间最近距离 {dist // 1_000_000}ms 过远，拒绝映射")
+        hits = [nearest]
+    if len(hits) > 1:
+        raise ValueError(f"ms 文件名 {file_ms} 命中 {len(hits)} 个候选源时间，歧义拒绝")
+    return SprayFrameTime(storage_ns=hits[0], basis=MAPPING_BAG_STORAGE, inferred=len(candidates_ns) > 1)
+
+
+def ms_from_filename(name: str) -> int | None:
+    """从 PCD/JPG 文件名尾段提取 13 位 ms（对照实现命名约定）。无则 None。"""
+    stem = name.rsplit(".", 1)[0]
+    m = _MS_NAME_RE.search(stem)
+    if m:
+        return int(m.group(1))
+    return None
