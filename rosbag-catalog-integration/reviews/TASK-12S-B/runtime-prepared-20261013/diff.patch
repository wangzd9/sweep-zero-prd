@@ -0,0 +1,101 @@
+"""spray run/attempt 私有工作目录 + manifest/hash 判断缓存（TASK-12S-B，§2/§3）。
+
+- **禁止「目录非空」判完成**：缓存命中必须逐字段核对完整身份键
+  （能力版本+规则修订+模型+参考图有序 hash+预处理参数+源指纹+帧存储 ns 序列+
+  decoder/render 修订）；
+- **禁止 PCD/图/cache 写原包内**：一切产物落 run 私有 work_dir（request.work_dir）；
+- 改变参考图/规则/参数/源指纹 → 缓存失效不复用旧判断。
+
+写失败降级为无缓存（缓存是优化不是事实来源，对照 slope.cache 口径）。
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+from dataclasses import dataclass
+from pathlib import Path
+
+SCHEMA_VERSION = 1
+
+
+def _sha(b: bytes) -> str:
+    return hashlib.sha256(b).hexdigest()
+
+
+@dataclass(frozen=True)
+class SprayCacheKey:
+    """完整身份键（任一不同即失效）。"""
+
+    capability_version: str
+    rules_revision: str
+    model_profile: str
+    ref_ordered_hash: str  # 7 参考图按序 hash 链（改变参考图→失效）
+    preprocessing: dict  # 冻结参数（skip/interval/ROI/quality/threshold）
+    source_fingerprint: str
+    frames: tuple[tuple[int, str], ...]  # (storage_ns, pcd hash 16)
+    decoder_revision: str
+    render_revision: str
+    segment_params: dict  # window/ratio/enter/exit/lead/merge
+
+
+def key_digest(key: SprayCacheKey) -> str:
+    payload = {
+        "schema_version": SCHEMA_VERSION,
+        "capability_version": key.capability_version,
+        "rules_revision": key.rules_revision,
+        "model_profile": key.model_profile,
+        "ref_ordered_hash": key.ref_ordered_hash,
+        "preprocessing": key.preprocessing,
+        "source_fingerprint": key.source_fingerprint,
+        "frames": [list(f) for f in key.frames],
+        "decoder_revision": key.decoder_revision,
+        "render_revision": key.render_revision,
+        "segment_params": key.segment_params,
+    }
+    blob = json.dumps(payload, ensure_ascii=False, sort_keys=True, separators=(",", ":"))
+    return _sha(blob.encode())
+
+
+class SprayResultCache:
+    """JSON 文件缓存（落 run 私有 work_dir/model_results.json）。"""
+
+    def __init__(self, work_dir: Path):
+        self._path = work_dir / "spray_model_results.json"
+
+    def load(self) -> dict | None:
+        if not self._path.exists():
+            return None
+        try:
+            data = json.loads(self._path.read_text(encoding="utf-8"))
+        except (OSError, json.JSONDecodeError):
+            return None
+        if not isinstance(data, dict) or data.get("schema_version") != SCHEMA_VERSION:
+            return None
+        return data
+
+    def hit(self, digest: str, expected_frame_count: int) -> dict | None:
+        """命中条件：schema + key 逐字段一致 + 帧数一致。否则 None（不复用）。"""
+        data = self.load()
+        if data is None:
+            return None
+        if data.get("cache_key") != digest:
+            return None
+        results = data.get("results")
+        if not isinstance(results, list) or len(results) != expected_frame_count:
+            return None
+        return data
+
+    def save(self, *, digest: str, results: list[dict]) -> None:
+        try:
+            self._path.parent.mkdir(parents=True, exist_ok=True)
+            self._path.write_text(
+                json.dumps(
+                    {"schema_version": SCHEMA_VERSION, "cache_key": digest, "results": results},
+                    ensure_ascii=False,
+                    sort_keys=True,
+                ),
+                encoding="utf-8",
+            )
+        except OSError:
+            pass
