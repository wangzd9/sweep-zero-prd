+"""spray 点云 PCD 纯 I/O（TASK-12S-B）。
+
+只依赖标准库（struct/os/pathlib）：
+- binary PCD 头解析 + intensity 抽取（渲染/上色前的确定性层）；
+- 测试 fixture 用 binary PCD 构造（x/y/z[/intensity]，WIDTH=点数、HEIGHT=1）。
+
+真实渲染（Open3D OffscreenRenderer + EGL/软件渲染）属处理机资源，见 render 段；
+本模块不 import numpy/open3d，保证无依赖环境下映射/分段/预检可测。
+"""
+
+from __future__ import annotations
+
+import struct
+from dataclasses import dataclass
+from pathlib import Path
+
+__all__ = ["PcdError", "parse_binary_pcd_header", "read_intensity", "build_binary_pcd"]
+
+
+class PcdError(Exception):
+    """PCD 头解析/格式非法。"""
+
+
+@dataclass(frozen=True)
+class PcdHeader:
+    """binary PCD 头部关键字段。"""
+
+    data_format: str
+    fields: tuple[str, ...]
+    sizes: tuple[int, ...]
+    types: tuple[str, ...]
+    counts: tuple[int, ...]
+    width: int
+    height: int
+    points: int
+    data_start: int
+
+    @property
+    def point_step(self) -> int:
+        return sum(self.sizes)
+
+    def has_intensity(self) -> bool:
+        return "intensity" in self.fields
+
+
+def parse_binary_pcd_header(path: Path | str) -> PcdHeader:
+    """解析 PCD 头，返回 DATA 段起始偏移。仅支持 binary / ascii。
+
+    头不合法（缺 FIELDS/SIZE/TYPE/COUNT/POINTS/DATA）抛 PcdError。
+    """
+    p = Path(path)
+    try:
+        raw = p.read_bytes()
+    except OSError as exc:
+        raise PcdError(f"PCD 不可读：{p}：{exc}") from exc
+    # 头最多 4096 字节（对照实现口径），DATA 段起点在头内定位
+    head = raw[:4096].decode("utf-8", errors="ignore")
+    lines = head.split("\n")
+    fields: list[str] = []
+    sizes: list[int] = []
+    types: list[str] = []
+    counts: list[int] = []
+    width = height = points = 0
+    data_format = ""
+    data_line_pos = -1
+    for i, line in enumerate(lines):
+        s = line.strip()
+        parts = s.split()
+        if not parts:
+            continue
+        key = parts[0].upper()
+        if key == "FIELDS":
+            fields = parts[1:]
+        elif key == "SIZE":
+            sizes = [int(x) for x in parts[1:]]
+        elif key == "TYPE":
+            types = parts[1:]
+        elif key == "COUNT":
+            counts = [int(x) for x in parts[1:]]
+        elif key == "WIDTH":
+            width = int(parts[1])
+        elif key == "HEIGHT":
+            height = int(parts[1])
+        elif key == "POINTS":
+            points = int(parts[1])
+        elif key == "DATA":
+            data_format = parts[1].lower()
+            data_line_pos = i
+            break
+    if data_line_pos < 0 or not fields or not sizes or not types:
+        raise PcdError(f"PCD 头缺失关键字段：{p.name}")
+    if data_format not in {"binary", "ascii", "binary_compressed"}:
+        raise PcdError(f"PCD DATA 格式不支持：{data_format!r}（仅 binary/ascii）")
+    # DATA 段起点 = DATA 行之后一行的行首偏移
+    data_start = sum(len(ln) + 1 for ln in lines[: data_line_pos + 1])
+    if len(sizes) != len(fields) or len(counts) != len(fields):
+        raise PcdError(f"PCD FIELDS/SIZE/COUNT 长度不一致：{p.name}")
+    return PcdHeader(
+        data_format=data_format,
+        fields=tuple(fields),
+        sizes=tuple(sizes),
+        types=tuple(types),
+        counts=tuple(counts),
+        width=width,
+        height=height,
+        points=points,
+        data_start=data_start,
+    )
+
+
+def read_intensity(path: Path | str) -> list[float]:
+    """抽取 intensity 字段值序列（无 intensity 抛 PcdError）。binary 逐点解析。"""
+    header = parse_binary_pcd_header(path)
+    if not header.has_intensity():
+        raise PcdError(f"PCD 无 intensity 字段：{Path(path).name}（可用 {header.fields}）")
+    if header.data_format == "ascii":
+        p = Path(path)
+        vals: list[float] = []
+        idx = header.fields.index("intensity")
+        head_lines = p.read_bytes()[: header.data_start].decode("utf-8", errors="ignore").split("\n")
+        with p.open("r", encoding="utf-8") as f:
+            for _ in range(len(head_lines)):
+                f.readline()
+            for line in f:
+                parts = line.split()
+                if len(parts) > idx:
+                    vals.append(float(parts[idx]))
+        return vals
+    if header.data_format != "binary":
+        raise PcdError(f"PCD 格式不支持 intensity 抽取：{header.data_format}")
+    p = Path(path)
+    raw = p.read_bytes()
+    idx = header.fields.index("intensity")
+    point_step = header.point_step
+    offset = sum(header.sizes[:idx])
+    size = header.sizes[idx]
+    type_char = header.types[idx]
+    fmt = {"F": "<f", "I": "<I", "U": "<I", "i": "<i", "d": "<d"}.get(type_char)
+    if fmt is None:
+        raise PcdError(f"intensity 类型不支持：{type_char!r}")
+    n = header.points if header.points > 0 else header.width
+    vals = []
+    for k in range(n):
+        base = header.data_start + k * point_step
+        chunk = raw[base + offset : base + offset + size]
+        if len(chunk) < size:
+            break
+        vals.append(struct.unpack(fmt, chunk)[0])
+    return vals
+
+
+def build_binary_pcd(
+    path: Path | str, points: list[tuple[float, float, float]], intensity: list[float] | None = None
+) -> Path:
+    """构造 binary PCD（x/y/z[/intensity]，WIDTH=点数、HEIGHT=1）。测试 fixture 用。"""
+    p = Path(path)
+    p.parent.mkdir(parents=True, exist_ok=True)
+    has_i = intensity is not None
+    n = len(points)
+    fields = "x y z intensity" if has_i else "x y z"
+    header = (
+        "# .PCD v0.7 - Point Cloud Data file format\n"
+        "VERSION 0.7\n"
+        f"FIELDS {fields}\n"
+        f"SIZE {'4 4 4 4' if has_i else '4 4 4'}\n"
+        f"TYPE {'F F F F' if has_i else 'F F F'}\n"
+        f"COUNT {'1 1 1 1' if has_i else '1 1 1'}\n"
+        f"WIDTH {n}\n"
+        "HEIGHT 1\n"
+        "VIEWPOINT 0 0 0 1 0 0 0\n"
+        f"POINTS {n}\n"
+        "DATA binary\n"
+    )
+    with p.open("wb") as f:
+        f.write(header.encode("ascii"))
+        for k in range(n):
+            x, y, z = points[k]
+            f.write(struct.pack("<fff", x, y, z))
+            if has_i:
+                f.write(struct.pack("<f", intensity[k]))
+    return p
