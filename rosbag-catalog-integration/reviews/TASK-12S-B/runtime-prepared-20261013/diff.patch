+def build_no_intensity_bag(tmp: Path) -> Path:
+    bag = tmp / "pc_noint"
+    msgs = []
+    for i in range(3):
+        ts = BASE_TS + i * NANO
+        payload = build_pointcloud2_cdr(ts // NANO, ts % NANO, [(1.0, 1.0, 1.0, 0.0)], with_intensity=False)
+        msgs.append(_msg(POINT_TOPIC, POINT_TYPE, ts, payload))
+    build_single_db3(bag / "r.db3", msgs)
+    return bag
