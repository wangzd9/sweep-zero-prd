+++ b/tests/test_spray_adapter.py
@@ -0,0 +1,952 @@
+"""spray 适配器测试（TASK-12S-B）。
+
+覆盖派单 §9 测试面（合成已知命中/正常、字符串冲突归一、未知/空/空模型 FAILED、
+缺 topic NOT_APPLICABLE、缺图/非零 converter 返回、PointCloud 字段布局/强度校验、
+短包/边界/乱序/多 DB3、源不变/取消/缓存版本）+ AC-17.1/17.2/17.3 关键证据。
+
+真实渲染/模型探针依赖处理机（numpy/open3d/decoder 共享库）与模型端点；本套在
+开发机用确定性替身（fake decoder / monkeypatch render / fake model client）跑
+完整管线逻辑，真实参考图用 /home/wang/work/ros2_slice/images/refs（7/7 受控清单）。
+"""
+
+from __future__ import annotations
+
+import json
+import struct
+import sys
+from pathlib import Path
+
+import pytest
+
+# 共享 fixture（rosbag2 sqlite3 bag 构造）在 tests/ 下
+sys.path.insert(0, str(Path(__file__).parent))
+from scene_fixture import build_single_db3  # noqa: E402
+
+BASE_TS = 1_700_000_000_000_000_000  # 1.7e18 ns
+NANO = 1_000_000_000
+
+PACKET_TOPIC = "/iv_packets_front_mid"
+PACKET_TYPE = "seyond/msg/SeyondScan"
+POINT_TOPIC = "/iv_points_front_mid_transformed"
+POINT_TYPE = "sensor_msgs/msg/PointCloud2"
+
+REAL_REF_DIR = Path("/home/wang/work/ros2_slice/images/refs")
+
+
+# ---------------------------------------------------------------------------
+# PointCloud2 CDR 合成（含 ROS2 封装头，对照 slope.cdr 口径）
+# ---------------------------------------------------------------------------
+
+
+def build_pointcloud2_cdr(
+    sec: int,
+    nanosec: int,
+    pts: list[tuple[float, float, float, float]],
+    *,
+    frame_id: str = "front_mid",
+    with_intensity: bool = True,
+) -> bytes:
+    """构造 sensor_msgs/PointCloud2 CDR（封装头 00010000 + header + 字段 + 数据）。
+
+    CDR 4 字节对齐：字符串序列后的下一个定长字段需对齐到 body 的 4 字节边界
+    （与 decode.parse_pointcloud2 的 _p2_align4 口径一致，base=封装头后 body 起点）。
+    """
+    fields = [("x", 0, 7, 1), ("y", 4, 7, 1), ("z", 8, 7, 1)]
+    if with_intensity:
+        fields.append(("intensity", 12, 7, 1))
+    point_step = 4 * len(fields)
+
+    body = bytearray()
+
+    def _align4() -> None:
+        pad = (-len(body)) % 4
+        if pad:
+            body.extend(b"\x00" * pad)
+
+    body += struct.pack("<iI", sec, nanosec)
+    fid = frame_id.encode("utf-8") + b"\x00"
+    body += struct.pack("<I", len(fid)) + fid
+    _align4()
+    body += struct.pack("<II", 1, len(pts))  # height=1, width=n
+    _align4()
+    body += struct.pack("<I", len(fields))
+    for name, off, dt, cnt in fields:
+        n = name.encode("utf-8") + b"\x00"
+        _align4()
+        body += struct.pack("<I", len(n)) + n
+        body += struct.pack("<IBB", off, dt, cnt)
+    body += struct.pack("<B", 0)  # is_bigendian
+    _align4()
+    body += struct.pack("<III", point_step, point_step, point_step * len(pts))
+    _align4()
+    for x, y, z, inten in pts:
+        body += struct.pack("<ffff", x, y, z, inten) if with_intensity else struct.pack("<fff", x, y, z)
+
+    wrapped = b"\x00\x01\x00\x00" + bytes(body)
+    return wrapped
+
+
+def _msg(topic: str, mtype: str, ts: int, payload: bytes) -> tuple:
+    return (topic, mtype, ts, payload)
+
+
+def build_packet_bag(tmp: Path, n: int, topic: str = PACKET_TOPIC) -> Path:
+    bag = tmp / "pk_bag"
+    msgs = [topic, None, None, None]
+    msgs = []
+    for i in range(n):
+        msgs.append(_msg(topic, PACKET_TYPE, BASE_TS + i * NANO, b"\x00" * 32))
+    build_single_db3(bag / "r.db3", msgs)
+    return bag
+
+
+def build_packet_multi(tmp: Path, n: int, topic: str = PACKET_TOPIC) -> Path:
+    bag = tmp / "pk_multi"
+    mid = n // 2
+    m0 = [_msg(topic, PACKET_TYPE, BASE_TS + i * NANO, b"\x00" * 32) for i in range(mid)]
+    m1 = [_msg(topic, PACKET_TYPE, BASE_TS + (mid + i) * NANO, b"\x00" * 32) for i in range(n - mid)]
+    build_single_db3(bag / "part0.db3", m0)
+    build_single_db3(bag / "part1.db3", m1)
+    return bag
+
+
+def build_pointcloud_bag(tmp: Path, labels: list[str], *, multi: bool = False, ooo: bool = False) -> Path:
+    bag = tmp / "pc_bag"
+    msgs = []
+    for i, lab in enumerate(labels):
+        ts = BASE_TS + i * NANO
+        pts = [(0.0 + i, 1.0, 2.0, 0.5 if lab == "spray" else 0.1)]
+        msgs.append(_msg(POINT_TOPIC, POINT_TYPE, ts, build_pointcloud2_cdr(ts // NANO, ts % NANO, pts)))
+    if ooo:
+        msgs = list(reversed(msgs))
+    if multi:
+        mid = len(msgs) // 2
+        build_single_db3(bag / "p0.db3", msgs[:mid])
+        build_single_db3(bag / "p1.db3", msgs[mid:])
+    else:
+        build_single_db3(bag / "r.db3", msgs)
+    return bag
+
+
+def build_other_topics_bag(tmp: Path) -> Path:
+    """只含后雷达 + 相机，无前雷达输入 → NOT_APPLICABLE。"""
+    bag = tmp / "other"
+    msgs = [
+        _msg("/iv_packets_rear_mid", PACKET_TYPE, BASE_TS, b"\x00" * 32),
