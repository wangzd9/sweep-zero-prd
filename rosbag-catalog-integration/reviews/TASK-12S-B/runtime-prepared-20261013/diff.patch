+"""spray 参考图受控清单（TASK-12S-B，SPRAY-INTEGRATION §3）。
+
+严格 7 文件清单（顺序固定，1~4 正常 / 5~7 异常）；部署路径由服务端
+SPRAY_REFERENCE_DIR 受控提供，启动预检校验非空/可解码/hash/顺序，缺失返回
+REFERENCE_MISSING；不把待判定图当参考图，不虚造替代图。
+
+清单内嵌 sha256/bytes/尺寸/顺序（对照 SPRAY-REFERENCES.json，source_commit
+be23177）；校验失败（hash 不符/字节数不符/顺序不符/文件缺失）抛 ReferenceError。
+本模块不硬编码本机绝对路径，目录由 env SPRAY_REFERENCE_DIR 提供（预检面）。
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+from dataclasses import dataclass
+from pathlib import Path
+
+SOURCE_COMMIT = "be23177eca685b5f0f75160ca82503beeb63147d"
+
+REF_ORDER = (1, 2, 3, 4, 5, 6, 7)
+NORMAL_ORDERS = frozenset({1, 2, 3, 4})
+ABNORMAL_ORDERS = frozenset({5, 6, 7})
+
+# 永久清单（对照 SPRAY-REFERENCES.json 逐图冻结）
+REFERENCES: tuple[dict, ...] = (
+    {
+        "order": 1,
+        "name": "2026_07_29-17_21_13_457-1785316873457.jpg",
+        "class": "normal",
+        "bytes": 1991039,
+        "sha256": "f6217d478a5052271fdd515f967934a22ceb748dc9de49721d87da4f26a257b3",
+        "dimensions": (3840, 2160),
+    },
+    {
+        "order": 2,
+        "name": "2026_07_29-17_21_12_257-1785316872257.jpg",
+        "class": "normal",
+        "bytes": 2032911,
+        "sha256": "1409e87992564dccaf0449cf3ee70e1a8220a99cde519c5d4cad34f782e0a4be",
+        "dimensions": (3840, 2160),
+    },
+    {
+        "order": 3,
+        "name": "2026_07_29-17_21_10_757-1785316870757.jpg",
+        "class": "normal",
+        "bytes": 2091513,
+        "sha256": "fa98957c0c9a31c3e7429466162c3b032f289326152422d3b65e6e9e58e4e460",
+        "dimensions": (3840, 2160),
+    },
+    {
+        "order": 4,
+        "name": "2026_07_01-11_07_37_357-1782875257357.jpg",
+        "class": "normal",
+        "bytes": 2253293,
+        "sha256": "f56d6a15529cfae28c6b9170489a3fa23954c15112ed9a7bed079ff0459fde46",
+        "dimensions": (3840, 2160),
+    },
+    {
+        "order": 5,
+        "name": "2026_07_29-17_21_45_257-1785316905257.jpg",
+        "class": "spray",
+        "bytes": 2373045,
+        "sha256": "3ebc9c76215510ff3a8fe184c3753bcee896d57449c6e54ba964ca464882b7ce",
+        "dimensions": (3840, 2160),
+    },
+    {
+        "order": 6,
+        "name": "2026_07_29-17_20_58_757-1785316858757.jpg",
+        "class": "spray",
+        "bytes": 2283924,
+        "sha256": "13cf7e1d821d40d7f45e9c1f1c5ce7bd5b099221d279907a19e9a16ee2deeac1",
+        "dimensions": (3840, 2160),
+    },
+    {
+        "order": 7,
+        "name": "2026_07_29-17_21_52_757-1785316912757.jpg",
+        "class": "spray",
+        "bytes": 2164316,
+        "sha256": "e57d9d892a5389b51bb77bc4eca710077670af5173c900aa5d8aefe66cc8e3ed",
+        "dimensions": (3840, 2160),
+    },
+)
+TOTAL_BYTES = sum(r["bytes"] for r in REFERENCES)  # 15190041
+
+
+class ReferenceError(Exception):
+    """参考图缺失/hash 不符/顺序不符/不可解码。"""
+
+
+def reference_dir() -> Path | None:
+    """服务端受控参考图目录（env SPRAY_REFERENCE_DIR）；未配置返回 None。"""
+    raw = os.getenv("SPRAY_REFERENCE_DIR", "").strip()
+    return Path(raw) if raw else None
+
+
+@dataclass(frozen=True)
+class VerifiedRefs:
+    """校验通过的 7 参考图：按顺序的绝对路径 + 逐图摘要。"""
+
+    paths: tuple[Path, ...]
+    total_bytes: int
+    ordered_hash: str
+
+
+def _jpeg_magic_ok(path: Path) -> bool:
+    try:
+        with path.open("rb") as f:
+            return f.read(3) == b"\xff\xd8\xff"
+    except OSError:
+        return False
+
+
+def verify_references(refs: tuple[dict, ...] = REFERENCES, directory: Path | str | None = None) -> VerifiedRefs:
+    """校验 7 文件清单：非空/可解码(hash+bytes)/顺序/尺寸。任一失败抛 ReferenceError。
+
+    - 顺序：文件名必须按 REFERENCES 的 order 排列；
+    - hash/sha256：逐图核对（对照清单冻结值）；
+    - bytes：逐图核对字节数；
+    - 可解码：JPEG magic（FF D8 FF）；
+    - 尺寸：不依赖 PIL（无 numpy 环境），仅记录清单尺寸进证据，真实像素校验
+      由处理机渲染预检补（本层 hash+bytes+magic 已足以防替换/缺图）。
+    """
+    dir_ = Path(directory) if directory is not None else reference_dir()
+    if dir_ is None:
+        raise ReferenceError("REFERENCE_MISSING: SPRAY_REFERENCE_DIR 未配置（参考图受控目录缺失）")
+    if not dir_.is_dir():
+        raise ReferenceError(f"REFERENCE_MISSING: 参考图目录不可读：{dir_}")
+    paths: list[Path] = []
+    for spec in refs:
+        p = dir_ / spec["name"]
+        if not p.is_file():
+            raise ReferenceError(f"REFERENCE_MISSING: 参考图{spec['order']} 缺失 {p.name}")
+        if p.stat().st_size == 0:
+            raise ReferenceError(f"REFERENCE_MISSING: 参考图{spec['order']} 为空文件 {p.name}")
+        actual_bytes = p.stat().st_size
+        if actual_bytes != spec["bytes"]:
+            detail = f"REFERENCE_MISMATCH: 参考图{spec['order']} 字节数 {actual_bytes} != 清单 {spec['bytes']}"
+            raise ReferenceError(detail)
+        digest = hashlib.sha256(p.read_bytes()).hexdigest()
+        if digest != spec["sha256"]:
+            raise ReferenceError(f"REFERENCE_MISMATCH: 参考图{spec['order']} sha256 不符（{digest[:16]}…）")
+        if not _jpeg_magic_ok(p):
+            raise ReferenceError(f"REFERENCE_UNDECODABLE: 参考图{spec['order']} 非 JPEG 可解码 {p.name}")
+        paths.append(p)
+    # 顺序指纹：7 图按 order 逐图 hash 串联
+    ordered = hashlib.sha256(
+        json.dumps([hashlib.sha256(p.read_bytes()).hexdigest() for p in paths], sort_keys=True).encode()
+    ).hexdigest()
+    if len(paths) != 7:
+        raise ReferenceError(f"REFERENCE_MISMATCH: 必须恰好 7 张参考图，实际 {len(paths)}")
+    return VerifiedRefs(paths=tuple(paths), total_bytes=TOTAL_BYTES, ordered_hash=ordered)
+
+
+def ordered_ref_bytes(verified: VerifiedRefs) -> list[bytes]:
+    """按 1~7 顺序返回 7 张参考图字节（送模型第 1~7 张）。"""
+    return [p.read_bytes() for p in verified.paths]
