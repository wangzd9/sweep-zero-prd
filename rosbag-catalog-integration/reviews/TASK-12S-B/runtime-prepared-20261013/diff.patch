@@ -0,0 +1,207 @@
+"""spray 分段纯逻辑（TASK-12S-B，SPRAY-INTEGRATION §4）。
+
+对照 ros2_slice/src/analysis_spray.py::analysis_ros + _denoise，整数纳秒化：
+- 全程**源 storage 整数 ns**，不 round 到秒、不从文件名回推（对照实现末尾
+  `int(round(w['start']))` 丢精度，本模块禁止）；
+- 时序滞后去噪 _denoise（enter/exit_）；
+- 滑动窗口按**异常帧密度**判定（不受帧率影响），短包裁剪窗口不补帧；
+- 重叠 >= overlap_merge 合并；
+- 参数 schema 校验：密度∈[0,1]、整数阈值 enter/exit_>=1、时长 window_size/lead/
+  overlap_merge>0。
+
+输入帧标签只含 spray/normal（unknown 在 adapter 层已判 FAILED，不进分段）。
+输出片段 label=spray（可发布）/normal（仅证据），publish_target 由能力
+output_labels 决定。
+"""
+
+from __future__ import annotations
+
+import bisect
+from dataclasses import dataclass
+
+NANO = 1_000_000_000
+
+# analysis_ros2 实际调用参数（SPRAY-INTEGRATION §4 冻结）
+DEFAULT_WINDOW_SIZE_S = 15
+DEFAULT_MIN_ABNORMAL_RATIO = 0.15
+DEFAULT_ENTER = 3
+DEFAULT_EXIT_ = 5
+DEFAULT_LEAD_S = 3
+DEFAULT_OVERLAP_MERGE_S = 7.0
+
+LABEL_SPRAY = "spray"
+LABEL_NORMAL = "normal"
+
+
+@dataclass(frozen=True)
+class SprayParams:
+    """校验后的分段参数（全部 ns 单位 + 密度）。"""
+
+    window_ns: int
+    min_abnormal_ratio: float
+    enter: int
+    exit_: int
+    lead_ns: int
+    overlap_merge_ns: int
+
+
+def validate_spray_params(
+    window_size: float = DEFAULT_WINDOW_SIZE_S,
+    min_abnormal_ratio: float = DEFAULT_MIN_ABNORMAL_RATIO,
+    enter: int = DEFAULT_ENTER,
+    exit_: int = DEFAULT_EXIT_,
+    lead_seconds: int = DEFAULT_LEAD_S,
+    overlap_merge_seconds: float = DEFAULT_OVERLAP_MERGE_S,
+) -> SprayParams:
+    """参数 schema 校验（密度[0,1]、整数阈值>=1、时长>0）。非法抛 ValueError。"""
+    if isinstance(window_size, bool) or not isinstance(window_size, int | float) or window_size <= 0:
+        raise ValueError(f"window_size 必须 >0，实际 {window_size!r}")
+    if isinstance(min_abnormal_ratio, bool) or not isinstance(min_abnormal_ratio, int | float):
+        raise ValueError(f"min_abnormal_ratio 必须 ∈[0,1]，实际 {min_abnormal_ratio!r}")
+    if not (0 <= min_abnormal_ratio <= 1):
+        raise ValueError(f"min_abnormal_ratio 必须 ∈[0,1]，实际 {min_abnormal_ratio!r}")
+    for name, val in (("enter", enter), ("exit_", exit_)):
+        if isinstance(val, bool) or not isinstance(val, int) or val < 1:
+            raise ValueError(f"{name} 必须是整数且 >=1，实际 {val!r}")
+    if isinstance(lead_seconds, bool) or not isinstance(lead_seconds, int) or lead_seconds < 0:
+        raise ValueError(f"lead_seconds 必须 >=0，实际 {lead_seconds!r}")
+    if (
+        isinstance(overlap_merge_seconds, bool)
+        or not isinstance(overlap_merge_seconds, int | float)
+        or overlap_merge_seconds <= 0
+    ):
+        raise ValueError(f"overlap_merge_seconds 必须 >0，实际 {overlap_merge_seconds!r}")
+    return SprayParams(
+        window_ns=int(window_size * NANO),
+        min_abnormal_ratio=float(min_abnormal_ratio),
+        enter=int(enter),
+        exit_=int(exit_),
+        lead_ns=int(lead_seconds * NANO),
+        overlap_merge_ns=int(overlap_merge_seconds * NANO),
+    )
+
+
+def _denoise(is_abnormal: list[bool], enter: int, exit_: int) -> list[bool]:
+    """时序滞后去噪（对照 analysis_spray._denoise，逐帧布尔语义整数化无关）。"""
+    out: list[bool] = []
+    state = False
+    run = 0
+    for a in is_abnormal:
+        if state:
+            if a:
+                run = 0
+            else:
+                run += 1
+                if run >= exit_:
+                    state = False
+                    run = 0
+        else:
+            if a:
+                run += 1
+                if run >= enter:
+                    state = True
+                    run = 0
+                    for k in range(1, enter):
+                        out[-k] = True
+            else:
+                run = 0
+        out.append(state)
+    return out
+
+
+def segment_spray_ns(
+    timestamps_ns: list[int],
+    labels: list[str],
+    *,
+    params: SprayParams | None = None,
+    publish_labels: frozenset[str] = frozenset({LABEL_SPRAY}),
+) -> list[dict]:
+    """整数 ns 分段（对照 analysis_ros，保留源 ns 不 round 到秒）。
+
+    :param timestamps_ns: 升序源存储纳秒（adapter 已保证升序；空列表由调用方判 FAILED）
+    :param labels: 与 timestamps 等长，仅 spray/normal（unknown 不在此）
+    :return: 片段列表，每项 {start_ns, end_ns, duration_ns, label, frame_count,
+             abnormal_count, publish_target}
+    """
+    if not timestamps_ns:
+        raise ValueError("timestamps_ns 不能为空：无有效帧应由调用方判 FAILED")
+    if len(timestamps_ns) != len(labels):
+        raise ValueError("timestamps_ns 与 labels 长度不一致")
+    p = params or validate_spray_params()
+    n = len(timestamps_ns)
+    is_abnormal = [lab == LABEL_SPRAY for lab in labels]
+    smooth = _denoise(is_abnormal, enter=p.enter, exit_=p.exit_)
+    window_ns = p.window_ns
+    lead_ns = p.lead_ns
+    min_ratio = p.min_abnormal_ratio
+
+    windows: list[dict] = []
+    i = 0
+    while i < n:
+        start_time = timestamps_ns[i]
+        end_time = start_time + window_ns
+        j = i
+        while j < n and timestamps_ns[j] <= end_time:
+            j += 1
+        window_indices = list(range(i, j))
+        if not window_indices:
+            i += 1
+            continue
+        ab_in_window = [k for k in window_indices if smooth[k]]
+        density = len(ab_in_window) / len(window_indices)
+        if ab_in_window and density >= min_ratio:
+            first_ab = ab_in_window[0]
+            window_start = max(timestamps_ns[0], timestamps_ns[first_ab] - lead_ns)
+            window_end = window_start + window_ns
+            if window_end > timestamps_ns[-1]:
+                window_end = timestamps_ns[-1]
+                window_start = max(timestamps_ns[0], window_end - window_ns)
+            start_local = bisect.bisect_left(timestamps_ns, window_start)
+            end_local = bisect.bisect_right(timestamps_ns, window_end) - 1
+            if end_local < start_local:
+                i += 1
+                continue
+            ab_final = [k for k in range(start_local, end_local + 1) if smooth[k]]
+            windows.append(
+                {
+                    "start": window_start,
+                    "end": window_end,
+                    "abnormal_count": len(ab_final),
+                    "total_count": end_local - start_local + 1,
+                }
+            )
+            i = end_local + 1
+        else:
+            i += 1
+
+    # 重叠合并（对照实现：重叠 >= overlap_merge 合并，时间取并集）
+    merged: list[dict] = []
+    for w in windows:
+        if merged and (merged[-1]["end"] - w["start"]) >= p.overlap_merge_ns:
+            prev = merged[-1]
+            prev["end"] = max(prev["end"], w["end"])
+            prev["total_count"] = max(prev["total_count"], w["total_count"])
+            prev["abnormal_count"] += w["abnormal_count"]
+            continue
+        merged.append(dict(w))
+
+    out: list[dict] = []
+    for w in merged:
+        start = int(w["start"])
+        end = int(w["end"])
+        if end <= start:
+            continue
+        # 片段 label：含去噪异常帧 → spray（可发布）；纯正常窗口不产生（ab_in_window 前提）
+        label = LABEL_SPRAY if w["abnormal_count"] > 0 else LABEL_NORMAL
+        out.append(
+            {
+                "start_ns": start,
+                "end_ns": end,
+                "duration_ns": end - start,
+                "label": label,
+                "frame_count": int(w["total_count"]),
+                "abnormal_count": int(w["abnormal_count"]),
+                "publish_target": label in publish_labels,
+            }
+        )
+    return out
