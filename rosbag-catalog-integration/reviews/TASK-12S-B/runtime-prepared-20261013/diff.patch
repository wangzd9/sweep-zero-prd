+class DeterministicModel:
+    """确定性客户端：按调用次序（=渲染选中帧次序）返回标签，可注入 spray 位置集。"""
+
+    def __init__(
+        self,
+        always: str | None = None,
+        fail: bool = False,
+        calls: list | None = None,
+        spray_positions: set[int] | None = None,
+    ):
+        self._always = always
+        self._fail = fail
+        self._calls = calls if calls is not None else []
+        self._spray_pos = spray_positions
+
+    def is_available(self) -> bool:
+        return True
+
+    def judge_frame(self, target_bytes: bytes, ref_bytes: list[bytes], on_pass=None):
+        from app.scene.spray.model import PassStat
+
+        if len(ref_bytes) != 7:
+            raise AssertionError("参考图必须恰好 7 张")
+        self._calls.append(target_bytes)
+        if self._fail:
+            from app.scene.spray.model import SprayModelError
+
+            raise SprayModelError("模型端点不可解析")
+        if on_pass:
+            total = len(target_bytes) + sum(len(r) for r in ref_bytes)
+            on_pass(
+                PassStat(
+                    prompt="V18",
+                    target_bytes=len(target_bytes),
+                    refs_bytes=sum(len(r) for r in ref_bytes),
+                    total_bytes=total,
+                    retries=0,
+                )
+            )
+        if self._spray_pos is not None:
+            spray = len(self._calls) - 1 in self._spray_pos
+        elif self._always is not None:
+            spray = self._always == "异常"
+        else:
+            spray = False
+        if spray:
+            return "异常", None, None
+        return "正常", "最像参考图3", 3
+
