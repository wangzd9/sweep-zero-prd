+"""spray 本机渲染与预处理冻结（TASK-12S-B，SPRAY-INTEGRATION §3）。
+
+预处理冻结规则（与原算法对照，不随意降阈值）：
+- PCD 有序序列**跳过前 10 帧、每 3 帧取 1**（对照 pdc_to_pic.generate_point_picture
+  的 `pcd_files[10::frame_interval]`，frame_interval=3）；
+- 渲染 3840×2160、旋转 90°、ROI x=(-2,6)/y=(-3,3)、intensity 配色、JPG q95；
+- 参考图过滤阈值 **500KiB**：小于阈值的小图**删除并记录**（不冒充"无水雾"）；
+  **过滤数量/失败/剩余数必须记录**；过滤后无足够有效数据 = **FAILED**（非 NO_MATCH）。
+
+渲染本体依赖 numpy + open3d + EGL/软件渲染（处理机资源）。本模块把纯会计逻辑
+（选帧索引/过滤计数/最少有效门槛）与真实离屏渲染分离：纯部分 stdlib 可测；
+真实渲染惰性 import open3d，缺失抛 RenderError(RENDER_UNAVAILABLE)（不迁 A100、
+不 mock 当 PASS）。
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from pathlib import Path
+from typing import Any
+
+# 冻结预处理参数（SPRAY-INTEGRATION §3）
+SKIP_FIRST_FRAMES = 10
+FRAME_INTERVAL = 3
+RENDER_WIDTH = 3840
+RENDER_HEIGHT = 2160
+ROTATE_DEGREES = 90
+ROI_X = (-2.0, 6.0)
+ROI_Y = (-3.0, 3.0)
+JPG_QUALITY = 95
+SMALL_IMAGE_THRESHOLD_KB = 500.0
+# 过滤后最少有效帧：低于此数 = FAILED（抽帧不足≠无命中）
+MIN_VALID_FRAMES = 3
+
+
+class RenderError(Exception):
+    """渲染依赖缺失/渲染失败/有效帧不足。"""
+
+    def __init__(self, code: str, detail: str = ""):
+        self.code = code
+        self.detail = detail or code
+        super().__init__(f"{code}: {self.detail}" if detail else code)
+
+
+def select_pcd_indices(total: int, skip_first: int = SKIP_FIRST_FRAMES, interval: int = FRAME_INTERVAL) -> list[int]:
+    """选帧索引（对照实现 `pcd_files[10::3]`）。total<=0 → []。
+
+    返回原 PCD 序列中的下标列表（升序）。interval<1 抛 RenderError。
+    """
+    if interval < 1:
+        raise RenderError("RENDER_CONFIG", f"interval 必须 >=1，实际 {interval}")
+    if total <= 0:
+        return []
+    return list(range(skip_first, total, interval))
+
+
+@dataclass
+class RenderReport:
+    """渲染/过滤会计（AC-15.2 证据 + "过滤数量/失败/剩余数必须记录"）。"""
+
+    threshold_kb: float = SMALL_IMAGE_THRESHOLD_KB
+    total_pcd: int = 0
+    selected: int = 0
+    rendered_ok: int = 0
+    filtered_small: int = 0
+    render_failed: int = 0
+    remaining: int = 0
+    min_valid: int = MIN_VALID_FRAMES
+    # 有效帧的 (storage_ns, jpg_path) 供下游模型判定
+    valid_frames: list[tuple[int, Path]] = field(default_factory=list)
+
+    def to_dict(self) -> dict:
+        return {
+            "threshold_kb": self.threshold_kb,
+            "total_pcd": self.total_pcd,
+            "selected": self.selected,
+            "rendered_ok": self.rendered_ok,
+            "filtered_small": self.filtered_small,
+            "render_failed": self.render_failed,
+            "remaining": self.remaining,
+            "min_valid": self.min_valid,
+            "valid_frame_count": len(self.valid_frames),
+        }
+
+
+def _size_kb(path: Path) -> float:
+    try:
+        return path.stat().st_size / 1024
+    except OSError:
+        return 0.0
+
+
+def account_frame(report: RenderReport, *, storage_ns: int, rendered: bool, output_path: Path | None) -> None:
+    """单帧会计：渲染成功且 >= 阈值 → 有效；渲染成功但 < 阈值 → 过滤删除；渲染失败 → 失败。
+
+    - 不把图片小当"无水雾"：小图计入 filtered_small（从推理剔除），不进 valid_frames；
+    - 失败计入 render_failed。
+    """
+    if not rendered or output_path is None:
+        report.render_failed += 1
+        return
+    kb = _size_kb(output_path)
+    if kb < report.threshold_kb:
+        # 过小图删除（对照实现 os.remove），保留计数
+        try:
+            output_path.unlink()
+        except OSError:
+            pass
+        report.filtered_small += 1
+        return
+    report.rendered_ok += 1
+    report.remaining += 1
+    report.valid_frames.append((storage_ns, output_path))
+
+
+def finalize(report: RenderReport) -> None:
+    """有效帧不足门槛 → FAILED（RENDER_INSUFFICIENT，非 NO_MATCH）。"""
+    if report.remaining < report.min_valid:
+        raise RenderError(
+            "RENDER_INSUFFICIENT",
+            f"过滤后有效帧 {report.remaining} < 门槛 {report.min_valid}"
+            f"（selected={report.selected}, filtered_small={report.filtered_small}, "
+            f"render_failed={report.render_failed}）——抽帧/过滤不足判 FAILED，不当无命中",
+        )
+
+
+# ---------------------------------------------------------------------------
+# 真实离屏渲染（numpy + open3d，处理机资源；缺失 fail-closed）
+# ---------------------------------------------------------------------------
+
+
+def render_pcd_to_jpg(pcd_path: Path, output_path: Path) -> bool:
+    """Open3D 离屏渲染 PCD → JPG（3840×2160 旋转 90°、ROI 裁剪、intensity 配色、q95）。
+
+    对照 pdc_to_pic.render_pcd_headless。缺 open3d/EGL → 抛 RenderError(RENDER_UNAVAILABLE)。
+    裁剪后为空/渲染返回空 → 返回 False（计入 render_failed）。
+    """
+    try:
+        import numpy as np
+        import open3d as o3d
+    except Exception as exc:  # ImportError / EGL 缺失
+        raise RenderError("RENDER_UNAVAILABLE", f"Open3D/numpy 不可用（处理机需安装）：{exc}") from exc
+
+    # ROI 裁剪 + intensity 上色：复用对照实现算法（红-绿-蓝渐变）
+    from app.scene.spray.pcd_io import read_intensity
+
+    try:
+        o3d_pcd = o3d.io.read_point_cloud(str(pcd_path))
+        points = np.asarray(o3d_pcd.points)
+        if len(points) == 0:
+            return False
+        mask = (
+            (points[:, 0] > ROI_X[0])
+            & (points[:, 0] < ROI_X[1])
+            & (points[:, 1] > ROI_Y[0])
+            & (points[:, 1] < ROI_Y[1])
+        )
+        cropped = points[mask]
+        if len(cropped) == 0:
+            return False
+        intensity = None
+        try:
+            intensity = read_intensity(pcd_path)
+        except Exception:
+            intensity = None
+        cloud = o3d.geometry.PointCloud()
+        cloud.points = o3d.utility.Vector3dVector(cropped)
+        if intensity is not None and len(intensity) == len(cropped):
+            cloud.colors = o3d.utility.Vector3dVector(_intensity_color(np.asarray(intensity, dtype=float)))
+        try:
+            renderer = o3d.visualization.rendering.OffscreenRenderer(RENDER_WIDTH, RENDER_HEIGHT)
+        except TypeError:
+            renderer = o3d.visualization.rendering.OffscreenRenderer(RENDER_WIDTH, RENDER_HEIGHT, headless=True)
+        except Exception as exc:  # EGL/无显示
+            raise RenderError("RENDER_UNAVAILABLE", f"OffscreenRenderer 创建失败（EGL/软件渲染缺失）：{exc}") from exc
+        renderer.scene.set_background(np.array([0.0, 0.0, 0.0, 1.0], dtype=np.float32))
+        material = o3d.visualization.rendering.MaterialRecord()
+        material.shader = "defaultUnlit"
+        renderer.scene.add_geometry("pointcloud", cloud, material)
+        center = cloud.get_center()
+        bounds = cloud.get_axis_aligned_bounding_box()
+        bbox_size = bounds.get_max_bound() - bounds.get_min_bound()
+        max_dim = float(np.max(bbox_size)) * 1.5
+        angle_rad = np.radians(-ROTATE_DEGREES)
+        up_x = 0 * np.cos(angle_rad) + (-1) * np.sin(angle_rad)
+        up_y = -0 * np.sin(angle_rad) + (-1) * np.cos(angle_rad)
+        up = np.array([up_x, up_y, 0])
+        up = up / np.linalg.norm(up)
+        renderer.scene.camera.look_at(center, center + np.array([0, 0, max_dim * 0.3]), up)
+        img = renderer.render_to_image()
+        if img is None:
+            return False
+        output_path.parent.mkdir(parents=True, exist_ok=True)
+        ok = o3d.io.write_image(str(output_path), img, quality=JPG_QUALITY)
+        return bool(ok)
+    except RenderError:
+        raise
+    except Exception as exc:
+        raise RenderError("RENDER_FAILED", f"渲染异常 {pcd_path.name}：{exc}") from exc
+
+
+def _intensity_color(values: Any) -> Any:
+    """对照实现 intensity_to_color_custom（深红→红→黄→绿→蓝，归一 [0,1]）。"""
+    import numpy as np
+
+    i_min = float(np.min(values)) if len(values) else 0.0
+    i_max = float(np.max(values)) if len(values) else 0.0
+    if i_max - i_min > 1e-6:
+        normalized = (values - i_min) / (i_max - i_min)
+    else:
+        normalized = np.zeros_like(values)
+    n = len(normalized)
+    colors = np.zeros((n, 3))
+    for i, val in enumerate(normalized):
+        if val < 0.25:
+            t = val / 0.25
+            colors[i] = [0.5 + 0.5 * t, 0.0, 0.0]
+        elif val < 0.5:
+            t = (val - 0.25) / 0.25
+            colors[i] = [1.0, t, 0.0]
+        elif val < 0.75:
+            t = (val - 0.5) / 0.25
+            colors[i] = [1.0 - t, 1.0, 0.0]
+        else:
+            t = (val - 0.75) / 0.25
+            colors[i] = [0.0, 1.0 - t, t]
+    return colors
