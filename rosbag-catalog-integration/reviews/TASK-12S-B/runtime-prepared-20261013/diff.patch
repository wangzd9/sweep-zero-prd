@@ -0,0 +1,427 @@
+"""真实水雾适配器（TASK-12S-B）：register_adapter(SPRAY_ADAPTER_KEY, SprayAdapter)。
+
+流水线（对照 ros2_slice：analysis_spray → point_to_pdc → pdc_to_pic → request_spray）：
+1. 适用性：按 sensor profile 选两路线之一（packet 优先 / pointcloud 替代）；
+   对应 topic 缺失 = **NOT_APPLICABLE**（没有识别结论，不产生"正常无水雾"）；
+2. 解码：packet 路线调 packet2pointcloud（检查 returncode，序号映射源 storage ns，
+   重复/歧义拒绝）；pointcloud 路线纯 stdlib 解析 PointCloud2（x/y/z/intensity，缺
+   intensity 拒绝）；**存在但解不出有效帧 = FAILED**（DECODE_FAILED，不冒充 []）；
+3. 渲染：Open3D 离屏（3840×2160 旋转 90°、ROI、intensity 配色、q95）；跳过前 10 帧
+   每 3 帧取 1；500KiB 小图过滤（记录数量/失败/剩余）；有效帧 < 门槛 = FAILED；
+4. 模型：双 pass（V18 thinking + SIM 参考图复核 1~4 正常/5~7 异常），归一
+   spray/normal/unknown；有界重试后仍不确定 = FAILED（禁止 !=异常 统称正常）；
+5. 分段：segment_spray_ns（15s/0.15/3/5/前置 3s/合并 7s，整数 storage ns，不 round 秒）；
+6. 缓存/取消：完整身份键 manifest/hash 判断（禁止目录非空判完成、禁止写原包）；
+   每帧检查取消信号。
+
+本模块不登记 Bag、不直连数据库、不写 NAS 发布路径（06B/12S-C 职责）；
+输出结构化区间 + manifest 证据，由 dispatch/06B 消费。
+真实模型请求与写测试 NAS 不在本单（12S-C/12S-D 派单口径），本单交付能力+预检+只读探针。
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+from collections.abc import Mapping
+from dataclasses import asdict
+from pathlib import Path
+
+from app.scene.adapter import register_adapter
+from app.scene.slope.bag_io import BagIoError, read_topics
+from app.scene.spray import decode as spray_decode
+from app.scene.spray import render as spray_render
+from app.scene.spray import segment as spray_segment
+from app.scene.spray.cache import SprayCacheKey, SprayResultCache, key_digest
+from app.scene.spray.decode import PACKET_TOPIC, POINTCLOUD_TOPIC, DecodeError, SprayFrame
+from app.scene.spray.model import (
+    SprayModelClient,
+    SprayModelError,
+    classify_two_pass,
+    prompt_hashes,
+)
+from app.scene.spray.pcd_io import parse_binary_pcd_header
+from app.scene.spray.precheck import run_precheck
+from app.scene.spray.references import ReferenceError, ordered_ref_bytes, verify_references
+from app.scene.spray.time_map import MAPPING_BAG_STORAGE
+from app.scene.types import (
+    AnalysisOutput,
+    ApplicabilityVerdict,
+    EvidenceRef,
+    SceneAdapter,
+    SceneAdapterError,
+    SceneOutcome,
+    SceneRunRequest,
+    SceneSegment,
+)
+
+SPRAY_ADAPTER_KEY = "ros2-spray-v1"
+
+# 路线 → 必需 topic（按 sensor profile 选择，不 AND）
+_ROUTE_TOPIC = {
+    "packet": PACKET_TOPIC,
+    "pointcloud": POINTCLOUD_TOPIC,
+}
+
+_CANCEL_CHECK_EVERY = 10
+
+
+class SprayAdapter(SceneAdapter):
+    """水雾场景适配器；model_client 可注入（测试用确定性客户端）。"""
+
+    def __init__(self, model_client: SprayModelClient | None = None, decoder_path: str | Path | None = None):
+        self._client = model_client
+        self._decoder_path = decoder_path
+
+    # ------------------------------------------------------------------
+    # 适用性：按 profile 选路线，topic 缺失 = NOT_APPLICABLE
+    # ------------------------------------------------------------------
+
+    def _route(self, request: SceneRunRequest) -> str:
+        route = str(request.parameters.get("route", "auto")).strip()
+        return route or "auto"
+
+    def _resolve_route(self, request: SceneRunRequest, topics: Mapping[str, object]) -> str:
+        """按 sensor profile 参数 + 实际 topic 选择路线（packet 优先，不 AND，不默默后雷达）。"""
+        route = self._route(request)
+        if route == "auto":
+            route = "packet" if PACKET_TOPIC in topics else ("pointcloud" if POINTCLOUD_TOPIC in topics else "auto")
+        return route
+
+    def check_applicability(self, request: SceneRunRequest) -> ApplicabilityVerdict:
+        try:
+            topics = {t.name: t for t in read_topics(Path(request.source_path))}
+        except BagIoError as exc:
+            return ApplicabilityVerdict(applicable=False, reason=f"bag 不可读：{exc}")
+        route = self._resolve_route(request, topics)
+        if route not in _ROUTE_TOPIC:
+            return ApplicabilityVerdict(applicable=False, reason=f"未知路线 {route!r}（应为 packet/pointcloud/auto）")
+        needed = _ROUTE_TOPIC[route]
+        if needed not in topics:
+            # 缺 topic = NOT_APPLICABLE（RAW-DATA §1：后雷达不能替代前雷达；缺=不适用）
+            return ApplicabilityVerdict(
+                applicable=False,
+                reason=f"缺少水雾输入 topic {needed}（路线 {route}；实际 {[t for t in topics]}）",
+            )
+        return ApplicabilityVerdict(applicable=True)
+
+    # ------------------------------------------------------------------
+    # 分析
+    # ------------------------------------------------------------------
+
+    def analyze(self, request: SceneRunRequest) -> AnalysisOutput:
+        bag_dir = Path(request.source_path)
+        work_dir = Path(request.work_dir)
+        if work_dir.exists() and not work_dir.is_absolute():
+            raise SceneAdapterError("WORK_DIR_INVALID", "work_dir 必须是受控绝对路径")
+        work_dir.mkdir(parents=True, exist_ok=True)
+
+        topics = {t.name: t for t in read_topics(bag_dir)}
+        route = self._resolve_route(request, topics)
+        needed = _ROUTE_TOPIC.get(route)
+        if needed is None or needed not in topics:
+            raise SceneAdapterError("NOT_APPLICABLE", "适用性检查通过后水雾输入 topic 消失（源代次变化）")
+
+        # 参考图受控校验（缺失 = REFERENCE_MISSING → FAILED，不冒充无命中）
+        try:
+            refs = verify_references()
+        except ReferenceError as exc:
+            msg = str(exc)
+            code = msg.split(":", 1)[0] if ":" in msg else "REFERENCE_MISSING"
+            raise SceneAdapterError(code, msg) from exc
+
+        # 1. 解码（存在但解不出有效帧 = FAILED）
+        frames = self._decode(request, route, bag_dir, work_dir)
+        if not frames:
+            raise SceneAdapterError("DECODE_FAILED", f"路线 {route} 解码无有效帧")
+        if request.cancellation.is_cancelled():
+            raise SceneAdapterError("CANCELLED", "解码后收到取消信号")
+
+        # 2. 冻结选帧（跳过前 10 帧、每 3 帧取 1，对照 pdc_to_pic 的 pcd_files[10::3]）
+        #    选帧作用于**全部解码 PCD 序列**，渲染/过滤只跑选中帧
+        sel_idx = spray_render.select_pcd_indices(len(frames))
+        selected = [frames[i] for i in sel_idx]
+        if not selected:
+            raise SceneAdapterError(
+                "DECODE_FAILED",
+                f"冻结选帧后无有效 PCD（total={len(frames)}，skip_first=10/interval=3）——短包抽帧不足判 FAILED",
+            )
+
+        # 3. 渲染 + 500KiB 过滤（有效帧不足 = FAILED，非 NO_MATCH）
+        report = spray_render.RenderReport()
+        report.total_pcd = len(frames)
+        report.selected = len(selected)
+        rendered_frames: list[tuple[int, Path]] = []
+        for idx, fr in enumerate(selected):
+            if idx % _CANCEL_CHECK_EVERY == 0 and request.cancellation.is_cancelled():
+                raise SceneAdapterError("CANCELLED", f"渲染第 {idx} 帧前收到取消信号，停止写入")
+            out_jpg = work_dir / "jpg" / f"frame_{idx:06d}.jpg"
+            ok = self._render_one(fr, out_jpg)
+            spray_render.account_frame(
+                report, storage_ns=fr.storage_ns, rendered=ok, output_path=out_jpg if ok else None
+            )
+            if ok:
+                rendered_frames.append((fr.storage_ns, out_jpg))
+        try:
+            spray_render.finalize(report)
+        except spray_render.RenderError as exc:
+            raise SceneAdapterError(exc.code, exc.detail) from exc
+
+        # 4. 模型双 pass + 归一（有界重试后不确定 = FAILED）
+        client = self._resolve_client()
+        ref_bytes = ordered_ref_bytes(refs)
+        cache = SprayResultCache(work_dir)
+        cache_key = self._build_cache_key(request, refs, selected, client)
+        cached = cache.hit(cache_key, expected_frame_count=len(rendered_frames))
+        labels: list[str] = []
+        verdicts: list[dict] = []
+        pass_stats: list[dict] = []
+        if cached is not None:
+            # 缓存命中：verdict 自带 storage_ns，无需重跑模型；时间轴由 render report 对齐
+            for r in cached["results"]:
+                labels.append(str(r["label"]))
+                verdicts.append(r)
+            pass_stats = []  # bytes 统计来自首次执行（render_log 注明 cache_reused）
+        else:
+            for i, (storage_ns, jpg) in enumerate(rendered_frames):
+                if i % _CANCEL_CHECK_EVERY == 0 and request.cancellation.is_cancelled():
+                    raise SceneAdapterError("CANCELLED", f"模型第 {i} 帧前收到取消信号，停止写入")
+                frame_stats: list = []
+
+                def _record(stat, _bucket=frame_stats):
+                    _bucket.append(stat)
+
+                try:
+                    p1_raw, p2_raw, p2n = client.judge_frame(jpg.read_bytes(), ref_bytes, on_pass=_record)
+                except SprayModelError as exc:
+                    raise SceneAdapterError("MODEL_FAILED", f"第 {i} 帧模型有界重试后仍不确定：{exc}") from exc
+                verdict = classify_two_pass(p1_raw, p2_raw, p2n)
+                if not verdict.resolvable:
+                    # unknown / 解析失败 → FAILED（不冒充正常，不 NO_MATCH）
+                    raise SceneAdapterError(
+                        "MODEL_UNRESOLVED",
+                        f"第 {i} 帧双 pass 归一不确定（p1={verdict.p1_raw!r} p2={verdict.p2_raw!r}）"
+                        f"——FAILED 不充当正常",
+                    )
+                for s in frame_stats:
+                    pass_stats.append({"frame": i, "storage_ns": storage_ns, **asdict(s)})
+                labels.append(verdict.label)
+                verdicts.append(
+                    {
+                        "storage_ns": storage_ns,
+                        "label": verdict.label,
+                        "p1_raw": verdict.p1_raw,
+                        "p2_raw": verdict.p2_raw,
+                        "p2_ref_num": verdict.p2_ref_num,
+                    }
+                )
+            cache.save(digest=cache_key, results=verdicts)
+
+        # 缓存命中时 verdicts 来自文件（自带 storage_ns）；未命中时与 rendered_frames 逐帧对齐
+        if cached is None:
+            model_storage_ns = [ns for ns, _ in rendered_frames]
+        else:
+            model_storage_ns = [int(v["storage_ns"]) for v in verdicts]
+
+        # 5. 分段（整数 storage ns，不 round 秒）
+        try:
+            seg_params = spray_segment.validate_spray_params(
+                window_size=float(request.parameters.get("window_size", 15)),
+                min_abnormal_ratio=float(request.parameters.get("min_abnormal_ratio", 0.15)),
+                enter=int(request.parameters.get("enter", 3)),
+                exit_=int(request.parameters.get("exit_", 5)),
+                lead_seconds=int(request.parameters.get("lead_seconds", 3)),
+                overlap_merge_seconds=float(request.parameters.get("overlap_merge_seconds", 7.0)),
+            )
+        except ValueError as exc:
+            raise SceneAdapterError("SEGMENT_RULE_ERROR", str(exc)) from exc
+        publish_labels = frozenset(o.label for o in request.capability.output_labels if o.publish_target)
+        try:
+            segments = spray_segment.segment_spray_ns(
+                model_storage_ns,
+                labels,
+                params=seg_params,
+                publish_labels=publish_labels,
+            )
+        except ValueError as exc:
+            raise SceneAdapterError("SEGMENT_RULE_ERROR", str(exc)) from exc
+
+        out_segments: list[SceneSegment] = []
+        for i, seg in enumerate(segments):
+            if seg["end_ns"] <= seg["start_ns"]:
+                continue
+            out_segments.append(
+                SceneSegment(
+                    label=seg["label"],
+                    start_ns=seg["start_ns"],
+                    end_ns=seg["end_ns"],
+                    publish_target=seg["publish_target"] and seg["end_ns"] > seg["start_ns"],
+                    mapping_basis=MAPPING_BAG_STORAGE,
+                    evidence_ref=f"render_log#{i}",
+                )
+            )
+
+        # 6. 证据落盘（render_log + 帧判定 + 预检 + 带宽统计）
+        render_log = self._write_render_log(
+            request, route, report, model_storage_ns, verdicts, pass_stats, refs, frames, cached is not None
+        )
+        has_target = any(s.publish_target for s in out_segments)
+        outcome = SceneOutcome.SUCCESS if has_target else SceneOutcome.NO_MATCH
+        evidence = (
+            EvidenceRef(
+                kind="SPRAY_RENDER_LOG",
+                path=str(render_log),
+                digest=hashlib.sha256(render_log.read_bytes()).hexdigest() if render_log.exists() else None,
+                count=len(rendered_frames),
+            ),
+            EvidenceRef(kind="SPRAY_ROUTE", path=route, count=len(frames)),
+            EvidenceRef(kind="SPRAY_REFS", path=refs.ordered_hash[:16], count=7),
+        )
+        return AnalysisOutput(outcome=outcome, segments=tuple(out_segments), evidence=evidence)
+
+    # ------------------------------------------------------------------
+    # 内部步骤
+    # ------------------------------------------------------------------
+
+    def _resolve_client(self) -> SprayModelClient:
+        if self._client is not None:
+            return self._client
+        client = _default_model_client()
+        if client is None:
+            raise SceneAdapterError("MODEL_UNAVAILABLE", "服务端未配置 spray 模型客户端（model_profile 引用缺失）")
+        return client
+
+    def _decode(self, request: SceneRunRequest, route: str, bag_dir: Path, work_dir: Path) -> list[SprayFrame]:
+        def _cancel() -> bool:
+            return request.cancellation.is_cancelled()
+
+        try:
+            if route == "packet":
+                if self._decoder_path is None:
+                    # 生产路径：decoder 在处理机，本单服务端只做预检与路径封装
+                    from app.scene.spray.precheck import check_decoder
+
+                    dec = check_decoder()
+                    if not dec.ok:
+                        raise DecodeError(dec.reason, dec.detail)
+                    decoder = "/home/wang/work/ros2_slice/utils/packet2pointcloud"
+                else:
+                    decoder = str(self._decoder_path)
+                return spray_decode.decode_packet_route(bag_dir, work_dir, decoder, cancel_check=_cancel)
+            if route == "pointcloud":
+                return spray_decode.decode_pointcloud_route(bag_dir, work_dir, require_intensity=True)
+            raise DecodeError("ROUTE_INVALID", f"未知路线 {route!r}")
+        except DecodeError as exc:
+            raise SceneAdapterError(exc.code, exc.detail) from exc
+
+    def _render_one(self, fr: SprayFrame, out_jpg: Path) -> bool:
+        if fr.pcd_path is None:
+            return False
+        try:
+            parse_binary_pcd_header(fr.pcd_path)
+        except Exception:
+            return False
+        try:
+            return spray_render.render_pcd_to_jpg(fr.pcd_path, out_jpg)
+        except spray_render.RenderError as exc:
+            if exc.code == "RENDER_UNAVAILABLE":
+                # 本机无 Open3D/EGL：真实渲染不可跑 → 本单探针口径 NOT_RUN，
+                # 不能 mock 当 PASS；标记该帧不可渲染（计入 render_failed）。
+                return False
+            return False
+
+    def _build_cache_key(self, request: SceneRunRequest, refs, frames: list[SprayFrame], client) -> str:
+        frame_h = []
+        for fr in frames:
+            if fr.pcd_path is not None:
+                h = hashlib.sha256(fr.pcd_path.read_bytes()).hexdigest()[:16]
+            else:
+                pts = fr.points or ()
+                h = hashlib.sha256(json.dumps([list(p) for p in pts], sort_keys=True).encode()).hexdigest()[:16]
+            frame_h.append((fr.storage_ns, h))
+        preprocessing = {
+            "skip_first": spray_render.SKIP_FIRST_FRAMES,
+            "interval": spray_render.FRAME_INTERVAL,
+            "roi_x": list(spray_render.ROI_X),
+            "roi_y": list(spray_render.ROI_Y),
+            "quality": spray_render.JPG_QUALITY,
+            "threshold_kb": spray_render.SMALL_IMAGE_THRESHOLD_KB,
+            "render": f"{spray_render.RENDER_WIDTH}x{spray_render.RENDER_HEIGHT}r{spray_render.ROTATE_DEGREES}",
+        }
+        seg_params = {
+            "window_size": request.parameters.get("window_size", 15),
+            "min_abnormal_ratio": request.parameters.get("min_abnormal_ratio", 0.15),
+            "enter": request.parameters.get("enter", 3),
+            "exit_": request.parameters.get("exit_", 5),
+            "lead_seconds": request.parameters.get("lead_seconds", 3),
+            "overlap_merge_seconds": request.parameters.get("overlap_merge_seconds", 7.0),
+        }
+        model_profile = getattr(client, "model", "") if client is not None else ""
+        return key_digest(
+            SprayCacheKey(
+                capability_version=request.capability.capability_version,
+                rules_revision=request.capability.rules_revision,
+                model_profile=model_profile,
+                ref_ordered_hash=refs.ordered_hash,
+                preprocessing=preprocessing,
+                source_fingerprint=request.source_fingerprint,
+                frames=tuple(frame_h),
+                decoder_revision=request.capability.adapter_revision,
+                render_revision=request.capability.adapter_revision,
+                segment_params=seg_params,
+            )
+        )
+
+    def _write_render_log(
+        self, request, route, report, model_storage_ns, verdicts, pass_stats, refs, frames, cache_reused
+    ) -> Path:
+        log = {
+            "route": route,
+            "source_id": request.source_id,
+            "source_fingerprint": request.source_fingerprint,
+            "preprocessing": report.to_dict(),
+            "frames": [{"storage_ns": f.storage_ns, "route": f.route} for f in frames],
+            # verdicts 已含 storage_ns（缓存命中/未命中统一）；这里只对齐时间轴记录
+            "verdicts": list(verdicts),
+            "model_storage_ns": list(model_storage_ns),
+            "pass_stats": pass_stats,
+            "prompt_hashes": prompt_hashes(),
+            "refs": {"ordered_hash": refs.ordered_hash, "total_bytes": refs.total_bytes, "source_commit": "be23177…"},
+            "cache_reused": cache_reused,
+            "capability_version": request.capability.capability_version,
+            "rules_revision": request.capability.rules_revision,
+            "model_profile": request.capability.model_profile,
+        }
+        path = Path(request.work_dir) / "render_log.json"
+        try:
+            path.write_text(json.dumps(log, ensure_ascii=False, sort_keys=True), encoding="utf-8")
+        except OSError:
+            print(f"⚠️ spray render_log 写入失败（证据缺失，不影响结果）：{path}", flush=True)
+        return path
+
+
+def _default_model_client() -> SprayModelClient | None:
+    """生产客户端：从服务端运行配置读取模型端点引用（凭据不进能力描述）。"""
+    import os
+
+    endpoint = os.getenv("SPRAY_VLM_ENDPOINT", "").strip()
+    if not endpoint:
+        return None
+    from app.scene.spray.model import HttpSprayModelClient
+    from app.scene.spray.references import REFERENCES
+
+    ref_names = tuple(r["name"] for r in REFERENCES)
+    return HttpSprayModelClient(
+        endpoint=endpoint,
+        api_key=os.getenv("SPRAY_VLM_API_KEY", ""),
+        model=os.getenv("SPRAY_VLM_MODEL", ""),
+        ref_order_names=ref_names,
+    )
+
+
+# 能力不可用原因（供描述/预检）：源码在但依赖缺失时明确 unavailable_reason
+def precheck_summary(decoder_path: str | Path | None = None, model_client=None) -> dict:
+    return run_precheck(decoder_path=decoder_path, model_client=model_client).to_dict()
+
+
+register_adapter(SPRAY_ADAPTER_KEY, SprayAdapter)
