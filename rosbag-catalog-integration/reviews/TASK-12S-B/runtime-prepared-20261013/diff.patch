+def patch_render(monkeypatch, size_bytes: int = 600 * 1024):
+    """monkeypatch adapter._render_one 与 render.render_pcd_to_jpg 走确定性渲染。"""
+    import app.scene.spray.adapter as A
+
+    def fake_render_one(self, fr, out_jpg) -> bool:
+        out_jpg.parent.mkdir(parents=True, exist_ok=True)
+        out_jpg.write_bytes(b"\xff\xd8\xff\xe0" + b"\x00" * max(0, size_bytes - 4))
+        return True
+
+    monkeypatch.setattr(A.SprayAdapter, "_render_one", fake_render_one)
+    return fake_render_one
+
