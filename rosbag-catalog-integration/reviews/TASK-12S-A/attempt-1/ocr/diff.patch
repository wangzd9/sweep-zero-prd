+def test_bind_name_contradicts_frozen_vehicle_409(db, scene_settings, spray_available, monkeypatch):
+    """目录名编号匹配到另一辆车 → 409 回滚，不猜车不篡改。"""
+    # 冻结车辆 = n3a（source_metadata.vehicle_code）；目录名编号 rust-{UNIQUE}n3
+    # 命中 n3b（另一辆车 rustdesk_id）→ basename 与冻结矛盾 → 409 fail-closed。
+    frozen = _make_vehicle(db, f"t12sa-{UNIQUE}-n3a")
+    _make_vehicle(db, f"t12sa-{UNIQUE}-n3b", rustdesk_id=f"rust-{UNIQUE}n3")
+    profile_id = f"t12sa-{UNIQUE}-spray-n3"
+    _seed_spray_profile(db, profile_id=profile_id)
+    leaf = f"rosbag2_2026_10_12-16_02_03-rust-{UNIQUE}n3"
+    _pending_spray_submission(db, profile_id, f"20261012/{leaf}", frozen.vehicle_code)
+    with pytest.raises(HTTPException) as exc:
+        _register(db, monkeypatch, f"spray/20261012/{leaf}")
+    assert exc.value.status_code == 409
+    assert "SOURCE_METADATA_VEHICLE_CONFLICT" in str(exc.value.detail)
+    with SessionLocal() as s:
+        # 登记回滚：无 bag、无 SCHEDULED 提交
+        bag_row = s.scalar(
+            select(BagRecord).where(BagRecord.relative_path == f"scene/ready/spray/20261012/{leaf}")
+        )
+        assert bag_row is None
+        assert s.scalar(
+            select(IngestSubmission).where(
+                IngestSubmission.profile_id == profile_id, IngestSubmission.status == "SCHEDULED"
+            )
+        ) is None
