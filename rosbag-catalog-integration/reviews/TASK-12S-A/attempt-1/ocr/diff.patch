+def test_hash_replay_same_metadata_same_hash(db, scene_settings, spray_available):
+    """hash 重放：同元数据独立 hash 可重放计算，改字段必变。"""
+    profile = _seed_spray_profile(db, profile_id=f"t12sa-{UNIQUE}-spray-replay")
+    vehicle = _make_vehicle(db, f"t12sa-{UNIQUE}-v1")
+    db.commit()
+    key = f"k-{UNIQUE}-replay"
+    metadata = _metadata(vehicle_code=vehicle.vehicle_code)
+    selection = SubmissionSelection(
+        purposes=[IngestPurpose.SCENE_SLICE],
+        scenes=[SceneSelection(scene_code="spray", capability_version="spray-v1", parameters={})],
+        relative_path="20261012/r1",
+    )
+    ingest_service.create_submission(db, profile.profile_id, "20261012/r1", selection, key, metadata)
+    sub = db.scalar(select(IngestSubmission).where(IngestSubmission.idempotency_key == key))
+    snap = json.loads(sub.intake_snapshot_json)
+    assert snap["source_metadata_hash"] == ingest_service._source_metadata_hash(metadata)
+    mutated = dict(metadata, batch_id="changed")
+    assert ingest_service._source_metadata_hash(mutated) != snap["source_metadata_hash"]
+    db.commit()
+    _cleanup_committed()
