+    path = f"{SCENE_READY}/{ready_rel}"
+    return source_service.register_source(
+        db,
+        {"path": path, "fast_fingerprint": f"fp-{UNIQUE}-{ready_rel}", "root_id": root_id,
+         "incoming_path": f"{SCENE_INCOMING}/{ready_rel}"},
