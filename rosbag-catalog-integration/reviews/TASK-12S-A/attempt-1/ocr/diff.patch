+def _pending_spray_submission(db, profile_id, entry_rel, vehicle_code):
+    row = db.scalar(select(IngestProfile).where(IngestProfile.profile_id == profile_id))
+    selection = SubmissionSelection(
+        purposes=[IngestPurpose.SCENE_SLICE],
+        scenes=[SceneSelection(scene_code="spray", capability_version="spray-v1", parameters={})],
+        relative_path=entry_rel,
+    )
+    response, status = ingest_service.create_submission(
+        db, profile_id, entry_rel, selection, None, _metadata(vehicle_code=vehicle_code)
+    )
+    assert status == 201
+    return row, response
+
