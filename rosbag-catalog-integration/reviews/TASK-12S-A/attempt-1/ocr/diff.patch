+    # 改回不存在的车辆 → 422（未绑定阶段也拒绝不猜车）
+    bad = client.patch(
+        f"/api/v1/ingest-submissions/{sub_id}",
+        json={"row_version": 2, "source_metadata": _metadata(vehicle_code=vehicle_gone, batch_id="b1")},
