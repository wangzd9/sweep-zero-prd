+        return
+    try:
+        snapshot = json.loads(submission.intake_snapshot_json)
+    except (TypeError, ValueError):
+        return
+    metadata = snapshot.get("source_metadata")
+    if not isinstance(metadata, dict):
+        return
+    vehicle_code = metadata.get("vehicle_code")
+    if not isinstance(vehicle_code, str) or not vehicle_code.strip():
+        return
+    from app.models import BagRecord, Vehicle
+
+    vehicle = db.scalar(select(Vehicle).where(Vehicle.vehicle_code == vehicle_code.strip()))
+    if vehicle is None:
