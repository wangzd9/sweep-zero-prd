+    vehicle_gone = f"t12sa-{UNIQUE}-gone"  # 未登记 code
+    db.commit()
+    client = next(_api_client())
+    created = _post(client, profile.profile_id, f"20261012/{UNIQUE}p", f"k-{UNIQUE}-p", _metadata(batch_id="b1"))
+    assert created.status_code == 201, created.text
+    sub_id = created.json()["submission_id"]
