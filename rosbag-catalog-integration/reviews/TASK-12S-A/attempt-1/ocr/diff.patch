+    created = _post(client, profile.profile_id, f"20261012/{UNIQUE}a", f"k-{UNIQUE}-1", metadata)
+    assert created.status_code == 201, created.text
+    sub_id = created.json()["submission_id"]
+    # 同键同元数据回放 → 200 同一提交（AC-18.2）
+    replay = _post(client, profile.profile_id, f"20261012/{UNIQUE}a", f"k-{UNIQUE}-1", metadata)
+    assert replay.status_code == 200 and replay.json()["submission_id"] == sub_id
+    # 同键不同元数据 → 409
+    conflict = _post(client, profile.profile_id, f"20261012/{UNIQUE}a", f"k-{UNIQUE}-1", _metadata(batch_id="9999"))
+    assert conflict.status_code == 409, conflict.text
+    # 未知车辆 → 422 不猜车（显式用一个从未登记的 code，避免命中默认车辆）
+    bad = _post(
+        client, profile.profile_id, f"20261012/{UNIQUE}b", f"k-{UNIQUE}-2",
+        _metadata(vehicle_code=f"t12sa-{UNIQUE}-ghost", batch_id="x"),
+    )
+    assert bad.status_code == 422 and "UNKNOWN_VEHICLE" in bad.text
+    # spray 入口缺 source_metadata → 422 必填
+    missing = _post(client, profile.profile_id, f"20261012/{UNIQUE}c", f"k-{UNIQUE}-3")
+    assert missing.status_code == 422 and "SOURCE_METADATA_REQUIRED" in missing.text
+    # 快照独立 hash 与 config_hash 分离
