+def _register(db, monkeypatch, ready_rel: str, root_id: str = "scene"):
+    # upsert_bag 的 bag.name = ready 路径末段（目录名），candidate_identifier 按
+    # 目录名解析 rustdesk 编号——测试用目录名末段编码车辆编号，与生产同口径。
+    bag_name = ready_rel.rsplit("/", 1)[-1]
+    monkeypatch.setattr(
+        source_service, "inspect_bag_directory", lambda path: {"path": path, "name": bag_name, "file_count": 2}
+    )
+    monkeypatch.setattr(source_service, "nas_client", lambda: _FakeClient(bag_name))
