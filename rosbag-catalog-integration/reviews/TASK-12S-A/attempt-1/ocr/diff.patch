+def test_recovery_registration_reapplies_frozen_binding(db, scene_settings, spray_available, monkeypatch):
+    """恢复登记（重放）：basename 匹配清空后仍按冻结快照恢复车辆（AC-18.2）。"""
+    vehicle = _make_vehicle(db, f"t12sa-{UNIQUE}-n5")
+    profile_id = f"t12sa-{UNIQUE}-spray-n5"
+    _seed_spray_profile(db, profile_id=profile_id)
+    _pending_spray_submission(db, profile_id, f"20261012/{UNIQUE}n5", vehicle.vehicle_code)
+    first = _register(db, monkeypatch, f"spray/20261012/{UNIQUE}n5")
+    assert first["ingest"]["matched"] is True
+    with SessionLocal() as s:
+        bag = s.scalar(select(BagRecord).where(BagRecord.relative_path == f"scene/ready/spray/20261012/{UNIQUE}n5"))
+        bag_uid = bag.bag_uid
+        # 模拟恢复轮次前 basename 匹配把车辆清空（无编号目录名 → UNMATCHED）
+        bag.vehicle = None
+        bag.vehicle_link_status = "UNMATCHED"
+        s.commit()
+    # 恢复登记：同 bag 重放（指纹相同 → 幂等路径不走，改同代次显式重登记）
+    second = source_service.register_source(
+        db,
+        {
+            "path": f"{SCENE_READY}/spray/20261012/{UNIQUE}n5",
+            "fast_fingerprint": f"fp-{UNIQUE}-spray-20261012/{UNIQUE}n5",
+            "root_id": "scene",
+            "incoming_path": f"{SCENE_INCOMING}/spray/20261012/{UNIQUE}n5",
