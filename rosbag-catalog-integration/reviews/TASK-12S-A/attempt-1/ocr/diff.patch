+        None,
+    )
+    assert second["ingest"]["matched"] is True
+    with SessionLocal() as s:
+        bag = s.scalar(select(BagRecord).where(BagRecord.bag_uid == bag_uid))
+        assert bag.vehicle_id == vehicle.id  # 冻结绑定重新应用，不被清空
+        assert bag.vehicle_link_status == "MATCHED"
