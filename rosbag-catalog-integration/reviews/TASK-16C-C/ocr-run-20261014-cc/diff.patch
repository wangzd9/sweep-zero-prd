@@ -0,0 +1,359 @@
+# TASK-16C-C：场景流水线详情（DESIGN §7.3.3）+ OCR 遗留逐条（C1/C2/C3/C4/C8/C9/c05-03/04/05）
+from __future__ import annotations
+
+import json
+from datetime import datetime
+
+import pytest
+from fastapi.testclient import TestClient
+from sqlalchemy import select
+from sqlalchemy.orm import Session
+
+from app.database import Base, SessionLocal, engine
+from app.domain.enums import QueueName
+from app.main import app
+from app.models import (
+    BagDerivation,
+    BagPurpose,
+    BagRecord,
+    PipelineEvent,
+    PipelineRun,
+    SceneAnalysisVersion,
+    SceneSegment,
+    SourceCopy,
+    StepRun,
+)
+from app.services.scene_slice_service import PIPELINE_TYPE_SCENE_SLICE
+from app.web.pipelines import (
+    SCENE_TERMINAL_STATUSES,
+    _scene_environment_paths,
+    _scene_model_identity,
+    _scene_phase_summary,
+    scene_terminal,
+)
+
+UID_PREFIX = "T16CC"
+
+
+def _uid(n: int) -> str:
+    return f"{UID_PREFIX}{n:020d}"
+
+
+@pytest.fixture
+def db():
+    session: Session = SessionLocal()
+    try:
+        _purge_prefix(session)
+    except Exception:  # noqa: BLE001
+        session.rollback()
+    Base.metadata.create_all(engine)
+    try:
+        _purge_prefix(session)
+    except Exception:  # noqa: BLE001
+        session.rollback()
+    try:
+        yield session
+    finally:
+        try:
+            session.rollback()
+        except Exception:  # noqa: BLE001
+            pass
+        session.close()
+        _purge_prefix()
+
+
+def _purge_prefix(session: Session | None = None) -> None:
+    s = session or SessionLocal()
+    try:
+        avs = s.scalars(
+            select(SceneAnalysisVersion.id).where(SceneAnalysisVersion.parent_bag_uid.like(f"{UID_PREFIX}%"))
+        ).all()
+        if avs:
+            s.execute(SceneSegment.__table__.delete().where(SceneSegment.analysis_version_id.in_(avs)))
+        s.execute(SceneAnalysisVersion.__table__.delete().where(SceneAnalysisVersion.parent_bag_uid.like(f"{UID_PREFIX}%")))
+        run_ids = s.scalars(select(PipelineRun.id).where(PipelineRun.source_id.like(f"{UID_PREFIX}%"))).all()
+        if run_ids:
+            s.execute(StepRun.__table__.delete().where(StepRun.pipeline_run_id.like(f"{UID_PREFIX}-run%")))
+            s.execute(PipelineEvent.__table__.delete().where(PipelineEvent.pipeline_run_id.like(f"{UID_PREFIX}-run%")))
+            s.execute(SourceCopy.__table__.delete().where(SourceCopy.pipeline_run_id.like(f"{UID_PREFIX}-run%")))
+        s.execute(
+            BagDerivation.__table__.delete().where(
+                BagDerivation.parent_bag_uid.like(f"{UID_PREFIX}%") | BagDerivation.child_bag_uid.like(f"{UID_PREFIX}%")
+            )
+        )
+        from app.models import bag_scene
+
+        bag_ids = s.scalars(select(BagRecord.id).where(BagRecord.bag_uid.like(f"{UID_PREFIX}%"))).all()
+        if bag_ids:
+            s.execute(BagPurpose.__table__.delete().where(BagPurpose.bag_id.in_(bag_ids)))
+            s.execute(bag_scene.delete().where(bag_scene.c.bag_id.in_(bag_ids)))
+        s.execute(BagRecord.__table__.delete().where(BagRecord.bag_uid.like(f"{UID_PREFIX}%")))
+        s.execute(PipelineRun.__table__.delete().where(PipelineRun.source_id.like(f"{UID_PREFIX}%")))
+        s.commit()
+    except Exception:  # noqa: BLE001
+        s.rollback()
+    finally:
+        s.close()
+
+
+def _add_bag(session: Session, n: int, *, bag_role: str = "ORIGINAL", dataset_type: str = "self_built") -> BagRecord:
+    bag = BagRecord(
+        bag_uid=_uid(n),
+        name=f"t16cc-bag-{n}",
+        relative_path=f"ready/t16cc/{n}",
+        bag_role=bag_role,
+        dataset_type=dataset_type,
+        started_at=datetime(2026, 1, 1),
+        availability="AVAILABLE",
+    )
+    session.add(bag)
+    session.flush()
+    session.add(BagPurpose(bag_id=bag.id, purpose="self_built"))
+    session.flush()
+    return bag
+
+
+def _scene_run(
+    session: Session,
+    n: int,
+    *,
+    status: str = "SCENE_RUNNING",
+    snapshot: dict | None = None,
+    bag: BagRecord | None = None,
+    pipeline_type: str = PIPELINE_TYPE_SCENE_SLICE,
+) -> PipelineRun:
+    if bag is None:
+        bag = _add_bag(session, 100 + n)
+    run = PipelineRun(
+        pipeline_run_id=f"{UID_PREFIX}-run{n:02d}",
+        source_id=bag.bag_uid,
+        queue_name=QueueName.SCENE_SLICE.value,
+        status=status,
+        pipeline_type=pipeline_type,
+        pipeline_config_name="slope",
+        pipeline_config_version="v1",
+        pipeline_config_snapshot_json=json.dumps(snapshot if snapshot is not None else {
+            "schema_version": "scene-run/v1",
+            "scenes": [{"scene_code": "slope", "capability_version": "v1", "capability_config_hash": "h" * 16}],
+            "effective_config_hash": "e" * 64,
+            "profile_id": "scene-isolated",
+            "profile_version": "v3",
+        }, ensure_ascii=False, sort_keys=True),
+    )
+    session.add(run)
+    session.flush()
+    return run
+
+
+def _add_step(session: Session, run: PipelineRun, name: str, status: str, *, error: str = "", attempt: int = 1) -> StepRun:
+    step = StepRun(pipeline_run_id=run.pipeline_run_id, step_name=name, attempt=attempt, status=status, error_message=error)
+    session.add(step)
+    session.flush()
+    return step
+
+
+def _outcome_snapshot(outcome: str) -> dict:
+    return {
+        "schema_version": "scene-run/v1",
+        "scenes": [{"scene_code": "slope", "capability_version": "v1", "capability_config_hash": "h" * 16}],
+        "effective_config_hash": "e" * 64,
+        "profile_id": "scene-isolated",
+        "profile_version": "v3",
+        "scene_outcomes": {"slope": {"outcome": outcome}},
+    }
+
+
+def _page(client: TestClient, run: PipelineRun) -> str:
+    resp = client.get(f"/pipelines/{run.pipeline_run_id}")
+    assert resp.status_code == 200, resp.text[:500]
+    return resp.text
+
+
+class TestScenePhaseSummaryUnit:
+    """C1/C3/C4：八步状态解释（单元面）。"""
+
+    def test_no_match_skips_segment_and_after_only(self, db: Session):
+        run = _scene_run(db, 1, status="SCENE_DONE", snapshot=_outcome_snapshot("NO_MATCH"))
+        latest = {"PRECHECK": _add_step(db, run, "PRECHECK", "DONE"),
+                  "EXTRACT": _add_step(db, run, "EXTRACT", "DONE"),
+                  "INFER": _add_step(db, run, "INFER", "DONE")}
+        db.commit()
+        summary = {p["name"]: p["status"] for p in _scene_phase_summary(run, latest, "NO_MATCH")}
+        assert summary["输入检查"] == "已完成"
+        assert summary["解码/抽帧"] == "已完成"
+        assert summary["模型识别"] == "已完成"
+        # C1：区间生成及之后=已跳过（无需）（原不可达 elif 删除后同一分支覆盖）
+        assert summary["区间生成"] == "已跳过（无需）"
+        assert summary["切包"] == "已跳过（无需）"
+        assert summary["产物校验"] == "已跳过（无需）"
+        assert summary["NAS 发布"] == "已跳过（无需）"
+        assert summary["登记/完成"] == "已跳过（无需）"
+
+    def test_failed_run_unstarted_steps_stay_not_started(self, db: Session):
+        # C4：run 失败但步骤无记录=「未开始」，不伪标完成/终止
+        run = _scene_run(db, 2, status="SCENE_FAILED")
+        _add_step(db, run, "PRECHECK", "DONE")
