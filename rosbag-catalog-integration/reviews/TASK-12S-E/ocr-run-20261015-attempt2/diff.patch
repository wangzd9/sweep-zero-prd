+    with SessionLocal() as s:
+        sub = _sub(s, sub_id)
+        assert sub.status == "PENDING_INPUT", sub.status
+        s.rollback()
+        s.query(IngestSubmission).filter(IngestSubmission.submission_id == sub_id).delete(
+            synchronize_session=False
+        )
+        s.query(PurposeScheduleEvent).delete(synchronize_session=False)
+        s.commit()
