+def test_register_move_recovery_with_slice_sibling_exempts_409(db, scene_settings, monkey_source, monkeypatch):
+    """E-R7/E-R8 豁免路：源行经 upsert_bag 真实口径登记在 incoming 侧（storage 相对段
+    incoming/…）+ 同指纹切片兄弟行 + Scanner 按 ready 路径携同指纹重登记（落在受控
+    ready 根）→ 豁免 409 走移动恢复，归并既有 UID（旧实现 tier-2 恒空 + 409 栅栏
+    前置 → 永不自愈）。"""
+    monkeypatch.setenv("SCENE_INGEST_ENABLED", "1")
+    pid = f"t12se-{UNIQUE}-er8x"
+    _add_scene_profile(db, pid)
+    bag = _bag_dir("er8x")
+    fp = f"fp-er8x-{UNIQUE}"
+    # 源袋物理位于 incoming 侧：按真实登记路径（upsert_bag 产物）落行
+    with TestClient(app) as client:
+        first = client.post(
+            "/api/v1/sources/register",
+            json={"path": f"{SCENE_INCOMING_ROOT}/{PFX}/{bag}", "fast_fingerprint": fp},
+        )
+    assert first.status_code == 200, first.text
+    source_id = first.json()["source_id"]
+    with SessionLocal() as s:
+        orig = s.scalar(select(BagRecord).where(BagRecord.bag_uid == source_id))
+        # E-R7 真实口径：落库 relative_path 是 storage 相对段（非绝对路径）
+        assert orig.relative_path == f"scene/incoming/{PFX}/{bag}", orig.relative_path
+        # 切片兄弟行（同快指纹，父子共享场景）
+        s.add(
+            BagRecord(
+                bag_uid="SLER8X" + UNIQUE.upper()[:20],
+                name=_bag_dir("er8x_slice"),
+                relative_path=f"scene/slices/{_bag_dir('er8x_slice')}",
+                bag_role="SCENE_SLICE",
+                fast_fingerprint=fp,
+                source_generation=1,
+                source_status="READY",
+            )
+        )
+        s.commit()
+    # Scanner 重放 MOVING/MOVED：源已移到 ready 位置，按 ready 路径携同指纹重登记
+    # slice_share（切片行）+ 无 exact_originals（ready 相对路径无行）
+    # + incoming_side 恰 1（E-R7 归一后真实口径命中）+ 注册落受控 ready 根
+    # → E-R8 豁免 409，移动恢复归并既有 UID
+    with TestClient(app) as client:
+        resp = client.post(
+            "/api/v1/sources/register",
+            json={
+                "path": f"{SCENE_READY}/{PFX}/{bag}",
+                "incoming_path": f"{SCENE_INCOMING_ROOT}/{PFX}/{bag}",
+                "root_id": "scene",
+                "fast_fingerprint": fp,
+            },
+        )
+    assert resp.status_code == 200, resp.text
+    assert resp.json()["source_id"] == source_id, (resp.json()["source_id"], source_id)
+    with SessionLocal() as s:
+        row = s.scalar(select(BagRecord).where(BagRecord.bag_uid == source_id))
+        # 移动恢复：incoming 行归并刷新为 ready 相对路径，UID 不变
+        assert row.relative_path == f"scene/ready/{PFX}/{bag}", row.relative_path
+        # 同指纹行只剩归并原包 + 切片两行（未新建第三行）
+        assert s.scalar(select(func.count(BagRecord.id)).where(BagRecord.fast_fingerprint == fp)) == 2
+
