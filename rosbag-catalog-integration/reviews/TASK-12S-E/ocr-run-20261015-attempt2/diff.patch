+def test_reconcile_fifo_selection_when_over_limit(scene_settings, monkey_source, db, monkeypatch):
+    """E-R5：>limit 条 PENDING 时按 created_at FIFO 选取——最旧的（可绑）先被选中
+    绑定，新的无源行不得挤占批内位置（饥饿）。limit=1 下选中行必须是最旧行。"""
+    monkeypatch.setenv("SCENE_INGEST_ENABLED", "1")
+
+    with SessionLocal() as s:
+        pid = f"t12se-{UNIQUE}-fifo"
+        _add_scene_profile(s, pid)
+    # 可绑袋先登记（源 READY 入行）
+    bag = _bag_dir("fifo")
+    with TestClient(app) as client:
+        reg = _register(client, bag)
+    assert reg.status_code == 200, reg.text
+    # 登记时源已 READY：系统兜底提交在登记事务内即被绑定（claim 释放、事件已出）；
+    # 再走 create_submission 真实链路生成正式提交（合法 effective_config/冻结 hash），
+    # 落库后显式回拨 created_at 为最旧
+    oldest_resp = _create_submission(pid, bag)
+    with SessionLocal() as s:
+        sub_oldest = _sub(s, oldest_resp["submission_id"])
+        sub_oldest.created_at = datetime(2026, 10, 14, 10, 0, 0)
+        s.commit()
+        # 3 条 newer 无源 PENDING（快照指向不存在袋 → NO_SOURCE_YET 跳过）；
+        # 选取顺序（FIFO）才是本用例断言点
+        for i in range(1, 4):
+            row = IngestSubmission(
+                submission_id=f"sub-fifo-new{i}-{UNIQUE}"[:32],
+                profile_id=pid,
+                profile_version=1,
+                relative_path=f"nosrc{i}_{UNIQUE}"[:40],
+                status="PENDING_INPUT",
+                row_version=1,
+                source="api",
+                selection_json="{}",
+                config_required=False,
+                effective_config_json=sub_oldest.effective_config_json,
+                frozen_capability_hashes_json=sub_oldest.frozen_capability_hashes_json,
+                intake_snapshot_json=json.dumps(
+                    {
+                        "schema_version": "scene-intake/v1",
+                        "root_id": "scene",
+                        "scan_root": SCENE_INCOMING_ROOT,
+                        "ready_root": SCENE_READY,
+                    },
+                    ensure_ascii=False,
+                ),
+            )
+            row.created_at = datetime(2026, 10, 14, 10, i, 0)
+            s.add(row)
+        s.commit()
+    with SessionLocal() as s:
+        result = pending_binding.reconcile_pending_bindings(s, limit=1)
+    # FIFO：limit=1 只选中最旧的 PENDING=可绑那条 → bound=1；
+    # 若 DB 自由裁量选到无源新行，则 checked=1/skipped NO_SOURCE_YET、bound 空。
+    assert result["bound"] == [sub_oldest.submission_id], result
+    with SessionLocal() as s:
+        s.rollback()
+        s.query(IngestSubmission).filter(IngestSubmission.submission_id.like("sub-fifo-%")).delete(
+            synchronize_session=False
+        )
+        s.query(IngestProfile).filter(IngestProfile.profile_id == pid).delete(synchronize_session=False)
+        bag_ids = [
