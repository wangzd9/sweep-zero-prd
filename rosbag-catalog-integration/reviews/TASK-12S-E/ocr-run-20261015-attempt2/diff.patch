+      非 ready_root 重复拼接）；
+    - bound_incoming_path 含 profile.incoming_prefix 段；
+    - bound_purposes_json 持久化（恢复登记回显 scheduled_purposes/self_built
+      与首登一致，不再回显 []/False）。
+    """
+    monkeypatch.setenv("SCENE_INGEST_ENABLED", "1")
+    pid = f"t12se-{UNIQUE}-er123"
+    _add_scene_profile(db, pid)
+    bag = _bag_dir("er123")
+    with TestClient(app) as client:
+        first = _register(client, bag)
+    assert first.status_code == 200, first.text
+    source_id = first.json()["source_id"]
+    with SessionLocal() as s:
+        orig = s.scalar(select(BagRecord).where(BagRecord.bag_uid == source_id))
+        assert orig.relative_path == f"scene/ready/{PFX}/{bag}", orig.relative_path
+    formal = _create_submission(pid, bag)
+    with SessionLocal() as s:
+        stats = _consume(s)
+    assert stats["pending_reconciled"]["bound"] == [formal["submission_id"]], stats
+    with SessionLocal() as s:
+        sub = _sub(s, formal["submission_id"])
+        # E-R1：真实物理路径（storage 根 + 落库相对段），不得是 ready_root 重复拼接
+        assert sub.bound_ready_path == f"{SCENE_READY}/{PFX}/{bag}", sub.bound_ready_path
+        assert sub.bound_ready_path == f"/test/{orig.relative_path}", sub.bound_ready_path
+        # E-R2：入口侧含 incoming_prefix 段的物理 incoming 路径
+        assert sub.bound_incoming_path == f"{SCENE_INCOMING_ROOT}/{PFX}/{bag}", sub.bound_incoming_path
+        # E-R3：用途集合持久化，恢复登记回显一致
+        assert json.loads(sub.bound_purposes_json) == ["scene_slice"], sub.bound_purposes_json
+        # 回显一致性：再登记（恢复短路）读 bound_purposes_json，scheduled_purposes 不变
