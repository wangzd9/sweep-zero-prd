+            s.query(BagTopic).filter(BagTopic.bag_id.in_(bag_ids)).delete(synchronize_session=False)
+            s.query(BagRecord).filter(BagRecord.id.in_(bag_ids)).delete(synchronize_session=False)
+        s.query(IngestSubmission).delete(synchronize_session=False)
+        s.query(PurposeScheduleEvent).delete(synchronize_session=False)
