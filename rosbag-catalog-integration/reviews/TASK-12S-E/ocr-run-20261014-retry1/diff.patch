+def _add_scene_profile(db, profile_id, prefix=PFX, scenes=("slope",), purposes=("scene_slice",)):
+    row = IngestProfile(
+        profile_id=profile_id,
+        version=1,
+        display_name=profile_id,
+        incoming_prefix=prefix,
+        default_purposes_json=json.dumps(list(purposes)),
+        default_scenes_json=json.dumps(list(scenes)),
+        default_scene_parameters_json=json.dumps({}),
+        intake_root_id="scene",
+        enabled=True,
+    )
+    db.add(row)
+    db.commit()
+    return row
+
+
+def _scene_ready(bag, prefix=PFX):
+    return f"{SCENE_READY}/{prefix}/{bag}"
+
+
+def _scene_incoming(bag, prefix=PFX):
+    return f"{SCENE_INCOMING_ROOT}/{prefix}/{bag}"
+
+
+def _register(client, bag, root="scene", fingerprint=None, prefix=PFX):
+    """默认每包唯一快指纹（fingerprint=None 自动派生）：登记链路只有携带指纹才把源
+    置 READY（TASK-10 修复口径），且唯一指纹避免跨用例指纹串扰。"""
+    if fingerprint is None:
+        fingerprint = f"fp-{UNIQUE}-{bag}"
+    if root == "scene":
+        path = _scene_ready(bag, prefix)
+        incoming = _scene_incoming(bag, prefix)
+    else:
+        path = f"{SELF_READY}/{bag}"
+        incoming = f"{INCOMING_ROOT}/{bag}"
+    body = {"path": path, "incoming_path": incoming, "root_id": root}
+    if fingerprint is not None:
+        body["fast_fingerprint"] = fingerprint
+    return client.post("/api/v1/sources/register", json=body)
+
+
+def _create_submission(pid, bag, metadata=None, key=None):
+    """正式提交（create_submission 口径：入口相对路径=bag，前缀已剥离）→ 恒 PENDING_INPUT。"""
+    selection = SubmissionSelection(
+        purposes=[IngestPurpose("scene_slice")],
+        scenes=[SceneSelection(scene_code="slope")],
+        relative_path=bag,
+    )
+    with SessionLocal() as s:
+        response, status = ingest_service.create_submission(s, pid, bag, selection, key, metadata)
+    assert status == 201, response
+    return response
+
+
+def _consume(s):
+    return scene_schedule_consumer.poll_and_consume_purpose_events(s)
+
+
+def _scene_runs(s, source_id):
+    return list(s.scalars(select(PipelineRun).where(PipelineRun.source_id == source_id)).all())
+
+
+def _sub(s, sub_id):
+    return s.scalar(select(IngestSubmission).where(IngestSubmission.submission_id == sub_id))
