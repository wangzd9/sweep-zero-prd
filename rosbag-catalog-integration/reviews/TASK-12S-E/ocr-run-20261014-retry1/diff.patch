+def test_repeat_reconcile_idempotent(db, scene_settings, monkey_source, monkeypatch):
+    """重复对账/重复 consume：提交绑定后离开 PENDING，不再被选中；run/attempt/事件不增
+    （AC-20.2 幂等：相同重放不新增 attempt/outbox 副作用或模型调用）。"""
+    monkeypatch.setenv("SCENE_INGEST_ENABLED", "1")
+    pid = f"t12se-{UNIQUE}-rp"
+    _add_scene_profile(db, pid)
+    bag = _bag_dir("rp")
+    with TestClient(app) as client:
+        first = _register(client, bag)
+    assert first.status_code == 200, first.text
+    source_id = first.json()["source_id"]
+    formal = _create_submission(pid, bag)
+    with SessionLocal() as s:
+        stats1 = _consume(s)
+        assert stats1.get("reused_runs", 0) >= 1 or stats1.get("created_runs", 0) >= 1, stats1
+        sub = _sub(s, formal["submission_id"])
+        assert sub.status == "SCHEDULED"
+        runs = _scene_runs(s, source_id)
+        assert len(runs) == 1
+        run_id = runs[0].pipeline_run_id
+        attempt0 = runs[0].attempt
+        events_before = s.scalar(select(func.count(PurposeScheduleEvent.id))) or 0
+        stats2 = _consume(s)
+        runs2 = _scene_runs(s, source_id)
+        assert len(runs2) == 1 and runs2[0].pipeline_run_id == run_id and runs2[0].attempt == attempt0
+        assert stats2.get("created_runs", 0) == 0 and stats2.get("reused_runs", 0) == 0, stats2
+        assert not (stats2.get("pending_reconciled") or {}).get("bound"), "重复对账不得再绑定"
+        events_after = s.scalar(select(func.count(PurposeScheduleEvent.id))) or 0
+        assert events_after == events_before, (events_before, events_after)
