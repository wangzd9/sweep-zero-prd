+def test_reconcile_vehicle_conflict_isolated(db, scene_settings, monkey_source, monkeypatch):
+    """车辆冲突：提交冻结车辆与原包现存 MATCHED 车辆矛盾 → 对账按既有 409 fail-closed
+    隔离该条（ERROR:* 计数），不猜车、不静默套配、不建 run（AC-20.2 契约4）。"""
+    monkeypatch.setenv("SCENE_INGEST_ENABLED", "1")
+    pid = f"t12se-{UNIQUE}-vc"
+    _add_scene_profile(db, pid)
+    bag = _bag_dir("vc")
+    with SessionLocal() as s:
+        veh_a = Vehicle(vehicle_code=f"veh-a-{UNIQUE}", display_name="A", rustdesk_id=f"rust-a-{UNIQUE}")
+        veh_b = Vehicle(vehicle_code=f"veh-b-{UNIQUE}", display_name="B", rustdesk_id=f"rust-b-{UNIQUE}")
+        s.add(veh_a)
+        s.add(veh_b)
+        s.commit()
+    metadata = {
+        "schema_version": "scene-input/v1",
+        "vehicle_code": f"veh-a-{UNIQUE}",
+        "collection_timezone": "Asia/Shanghai",
+        "batch_id": "b-" + UNIQUE,
+        "sensor_profile": "seyond-front-mid-approved-v1",
+    }
+    with TestClient(app) as client:
+        first = _register(client, bag)  # 系统兜底提交绑定（无 metadata → 零变化）
+    assert first.status_code == 200, first.text
+    source_id = first.json()["source_id"]
+    with SessionLocal() as s:
+        orig = s.scalar(select(BagRecord).where(BagRecord.bag_uid == source_id))
+        # 制造矛盾：原包 MATCHED 到 veh-b（≠ 正式提交冻结 veh-a）
+        orig.vehicle_id = veh_b.id
+        orig.vehicle_link_status = "MATCHED"
+        s.commit()
+    formal = _create_submission(pid, bag, metadata=metadata)
+    with SessionLocal() as s:
+        # 冲突隔离前置断言：consume 前系统兜底事件未消费 → 无 run（冲突隔离不烧模型）
+        assert _scene_runs(s, source_id) == []
+    with SessionLocal() as s:
+        stats = _consume(s)
+    with SessionLocal() as s:
+        sub = _sub(s, formal["submission_id"])
+        assert sub.status == "PENDING_INPUT", sub.status
+        assert any(k.startswith("ERROR") for k in stats["pending_reconciled"]["skipped"]), stats
+        assert not stats["pending_reconciled"]["bound"]
+
