+def test_reconcile_generation_drift_isolated(db, scene_settings, monkey_source, monkeypatch):
+    """代次漂移：同一入口既有绑定提交代次与现存原包代次不一致（墓碑重登记推进代次后旧
+    代次行残留）→ 隔离不静默按新代次出事件。"""
+    monkeypatch.setenv("SCENE_INGEST_ENABLED", "1")
+    pid = f"t12se-{UNIQUE}-gd"
+    _add_scene_profile(db, pid)
+    bag = _bag_dir("gd")
+    with TestClient(app) as client:
+        first = _register(client, bag)
+    assert first.status_code == 200, first.text
+    source_id = first.json()["source_id"]
+    with SessionLocal() as s:
+        sys_sub = s.scalar(select(IngestSubmission).where(IngestSubmission.source_id == source_id))
+        assert sys_sub is not None and sys_sub.status == "SCHEDULED"
+        # 制造同入口代次漂移：既有绑定提交代次 2 ≠ 现存原包代次 1
+        sys_sub.source_generation = 2
+        s.commit()
+    formal = _create_submission(pid, bag)
+    with SessionLocal() as s:
+        stats = _consume(s)
+    with SessionLocal() as s:
+        sub = _sub(s, formal["submission_id"])
+        assert sub.status == "PENDING_INPUT", sub.status
+        assert stats["pending_reconciled"]["skipped"].get("GENERATION_DRIFT", 0) >= 1, stats
