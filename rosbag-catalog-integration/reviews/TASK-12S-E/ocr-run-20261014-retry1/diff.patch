index 0000000..81b9f43
--- /dev/null
+++ b/app/services/pending_binding.py
@@ -0,0 +1,220 @@
+"""接收/登记/绑定自动闭环（TASK-12S-E，REQ-20/AC-20；SPRAY-POST-V04 §1）。
+
+补「提交/登记时序空隙」的**既有后台有界对账**（不新建通用调度平台、不无限等待、
+不依赖模型执行槽释放）：orchestrator 每轮 /orchestrator/reconcile 时，把仍处
+PENDING_INPUT 的提交与已登记原包按**冻结 root/profile/version + 相对 ready 映射**
+对账，命中准确源即按该提交自身冻结身份出用途事件，由既有 outbox 消费端幂等
+（``create_scene_run`` 的 ``scene_identity_key`` 持久唯一键）保证单份运行 + 已接受
+结果复用：相同重放不分配新分析版本、不新增 attempt/outbox 消费副作用或模型调用。
+
+契约（SPRAY-POST-V04 §1 第 2 条）：后提交必须从冻结 root/profile/version +
+相对 ready 映射定位已登记源，**不能只按 basename/快指纹匹配**。本模块定位证据：
+- 提交 intake_snapshot 的 root_id/scan_root/ready_root/profile_id/profile_version
+  （接受时冻结，DESIGN §7.3.1）；
+- ready 物理路径 = ready_root + "/" + relative_path（与 Scanner ``ready_directory_for``
+  同一 incoming→ready 相对映射）；
+- 命中的 BagRecord 必须 relative_path 精确一致、root_id 与快照推导一致、
+  bag_role 非派生切片、source_status READY。
+
+为什么不直接复用 ``bind_ingest_for_registration``：该服务按 bag 查已绑定提交做恢复
+短路（``_find_bound_submission``），当同一原包已被旧提交绑定（生产 1012 批「旧重复
+链」先于「正式提交」的场景）时，新正式 PENDING 提交会被短路跳过、永不收敛。本模块
+按**本条 PENDING 提交自身的冻结身份**直接出事件；消费端 scene_identity_key 去重保证
+与旧绑定命中同一 run（复用不重建）。
+
+不满足任一项即跳过（仍待补，不制造成功绑定）：无源=缺材料、CONFIG_REQUIRED=等补
+配置、根/车辆/代次/profile 版本漂移=需用户显式处置（既有冲突规则，不猜车、不静默
+套配）。
+"""
+
+from __future__ import annotations
+
+import json
+import os
+
+from sqlalchemy import select
+from sqlalchemy.orm import Session
+
+from app.clock import now
+from app.config import settings
+from app.domain.scene_config import EffectiveConfig, IngestPurpose, ResolvedScene
+from app.models import BagRecord, IngestProfile, IngestSubmission
+from app.services.ingest_service import _apply_frozen_vehicle_binding, _emit_purpose_events
+from app.services.scene_intake import derive_root_id_for_ready
+
+
+def pending_binding_enabled() -> bool:
+    """自动对账开关：默认启用；显式 0/false 时保持旧行为（提交停在 PENDING 等人工）。"""
+    return os.getenv("PENDING_BINDING_RECONCILE", "1").strip().lower() in {"1", "true", "yes", "on"}
+
+
+def _rebuild_effective(sub: IngestSubmission, profile_id: str, profile_version: int) -> EffectiveConfig:
+    """从提交冻结快照重建 EffectiveConfig（与 bind 主路径同一口径，避免二次解析漂移）。"""
+    snapshot = json.loads(sub.effective_config_json)
+    return EffectiveConfig(
+        profile_id=profile_id,
+        profile_version=profile_version,
+        purposes=tuple(IngestPurpose(p) for p in snapshot["purposes"]),
+        scenes=tuple(
+            ResolvedScene(
+                scene_code=s["scene_code"], capability_version=s["capability_version"], parameters=s["parameters"]
+            )
+            for s in snapshot.get("scenes", [])
+        ),
+        config_hash=snapshot["config_hash"],
+    )
+
+
+def _same_entry_bound_generation(db: Session, sub: IngestSubmission) -> int | None:
+    """同一入口（profile + relative_path）最近一条已绑定提交（排除本条）冻结的代次。
+
+    仅比对**同入口**的既有绑定：不同入口（不同 relative_path）绑同一物理原包时，
+    代次可不同（各自显式重导入）；同入口代次不一致=该入口既有绑定被墓碑重登记
+    推进后旧代次行残留，属需显式处置的冲突，不能静默按新代次出事件。
+    """
+    row = db.scalar(
+        select(IngestSubmission.source_generation)
+        .where(
+            IngestSubmission.profile_id == sub.profile_id,
+            IngestSubmission.relative_path == sub.relative_path,
+            IngestSubmission.status.in_(["BOUND", "SCHEDULED"]),
+            IngestSubmission.submission_id != sub.submission_id,
+            IngestSubmission.source_generation.is_not(None),
+        )
+        .order_by(IngestSubmission.updated_at.desc())
+        .limit(1)
+    )
+    return row
+
+
+def reconcile_pending_bindings(db: Session, limit: int = 50) -> dict:
+    """把 PENDING_INPUT 提交与已登记原包对账绑定（幂等、有界、单条隔离）。
+
+    返回 {"checked": N, "bound": [submission_id...], "skipped": {reason: count},
+    "events_created": int}。逐条独立事务：单条故障只回滚本条并记原因，不拖垮整批，
+    下轮重试。提交成功即固化，重复对账不再选中（幂等无副作用）。"""
+    result = {"checked": 0, "bound": [], "skipped": {}, "events_created": 0}
+    if not pending_binding_enabled():
+        return result
+    submissions = list(
+        db.scalars(select(IngestSubmission).where(IngestSubmission.status == "PENDING_INPUT").limit(limit)).all()
+    )
+    for sub in submissions:
+        result["checked"] += 1
+        try:
+            outcome, events = _reconcile_one(db, sub)
+        except Exception as exc:  # 单条隔离：回滚本条，记原因继续
+            db.rollback()
+            reason = f"ERROR:{type(exc).__name__}"
+            result["skipped"][reason] = result["skipped"].get(reason, 0) + 1
+            continue
+        if outcome == "bound":
+            result["bound"].append(sub.submission_id)
+            result["events_created"] += events
+        else:
+            result["skipped"][outcome] = result["skipped"].get(outcome, 0) + 1
+    return result
+
+
+def _reconcile_one(db: Session, sub: IngestSubmission) -> tuple[str, int]:
+    """定位并绑定单条 PENDING 提交；返回 (outcome, 新增事件数)。
+
+    outcome ∈ {"bound", "NO_SNAPSHOT", "CONFIG_REQUIRED", "ROOT_MISMATCH",
+    "NO_SOURCE_YET", "SLICE_NOT_ORIGINAL", "SOURCE_NOT_READY", "PROFILE_DISABLED",
+    "GENERATION_DRIFT"}。车辆冲突等既有 409/ValueError 语义冒泡由上层按 ERROR:* 隔离
+    （不猜车、不静默套配）。
+    """
+    snapshot_raw = sub.intake_snapshot_json
+    if not snapshot_raw:
+        return "NO_SNAPSHOT", 0
+    try:
+        snapshot = json.loads(snapshot_raw)
+    except (TypeError, ValueError):
+        return "NO_SNAPSHOT", 0
+    ready_root = snapshot.get("ready_root")
+    if not ready_root or not sub.relative_path:
+        return "NO_SNAPSHOT", 0
+    # CONFIG_REQUIRED（接受时未解析）：停在待处理等用户补配置，不在对账里猜配置
+    # （与 bind 主路径同口径：补配置后经显式登记/绑定出事件）。
+    if sub.config_required or not sub.effective_config_json:
+        return "CONFIG_REQUIRED", 0
+    ready_root = str(ready_root).rstrip("/")
+    incoming_root = str(snapshot.get("scan_root") or "").rstrip("/")
+    profile_row = db.scalar(
+        select(IngestProfile).where(
+            IngestProfile.profile_id == sub.profile_id,
+            IngestProfile.version == sub.profile_version,
+        )
+    )
+    if profile_row is None or not profile_row.enabled:
+        return "PROFILE_DISABLED", 0
+    # 相对 ready 映射（契约2：冻结 root/profile/version + 相对 ready 映射，非 basename
+    # 匹配）。提交 relative_path 是**入口相对路径**（match_profile_for_incoming 已按
+    # profile.incoming_prefix 剥离前缀），故原包行 relative_path ∈ {相对段, prefix/相对段}。
+    # 用精确相对路径候选查原包行（storage/ready 根绝对段在测试与生产不一致，不做前缀假设）。
+    prefix = (profile_row.incoming_prefix or "").strip("/")
+    # 候选相对路径：优先 ready_root 的 storage 相对段（root 限定，杜绝跨根同包名误配：
+    # self_built 根 "ready/{bag}" 段 vs scene 提交短段 "{bag}"），回落短段兼容测试口径
+    # （fake 登记 path 不带 storage 前缀时 bag.relative_path 即短段）。
+    storage_root = settings.nas_storage_root.rstrip("/")
+    if ready_root == storage_root or ready_root.startswith(storage_root + "/"):
+        ready_rel_root = ready_root.removeprefix(storage_root).lstrip("/")
+    else:
+        # 防御：ready 根不在 storage 根下时（配置异常），物理段口径退化为相对路径候选
+        # 命中即视为同根（身份防线仍由 snapshot root_id 推导核对承载）。
+        ready_rel_root = None
+    candidates = [sub.relative_path]
+    if ready_rel_root:
+        candidates.append("/".join(part for part in (ready_rel_root, prefix, sub.relative_path) if part))
+    # 兜底：ready 根的 storage 相对段（ready 根恰为 storage 根或其下时与上式重复去重；
+    # 测试环境 fake ready 根不在 storage 下时，此式命中同包名另一根登记的相对行）
+    candidates.append(ready_root.lstrip("/") + "/" + sub.relative_path)
+    if prefix:
+        candidates.append(f"{prefix}/{sub.relative_path}")
+    bag = None
+    for cand in dict.fromkeys(candidates):
+        bag = db.scalar(select(BagRecord).where(BagRecord.relative_path == cand).limit(1))
+        if bag is not None:
+            break
+    # 身份防线：ready_root 必须落在受控根且推导身份与快照 root_id 一致（跨根不绑、不猜）。
+    snapshot_root = snapshot.get("root_id")
+    configured = derive_root_id_for_ready(ready_root)
+    if configured is not None and configured != snapshot_root:
+        return "ROOT_MISMATCH", 0
+    if snapshot_root == "scene" and settings.scene_nas_ready_root:
+        if derive_root_id_for_ready(ready_root) != "scene":
+            return "ROOT_MISMATCH", 0
+    if bag is None:
+        return "NO_SOURCE_YET", 0
+    # 身份防线（物理段）：命中的原包行必须落在本提交冻结 ready 根的物理相对段下。
+    # 相对段候选命中但物理段不符（同包名登记在**另一根**，如 self_built 根的
+    # ready/{bag} 行被 scene 提交短段候选捞中）→ ROOT_MISMATCH 不绑（AC-20.2 契约2：
+    # 同 root/profile/version + 相对 ready 映射定位，跨根不静默套配）。
+    if ready_rel_root and not (
+        bag.relative_path == ready_rel_root or bag.relative_path.startswith(ready_rel_root + "/")
+    ):
+        return "ROOT_MISMATCH", 0
+    if bag.bag_role == "SCENE_SLICE":
+        return "SLICE_NOT_ORIGINAL", 0  # 派生切片不是可绑定原包（AC-20.2）
+    if bag.source_status != "READY":
+        return "SOURCE_NOT_READY", 0
+    source_generation = bag.source_generation or 1
+    # 代次一致性：同一入口已有绑定提交且其代次与现存原包不一致 → 代次漂移，需显式
+    # 处置（既有冲突规则），不静默套配。
+    bound_gen = _same_entry_bound_generation(db, sub)
+    if bound_gen is not None and bound_gen != source_generation:
+        return "GENERATION_DRIFT", 0
+    # 按本条提交自身冻结身份出用途事件（消费端 scene_identity_key 去重保证与旧绑定
+    # 命中同一 run，复用不重建）；车辆冻结绑定同 bind 主路径（矛盾 409 由上层隔离）。
+    effective = _rebuild_effective(sub, profile_row.profile_id, profile_row.version)
+    _apply_frozen_vehicle_binding(db, sub, bag.bag_uid)
+    events = _emit_purpose_events(db, sub, effective, bag.bag_uid, source_generation, profile_row)
+    sub.status = "SCHEDULED" if events else "BOUND"
+    sub.source_id = bag.bag_uid
+    sub.source_generation = source_generation
+    sub.bound_incoming_path = f"{incoming_root}/{sub.relative_path}" if incoming_root else None
+    sub.bound_ready_path = f"{ready_root}/{bag.relative_path}"
+    sub.path_claim_key = None  # 绑定完成释放占位（路径可被后续提交复用）
+    sub.updated_at = now()
+    db.commit()
+    return "bound", len(events)
