+def test_register_then_formal_submit_reuses_existing_run(db, scene_settings, monkey_source, monkeypatch):
+    """主事故场景：先登记（系统兜底提交 SCHEDULED + consume 建 run）→ 源已 READY 后再建
+    正式提交（PENDING_INPUT）→ 对账绑定，消费复用既有 scene_identity_key run：
+    created_runs=0/reused_runs>=1，单份 run，attempt 不变（REPORT.md 人工修复口径自动化）。"""
+    monkeypatch.setenv("SCENE_INGEST_ENABLED", "1")
+    pid = f"t12se-{UNIQUE}-rt"
+    _add_scene_profile(db, pid)
+    bag = _bag_dir("rt")
+    with TestClient(app) as client:
+        first = _register(client, bag)
+    assert first.status_code == 200, first.text
+    source_id = first.json()["source_id"]
+    with SessionLocal() as s:
+        # 登记出系统兜底提交 SCHEDULED；consume 建唯一 run
+        sys_sub = s.scalar(select(IngestSubmission).where(IngestSubmission.source_id == source_id))
+        assert sys_sub is not None and sys_sub.status == "SCHEDULED", sys_sub.status
+        stats0 = _consume(s)
+        assert stats0["created_runs"] == 1 and stats0["pending"] == 0, stats0
+        runs = _scene_runs(s, source_id)
+        assert len(runs) == 1
+        run_id = runs[0].pipeline_run_id
+        attempt0 = runs[0].attempt
+    # 源已 READY 后建正式提交（create_submission 不绑定已存在源 → PENDING_INPUT）
+    formal = _create_submission(pid, bag)
+    with SessionLocal() as s:
+        assert _sub(s, formal["submission_id"]).status == "PENDING_INPUT"
+        stats = _consume(s)
+    with SessionLocal() as s:
+        sub = _sub(s, formal["submission_id"])
+        assert sub.status == "SCHEDULED" and sub.source_id == source_id and sub.source_generation == 1, sub.status
+        assert sub.bound_ready_path, "对账必须落 bound_ready_path（精确原包身份证据）"
+        # 复用既有 run：不新建、不烧模型（REPORT.md created_runs=0/reused 口径）
+        assert stats["created_runs"] == 0, stats
+        assert stats["reused_runs"] >= 1, stats
+        runs = _scene_runs(s, source_id)
+        assert len(runs) == 1 and runs[0].pipeline_run_id == run_id and runs[0].attempt == attempt0
+
