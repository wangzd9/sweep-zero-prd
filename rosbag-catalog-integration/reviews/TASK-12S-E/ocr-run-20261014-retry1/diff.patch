+def test_reconcile_cross_root_not_bound(db, scene_settings, monkey_source, monkeypatch):
+    """跨根身份防线：scene 提交（快照 root=scene，ready_root=scene 根）只能绑定落在本冻结
+    ready 根物理相对段下的原包行；另一根/歧义位置的同包名行 → ROOT_MISMATCH 不绑、
+    不猜根，提交保持 PENDING，self_built 源零触碰（AC-20.2 契约2）。"""
+    monkeypatch.setenv("SCENE_INGEST_ENABLED", "1")
+    pid = f"t12se-{UNIQUE}-xr"
+    _add_scene_profile(db, pid)
+    bag = _bag_dir("xr")
+    # self_built 根登记（行落 ready/{bag}，READY）
+    with TestClient(app) as client:
+        resp = _register(client, bag, root="self_built")
+    assert resp.status_code == 200, resp.text
+    self_source_id = resp.json()["source_id"]
+    with SessionLocal() as s:
+        other = s.scalar(select(BagRecord).where(BagRecord.bag_uid == self_source_id))
+        assert other is not None and other.relative_path == f"ready/{bag}", other.relative_path
+        assert other.source_status == "READY"
+        # 造一行业务行落在 ready 根的 storage 绝对段（候选命中但不在冻结 ready 根物理
+        # 相对段 scene/ready/ 下）→ 触发物理段身份防线 ROOT_MISMATCH
+        s.add(
+            BagRecord(
+                bag_uid="XRA" + UNIQUE.upper(),
+                name=bag,
+                relative_path=f"test/scene/ready/{bag}",
+                bag_role="ORIGINAL",
+                source_generation=1,
+                source_status="READY",
+            )
+        )
+        s.commit()
+    formal = _create_submission(pid, bag)  # scene 提交（快照 root=scene）
+    with SessionLocal() as s:
+        stats = _consume(s)
+    with SessionLocal() as s:
+        sub = _sub(s, formal["submission_id"])
+        assert sub.status == "PENDING_INPUT", sub.status
+        assert (stats["pending_reconciled"]["skipped"]).get("ROOT_MISMATCH", 0) >= 1, stats
+        assert not stats["pending_reconciled"]["bound"]
+        # self_built 源未被 scene 事件触碰（self_built 登记自建 Phase0 run 是既有合法行为，
+        # 断言其无 SCENE_SLICE run）
+        assert [r for r in _scene_runs(s, self_source_id) if r.pipeline_type == "SCENE_SLICE"] == []
+
