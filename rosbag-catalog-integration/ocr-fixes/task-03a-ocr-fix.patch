+# ---- 2026-10-08 OCR 审查回归（协调者合入修复） ----
+
+
+def test_effective_config_view_schema_version_roundtrip():
+    """schema_version 双向保真：非当前版本的视图往返不得漂移回默认常量。"""
+    profile = IngestProfileSchema(
+        profile_id="scene-incoming",
+        version=1,
+        incoming_prefix="/test/incoming",
+        default_purposes=[IngestPurpose.SCENE_SLICE],
+        default_scenes=["slope"],
+    ).to_domain()
+    capability = CapabilityDescriptionSchema(**_capability_payload()).to_domain()
+    config = resolve_effective_config(profile, StaticCapabilityRegistry({"slope": (capability,)}))
+    assert config is not None
+    view = EffectiveConfigView.from_domain(config)
+    # 构造一个 schema_version 非当前常量的视图，验证 to_domain 不再丢弃它。
+    stale = view.model_copy(update={"schema_version": "scene-config-v0"})
+    restored = stale.to_domain()
+    assert restored.schema_version == "scene-config-v0"
+
+
+def test_capability_parameter_default_must_conform():
+    """能力描述 default 与声明 type/范围/枚举不一致时拒绝。"""
+    with pytest.raises(ValidationError, match="default"):
+        CapabilityParameterSchema(name="x", type="int", default="abc")
+    with pytest.raises(ValidationError, match="default"):
+        CapabilityParameterSchema(name="x", type="int", default=100, minimum=1, maximum=10)
+    with pytest.raises(ValidationError, match="default"):
+        CapabilityParameterSchema(name="x", type="str", default=123)
+    with pytest.raises(ValidationError, match="default"):
+        CapabilityParameterSchema(name="x", type="str", default="b", allowed_values=["a"])
+
