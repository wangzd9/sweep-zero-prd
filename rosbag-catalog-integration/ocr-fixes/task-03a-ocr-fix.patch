diff --git a/tests/test_scene_config_resolution.py b/tests/test_scene_config_resolution.py
index 2f3219c..f6960a7 100644
--- a/tests/test_scene_config_resolution.py
+++ b/tests/test_scene_config_resolution.py
@@ -304,3 +304,57 @@ def test_idempotency_key_length_limit():
     with pytest.raises(SceneConfigError) as excinfo:
         resolve_effective_config(profile, _registry(_slope_description()), selection)
     assert excinfo.value.code == "INVALID_IDEMPOTENCY_KEY"
+
+
+# ---- 2026-10-08 OCR 审查回归（协调者合入修复） ----
+
+
+def test_identical_duplicate_scenes_are_deduped():
+    """同一场景重复提交且版本一致：去重取先者，不报版本冲突。"""
+    profile = _profile()
+    registry = _registry(_slope_description("slope-v1"))
+    selection = SubmissionSelection(
+        scenes=[
+            SceneSelection(scene_code="slope", capability_version="slope-v1", parameters={"segment_len": 20}),
+            SceneSelection(scene_code="slope", capability_version="slope-v1", parameters={"segment_len": 30}),
+        ]
+    )
+    config = resolve_effective_config(profile, registry, selection)
+    assert config is not None
+    assert [scene.scene_code for scene in config.scenes] == ["slope"]
+    assert config.scenes[0].parameters["segment_len"] == 20  # 取先者
+
+
+def test_purposes_reject_unhashable_item():
+    """不可哈希的用途元素（dict/list）必须收敛为 INVALID_PURPOSES，不逃逸 TypeError。"""
+    profile = _profile()
+    selection = SubmissionSelection(purposes=[{"scene_slice": 1}])  # type: ignore[list-item]
+    with pytest.raises(SceneConfigError) as excinfo:
+        resolve_effective_config(profile, _registry(_slope_description()), selection)
+    assert excinfo.value.code == "INVALID_PURPOSES"
+
+
+def test_non_finite_parameter_rejected():
+    """NaN/Inf 与上下限比较恒为 False，必须显式拒绝而不是静默进入冻结配置。"""
+    import math
+
+    profile = _profile()
+    registry = _registry(_slope_description())
+    selection = SubmissionSelection(
+        scenes=[SceneSelection(scene_code="slope", parameters={"segment_len": math.inf})]
+    )
+    with pytest.raises(SceneConfigError) as excinfo:
+        resolve_effective_config(profile, registry, selection)
+    assert excinfo.value.code == "INVALID_PARAMETERS"
+
+
+def test_scene_parameters_non_dict_rejected():
+    """parameters 为 falsy 非 dict（0/False/[]）时必须拒绝，不得静默强转空 dict。"""
+    profile = _profile()
+    registry = _registry(_slope_description())
+    selection = SubmissionSelection(
+        scenes=[SceneSelection(scene_code="slope", parameters=[])]  # type: ignore[dict-item]
+    )
+    with pytest.raises(SceneConfigError) as excinfo:
+        resolve_effective_config(profile, registry, selection)
+    assert excinfo.value.code == "INVALID_SCENES"
