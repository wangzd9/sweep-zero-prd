+    def test_latest_version_prefers_numeric_suffix(self, tmp_path):
+        """多位版本号按数字后缀排序，字典序不得选中 slope-v9 当 latest。"""
+        entry = _test_capability()
+        v9 = dict(entry, scene_code="multi", adapter_key="multi-v9", capability_version="multi-v9")
+        v10 = dict(entry, scene_code="multi", adapter_key="multi-v10", capability_version="multi-v10")
+        reg = _make_registry(tmp_path, [v9, v10])
+        assert reg.resolve("multi").capability_version == "multi-v10"
+
+    def test_defaults_must_match_schema_default(self, tmp_path):
+        """YAML defaults 与 parameter_schema default 不一致时拒绝，不静默漂移。"""
+        entry = _test_capability()
+        entry["defaults"] = {"expect_frames": 5}  # schema default=1
+        with pytest.raises(CapabilityError, match="不一致"):
+            _make_registry(tmp_path, [entry])
+
+    def test_cross_field_constraint_rejects_invalid_combo(self, tmp_path):
+        """声明 overlap<segment_len：非法组合在冻结 config_hash 前被拒。"""
+        entry = _slope_capability_entry()
+        entry["scene_code"] = "slopex"  # 避免与 _make_registry 默认 slope-v1 重复注册
+        entry["adapter_key"] = "slopex-v1"
+        entry["parameter_constraints"] = ["overlap_lt_segment_len"]
+        reg = _make_registry(tmp_path, [entry])
+        # segment_len 下限 5、overlap 上限 60：该组合合法单参但违反跨字段约束
+        with pytest.raises(CapabilityError, match="overlap_lt_segment_len") as excinfo:
+            reg.effective_params("slopex", {"segment_len": 5, "overlap": 60})
+        assert excinfo.value.code == "INVALID_PARAMETERS"
+        # 合法组合（overlap 60 < segment_len 300）通过
+        ok = reg.effective_params("slopex", {"segment_len": 300, "overlap": 60})
+        assert ok.parameters == {"segment_len": 300, "overlap": 60, "min_effective": 5}
+
